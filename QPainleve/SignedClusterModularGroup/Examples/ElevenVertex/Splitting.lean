/-!
# The eleven-vertex cyclic complement

The ordered plane presentation supplies a one-component boundary for
`CompleteToricPresentation.exists_picardEquiv_with_faithful_exchangeKernelAction`.
The faithful action identifies the specified word's centrality from its action
by negation. The cyclic group generated by the word complements the unsigned
group, with the direct product realized by multiplication of point maps.
-/

public section

open CategoryTheory MulOpposite Quiver
open QPainleve.Cluster

namespace QPainleve.ElevenVertex

local notation "B" => exchangeMatrix
local notation "eval[" k "," w "]" => signedClusterModularGroupMap k B (End.of w)

section Faithfulness

open AlgebraicGeometry Module
open QPainleve.SignedClusterModularGroup
open Scheme.IdealSheafData TauCeti.AlgebraicGeometry TauCeti.Toric TauCeti.Toric.Fan

local notation "S" => Spec (CommRingCat.of ℂ)
local notation "b" => Pi.basisFun ℤ (Fin 2)
local notation "hi" => isIntegralLattice_intCast 2
local notation "δ[" h "]" => (LineBundleClass.mk (IsEffectiveCartier.toInvertibleSheaf h))⁻¹

private theorem exchangeKernelAction_injective_or_neg :
    Function.Injective (exchangeKernelAction ℂ B) ∨
      Function.Injective (exchangeKernelAction ℂ (-B)) := by
  obtain ⟨W, s, hs, D, hD, _, hpre, _, _, A, U, R, a, _, hW, hproj, hrat, _, _, _,
    hprim, hnef, hsq, hR, hbase, hker, _, _, _, _⟩ := exists_eleven_vertex_toric_presentation 1
  let : W.Over S := ⟨s⟩
  let : SmoothOfRelativeDimension 2 (W ↘ S) := hs
  let : IsIntegral W := hW
  let : W.IsProjectiveOver ℂ := hproj
  let : Scheme.IsRationalOver (W ↘ S) := hrat
  let : PrestableFamily (D.subscheme ↘ S) := hpre
  let : (Iso.refl D.subscheme).hom.IsOver S :=
    inferInstanceAs ((𝟙 D.subscheme : D.subscheme ⟶ D.subscheme).IsOver S)
  let numbering := (Iso.refl D.subscheme).mapNodalCycleNumbering A
    (q := (Empty.elim : Empty → (D.subscheme ↘ S).smoothLocus))
  let : Module.Free ℤ (Additive (LineBundleClass W)) := W.free_picard_of_isRationalOver ℂ
  let : Module.Finite ℤ (Additive (LineBundleClass W)) := W.finite_picard_of_isRationalOver ℂ
  let coordinates := (Module.finBasis ℤ (Additive (LineBundleClass W))).equivFun.symm
  let H := (Chow.intersectionBilinForm ℂ W).comp coordinates.toLinearMap coordinates.toLinearMap
  let μ : H.IsometryEquiv (Chow.intersectionBilinForm ℂ W) :=
    ((Chow.intersectionBilinForm ℂ W).isometryEquivOfCompLinearEquiv coordinates).symm
  obtain ⟨b', ⟨Q, c, f, href⟩, hframe, ⟨hfan, hrays⟩⟩ :=
    exists_marked_reference_fiber_of_ordered_towers (isRegular_projectiveSpace b hi)
      (isComplete_projectiveSpace b hi) planeCenterRay 1 hR a hbase hker hD numbering μ
  let M := MarkedSurface.ofBoundary D numbering μ f
  have hδ : δ[M.isEffectiveCartier_boundaryIdeal] = δ[hD] :=
    congrArg Inv.inv (LineBundleClass.mk_toInvertibleSheaf_congr _ _
      (MarkedSurface.ofBoundary_ker ..))
  have hcharge {Φ Ψ : Fan (AddMonoidHom.compLeft (Int.castAddHom ℝ) (Fin 2))}
      (h : Φ = Ψ) (r : Fin 11 → Φ.Ray) :
      Fan.rayChargeMap (h ▸ r : Fin 11 → Ψ.Ray) = Fan.rayChargeMap r := by
    subst Ψ
    rfl
  have hq : Fan.rayChargeMap Q.rays = chargeMap := (hcharge hfan Q.rays).symm.trans
    ((congrArg (fun r ↦ Fan.rayChargeMap r) hrays).trans rayChargeMap_planeCenterRay)
  have hFaithful (E : SkewExchangeMatrix (Fin 11))
      (hE : E.matrix = chargeExchangeMatrix b'.detDualEquiv.toLinearMap (Fan.rayChargeMap Q.rays)) :
      Function.Injective (exchangeKernelAction ℂ E) := by
    obtain ⟨_, _, _, _, hinj, _⟩ := Q.exists_picardEquiv_with_faithful_exchangeKernelAction
      href hE (by rwa [hδ]) (by rwa [hδ]) (by rwa [hδ])
    exact hinj
  rcases hframe with ⟨hb, _⟩ | ⟨hb, _⟩
  · exact Or.inl (hFaithful B (by rw [hq, hb, exchangeMatrix_eq_chargeExchangeMatrix]))
  · exact Or.inr (hFaithful (-B) (by
      rw [hq, ← rayChargeMap_planeCenterRay, hb, chargeExchangeMatrix_reindex_swap,
        rayChargeMap_planeCenterRay, SkewExchangeMatrix.neg_matrix,
        exchangeMatrix_eq_chargeExchangeMatrix]))

private theorem xPullback_eq_of_exchangeKernelEquiv_eq_of_faithful_neg
    (h : Function.Injective (exchangeKernelAction ℂ (-B))) (w v : Word B B)
    (he : w.exchangeKernelEquiv = v.exchangeKernelEquiv) : w.xPullback ℂ = v.xPullback ℂ := by
  let t : Word B (-B) := (Path.nil : Word B B).cons ⟨.invert, Generator.target_invert B⟩
  let w' := (t.reverse.comp w).comp t
  let v' := (t.reverse.comp v).comp t
  have he' : w'.exchangeKernelEquiv = v'.exchangeKernelEquiv := by
    simp only [w', v', Path.exchangeKernelEquiv_comp, he]
  have hp : w'.xPullback ℂ = v'.xPullback ℂ := by
    apply (signedClusterModularGroupMap_eq_iff ℂ (-B) (End.of w') (End.of v')).mp
    apply op_injective
    apply h
    simpa only [exchangeKernelAction_op_loop] using he'
  simp only [w', v', Path.xPullback_comp] at hp
  exact mul_right_cancel (mul_left_cancel hp)

/-- Equality of eleven-vertex signed loop pullbacks is detected by the integral
action on the exchange kernel, over every field of characteristic zero. -/
theorem xPullback_eq_iff_exchangeKernelEquiv_eq (k : Type*) [Field k] [CharZero k]
    (w v : Word B B) : w.xPullback k = v.xPullback k ↔
      w.exchangeKernelEquiv = v.exchangeKernelEquiv := by
  refine ⟨Path.exchangeKernelEquiv_eq_of_xPullback_eq k, fun h ↦ ?_⟩
  rw [Path.xPullback_eq_iff_ySeed_coefficient_eq k w v,
    ← Path.xPullback_eq_iff_ySeed_coefficient_eq ℂ w v]
  rcases exchangeKernelAction_injective_or_neg with hB | hB
  · apply (signedClusterModularGroupMap_eq_iff ℂ B (End.of w) (End.of v)).mp
    apply op_injective
    apply hB
    simpa only [exchangeKernelAction_op_loop] using h
  · exact xPullback_eq_of_exchangeKernelEquiv_eq_of_faithful_neg hB w v h

end Faithfulness

private theorem exchangeKernelAction_injective (k : Type*) [Field k] [CharZero k] :
    Function.Injective (exchangeKernelAction k B) := by
  intro x y h
  obtain ⟨w, hw⟩ := signedClusterModularGroupMap_surjective k B x.unop
  obtain ⟨v, hv⟩ := signedClusterModularGroupMap_surjective k B y.unop
  rw [← op_unop x, ← op_unop y, ← hw, ← hv] at h ⊢
  rw [exchangeKernelAction_op_loop, exchangeKernelAction_op_loop] at h
  exact congrArg op ((signedClusterModularGroupMap_eq_iff k B w v).mpr
    ((xPullback_eq_iff_exchangeKernelEquiv_eq k w.asHom v.asHom).mpr h))

private theorem involutionWord_action (k : Type*) [Field k] :
    exchangeKernelAction k B (op eval[k,involutionWord]) = LinearEquiv.neg ℤ := by
  rw [exchangeKernelAction_op_loop]
  exact LinearEquiv.ext involutionWord_exchangeKernelEquiv_apply

/-- The cyclic subgroup generated by the eleven-vertex involution word has order two
and is a direct product complement of the unsigned cluster modular group. The
equivalence multiplies the included unsigned point map by the cyclic factor. -/
theorem exists_mulEquiv_prod_zpowers_involutionWord (k : Type*) [Field k] [CharZero k] :
    let z := eval[k,involutionWord]
    orderOf z = 2 ∧
      ∃ e : ClusterModularGroup k B × Subgroup.zpowers z ≃* SignedClusterModularGroup k B,
      ∀ (f : ClusterModularGroup k B) (u : Subgroup.zpowers z),
        e (f, u) = clusterModularGroupInclusion k B f * u.val := by
  let z := eval[k,involutionWord]
  have horder : orderOf z = 2 := by
    let inclusion := (signedLoopPullbacks k B).subtype
    have hp : inclusion z.unop = involutionWord.xPullback k :=
      signedClusterModularGroupMap_unop_coe k B (End.of involutionWord)
    have h := (orderOf_injective inclusion Subtype.coe_injective z.unop).symm
    rw [hp, orderOf_involutionWord_xPullback] at h
    have he := (MulEquiv.inv' (signedLoopPullbacks k B)).orderOf_eq z.unop
    simpa only [MulEquiv.inv'_apply, Function.comp_apply, MulOpposite.op_inv, op_unop, orderOf_inv]
      using he.trans h
  have hcentral : z ∈ Subgroup.center (SignedClusterModularGroup k B) := by
    rw [Subgroup.mem_center_iff]
    intro f
    apply op_injective
    apply exchangeKernelAction_injective k
    simp only [op_mul, map_mul, z, involutionWord_action]
    ext x
    simp
  have hB : (B).matrix ≠ 0 := by
    intro h
    apply LinearMap.ne_zero_of_surjective surjective_chargeMap
    rw [← LinearMap.ker_eq_top, ← exchangeKernel_eq_chargeKernel, h,
      Matrix.mulVecLin_zero, LinearMap.ker_zero]
  have hodd : Odd involutionWord.inversionCount := by
    rw [inversionCount_involutionWord]
    decide
  exact ⟨horder, exists_mulEquiv_prod_zpowers_of_central_odd_loop k B (hB := hB)
    involutionWord hodd horder hcentral⟩

end QPainleve.ElevenVertex
