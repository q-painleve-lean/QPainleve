module

public import QPainleve.Algebra.Cluster.Word.SignExtension
public import QPainleve.SignedClusterModularGroup.Examples.ElevenVertex

import QPainleve.SignedClusterModularGroup.Examples.ElevenVertex.Decision

/-!
# The eleven-vertex cyclic complement

The integral exchange-kernel action is faithful and the involution word acts by negation.
The cyclic subgroup generated by this central involution complements the unsigned group.
The direct-product equivalence multiplies the two factors as point maps.
-/

public noncomputable section

open CategoryTheory MulOpposite Quiver
open QPainleve.Cluster

namespace QPainleve.ElevenVertex

variable (k : Type*) [Field k]

local notation "B" => exchangeMatrix
local notation "z" => signedClusterModularGroupMap k B (End.of involutionWord)

/-- The point map of the eleven-vertex involution word has order two. -/
theorem orderOf_involutionWord_pointMap : orderOf z = 2 := by
  have hp := signedClusterModularGroupMap_unop_coe k B (End.of involutionWord)
  have h := (MulEquiv.inv' (signedLoopPullbacks k B)).orderOf_eq (unop z)
  calc
    orderOf z = orderOf (unop z) := by
      simpa only [MulEquiv.inv'_apply, Function.comp_apply, MulOpposite.op_inv, op_unop,
        orderOf_inv] using h
    _ = 2 := by
      rw [← Subgroup.orderOf_coe (unop z), hp]
      exact orderOf_involutionWord_xPullback k

private theorem signedInversionSign_involutionWord :
    signedInversionSign k B exchangeMatrix_matrix_ne_zero z = -1 := by
  have h : (-1 : ℤˣ) ^ involutionWord.inversionCount = -1 := by
    simp only [inversionCount_involutionWord, pow_one]
  exact (signedInversionSign_apply k B exchangeMatrix_matrix_ne_zero
    (End.of involutionWord)).trans h

variable [CharZero k]

/-- The eleven-vertex involution word is central in the signed cluster modular group. -/
theorem involutionWord_pointMap_mem_center :
    z ∈ Subgroup.center (SignedClusterModularGroup k B) := by
  rw [Subgroup.mem_center_iff]
  intro f
  apply op_injective
  apply exchangeKernelAction_injective k
  have hneg : exchangeKernelAction k B (op z) = LinearEquiv.neg ℤ := by
    rw [exchangeKernelAction_op_loop]
    exact LinearEquiv.ext involutionWord_exchangeKernelEquiv_apply
  simp only [op_mul, map_mul, hneg]
  ext x
  simp

/-- Multiplication of point maps identifies the signed eleven-vertex cluster modular group
with the product of the unsigned group and the order-two subgroup of the involution word. -/
def involutionWordMulEquiv :
    ClusterModularGroup k B × Subgroup.zpowers z ≃* SignedClusterModularGroup k B :=
  mulEquivProdZPowersOfCentralInvolution k B
    (signedInversionSign_involutionWord k) (orderOf_involutionWord_pointMap k)
    (involutionWord_pointMap_mem_center k)

@[simp]
theorem involutionWordMulEquiv_apply (x : ClusterModularGroup k B × Subgroup.zpowers z) :
    involutionWordMulEquiv k x = clusterModularGroupInclusion k B x.1 * x.2.val := by
  simp [involutionWordMulEquiv]

end QPainleve.ElevenVertex
