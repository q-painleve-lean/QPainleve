module

public import QPainleve.SignedClusterModularGroup.Examples.FourVertex.Basic

import Mathlib.LinearAlgebra.RootSystem.OfBilinear
import Mathlib.LinearAlgebra.Transvection.Basic
import QPainleve.LinearAlgebra.BilinearForm.RadicalGenerator

/-!
# Generators of the four-vertex boundary isometry groups

The rotation group is generated by a two-step boundary rotation and a lift of the
unit translation of the orthogonal lattice. The translation is the composite of a
two-step rotation and the root reflection in the first orthogonal basis vector.
A signed reflection then generates the nontrivial sign coset.

The lattice calculation provides a generation criterion for comparing with the three
cluster words of Bershtein, Gavrylenko and Marshakov, *Cluster integrable systems,
q-Painlevé equations and their quantization*, §3, equation (3.1).
-/

public noncomputable section

open LinearMap Module Submodule
open scoped RightActions

namespace QPainleve.FourVertex

open SignedBoundaryIsometryGroup

local notation "L" => Fin 10 → ℤ
local notation "K" => intersectionForm.orthogonal (Submodule.span ℤ (Set.range boundaryClass))
local notation "B" => intersectionForm.restrict K
local notation "G" => boundaryRotationGroup intersectionForm boundaryClass
local notation "Ĝ" => signedBoundaryIsometryGroup intersectionForm boundaryClass
local notation "ι" => rotationInclusion intersectionForm boundaryClass
local notation "ε" => sign intersectionForm boundaryClass
local notation "ρ" => MonoidHom.comp (signedOrthogonalRestriction intersectionForm boundaryClass) ι
local notation "κ" => boundaryOrthogonalBasis 0
local notation "δ" => boundaryOrthogonalBasis 0 + boundaryOrthogonalBasis 1

private theorem coord_one_first_orthogonal : boundaryOrthogonalBasis.coord 1 κ = 0 := by
  simp [Basis.coord_apply]

private def radicalBasis : Basis (Fin 2) ℤ K :=
  boundaryOrthogonalBasis.map (LinearEquiv.transvection coord_one_first_orthogonal)

@[simp]
private theorem radicalBasis_zero : radicalBasis 0 = κ := by
  rw [radicalBasis, Basis.map_apply, LinearEquiv.transvection.apply, coord_one_first_orthogonal]
  simp

@[simp]
private theorem radicalBasis_one : radicalBasis 1 = δ := by
  rw [radicalBasis, Basis.map_apply, LinearEquiv.transvection.apply]
  simp [Basis.coord_apply, add_comm]

private theorem toMatrix_restrict_radicalBasis :
    (B).toMatrix radicalBasis = Matrix.diagonal ![-2, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [BilinForm.toMatrix_apply, BilinForm.restrict_apply, radicalBasis_zero,
      radicalBasis_one, Submodule.coe_add, map_add, add_apply,
      intersectionForm_boundaryOrthogonalBasis, Matrix.diagonal_apply,
      -coe_boundaryOrthogonalBasis_zero, -coe_boundaryOrthogonalBasis_one]

private theorem coe_radicalGenerator :
    (δ : L) = ∑ j : ZMod 8, boundaryClass j := by
  simpa only [Fin.sum_univ_two, Submodule.coe_add] using sum_boundaryOrthogonalBasis

private def rotationRestriction :
    G →* MulAction.stabilizer (B).isometryGroup (radicalBasis 1) :=
  (ρ).codRestrict _ fun g ↦ by
    apply MulAction.mem_stabilizer_iff.mpr
    rw [radicalBasis_one]
    have hδ : (∑ j : ZMod 8, boundaryClass j) ∈ K :=
      coe_radicalGenerator ▸ (δ).property
    have hcoe : (⟨_, hδ⟩ : K) = δ := Subtype.ext coe_radicalGenerator.symm
    -- Evaluate the isometry action on the total boundary class.
    change (ρ g).val δ = δ
    simpa only [MonoidHom.comp_apply, hcoe, sign_apply, coe_rotationInclusion, one_smul] using
      signedOrthogonalRestriction_apply_sum (ι g) hδ

private theorem rotationRestriction_smul_coe (g : G) (x : K) :
    (↑(rotationRestriction g • x) : L) = g.val.val x := by
  -- The action forgets the stabilizer proof and evaluates the restricted isometry.
  change ((ρ g).val x : L) = _
  simp only [MonoidHom.comp_apply, coe_signedOrthogonalRestriction_apply, sign_apply,
    coe_rotationInclusion, one_smul, toIsometry_apply]

/-- A boundary rotation acts on the first orthogonal generator by a sign and an
integral multiple of the total boundary class. These two coefficients are unique. -/
theorem existsUnique_rotation_apply_boundaryOrthogonalBasis_zero (g : G) :
    ∃! p : ℤˣ × ℤ, g.val.val (κ : L) = (p.1 : ℤ) • (κ : L) + p.2 • (δ : L) := by
  have h := BilinForm.existsUnique_radicalGeneratorStabilizer_smul_basis_zero B radicalBasis
    toMatrix_restrict_radicalBasis (by decide : (-2 : ℤ) ≠ 0) (rotationRestriction g)
  refine (existsUnique_congr fun p ↦ ?_).mp h
  rw [← Subtype.coe_inj]
  simp only [radicalBasis_zero, radicalBasis_one, Submodule.coe_add, Submodule.coe_smul,
    rotationRestriction_smul_coe]

/-- A lift of the reflection on the orthogonal lattice and a lift of its unit translation
generate all four-vertex boundary rotations if the square of the reflection lift is the
boundary half-turn. Only the action on the first orthogonal basis vector needs to be checked,
since every boundary rotation fixes the total boundary class. -/
theorem closure_pair_eq_top_of_four_vertex_rotation_actions {p t : G}
    (hp : p.val.val (κ : L) = (boundaryOrthogonalBasis 1 : L))
    (ht : t.val.val (κ : L) = (κ + δ : K).val) (hhalf : p * p = halfTurn) :
    Subgroup.closure ({p, t} : Set G) = ⊤ := by
  let H := Subgroup.closure ({p, t} : Set G)
  have hp' : rotationRestriction p • radicalBasis 0 = -radicalBasis 0 + radicalBasis 1 := by
    calc
      _ = boundaryOrthogonalBasis 1 := by
        rw [radicalBasis_zero]
        exact Subtype.ext ((rotationRestriction_smul_coe p κ).trans hp)
      _ = _ := by simp
  have ht' : rotationRestriction t • radicalBasis 0 = radicalBasis 0 + radicalBasis 1 := by
    calc
      _ = κ + δ := by
        rw [radicalBasis_zero]
        exact Subtype.ext ((rotationRestriction_smul_coe t κ).trans ht)
      _ = _ := by simp
  have himage : H.map rotationRestriction = ⊤ := by
    dsimp only [H]
    rw [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]
    exact BilinForm.closure_pair_eq_top_of_smul_basis_zero B radicalBasis
      toMatrix_restrict_radicalBasis (by decide : (-2 : ℤ) ≠ 0) hp' ht'
  have hker : (rotationRestriction).ker ≤ H := by
    have hpH : p ∈ H := Subgroup.subset_closure (by simp)
    have hker_eq : rotationRestriction.ker = (ρ).ker := MonoidHom.ker_codRestrict _ _ _
    intro g hg
    have hg' : g ∈ ((ρ).ker : Set G) := hker_eq ▸ hg
    rw [ker_four_vertex_rotation_restriction] at hg'
    rcases Set.mem_insert_iff.mp hg' with rfl | hg
    · exact H.one_mem
    · rw [Set.mem_singleton_iff.mp hg, ← hhalf]
      exact H.mul_mem hpH hpH
  calc
    H = (H.map rotationRestriction).comap rotationRestriction :=
      (Subgroup.comap_map_eq_self (H := H) hker).symm
    _ = ⊤ := by rw [himage, Subgroup.comap_top]

/-- The signed boundary group is generated by the rotation generators and any
negative-sign element. -/
theorem closure_triple_eq_top_of_four_vertex_rotation_actions {p t : G} {s : Ĝ}
    (hp : p.val.val (κ : L) = (boundaryOrthogonalBasis 1 : L))
    (ht : t.val.val (κ : L) = (κ + δ : K).val) (hhalf : p * p = halfTurn)
    (hs : ε s = -1) : Subgroup.closure ({s, ι p, ι t} : Set Ĝ) = ⊤ := by
  let H := Subgroup.closure ({s, ι p, ι t} : Set Ĝ)
  have hker : (ε).ker ≤ H := by
    rw [← range_rotationInclusion, MonoidHom.range_eq_map,
      ← closure_pair_eq_top_of_four_vertex_rotation_actions hp ht hhalf,
      MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]
    exact Subgroup.closure_mono (Set.subset_insert _ _)
  have hsH : s ∈ H := Subgroup.subset_closure (by simp)
  have himage : H.map ε = (ε).range := by
    apply le_antisymm (Subgroup.map_le_range _ _)
    rintro η ⟨g, rfl⟩
    rcases Int.units_eq_one_or (ε g) with hg | hg
    · rw [hg]
      exact one_mem _
    · rw [hg, ← hs]
      exact Subgroup.mem_map_of_mem _ hsH
  calc
    H = (H.map ε).comap ε := (Subgroup.comap_map_eq_self (H := H) hker).symm
    _ = ⊤ := by rw [himage, MonoidHom.comap_range_self]

-- The two fiber coordinates are exchanged, and the exceptional coordinates
-- can be permuted independently of them.
private def swapRulings (p : Equiv.Perm (Fin 8)) : L ≃ₗ[ℤ] L :=
  LinearEquiv.funCongrLeft ℤ ℤ
    ((finSumFinEquiv.symm.trans (Equiv.sumCongr (Equiv.swap 0 1) p)).trans finSumFinEquiv)

private theorem swapRulings_apply_exceptional (p : Equiv.Perm (Fin 8)) (x : L) (i : Fin 8) :
    swapRulings p x (i.natAdd 2) = x ((p i).natAdd 2) := by
  simp [swapRulings, finSumFinEquiv_symm_apply_natAdd (m := 2),
    finSumFinEquiv_apply_right (m := 2)]

private theorem swapRulings_isometry (p : Equiv.Perm (Fin 8)) :
    swapRulings p ∈ intersectionForm.isometryGroup := by
  apply BilinForm.mem_isometryGroup_iff.mpr
  intro x y
  have h₀ (z : L) : swapRulings p z 0 = z 1 := rfl
  have h₁ (z : L) : swapRulings p z 1 = z 0 := rfl
  rw [intersectionForm_apply, intersectionForm_apply, h₀, h₁, h₀, h₁, add_comm (x 1 * y 0)]
  simp only [swapRulings_apply_exceptional]
  rw [Equiv.sum_comp p (fun i ↦ x (i.natAdd 2) * y (i.natAdd 2))]

private def quarterTurnPerm : Equiv.Perm (Fin 8) :=
  Equiv.swap 0 1 * Equiv.swap 1 2 * Equiv.swap 2 3 *
    (Equiv.swap 4 5 * Equiv.swap 5 6 * Equiv.swap 6 7)

private theorem quarterTurn_boundary (j : ZMod 8) :
    swapRulings quarterTurnPerm (boundaryClass j) = boundaryClass (j - 2) := by
  funext i
  revert j i
  decide

/-- The pullback of the quarter-turn swaps the ruling classes and moves the exceptional
classes one step backwards in each set of four. -/
def quarterTurn : G :=
  ⟨⟨swapRulings quarterTurnPerm, swapRulings_isometry quarterTurnPerm⟩,
    (mem_boundaryRotationGroup_iff _ _).mpr
      ⟨-2, fun j ↦ by simpa only [sub_eq_add_neg] using quarterTurn_boundary j⟩⟩

/-- The quarter-turn pulls each strict boundary class back two positions. -/
@[simp] theorem quarterTurn_boundaryClass (j : ZMod 8) :
    quarterTurn.val.val (boundaryClass j) = boundaryClass (j - 2) :=
  quarterTurn_boundary j

/-- The square of the quarter-turn is the half-turn. -/
@[simp] theorem quarterTurn_mul_self : quarterTurn * quarterTurn = halfTurn := by
  apply Subtype.ext (Subtype.ext (LinearEquiv.ext fun x ↦ ?_))
  simp only [Subgroup.coe_mul, mul_apply_eq_comp, halfTurn_apply]
  funext i
  fin_cases i <;> rfl

/-- The quarter-turn interchanges the two alternating orthogonal generators. -/
@[simp] theorem quarterTurn_boundaryOrthogonalBasis (i : Fin 2) :
    quarterTurn.val.val (boundaryOrthogonalBasis i : L) = (boundaryOrthogonalBasis i.rev : L) := by
  have h₀ : (0 : Fin 2).rev = 1 := rfl
  have h₁ : (1 : Fin 2).rev = 0 := rfl
  fin_cases i
  · simp only [Fin.reduceFinMk, h₀, coe_boundaryOrthogonalBasis_zero,
      coe_boundaryOrthogonalBasis_one]
    funext j
    fin_cases j <;> rfl
  · simp only [Fin.reduceFinMk, h₁, coe_boundaryOrthogonalBasis_zero,
      coe_boundaryOrthogonalBasis_one]
    funext j
    fin_cases j <;> rfl

private theorem orthogonalRoot_square : intersectionForm (κ : L) (κ : L) = -2 := by
  simpa using intersectionForm_boundaryOrthogonalBasis 0 0

private theorem orthogonalRoot_reflective : LinearMap.IsReflective intersectionForm (κ : L) :=
  LinearMap.IsReflective.of_dvd_two intersectionForm (by rw [orthogonalRoot_square]; decide)

private def orthogonalRootReflection : L ≃ₗ[ℤ] L :=
  Module.reflection (IsReflective.coroot_apply_self intersectionForm orthogonalRoot_reflective)

private theorem orthogonalRootReflection_apply (x : L) :
    orthogonalRootReflection x = x + intersectionForm (κ : L) x • (κ : L) := by
  have hx := IsReflective.apply_self_mul_coroot_apply intersectionForm
    orthogonalRoot_reflective (y := x)
  rw [orthogonalRoot_square] at hx
  have hcoroot : IsReflective.coroot intersectionForm orthogonalRoot_reflective x =
      -intersectionForm (κ : L) x := by omega
  rw [orthogonalRootReflection, Module.reflection_apply, hcoroot, neg_smul, sub_neg_eq_add]

private theorem orthogonalRootReflection_boundaryClass (j : ZMod 8) :
    orthogonalRootReflection (boundaryClass j) = boundaryClass j := by
  have h := Submodule.mem_orthogonalBilin_span.mp (κ).property (Set.mem_range_self j)
  rw [orthogonalRootReflection_apply, intersectionForm_isSymm.eq, h, zero_smul, add_zero]

private def rootReflectionRotation : G :=
  ⟨⟨orthogonalRootReflection, BilinForm.mem_isometryGroup_iff.mpr
    (IsReflective.isOrthogonal_reflection intersectionForm orthogonalRoot_reflective
      (BilinForm.isSymm_iff.mp intersectionForm_isSymm))⟩,
    (mem_boundaryRotationGroup_iff _ _).mpr ⟨0, by
      simpa only [add_zero] using orthogonalRootReflection_boundaryClass⟩⟩

/-- On the Picard lattice, compose the inverse quarter-turn with reflection in the first
orthogonal generator to lift the translation of the orthogonal lattice. -/
def picardTranslation : G :=
  rootReflectionRotation * quarterTurn⁻¹

/-- The lift of the translation pulls the strict boundary classes back by two positions. -/
@[simp] theorem picardTranslation_boundaryClass (j : ZMod 8) :
    picardTranslation.val.val (boundaryClass j) = boundaryClass (j + 2) := by
  have hinv : (quarterTurn⁻¹).val.val (boundaryClass j) = boundaryClass (j + 2) := by
    apply quarterTurn.val.val.injective
    rw [quarterTurn_boundaryClass, add_sub_cancel_right]
    exact quarterTurn.val.val.apply_symm_apply _
  simp only [picardTranslation, Subgroup.coe_mul, mul_apply_eq_comp, hinv]
  exact orthogonalRootReflection_boundaryClass _

/-- On the first orthogonal generator, the translation adds the total boundary class. -/
theorem picardTranslation_boundaryOrthogonalBasis_zero :
    picardTranslation.val.val (κ : L) = (κ + δ : K).val := by
  have hinv : (quarterTurn⁻¹).val.val (κ : L) = (boundaryOrthogonalBasis 1 : L) := by
    apply quarterTurn.val.val.injective
    rw [quarterTurn_boundaryOrthogonalBasis]
    exact quarterTurn.val.val.apply_symm_apply _
  simp only [picardTranslation, Subgroup.coe_mul, mul_apply_eq_comp, hinv, rootReflectionRotation]
  rw [orthogonalRootReflection_apply, intersectionForm_boundaryOrthogonalBasis]
  norm_num only [Fin.zero_ne_one, ite_false]
  simp only [Submodule.coe_add, two_smul]
  abel

/-- On the second orthogonal generator, the translation gives the negative of the first. -/
theorem picardTranslation_boundaryOrthogonalBasis_one :
    picardTranslation.val.val (boundaryOrthogonalBasis 1 : L) = -(κ : L) := by
  have hsum : picardTranslation.val.val (δ : L) = (δ : L) := by
    rw [coe_radicalGenerator]
    simpa only [toIsometry_apply, coe_rotationInclusion] using
      toIsometry_apply_sum intersectionForm boundaryClass (ι picardTranslation)
  have hsum' : (κ : L) + (δ : L) +
      picardTranslation.val.val (boundaryOrthogonalBasis 1 : L) = (δ : L) := by
    simpa only [Submodule.coe_add, map_add, picardTranslation_boundaryOrthogonalBasis_zero]
      using hsum
  apply add_left_cancel (a := (κ : L) + (δ : L))
  rw [hsum']
  abel

private def boundaryReflectionPerm : Equiv.Perm (Fin 8) :=
  Equiv.swap 0 2 * Equiv.swap 4 6

private theorem boundaryReflection_boundary (j : ZMod 8) :
    swapRulings boundaryReflectionPerm (boundaryClass j) = boundaryClass (-j + 6) := by
  funext i
  revert j i
  decide

/-- The signed reflection interchanges the rulings and the first and third exceptional
classes in each set of four. Its action on the boundary has sign `-1`. -/
def boundaryReflection : Ĝ :=
  ⟨(⟨swapRulings boundaryReflectionPerm, swapRulings_isometry boundaryReflectionPerm⟩, -1),
    (mem_signedBoundaryIsometryGroup_iff _ _).mpr
      ⟨6, fun j ↦ by simpa only [Units.neg_smul, one_smul] using boundaryReflection_boundary j⟩⟩

/-- The reflection pulls the boundary classes back by the signed shift `j ↦ -j + 6`. -/
@[simp] theorem boundaryReflection_boundaryClass (j : ZMod 8) :
    boundaryReflection.val.1.val (boundaryClass j) = boundaryClass (-j + 6) := by
  exact boundaryReflection_boundary j

/-- The underlying Picard isometry of the signed reflection fixes both orthogonal generators. -/
@[simp] theorem boundaryReflection_boundaryOrthogonalBasis (i : Fin 2) :
    boundaryReflection.val.1.val (boundaryOrthogonalBasis i : L) =
      (boundaryOrthogonalBasis i : L) := by
  fin_cases i
  · simp only [boundaryReflection, Fin.reduceFinMk,
      coe_boundaryOrthogonalBasis_zero]
    funext j
    fin_cases j <;> rfl
  · simp only [boundaryReflection, Fin.reduceFinMk,
      coe_boundaryOrthogonalBasis_one]
    funext j
    fin_cases j <;> rfl

/-- The boundary reflection is in the negative sign coset. -/
@[simp] theorem boundaryReflection_sign : boundaryReflection.val.2 = -1 :=
  (rfl)

/-- The explicit quarter-turn and translation generate the four-vertex boundary rotation group. -/
theorem closure_four_vertex_rotation_generators :
    Subgroup.closure ({quarterTurn, picardTranslation} : Set G) = ⊤ :=
  closure_pair_eq_top_of_four_vertex_rotation_actions (quarterTurn_boundaryOrthogonalBasis 0)
    picardTranslation_boundaryOrthogonalBasis_zero quarterTurn_mul_self

/-- The explicit reflection, quarter-turn and translation generate the signed four-vertex
boundary isometry group. -/
theorem closure_four_vertex_signed_generators :
    Subgroup.closure ({boundaryReflection, ι quarterTurn, ι picardTranslation} : Set Ĝ) = ⊤ :=
  closure_triple_eq_top_of_four_vertex_rotation_actions (quarterTurn_boundaryOrthogonalBasis 0)
    picardTranslation_boundaryOrthogonalBasis_zero quarterTurn_mul_self
    (by simp only [sign_apply, boundaryReflection_sign])

end QPainleve.FourVertex
