module

public import TauCeti.LinearAlgebra.IntegralLattice.RootLattice.TypeA.Basic

/-!
# The type-A quotient of a boundary cycle

For a cycle of classes with the negative cycle Laplacian as its Gram matrix, the form on
the span descends to the quotient by the sum of the classes. Choosing a component to omit
identifies the other components, in cyclic order, with the simple roots of Tau Ceti's
`IntegralLattice.typeARootLattice` with the opposite form. This includes cycles of length
one and two, with both incidences counted in the Gram matrix.
-/

public section

open LinearMap TauCeti.IntegralLattice

namespace QPainleve.BoundaryCycle

variable {n : ℕ} {L : Type*} [AddCommGroup L]

local notation "S" D => Submodule.span ℤ (Set.range D)

/-- A boundary component as a vector in the boundary span. -/
def component (D : ZMod (n + 1) → L) (i : ZMod (n + 1)) : S D :=
  ⟨D i, Submodule.subset_span (Set.mem_range_self i)⟩

/-- Coercing a boundary component out of the span recovers the original class. -/
@[simp] theorem coe_component (D : ZMod (n + 1) → L) (i : ZMod (n + 1)) :
    (component D i : L) = D i := (rfl)

/-- The boundary span modulo the line generated by the total boundary class. -/
abbrev BoundaryQuotient (D : ZMod (n + 1) → L) :=
  (S D) ⧸ (ℤ ∙ ∑ i, component D i)

/-- The class of a boundary component in the quotient by the total class. -/
def componentClass (D : ZMod (n + 1) → L) (i : ZMod (n + 1)) : BoundaryQuotient D :=
  Submodule.Quotient.mk (component D i)

private theorem span_range_component (D : ZMod (n + 1) → L) :
    Submodule.span ℤ (Set.range (component D)) = ⊤ :=
  (Submodule.span_range_subtype_eq_top_iff _ fun i ↦ (component D i).property).2 rfl

/-- The boundary component classes sum to zero in the boundary quotient. -/
@[simp] theorem sum_componentClass (D : ZMod (n + 1) → L) :
    ∑ i, componentClass D i = 0 := by
  simp only [componentClass, ← Submodule.mkQ_apply, ← map_sum, ← LinearMap.mem_ker,
    Submodule.ker_mkQ, Submodule.mem_span_singleton_self]

variable {B : LinearMap.BilinForm ℤ L} {D : ZMod (n + 1) → L}
  (hGram : ∀ i j, B (D i) (D j) =
    (-2 : ℤ) * (if i = j then 1 else 0) +
      (if j = i + 1 then 1 else 0) + (if j = i - 1 then 1 else 0))

include hGram in
private theorem isSymm_restrict_span : (B.restrict (S D)).IsSymm := by
  rw [BilinForm.isSymm_iff_flip, eq_comm]
  apply LinearMap.ext_on_range (span_range_component D)
  intro i
  apply LinearMap.ext_on_range (span_range_component D)
  intro j
  have hnext : i = j + 1 ↔ j = i - 1 := by rw [eq_sub_iff_add_eq, eq_comm]
  have hprev : i = j - 1 ↔ j = i + 1 := eq_sub_iff_add_eq.trans eq_comm
  simp only [BilinForm.flip_apply, BilinForm.restrict_apply, LinearMap.domRestrict_apply,
    coe_component, hGram, eq_comm (a := j) (b := i), hnext, hprev, add_right_comm]

include hGram in
private theorem total_mem_ker :
    (ℤ ∙ ∑ i, component D i) ≤ (B.restrict (S D)).ker := by
  rw [Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]
  apply LinearMap.ext_on (span_range_component D)
  rintro _ ⟨j, rfl⟩
  have hnext (i : ZMod (n + 1)) : j = i + 1 ↔ i = j - 1 := by
    rw [eq_sub_iff_add_eq, eq_comm]
  have hprev (i : ZMod (n + 1)) : j = i - 1 ↔ i = j + 1 := by
    rw [eq_comm, sub_eq_iff_eq_add]
  simp [BilinForm.restrict_apply, hGram, hnext, hprev, Finset.sum_add_distrib]

/-- The form induced by the intersection pairing on the boundary quotient. -/
def quotientForm : LinearMap.BilinForm ℤ (BoundaryQuotient D) :=
  IsRefl.liftQ₂ (B.restrict (S D)) _ (isSymm_restrict_span hGram).isRefl (total_mem_ker hGram)

/-- The quotient form evaluates on representatives by the original pairing. -/
@[simp] theorem quotientForm_mk (x y : S D) :
    quotientForm hGram (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) = B x y := by
  simp [quotientForm, BilinForm.restrict_apply]

/-- The quotient form pairs boundary component classes by their intersection numbers. -/
@[simp] theorem quotientForm_componentClass (i j : ZMod (n + 1)) :
    quotientForm hGram (componentClass D i) (componentClass D j) = B (D i) (D j) := by
  simp [componentClass]

private def cycleIndex (k : ZMod (n + 1)) : Fin (n + 1) ≃ ZMod (n + 1) :=
  (ZMod.finEquiv (n + 1)).toEquiv.trans (Equiv.addRight k)

@[simp] private theorem cycleIndex_apply (k : ZMod (n + 1)) (i : Fin (n + 1)) :
    cycleIndex k i = (i.val : ZMod (n + 1)) + k := by
  rw [cycleIndex, Equiv.trans_apply, Equiv.coe_addRight]
  congr 1
  exact (ZMod.natCast_zmod_val ((ZMod.finEquiv (n + 1)) i)).symm

private theorem span_range_componentClass (D : ZMod (n + 1) → L) :
    Submodule.span ℤ (Set.range (componentClass D)) = ⊤ := by
  -- Express the component classes as the image of the components under the quotient map.
  change Submodule.span ℤ (Set.range ((Submodule.mkQ _) ∘ component D)) = ⊤
  rw [Set.range_comp, ← Submodule.map_span, span_range_component, Submodule.map_top,
    Submodule.range_mkQ]

private theorem componentClass_cut_eq_neg_sum (D : ZMod (n + 1) → L) (k : ZMod (n + 1)) :
    componentClass D k = -∑ i : Fin n, componentClass D (cycleIndex k i.succ) := by
  have hsum := (cycleIndex k).sum_comp (componentClass D)
  have hcut : cycleIndex k 0 = k := by simp
  rw [Fin.sum_univ_succ, sum_componentClass, hcut] at hsum
  exact eq_neg_of_add_eq_zero_left hsum

private theorem span_range_componentClass_succ (D : ZMod (n + 1) → L) (k : ZMod (n + 1)) :
    Submodule.span ℤ (Set.range fun i : Fin n ↦ componentClass D (cycleIndex k i.succ)) = ⊤ := by
  let P := Submodule.span ℤ (Set.range fun i : Fin n ↦ componentClass D (cycleIndex k i.succ))
  have hmem (i : Fin n) : componentClass D (cycleIndex k i.succ) ∈ P :=
    Submodule.subset_span (Set.mem_range_self i)
  apply top_unique
  rw [← span_range_componentClass D]
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨j, rfl⟩
  obtain ⟨i, rfl⟩ := (cycleIndex k).surjective j
  refine Fin.cases ?_ hmem i
  rw [cycleIndex_apply, Fin.val_zero, Nat.cast_zero, zero_add, componentClass_cut_eq_neg_sum]
  exact P.neg_mem (Submodule.sum_mem _ fun i _ ↦ hmem i)

private theorem cycleIndex_succ_eq_add_one_iff (k : ZMod (n + 1)) (i j : Fin n) :
    cycleIndex k j.succ = cycleIndex k i.succ + 1 ↔ j.val = i.val + 1 := by
  have hi : i.val + 1 < n + 1 := by omega
  have hj : j.val < n + 1 := by omega
  simp only [cycleIndex_apply, Fin.val_succ, Nat.cast_add, Nat.cast_one]
  rw [add_right_comm _ k 1, add_left_inj, add_left_inj, ← Nat.cast_one (R := ZMod (n + 1)),
    ← Nat.cast_add]
  rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt hj, Nat.mod_eq_of_lt hi]

include hGram in
private theorem pairing_component_succ (k : ZMod (n + 1)) (i j : Fin n) :
    B (D (cycleIndex k i.succ)) (D (cycleIndex k j.succ)) = -CartanMatrix.A n i j := by
  have hdiag : cycleIndex k i.succ = cycleIndex k j.succ ↔ i = j :=
    (cycleIndex k).injective.eq_iff.trans Fin.succ_inj
  have hback : cycleIndex k j.succ = cycleIndex k i.succ - 1 ↔ i.val = j.val + 1 := by
    rw [eq_sub_iff_add_eq, eq_comm, cycleIndex_succ_eq_add_one_iff]
  simp only [hGram, hdiag, cycleIndex_succ_eq_add_one_iff, hback, CartanMatrix.A, Matrix.of_apply]
  simp only [Fin.ext_iff]
  split_ifs <;> omega

private noncomputable def typeAToBoundary (D : ZMod (n + 1) → L) (k : ZMod (n + 1)) :
    typeARootLattice n →ₗ[ℤ] BoundaryQuotient D :=
  (typeASimpleRootBasis n).constr ℤ (fun i ↦ componentClass D (cycleIndex k i.succ))

@[simp] private theorem typeAToBoundary_apply_basis
    (D : ZMod (n + 1) → L) (k : ZMod (n + 1)) (i : Fin n) :
    typeAToBoundary D k (typeASimpleRootBasis n i) = componentClass D (cycleIndex k i.succ) := by
  simp [typeAToBoundary]

include hGram in
private theorem typeAToBoundary_map_pairing (k : ZMod (n + 1))
    (x y : typeARootLattice n) :
    quotientForm hGram (typeAToBoundary D k x) (typeAToBoundary D k y) =
      (-(typeARootLattice n).integralForm) x y := by
  have h := BilinForm.ext_basis (b := typeASimpleRootBasis n)
    (B := (quotientForm hGram).comp (typeAToBoundary D k) (typeAToBoundary D k))
    (F₂ := -(typeARootLattice n).integralForm) (by
      intro i j
      simp only [BilinForm.comp_apply, typeAToBoundary_apply_basis, quotientForm_componentClass,
        pairing_component_succ hGram, LinearMap.neg_apply, ← gramMatrix_apply,
        gramMatrix_typeASimpleRootBasis])
  exact LinearMap.congr_fun (LinearMap.congr_fun h x) y

include hGram in
private theorem typeAToBoundary_bijective (k : ZMod (n + 1)) :
    Function.Bijective (typeAToBoundary D k) := by
  constructor
  · refine LinearMap.ker_eq_bot.mp (LinearMap.ker_eq_bot'.mpr fun x hx ↦ ?_)
    have hnondeg := (nondegenerate_integralForm_iff (typeARootLattice n)).mpr
      (form_nondegenerate (typeARootLattice n))
    refine hnondeg.1 x fun y ↦ ?_
    simpa [hx] using (typeAToBoundary_map_pairing hGram k x y).symm
  · rw [← LinearMap.range_eq_top, typeAToBoundary, Module.Basis.constr_range,
      span_range_componentClass_succ]

/-- Cutting the boundary cycle at `k` identifies its quotient form with the negative
type-`Aₙ` form, where the cycle has `n + 1` components. The components immediately
following `k` are sent to the simple roots in order. -/
noncomputable def boundaryQuotientIsometryTypeA (k : ZMod (n + 1)) :
    (quotientForm hGram).IsometryEquiv (-(typeARootLattice n).integralForm) :=
  (BilinForm.IsometryEquiv.mk (LinearEquiv.ofBijective _ (typeAToBoundary_bijective hGram k))
    (typeAToBoundary_map_pairing hGram k)).symm

/-- The component at offset `i + 1` from the cut maps to the `i`-th simple root. -/
@[simp] theorem boundaryQuotientIsometryTypeA_componentClass_succ
    (k : ZMod (n + 1)) (i : Fin n) :
    boundaryQuotientIsometryTypeA hGram k (componentClass D ((i.val : ZMod (n + 1)) + 1 + k)) =
      typeASimpleRootBasis n i := by
  have h := typeAToBoundary_apply_basis D k i
  rw [cycleIndex_apply, Fin.val_succ, Nat.cast_add, Nat.cast_one] at h
  rw [← h]
  -- The inverse of the constructed isometry is the linear equivalence extending the roots.
  exact (LinearEquiv.ofBijective _ (typeAToBoundary_bijective hGram k)).symm_apply_apply _

/-- The cut component maps to the negative sum of all the simple roots. -/
@[simp] theorem boundaryQuotientIsometryTypeA_componentClass_cut (k : ZMod (n + 1)) :
    boundaryQuotientIsometryTypeA hGram k (componentClass D k) =
      -∑ i, typeASimpleRootBasis n i := by
  rw [componentClass_cut_eq_neg_sum D k, map_neg, map_sum]
  simp only [cycleIndex_apply, Fin.val_succ, Nat.cast_add, Nat.cast_one,
    boundaryQuotientIsometryTypeA_componentClass_succ]

/-- The classes following the cut component, in cyclic order, form a basis of the quotient. -/
noncomputable def boundaryQuotientBasis (k : ZMod (n + 1)) :
    Module.Basis (Fin n) ℤ (BoundaryQuotient D) :=
  (typeASimpleRootBasis n).map (boundaryQuotientIsometryTypeA hGram k).symm.toLinearEquiv

/-- The basis vector at index `i` is the component class at offset `i + 1` from the cut. -/
@[simp] theorem boundaryQuotientBasis_apply (k : ZMod (n + 1)) (i : Fin n) :
    boundaryQuotientBasis hGram k i = componentClass D ((i.val : ZMod (n + 1)) + 1 + k) := by
  apply (boundaryQuotientIsometryTypeA hGram k).toLinearEquiv.injective
  simp only [BilinForm.IsometryEquiv.coe_toLinearEquiv]
  rw [boundaryQuotientIsometryTypeA_componentClass_succ, boundaryQuotientBasis,
    Module.Basis.map_apply]
  exact (boundaryQuotientIsometryTypeA hGram k).toLinearEquiv.apply_symm_apply _

/-- The quotient pairing in the basis obtained by cutting the cycle is the negative
type-`Aₙ` Cartan matrix. -/
theorem toMatrix_quotientForm (k : ZMod (n + 1)) :
    BilinForm.toMatrix (boundaryQuotientBasis hGram k) (quotientForm hGram) =
      -CartanMatrix.A n := by
  ext i j
  rw [BilinForm.toMatrix_apply, boundaryQuotientBasis_apply, boundaryQuotientBasis_apply,
    quotientForm_componentClass]
  simpa only [Matrix.neg_apply, cycleIndex_apply, Fin.val_succ, Nat.cast_add, Nat.cast_one] using
    pairing_component_succ hGram k i j

/-- The absolute Gram determinant of the boundary quotient is the cycle length. -/
theorem natAbs_det_toMatrix_quotientForm (k : ZMod (n + 1)) :
    (BilinForm.toMatrix (boundaryQuotientBasis hGram k) (quotientForm hGram)).det.natAbs =
      n + 1 := by
  rw [toMatrix_quotientForm, Matrix.det_neg, CartanMatrix.A_det]
  simp only [Int.natAbs_mul, Int.natAbs_pow, Int.natAbs_neg, Int.natAbs_one, one_pow, one_mul,
    ← Int.natCast_succ, Int.natAbs_natCast]

end QPainleve.BoundaryCycle
