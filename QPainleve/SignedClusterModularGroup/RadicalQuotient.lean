module

public import QPainleve.LinearAlgebra.IntegralLattice.RadicalQuotient
public import QPainleve.SignedClusterModularGroup.BoundaryQuotient
public import TauCeti.LinearAlgebra.IntegralLattice.Scaling
import QPainleve.SignedClusterModularGroup.BoundaryCycle
import Mathlib.LinearAlgebra.FreeModule.PID

/-!
# The boundary cycle as a radical quotient

The form on the span of the cycle has radical generated by the sum of the components.
Its quotient by this line therefore agrees with the integral form on Tau Ceti's
radical quotient of the rationalized boundary span. The type-A comparison identifies
that native lattice with the negative of the standard type-A lattice.
-/

public section

open LinearMap Submodule TauCeti.IntegralLattice
open scoped TensorProduct

namespace QPainleve.BoundaryCycle

variable {n : ℕ} {L : Type*} [AddCommGroup L]
  {B : LinearMap.BilinForm ℤ L} {D : ZMod (n + 1) → L}
  (hGram : ∀ i j, B (D i) (D j) =
    (-2 : ℤ) * (if i = j then 1 else 0) +
      (if j = i + 1 then 1 else 0) + (if j = i - 1 then 1 else 0))

local notation "S" => span ℤ (Set.range D)
local notation "d" => ∑ i, component D i

include hGram in
/-- The kernel of the intersection form on the boundary span is the line of the total class. -/
theorem ker_restrict_span (hB : B.IsSymm) :
    (B.restrict S).ker = ℤ ∙ d := by
  apply Submodule.map_injective_of_injective (S).injective_subtype
  rw [Submodule.map_span, Set.image_singleton, map_sum]
  simp only [Submodule.subtype_apply, coe_component]
  rw [← span_inf_orthogonal hGram hB]
  refine le_antisymm ?_ (B.inf_orthogonal_self_le_ker_restrict hB.isRefl)
  rintro _ ⟨x, hx, rfl⟩
  refine ⟨x.property, B.mem_orthogonal_iff.mpr fun y hy ↦ ?_⟩
  rw [Submodule.subtype_apply, hB.eq y (x : L)]
  simpa only [BilinForm.restrict_apply, LinearMap.domRestrict_apply, LinearMap.zero_apply] using
    LinearMap.congr_fun (mem_ker.mp hx) (⟨y, hy⟩ : S)

variable [Module.Free ℤ L] [Module.Finite ℤ L]

include hGram in
/-- The radical of the rationalized boundary span is the rational line of the total class. -/
theorem radical_ofIntegralForm_restrict_span (hB : B.IsSymm) :
    (ofIntegralForm (B.restrict S) (hB.restrict S)).radical =
      ℚ ∙ ((1 : ℚ) ⊗ₜ[ℤ] d) := by
  rw [ofIntegralForm.radical_eq_baseChange_ker, ker_restrict_span hGram hB,
    Submodule.baseChange_span, Set.image_singleton, TensorProduct.mk_apply]

/-- The boundary quotient and Tau Ceti's radical quotient have isometric integral forms. -/
noncomputable def boundaryQuotientIsometryRadicalQuotient (hB : B.IsSymm) :
    (quotientForm hGram).IsometryEquiv
      (ofIntegralForm (B.restrict S) (hB.restrict S)).radicalQuotient.integralForm := by
  let e := ofIntegralForm.radicalQuotientIsometry (hB.restrict S) (ℤ ∙ d)
    (ker_restrict_span hGram hB).symm
  refine ⟨e.toLinearEquiv, fun x y ↦ ?_⟩
  obtain ⟨x, rfl⟩ := (ℤ ∙ d).mkQ_surjective x
  obtain ⟨y, rfl⟩ := (ℤ ∙ d).mkQ_surjective y
  simp [e]

/-- The comparison sends a boundary quotient representative to its radical quotient class. -/
@[simp]
theorem boundaryQuotientIsometryRadicalQuotient_mk (hB : B.IsSymm) (x : S) :
    boundaryQuotientIsometryRadicalQuotient hGram hB (Submodule.Quotient.mk x) =
      (ofIntegralForm (B.restrict S) (hB.restrict S)).radicalQuotientMap
        (ofIntegralForm.carrierEquiv (B.restrict S) (hB.restrict S) x) := by
  rw [← BilinForm.IsometryEquiv.coe_toLinearEquiv]
  simp [boundaryQuotientIsometryRadicalQuotient, BilinForm.IsometryEquiv.coe_toLinearEquiv]

/-- Cutting the cycle identifies the native radical quotient of the boundary span with the
negative type-`Aₙ` lattice, where the cycle has `n + 1` components. -/
noncomputable def radicalQuotientIsometryNegTypeA (hB : B.IsSymm) (k : ZMod (n + 1)) :
    TauCeti.IntegralLattice.Isometry
      (ofIntegralForm (B.restrict S) (hB.restrict S)).radicalQuotient (-(typeARootLattice n)) := by
  let e := (boundaryQuotientIsometryRadicalQuotient hGram hB).symm.trans
    (boundaryQuotientIsometryTypeA hGram k)
  refine Isometry.ofCarrierEquiv e.toLinearEquiv fun x y ↦ ?_
  simpa only [integralForm_neg_apply, BilinForm.IsometryEquiv.coe_toLinearEquiv,
    LinearMap.neg_apply] using e.map_app y x

/-- On integral representatives, the native type-A isometry is the type-A comparison
of the corresponding boundary quotient class. -/
@[simp]
theorem radicalQuotientIsometryNegTypeA_carrierEquiv_mk (hB : B.IsSymm)
    (k : ZMod (n + 1)) (x : S) :
    (radicalQuotientIsometryNegTypeA hGram hB k).carrierEquiv
      ((ofIntegralForm (B.restrict S) (hB.restrict S)).radicalQuotientMap
        (ofIntegralForm.carrierEquiv (B.restrict S) (hB.restrict S) x)) =
      boundaryQuotientIsometryTypeA hGram k (Submodule.Quotient.mk x) := by
  rw [radicalQuotientIsometryNegTypeA, Isometry.carrierEquiv_ofCarrierEquiv,
    ← boundaryQuotientIsometryRadicalQuotient_mk hGram hB]
  exact congrArg (boundaryQuotientIsometryTypeA hGram k)
    ((boundaryQuotientIsometryRadicalQuotient hGram hB).toLinearEquiv.symm_apply_apply _)

end QPainleve.BoundaryCycle
