/-!
# Recovering cone regularity from the dual semigroup

The dual semigroup generates the whole character lattice. If it is generated by a
basis, the basis dual to it generates the original cone. A full-dimensional cone
admits a positive grading on the dual semigroup, so its additive irreducibles
generate it.
-/

public section

open Module Submodule

namespace TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {σ : PointedCone ℝ V}

/-- The dual semigroup of a full-dimensional lattice-rational cone admits a degree
that is positive on every nonzero character. -/
theorem IsLatticeRational.exists_positive_degree_dualSemigroup
    (hσ : IsLatticeRational i σ) (hi : IsIntegralLattice i)
    (hspan : span ℝ (σ : Set V) = ⊤) :
    ∃ d : dualSemigroup hi σ →+ ℕ, ∀ m, d m = 0 → m = 0 := by
  classical
  obtain ⟨s, rfl⟩ := isLatticeRational_iff.mp hσ
  let S := dualSemigroup hi (PointedCone.hull ℝ (i '' (s : Set N)))
  have hnonneg (m : S) (v : N) (hv : v ∈ s) : 0 ≤ m.val v :=
    (mem_dualSemigroup_hull_image hi _ _).mp m.property v hv
  let d : S →+ ℕ :=
    { toFun := fun m ↦ ∑ v ∈ s, (m.val v).toNat
      map_zero' := by simp
      map_add' := fun m n ↦ by
        rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun v hv ↦ Int.toNat_add (hnonneg m v hv) (hnonneg n v hv) }
  refine ⟨d, fun m hm ↦ Subtype.ext (hi.realCharacter_injective ?_)⟩
  have hz (v : N) (hv : v ∈ s) : m.val v = 0 := by
    have he := (Finset.sum_eq_zero_iff_of_nonneg fun _ _ ↦ Nat.zero_le _).mp hm v hv
    exact (Int.toNat_eq_zero.mp he).antisymm (hnonneg m v hv)
  have hker : PointedCone.hull ℝ (i '' (s : Set N)) ≤
      PointedCone.ofSubmodule (hi.realCharacter m.val).ker := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨v, hv, rfl⟩
    simpa using hz v hv
  rw [AddSubmonoid.coe_zero, map_zero, ← LinearMap.ker_eq_top]
  have hle : (↑(PointedCone.hull ℝ (i '' (s : Set N))) : Set V) ⊆
      (hi.realCharacter m.val).ker := hker
  exact top_unique (hspan ▸ Submodule.span_le.mpr hle)

/-- The integral characters nonnegative on a toric cone span the character lattice. -/
theorem IsToricCone.span_dualSemigroup_eq_top (hσ : IsToricCone i σ) (hi : IsIntegralLattice i) :
    span ℤ ((dualSemigroup hi σ : Set (N →+ ℤ))) = ⊤ := by
  obtain ⟨m, hm, hcut⟩ := hσ.rational.exists_mem_dualSemigroup_inf_ker_eq hi hσ.salient.bot_isFaceOf
  have he := dualSemigroup_inf_ker_eq_sup hi hσ.fg hm
  rw [hcut, dualSemigroup_bot] at he
  apply top_unique
  intro x _
  have hle : (⊤ : AddSubmonoid (N →+ ℤ)) ≤
      (span ℤ (dualSemigroup hi σ : Set (N →+ ℤ))).toAddSubmonoid := by
    rw [he, sup_le_iff, AddSubmonoid.closure_le, Set.singleton_subset_iff]
    exact ⟨fun _ hx ↦ subset_span hx, Submodule.neg_mem _ (subset_span hm)⟩
  exact hle (AddSubmonoid.mem_top x)

/-- A lattice-rational cone is regular if its dual semigroup is generated by a
basis of the character lattice. -/
theorem IsLatticeRational.isRegularCone_of_dualBasis (hσ : IsLatticeRational i σ)
    (hi : IsIntegralLattice i)
    {ι : Type*} (b : Basis ι ℤ (N →+ ℤ))
    (hgen : AddSubmonoid.closure (Set.range b) = dualSemigroup hi σ) :
    IsRegularCone i σ := by
  classical
  let := hi.free
  let := hi.finite
  have hb (j : ι) : b j ∈ dualSemigroup hi σ :=
    hgen ▸ AddSubmonoid.subset_closure (Set.mem_range_self j)
  let B := b.map (addMonoidHomLequivInt ℤ)
  let := Module.Finite.finite_basis B
  let := Fintype.ofFinite ι
  let a := B.dualBasis.map (Module.evalEquiv ℤ N).symm
  have hform (j : ι) : a.coord j = B j := by
    apply a.ext
    intro k
    have hEval : (Module.evalEquiv ℤ N) (a k) = B.dualBasis k := by
      rw [Basis.map_apply, LinearEquiv.apply_symm_apply]
    have h := DFunLike.congr_fun hEval (B j)
    rw [Module.evalEquiv_apply, Dual.eval_apply, Basis.dualBasis_apply, Basis.repr_self] at h
    simpa only [Basis.coord_apply, Basis.repr_self, Finsupp.single_apply, eq_comm] using h.symm
  have hcoord (j : ι) (x : N) : a.repr x j = b j x :=
    DFunLike.congr_fun (hform j) x
  have hσa (k : ι) : i (a k) ∈ σ := by
    apply (hσ.mem_iff_forall_dualSemigroup_nonneg hi _).mpr
    intro m hm
    rw [← hgen] at hm
    induction hm using AddSubmonoid.closure_induction with
    | mem m hm =>
      obtain ⟨j, rfl⟩ := hm
      rw [← hcoord, Basis.repr_self, Finsupp.single_apply]
      split <;> decide
    | zero => simp
    | add a b _ _ ha hb => exact add_nonneg ha hb
  have he : PointedCone.hull ℝ (i '' Set.range a) = σ := by
    refine le_antisymm (Submodule.span_le.mpr ?_) ?_
    · rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
      exact hσa j
    · obtain ⟨s, rfl⟩ := isLatticeRational_iff.mp hσ
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨v, hv, rfl⟩
      have hnonneg (j : ι) : 0 ≤ b j v :=
        (mem_dualSemigroup_hull_image hi _ _).mp (hb j) _ hv
      rw [← a.sum_repr v, map_sum]
      refine Submodule.sum_mem _ fun j _ ↦ ?_
      rw [map_zsmul, ← Int.cast_smul_eq_zsmul ℝ]
      exact (PointedCone.hull ℝ (i '' Set.range a)).smul_mem
        (by exact_mod_cast hcoord j v ▸ hnonneg j)
        (PointedCone.subset_hull ⟨_, ⟨j, rfl⟩, rfl⟩)
  rw [← he, ← Set.image_univ]
  exact isRegularCone_hull_image_basis hi a Set.univ

/-- If a positively graded dual semigroup has at most as many additive irreducibles
as the lattice rank, the cone is regular. -/
theorem IsToricCone.isRegularCone_of_card_addIrreducible_le
    (hσ : IsToricCone i σ) (hi : IsIntegralLattice i)
    (d : dualSemigroup hi σ →+ ℕ) (hd : ∀ m, d m = 0 → m = 0)
    [Finite {m : dualSemigroup hi σ // AddIrreducible m}]
    (hn : Nat.card {m : dualSemigroup hi σ // AddIrreducible m} ≤ finrank ℤ N) :
    IsRegularCone i σ := by
  classical
  let := Fintype.ofFinite {m : dualSemigroup hi σ // AddIrreducible m}
  let v (m : {m : dualSemigroup hi σ // AddIrreducible m}) : N →+ ℤ := m.val.val
  have hgen : AddSubmonoid.closure (Set.range v) = dualSemigroup hi σ := by
    have he : Set.range v = (dualSemigroup hi σ).subtype '' {m | AddIrreducible m} :=
      (Set.image_eq_range (dualSemigroup hi σ).subtype
        ({m | AddIrreducible m} : Set (dualSemigroup hi σ))).symm
    rw [he, ← AddMonoidHom.map_mclosure, d.closure_setOf_addIrreducible_eq_top hd,
      ← AddMonoidHom.mrange_eq_map, AddSubmonoid.mrange_subtype]
  have hspan : span ℤ (Set.range v) = ⊤ := by
    refine top_unique ((hσ.span_dualSemigroup_eq_top hi).ge.trans (Submodule.span_le.mpr ?_))
    have hle : AddSubmonoid.closure (Set.range v) ≤ (span ℤ (Set.range v)).toAddSubmonoid :=
      AddSubmonoid.closure_le.mpr subset_span
    exact fun m hm ↦ hle (hgen.symm ▸ hm)
  let := hi.free
  let := hi.finite
  have hrank : finrank ℤ (N →+ ℤ) = finrank ℤ N := by
    let a := Module.finBasis ℤ N
    exact (finrank_eq_card_basis (a.dualBasis.map (addMonoidHomLequivInt ℤ).symm)).trans
      (finrank_eq_card_basis a).symm
  have hcard : Fintype.card {m : dualSemigroup hi σ // AddIrreducible m} = finrank ℤ (N →+ ℤ) := by
    apply le_antisymm (by simpa only [hrank, Nat.card_eq_fintype_card] using hn)
    exact finrank_le_of_span_eq_top hspan
  let b := basisOfTopLeSpanOfCardEqFinrank v hspan.ge hcard
  have hb : (b : _ → N →+ ℤ) = v := coe_basisOfTopLeSpanOfCardEqFinrank _ _ _
  exact hσ.rational.isRegularCone_of_dualBasis hi b (by rwa [hb])

/-- A toric cone of dimension at most one is regular. -/
theorem IsToricCone.isRegularCone_of_finrank_span_le_one (hσ : IsToricCone i σ)
    (hi : IsIntegralLattice i)
    (h : finrank ℝ (span ℝ (σ : Set V)) ≤ 1) : IsRegularCone i σ := by
  let := hi.finiteDimensional
  by_cases hbot : σ = ⊥
  · exact hbot ▸ isRegularCone_bot hi
  obtain ⟨ρ⟩ := ToricRay.nonempty_of_ne_bot hσ.fg hσ.salient hbot
  have he : ρ.toPointedCone = σ := by
    have hs : finrank ℝ (span ℝ (σ : Set V)) = 1 := le_antisymm h
      (ρ.finrank_span ▸ finrank_mono (Submodule.span_mono ρ.val.isFaceOf.le))
    let q : ToricRay σ := ⟨⟨σ, PointedCone.IsFaceOf.refl _⟩, hs⟩
    exact congrArg ToricRay.toPointedCone (ToricRay.eq_of_toPointedCone_le hσ.salient
      (ν := ρ) (ρ := q) ρ.val.isFaceOf.le)
  have hne : i (primitiveGenerator hi hσ ρ) ≠ 0 := by
    simpa using hi.injective.ne (primitiveGenerator_ne_zero hi hσ ρ)
  rw [← he, ρ.eq_hull_singleton (hσ.salient.anti ρ.val.isFaceOf.le)
    (primitiveGenerator_mem hi hσ ρ) hne]
  exact isRegularCone_hull_singleton hi (primitiveGenerator_isPrimitive hi hσ ρ)

end TauCeti.Toric
