/-!
# Common refinements of finite fans

The common refinement of two fans in one lattice is generated by the pairwise intersections
of their cones. Its support is the intersection of the two supports. For fans with equal
support, it is the coarsest fan that subdivides both, so a regular subdivision of the
common refinement subdivides both original fans. Two regular surface fans with
equal support admit a regular common subdivision. Inserting the supported
directions of the second fan's coordinate lines separates the resulting cones
so that each lies in a cone of the second fan.

The construction uses the usual intersection of cone decompositions, as in Fulton,
*Introduction to Toric Varieties*, §1.4. Rationality of the intersections is supplied by
Tau Ceti's `IsToricCone.inf`.
-/

public section

namespace TauCeti.Toric.Fan

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V] {i : N →+ V}

/-- The fan of faces of the pairwise intersections of cones of two fans in the same lattice. -/
def commonRefinement (Φ Ψ : Fan i) : Fan i :=
  ofCones Φ.lattice (Set.image2 (· ⊓ ·) Φ.cones Ψ.cones)
    (Set.Finite.image2 _ Φ.finite_cones Ψ.finite_cones)
    (by
      rintro κ ⟨σ, hσ, τ, hτ, rfl⟩
      exact IsToricCone.inf Φ.lattice.isBaseChange.liftBaseChange_injective
        (Φ.isToricCone hσ) (Ψ.isToricCone hτ))
    (by
      rintro κ ξ ⟨σ, hσ, τ, hτ, rfl⟩ ⟨σ', hσ', τ', hτ', rfl⟩
      simpa only [inf_assoc, inf_left_comm, inf_comm] using
        (Φ.inf_isFaceOf_left hσ hσ').inf (Ψ.inf_isFaceOf_left hτ hτ'))

/-- The cones of the common refinement are the faces of the intersections. -/
@[simp]
theorem mem_commonRefinement_cones {Φ Ψ : Fan i} {κ : PointedCone ℝ V} :
    κ ∈ (Φ.commonRefinement Ψ).cones ↔
      ∃ σ ∈ Φ.cones, ∃ τ ∈ Ψ.cones, κ.IsFaceOf (σ ⊓ τ) := by
  rw [commonRefinement, mem_ofCones_cones]
  constructor
  · rintro ⟨_, ⟨σ, hσ, τ, hτ, rfl⟩, hκ⟩
    exact ⟨σ, hσ, τ, hτ, hκ⟩
  · rintro ⟨σ, hσ, τ, hτ, hκ⟩
    exact ⟨σ ⊓ τ, Set.mem_image2_of_mem hσ hτ, hκ⟩

/-- Intersecting cones from the two fans gives a cone of the common refinement. -/
theorem inf_mem_commonRefinement_cones {Φ Ψ : Fan i} {σ τ : PointedCone ℝ V}
    (hσ : σ ∈ Φ.cones) (hτ : τ ∈ Ψ.cones) : σ ⊓ τ ∈ (Φ.commonRefinement Ψ).cones :=
  mem_commonRefinement_cones.mpr ⟨σ, hσ, τ, hτ, .rfl⟩

/-- The support of a common refinement is the intersection of the two supports. -/
@[simp]
theorem support_commonRefinement (Φ Ψ : Fan i) :
    (Φ.commonRefinement Ψ).support = Φ.support ∩ Ψ.support := by
  ext x
  rw [commonRefinement, support_ofCones, Set.mem_iUnion₂, Set.mem_inter_iff]
  constructor
  · rintro ⟨_, ⟨σ, hσ, τ, hτ, rfl⟩, hx⟩
    exact ⟨Φ.subset_support hσ hx.1, Ψ.subset_support hτ hx.2⟩
  · rintro ⟨hxΦ, hxΨ⟩
    obtain ⟨σ, hσ, hxσ⟩ := Φ.mem_support.mp hxΦ
    obtain ⟨τ, hτ, hxτ⟩ := Ψ.mem_support.mp hxΨ
    exact ⟨σ ⊓ τ, Set.mem_image2_of_mem hσ hτ, hxσ, hxτ⟩

/-- The common refinement is symmetric in the input fans. -/
theorem commonRefinement_comm (Φ Ψ : Fan i) :
    Φ.commonRefinement Ψ = Ψ.commonRefinement Φ := by
  apply Fan.ext
  ext κ
  simp only [mem_commonRefinement_cones]
  constructor <;> rintro ⟨σ, hσ, τ, hτ, hκ⟩ <;> exact ⟨τ, hτ, σ, hσ, inf_comm σ τ ▸ hκ⟩

/-- The common refinement subdivides the first fan exactly when the second support contains
the first support. -/
theorem commonRefinement_isSubdivision_left_iff (Φ Ψ : Fan i) :
    (Φ.commonRefinement Ψ).IsSubdivision Φ ↔ Φ.support ⊆ Ψ.support := by
  refine ⟨fun h ↦ ?_, fun h ↦ ⟨?_, ?_⟩⟩
  · exact Set.inter_eq_left.mp (by simpa only [support_commonRefinement] using h.support_eq)
  · intro κ hκ
    obtain ⟨σ, hσ, τ, _, hface⟩ := mem_commonRefinement_cones.mp hκ
    exact ⟨σ, hσ, hface.le.trans (inf_le_left : σ ⊓ τ ≤ σ)⟩
  · rw [support_commonRefinement, Set.inter_eq_left.mpr h]

/-- The common refinement subdivides the second fan exactly when the first support contains
the second support. -/
theorem commonRefinement_isSubdivision_right_iff (Φ Ψ : Fan i) :
    (Φ.commonRefinement Ψ).IsSubdivision Ψ ↔ Ψ.support ⊆ Φ.support := by
  rw [commonRefinement_comm, commonRefinement_isSubdivision_left_iff]

/-- A common refinement is complete exactly when both fans are complete. -/
theorem isComplete_commonRefinement_iff (Φ Ψ : Fan i) :
    (Φ.commonRefinement Ψ).IsComplete ↔ Φ.IsComplete ∧ Ψ.IsComplete := by
  simp only [isComplete_iff, ← mem_support, support_commonRefinement, Set.mem_inter_iff, forall_and]

/-- Any fan that subdivides both inputs subdivides their common refinement. -/
theorem IsSubdivision.commonRefinement {Ω Φ Ψ : Fan i} (hΦ : Ω.IsSubdivision Φ)
    (hΨ : Ω.IsSubdivision Ψ) : Ω.IsSubdivision (Φ.commonRefinement Ψ) where
  exists_cone_le := by
    intro κ hκ
    obtain ⟨σ, hσ, hκσ⟩ := hΦ.exists_cone_le hκ
    obtain ⟨τ, hτ, hκτ⟩ := hΨ.exists_cone_le hκ
    exact ⟨σ ⊓ τ, inf_mem_commonRefinement_cones hσ hτ, le_inf hκσ hκτ⟩
  support_eq := by rw [support_commonRefinement, ← hΦ.support_eq, ← hΨ.support_eq, Set.inter_self]

/-- When the input supports agree, subdividing their common refinement is equivalent to
subdividing both fans. -/
theorem isSubdivision_commonRefinement_iff {Ω Φ Ψ : Fan i} (hs : Φ.support = Ψ.support) :
    Ω.IsSubdivision (Φ.commonRefinement Ψ) ↔ Ω.IsSubdivision Φ ∧ Ω.IsSubdivision Ψ := by
  refine ⟨fun h ↦ ⟨h.trans ((commonRefinement_isSubdivision_left_iff Φ Ψ).mpr hs.le),
    h.trans ((commonRefinement_isSubdivision_right_iff Φ Ψ).mpr hs.ge)⟩, ?_⟩
  rintro ⟨hΦ, hΨ⟩
  exact hΦ.commonRefinement hΨ

/-- If the first fan already subdivides the second, their common refinement is the first fan. -/
theorem IsSubdivision.commonRefinement_eq {Φ Ψ : Fan i} (h : Φ.IsSubdivision Ψ) :
    Φ.commonRefinement Ψ = Φ := by
  apply Fan.ext
  ext κ
  constructor
  · intro hκ
    obtain ⟨σ, hσ, τ, hτ, hface⟩ := mem_commonRefinement_cones.mp hκ
    obtain ⟨τ', hτ', hστ'⟩ := h.exists_cone_le hσ
    have hlim := (PointedCone.IsFaceOf.refl σ).inf (Ψ.inf_isFaceOf_left hτ' hτ)
    rw [← inf_assoc, inf_eq_left.mpr hστ'] at hlim
    exact Φ.mem_of_isFaceOf hσ (hface.trans hlim)
  · intro hκ
    obtain ⟨τ, hτ, hκτ⟩ := h.exists_cone_le hκ
    simpa only [inf_eq_left.mpr hκτ] using inf_mem_commonRefinement_cones hκ hτ

/-- A fan is its own common refinement. -/
@[simp]
theorem commonRefinement_self (Φ : Fan i) : Φ.commonRefinement Φ = Φ :=
  (IsSubdivision.refl Φ).commonRefinement_eq

open PointedCone

/-- Two regular fans in a rank-two lattice with the same support admit a regular common
subdivision. In particular, two complete regular surface fans have a complete regular
common subdivision. -/
theorem exists_regular_common_subdivision (Φ Ψ : Fan i)
    (hΦ : Φ.IsRegular) (hΨ : Ψ.IsRegular) (hN : Module.finrank ℤ N = 2)
    (hs : Φ.support = Ψ.support) :
    ∃ Ω : Fan i, Ω.IsSubdivision Φ ∧ Ω.IsSubdivision Ψ ∧ Ω.IsRegular := by
  classical
  have hbase (τ : Ψ.cones) := hN ▸ (isRegular_iff.mp hΨ _ τ.property).exists_basis_finrank
  choose b r hb using hbase
  let v (p : Ψ.cones × Fin 2 × Bool) := if p.2.2 then b p.1 p.2.1 else -b p.1 p.2.1
  let S : Set N := Set.range v ∩ i ⁻¹' Φ.support
  let _ := Ψ.finite_cones.fintype
  have hS : S.Finite := (Set.finite_range v).subset Set.inter_subset_left
  have hm : ∀ u ∈ S, u ≠ 0 ∧ i u ∈ Φ.support := by
    rintro u ⟨⟨p, rfl⟩, hp⟩
    refine ⟨?_, hp⟩
    rcases p with ⟨τ, j, s⟩
    cases s <;> simp [v, (b τ).ne_zero j]
  obtain ⟨Ω, hΩ, hreg, hrays⟩ := Φ.exists_regular_subdivision_containing_rays hΦ hN hS hm
  have hsΩ := hΩ.support_eq.trans hs
  refine ⟨Ω, hΩ, ⟨?_, hsΩ⟩, hreg⟩
  intro σ hσ
  let hσt := Ω.isToricCone hσ
  have := ToricRay.finite_of_fg hσt.fg
  let _ := Fintype.ofFinite (ToricRay σ)
  let z := ∑ ρ : ToricRay σ, i (primitiveGenerator Ω.lattice hσt ρ)
  have hz : z ∈ σ := Submodule.sum_mem _ fun ρ _ ↦
    ρ.val.isFaceOf.le (primitiveGenerator_mem Ω.lattice hσt ρ)
  obtain ⟨τ, hτ, hzτ⟩ := Ψ.mem_support.mp (hsΩ ▸ Ω.subset_support hσ hz)
  let τ' : Ψ.cones := ⟨τ, hτ⟩
  refine ⟨τ, hτ, hσt.le_of_sum_generators_mem Ω.lattice (Ψ.isToricCone hτ) _ _ (hb τ')
    hzτ fun j ↦ Ω.nonneg_or_nonpos_basis_repr_on_cone (b τ') j ⟨σ, hσ⟩ (fun hp ↦ ?_)
      (fun hn ↦ ?_)⟩
  · exact hrays _ ⟨⟨⟨τ', j.rev, true⟩, by simp [v]⟩,
      Set.mem_preimage.mpr (hΩ.support_eq ▸ hp)⟩
  · exact hrays _ ⟨⟨⟨τ', j.rev, false⟩, by simp [v]⟩,
      Set.mem_preimage.mpr (hΩ.support_eq ▸ hn)⟩

end TauCeti.Toric.Fan

namespace TauCeti.Toric.FanEquiv

variable {N N' V V' : Type*} [AddCommGroup N] [AddCommGroup N']
  [AddCommGroup V] [AddCommGroup V'] [Module ℝ V] [Module ℝ V']
  {i : N →+ V} {i' : N' →+ V'} {Φ Ω : Fan i} {Ψ : Fan i'}

/-- Two complete regular surface fans admit a regular common subdivision after
transporting the second fan to the lattice of the first via the specified equivalence. -/
theorem exists_common_regular_subdivision_of_complete (e : FanEquiv Ψ Ω)
    (hΦ : Φ.IsRegular) (hΨ : Ψ.IsRegular) (hcΦ : Φ.IsComplete) (hcΨ : Ψ.IsComplete)
    (b : Module.Basis (Fin 2) ℤ N) :
    ∃ Δ : Fan i, Δ.IsSubdivision Φ ∧ Δ.IsSubdivision Ω ∧ Δ.IsRegular := by
  have hcΩ := e.isComplete_iff.mpr hcΨ
  have hs : Φ.support = Ω.support := by
    ext x
    exact iff_of_true (Φ.mem_support.mpr (Φ.isComplete_iff.mp hcΦ x))
      (Ω.mem_support.mpr (Ω.isComplete_iff.mp hcΩ x))
  exact Φ.exists_regular_common_subdivision Ω hΦ (e.isRegular_iff.mpr hΨ)
    ((Module.finrank_eq_card_basis b).trans (Fintype.card_fin 2)) hs

end TauCeti.Toric.FanEquiv
