/-!
# Toric boundary points and orders of characters

The prime associated to a ray is generated by monomials whose exponents pair positively
with its primitive lattice generator. In regular coordinates this prime is generated by
the corresponding polynomial variable. Its generic point has codimension one, and the
order of a torus character there is its integral pairing with the primitive generator.

The description of invariant divisors and their character orders follows Fulton,
*Introduction to Toric Varieties*, §3.1.
-/

public noncomputable section

open AlgebraicGeometry CategoryTheory Multiplicative
open TauCeti.AlgebraicGeometry (CodimensionOnePoint)

namespace TauCeti.Toric

variable {N V ι : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {σ : PointedCone ℝ V}

section Chart

variable (hi : IsIntegralLattice i) (hσ : IsToricCone i σ)

local notation "χ" => MonoidAlgebra.of ℂ (Multiplicative (dualSemigroup hi σ))

/-- The ideal of the ray in the affine chart of a cone containing it is generated by the
characters taking strictly positive values on the ray's primitive generator. -/
def rayIdeal (ρ : ToricRay σ) : Ideal (affineCoordinateRing hi σ) :=
  Ideal.span {f | ∃ m : dualSemigroup hi σ,
    0 < (m : N →+ ℤ) (primitiveGenerator hi hσ ρ) ∧ f = χ (ofAdd m)}

/-- An ideal contains the ray ideal exactly when it contains the positive character monomials. -/
theorem rayIdeal_le_iff (ρ : ToricRay σ) (I : Ideal (affineCoordinateRing hi σ)) :
    rayIdeal hi hσ ρ ≤ I ↔ ∀ m : dualSemigroup hi σ,
      0 < (m : N →+ ℤ) (primitiveGenerator hi hσ ρ) → χ (ofAdd m) ∈ I := by
  rw [rayIdeal, Ideal.span_le]
  constructor
  · intro h m hm
    apply h
    exact ⟨m, hm, rfl⟩
  · rintro h _ ⟨m, hm, rfl⟩
    exact h m hm

/-- A character strictly positive on the primitive ray generator belongs to the ray ideal. -/
theorem monomial_mem_rayIdeal (ρ : ToricRay σ) (m : dualSemigroup hi σ)
    (hm : 0 < (m : N →+ ℤ) (primitiveGenerator hi hσ ρ)) :
    χ (ofAdd m) ∈ rayIdeal hi hσ ρ :=
  Ideal.subset_span ⟨m, hm, rfl⟩

variable {b : Module.Basis (ToricRay σ ⊕ ι) ℤ N}
  (hb : ∀ ρ, IsPrimitiveGenerator i ρ (b (Sum.inl ρ)))

private theorem rayCoord_apply (ρ : ToricRay σ) :
    affineCoordinateRingEquivMvPolynomial hi hσ hb
      (χ (ofAdd (dualSemigroupCoord hi hσ hb (Sum.inl ρ)))) = MvPolynomial.X ρ := by
  have h := (regularDualSemigroupEquiv hi hσ hb).apply_symm_apply (Finsupp.single ρ 1, 0)
  rw [regularDualSemigroupEquiv_symm_apply_single_zero] at h
  rw [MonoidAlgebra.of_apply, affineCoordinateRingEquivMvPolynomial_single, h]
  rw [← AddMonoidAlgebra.one_def, ← MvPolynomial.X_pow_eq_monomial, pow_one]

/-- In regular coordinates the ray ideal is the principal ideal of the ray variable. -/
theorem rayIdeal_eq_span (ρ : ToricRay σ) :
    rayIdeal hi hσ ρ = Ideal.span {χ (ofAdd (dualSemigroupCoord hi hσ hb (Sum.inl ρ)))} := by
  classical
  let e := affineCoordinateRingEquivMvPolynomial hi hσ hb
  apply le_antisymm
  · refine (rayIdeal_le_iff hi hσ ρ _).2 ?_
    intro m hm
    apply Ideal.mem_span_singleton.mpr
    apply (map_dvd_iff e).mp
    rw [rayCoord_apply hi hσ hb ρ]
    simp only [e, MonoidAlgebra.of_apply,
      affineCoordinateRingEquivMvPolynomial_single, MvPolynomial.X_dvd_monomial]
    right
    have hpos : (0 : ℤ) < ((regularDualSemigroupEquiv hi hσ hb m).1 ρ : ℤ) := by
      rwa [coe_regularDualSemigroupEquiv_fst_apply, (hb ρ).eq_primitiveGenerator hi hσ]
    exact (Int.natCast_pos.mp hpos).ne'
  · apply Ideal.span_le.2
    rw [Set.singleton_subset_iff]
    apply monomial_mem_rayIdeal
    simp [← (hb ρ).eq_primitiveGenerator hi hσ]

/-- A character belongs to the ray ideal on a regular chart exactly when its pairing with the
primitive generator is positive. -/
@[simp]
theorem monomial_mem_rayIdeal_iff (hreg : IsRegularCone i σ) (ρ : ToricRay σ)
    (m : dualSemigroup hi σ) :
    MonoidAlgebra.single (ofAdd m) (1 : ℂ) ∈ rayIdeal hi hσ ρ ↔
      0 < (m : N →+ ℤ) (primitiveGenerator hi hσ ρ) := by
  classical
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  constructor
  · intro hm
    rw [rayIdeal_eq_span hi hσ hb] at hm
    have hd := (map_dvd_iff (affineCoordinateRingEquivMvPolynomial hi hσ hb)).mpr
      (Ideal.mem_span_singleton.mp hm)
    rw [rayCoord_apply hi hσ hb ρ] at hd
    simp only [affineCoordinateRingEquivMvPolynomial_single, MvPolynomial.X_dvd_monomial,
      AddMonoidAlgebra.single_eq_zero, one_ne_zero, false_or] at hd
    have hpos : (0 : ℤ) < ((regularDualSemigroupEquiv hi hσ hb m).1 ρ : ℤ) :=
      Int.natCast_pos.mpr (Nat.pos_of_ne_zero hd)
    rwa [coe_regularDualSemigroupEquiv_fst_apply, (hb ρ).eq_primitiveGenerator hi hσ] at hpos
  · intro hm
    simpa only [MonoidAlgebra.of_apply] using monomial_mem_rayIdeal hi hσ ρ m hm

/-- At an exponent of weight zero, the coefficient of every element of the ray ideal vanishes. -/
theorem coeff_eq_zero_of_mem_rayIdeal (hi : IsIntegralLattice i) (hσ : IsToricCone i σ)
    (hreg : IsRegularCone i σ) (ρ : ToricRay σ) {f : affineCoordinateRing hi σ}
    (hf : f ∈ rayIdeal hi hσ ρ) (m : dualSemigroup hi σ)
    (hm : (m : N →+ ℤ) (primitiveGenerator hi hσ ρ) = 0) : f.coeff (ofAdd m) = 0 := by
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  let q := dualSemigroupCoord hi hσ hb (Sum.inl ρ)
  rw [rayIdeal_eq_span hi hσ hb, Ideal.mem_span_singleton] at hf
  obtain ⟨g, rfl⟩ := hf
  rw [MonoidAlgebra.of_apply]
  apply MonoidAlgebra.coeff_single_mul_of_forall_mul_ne
  intro d hd
  let u := primitiveGenerator hi hσ ρ
  have hq : (q : N →+ ℤ) u = 1 := by
    simp [q, u, ← (hb ρ).eq_primitiveGenerator hi hσ]
  have hdu : (0 : ℤ) ≤ (d.toAdd : N →+ ℤ) u := by
    have h := (mem_dualSemigroup hi _).mp d.toAdd.property
      (ρ.val.isFaceOf.le (primitiveGenerator_mem hi hσ ρ))
    exact_mod_cast (hi.realCharacter_apply _ u ▸ h)
  have h := congrArg (fun x : Multiplicative (dualSemigroup hi σ) ↦
    (x.toAdd : N →+ ℤ) u) hd
  have heq : (q : N →+ ℤ) u + (d.toAdd : N →+ ℤ) u = (m : N →+ ℤ) u := by
    simpa only [toAdd_mul, toAdd_ofAdd, AddSubmonoid.coe_add, AddMonoidHom.add_apply] using h
  have hm' : (m : N →+ ℤ) u = 0 := hm
  omega

/-- Ray ideals in regular cones are prime. -/
theorem IsRegularCone.isPrime_rayIdeal (hreg : IsRegularCone i σ) (ρ : ToricRay σ) :
    (rayIdeal hi hσ ρ).IsPrime := by
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  let e := affineCoordinateRingEquivMvPolynomial hi hσ hb
  have hp : Prime (χ (ofAdd (dualSemigroupCoord hi hσ hb (Sum.inl ρ)))) := by
    apply (MulEquiv.prime_iff e.toMulEquiv).1
    exact (rayCoord_apply hi hσ hb ρ).symm ▸ MvPolynomial.prime_X
  rw [rayIdeal_eq_span hi hσ hb]
  exact (Ideal.span_singleton_prime hp.ne_zero).2 hp

/-- In a regular chart the prime associated to a ray has height one. -/
theorem IsRegularCone.height_rayIdeal (hreg : IsRegularCone i σ) (ρ : ToricRay σ) :
    (rayIdeal hi hσ ρ).height = 1 := by
  have := hσ.isNoetherianRing_affineCoordinateRing hi
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  have hp := hreg.isPrime_rayIdeal hi hσ ρ
  rw [rayIdeal_eq_span hi hσ hb] at hp ⊢
  exact Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero (MonoidAlgebra.single_ne_zero.mpr one_ne_zero))
    (fun hu ↦ hp.ne_top (Ideal.span_singleton_eq_top.mpr hu))

/-- The generic point of the ray divisor in a regular affine toric chart. -/
def IsRegularCone.rayPoint (hreg : IsRegularCone i σ) (ρ : ToricRay σ) :
    CodimensionOnePoint (affineToricScheme hi σ) :=
  let x : PrimeSpectrum (affineCoordinateRing hi σ) :=
    ⟨rayIdeal hi hσ ρ, hreg.isPrime_rayIdeal hi hσ ρ⟩
  ⟨x, (idealHeight_eq_coheight (.of (affineCoordinateRing hi σ)) x).symm.trans
    (hreg.height_rayIdeal hi hσ ρ)⟩

/-- The prime underlying the ray point is the ideal of positive monomials. -/
@[simp]
theorem IsRegularCone.rayPoint_asIdeal (hreg : IsRegularCone i σ) (ρ : ToricRay σ) :
    (hreg.rayPoint hi hσ ρ).val.asIdeal = rayIdeal hi hσ ρ := (rfl)

private theorem monomial_factor_ray (ρ : ToricRay σ) (m : dualSemigroup hi σ) :
    ∃ m₀ : dualSemigroup hi σ,
      (m₀ : N →+ ℤ) (primitiveGenerator hi hσ ρ) = 0 ∧
      χ (ofAdd m) =
        χ (ofAdd m₀) * χ (ofAdd (dualSemigroupCoord hi hσ hb (Sum.inl ρ))) ^
          (regularDualSemigroupEquiv hi hσ hb m).1 ρ := by
  let e := regularDualSemigroupEquiv hi hσ hb
  let m₀ := e.symm ((e m).1.erase ρ, (e m).2)
  let q := dualSemigroupCoord hi hσ hb (Sum.inl ρ)
  have hq : e q = (Finsupp.single ρ 1, 0) := by
    simp only [e, q, ← regularDualSemigroupEquiv_symm_apply_single_zero hi hσ hb ρ,
      AddEquiv.apply_symm_apply]
  have h₀ : e m₀ = ((e m).1.erase ρ, (e m).2) := e.apply_symm_apply _
  refine ⟨m₀, ?_, ?_⟩
  · rw [← (hb ρ).eq_primitiveGenerator hi hσ, ← coe_regularDualSemigroupEquiv_fst_apply hi hσ hb,
      h₀, Finsupp.erase_same, Nat.cast_zero]
  · have hm : m = m₀ + (e m).1 ρ • q := by
      apply e.injective
      rw [map_add, map_nsmul, h₀, hq]
      ext : 1
      · simp only [Prod.fst_add, Prod.smul_fst, Finsupp.smul_single, nsmul_eq_mul, mul_one,
          Nat.cast_id, Finsupp.erase_add_single]
      · simp
    rw [← map_pow, ← ofAdd_nsmul, ← map_mul, ← ofAdd_add, ← hm]

local notation "R" => CommRingCat.of (affineCoordinateRing hi σ)
local notation "X" => Spec R
local notation "toField" => (Iso.inv (Scheme.ΓSpecIso R) ≫ Scheme.germToFunctionField (X) ⊤)

private theorem rayMonomial_ord (hreg : IsRegularCone i σ) (ρ : ToricRay σ)
    (m : dualSemigroup hi σ) :
    letI := hσ.isNoetherianRing_affineCoordinateRing hi
    (X).ord ((toField) (χ (ofAdd m))) (hreg.rayPoint hi hσ ρ).val =
      (m : N →+ ℤ) (primitiveGenerator hi hσ ρ) := by
  let x := hreg.rayPoint hi hσ ρ
  let := hσ.isNoetherianRing_affineCoordinateRing hi
  let p : PrimeSpectrum (affineCoordinateRing hi σ) := x.val
  let A := (X).presheaf.stalk x.val
  let := p.isPrime
  let : Algebra (affineCoordinateRing hi σ) A :=
    StructureSheaf.stalkAlgebra (affineCoordinateRing hi σ) p
  have : IsLocalization.AtPrime A p.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk (affineCoordinateRing hi σ) p
  have hmap (a : R) :
      algebraMap A (X).functionField (algebraMap (affineCoordinateRing hi σ) A a) = (toField) a :=
    (X).algebraMap_germ_eq_germToFunctionField (x := x.val) trivial ((Scheme.ΓSpecIso R).inv a)
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  let q := χ (ofAdd (dualSemigroupCoord hi hσ hb (Sum.inl ρ)))
  have hmmax : IsLocalRing.maximalIdeal A =
      Ideal.span {algebraMap (affineCoordinateRing hi σ) A q} := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p.asIdeal,
      hreg.rayPoint_asIdeal, rayIdeal_eq_span hi hσ hb, Ideal.map_span, Set.image_singleton]
  have hq : (X).ord (toField q) x.val = 1 := by
    rw [← hmap]
    apply TauCeti.AlgebraicGeometry.Scheme.ord_algebraMap_stalk_eq_one x.property specializes_rfl
    simpa only [TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id, Ideal.comap_id]
      using hmmax
  obtain ⟨m₀, h₀, hm⟩ := monomial_factor_ray hi hσ hb ρ m
  have hu : IsUnit (algebraMap (affineCoordinateRing hi σ) A (χ (ofAdd m₀))) := by
    apply (IsLocalization.AtPrime.isUnit_to_map_iff A p.asIdeal _).2
    rw [Ideal.mem_primeCompl_iff, hreg.rayPoint_asIdeal, MonoidAlgebra.of_apply,
      monomial_mem_rayIdeal_iff hi hσ hreg, h₀]
    simp
  have h₀ord : (X).ord ((toField) (χ (ofAdd m₀))) x.val = 0 := by
    rw [← hmap]
    exact Scheme.ord_algebraMap_eq_zero_of_isUnit hu
  have hinj : Function.Injective (toField) := by
    intro a b hab
    exact (Scheme.ΓSpecIso R).symm.commRingCatIsoToRingEquiv.injective
      ((X).germToFunctionField_injective ⊤ hab)
  have hne (m : dualSemigroup hi σ) : toField (χ (ofAdd m)) ≠ 0 :=
    (map_ne_zero_iff _ hinj).2 (MonoidAlgebra.single_ne_zero.mpr one_ne_zero)
  rw [hm, map_mul, map_pow, Scheme.ord_mul (hne m₀) (pow_ne_zero _ (hne _)),
    h₀ord, Scheme.ord_pow, hq, zero_add, mul_one, coe_regularDualSemigroupEquiv_fst_apply,
    (hb ρ).eq_primitiveGenerator hi hσ]

private theorem exists_rayIdeal_le_of_monomial_mem (hreg : IsRegularCone i σ)
    (p : PrimeSpectrum (affineCoordinateRing hi σ)) (m : dualSemigroup hi σ)
    (hm : χ (ofAdd m) ∈ p.asIdeal) :
    ∃ ρ : ToricRay σ, rayIdeal hi hσ ρ ≤ p.asIdeal := by
  classical
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  let e := affineCoordinateRingEquivMvPolynomial hi hσ hb
  let P := p.asIdeal.map e
  have := p.isPrime
  have hP : P.IsPrime := Ideal.map_isPrime_of_equiv e
  let v := regularDualSemigroupEquiv hi hσ hb m
  have hmem : e (χ (ofAdd m)) ∈ P := Ideal.mem_map_of_mem e hm
  rw [MonoidAlgebra.of_apply, affineCoordinateRingEquivMvPolynomial_single,
    MvPolynomial.monomial_eq] at hmem
  have hu : IsUnit (AddMonoidAlgebra.single v.2 (1 : ℂ)) :=
    (Group.isUnit (ofAdd v.2)).map (AddMonoidAlgebra.of ℂ (Fin l →₀ ℤ))
  have hprod := (hP.mem_or_mem hmem).resolve_left
    (P.notMem_of_isUnit (hu.map MvPolynomial.C))
  obtain ⟨ρ, hρ, hx⟩ := (Ideal.IsPrime.prod_mem_iff
    (s := v.1.support) (x := fun ρ ↦ MvPolynomial.X ρ ^ v.1 ρ) (p := P)).1 hprod
  have hX := (hP.pow_mem_iff_mem (v.1 ρ) (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hρ))).1 hx
  refine ⟨ρ, ?_⟩
  rw [rayIdeal_eq_span hi hσ hb, Ideal.span_le, Set.singleton_subset_iff]
  obtain ⟨q, hq, hqX⟩ := (Ideal.mem_map_of_equiv e _).1 hX
  exact e.injective (hqX.trans (rayCoord_apply hi hσ hb ρ).symm) ▸ hq

end Chart

namespace Fan

variable {Φ : Fan i}

/-- The generator of a fan ray as a primitive lattice vector. -/
def Ray.primitiveGenerator (ρ : Φ.Ray) : N :=
  TauCeti.Toric.primitiveGenerator Φ.lattice (Φ.isToricCone ρ.toCone.property)
    (Ray.toToricRay Φ ρ ρ.toCone le_rfl)

/-- A fan ray is the cone spanned by its primitive generator. -/
theorem Ray.toCone_eq_hull_primitiveGenerator (ρ : Φ.Ray) :
    ρ.toCone.val = PointedCone.hull ℝ {i (Ray.primitiveGenerator ρ)} := by
  classical
  let σ := ρ.toCone
  let r := Ray.toToricRay Φ ρ σ le_rfl
  let hσ := Φ.isToricCone σ.property
  have hr : r.toPointedCone = σ.val := Ray.toPointedCone_toToricRay Φ ρ σ le_rfl
  have hne : i (TauCeti.Toric.primitiveGenerator Φ.lattice hσ r) ≠ 0 := by
    rw [map_ne_zero_iff _ Φ.lattice.injective]
    exact primitiveGenerator_ne_zero Φ.lattice hσ r
  exact hr ▸ r.eq_hull_singleton (hσ.salient.anti r.val.isFaceOf.le)
    (primitiveGenerator_mem Φ.lattice hσ r) hne

/-- The generic point of a fan ray's boundary divisor, viewed in the fan scheme. -/
def rayBoundaryPoint (Φ : Fan i) (hΦ : Φ.IsRegular) (ρ : Φ.Ray) :
    CodimensionOnePoint Φ.algebraicRealization :=
  CodimensionOnePoint.mapOfIsOpenImmersion (Φ.affineToricChartι ρ.toCone)
    ((isRegular_iff.1 hΦ _ ρ.toCone.property).rayPoint Φ.lattice
      (Φ.isToricCone ρ.toCone.property) (Ray.toToricRay Φ ρ ρ.toCone le_rfl))

/-- The ray boundary point is the image of the ray prime in its affine chart. -/
@[simp]
theorem coe_rayBoundaryPoint (Φ : Fan i) (hΦ : Φ.IsRegular) (ρ : Φ.Ray) :
    (Φ.rayBoundaryPoint hΦ ρ).val =
      Φ.affineToricChartι ρ.toCone
        ((isRegular_iff.1 hΦ _ ρ.toCone.property).rayPoint Φ.lattice
          (Φ.isToricCone ρ.toCone.property) (Ray.toToricRay Φ ρ ρ.toCone le_rfl)).val := by
  rw [rayBoundaryPoint, CodimensionOnePoint.coe_mapOfIsOpenImmersion]

/-- In any chart containing a fan ray, its boundary point is the prime of that ray in the chart. -/
theorem rayBoundaryPoint_ofToricRay (Φ : Fan i) (hΦ : Φ.IsRegular)
    (σ : Φ.cones) (ρ : ToricRay σ.val) :
    (Φ.rayBoundaryPoint hΦ (Ray.ofToricRay Φ σ ρ)).val =
      Φ.affineToricChartι σ
        ((isRegular_iff.1 hΦ _ σ.property).rayPoint Φ.lattice
          (Φ.isToricCone σ.property) ρ).val := by
  let τ := (Ray.ofToricRay Φ σ ρ).toCone
  let r := Ray.toToricRay Φ (Ray.ofToricRay Φ σ ρ) τ le_rfl
  let hτ := Φ.isToricCone τ.property
  let hσ := Φ.isToricCone σ.property
  let hτreg := (isRegular_iff.1 hΦ) _ τ.property
  let hσreg := (isRegular_iff.1 hΦ) _ σ.property
  let hface := Φ.isFaceOf_of_le σ.property τ.property (Ray.toCone_ofToricRay_le Φ σ ρ)
  let f := faceAffineToricSchemeMap Φ.lattice hface
  have : IsOpenImmersion f := hσ.rational.isOpenImmersion_faceAffineToricSchemeMap Φ.lattice hface
  let q := hτreg.rayPoint Φ.lattice hτ r
  let p := hσreg.rayPoint Φ.lattice hσ ρ
  have hr : ToricRay.faceEmbedding hface r = ρ := by
    apply SetLike.coe_injective
    exact congrArg (fun C : PointedCone ℝ V ↦ (C : Set V)) <| by
      rw [ToricRay.toPointedCone_faceEmbedding, Ray.toPointedCone_toToricRay,
        Ray.toCone_ofToricRay]
  have hv : primitiveGenerator Φ.lattice hσ ρ = primitiveGenerator Φ.lattice hτ r := by
    rw [← hr, primitiveGenerator_faceEmbedding]
  have hsub : p.val.asIdeal ≤ (f q.val).asIdeal := by
    rw [hσreg.rayPoint_asIdeal, rayIdeal_le_iff]
    intro m hm
    have hmap : f = Spec.map (CommRingCat.ofHom
        (faceAffineCoordinateRingMap Φ.lattice hface).toRingHom) :=
      faceAffineToricSchemeMap_def Φ.lattice hface
    simp only [hmap, Spec.map_apply, CommRingCat.hom_ofHom]
    refine Ideal.mem_comap.mpr ?_
    rw [hτreg.rayPoint_asIdeal, MonoidAlgebra.of_apply]
    let m' : dualSemigroup Φ.lattice τ.val :=
      ⟨m, dualSemigroup_anti Φ.lattice hface.le m.property⟩
    have he :
        (faceAffineCoordinateRingMap Φ.lattice hface).toRingHom
          (MonoidAlgebra.single (ofAdd m) 1) = MonoidAlgebra.of ℂ _ (ofAdd m') :=
      faceAffineCoordinateRingMap_single Φ.lattice hface m 1
    rw [he]
    exact monomial_mem_rayIdeal Φ.lattice hτ r _ (hv ▸ hm)
  have hqheight : (f q.val).asIdeal.height = 1 :=
    (idealHeight_eq_coheight (.of (affineCoordinateRing Φ.lattice σ.val)) _).trans
      ((coheight_eq_of_isOpenImmersion f).trans q.property)
  have hpheight : p.val.asIdeal.height = 1 :=
    (idealHeight_eq_coheight (.of (affineCoordinateRing Φ.lattice σ.val)) _).trans p.property
  have := p.val.isPrime
  have : p.val.asIdeal.FiniteHeight := p.val.asIdeal.finiteHeight_iff.mpr (by rw [hpheight]; simp)
  have heq : f q.val = p.val := PrimeSpectrum.ext <|
    (Ideal.eq_of_le_of_height_le p.val.asIdeal hsub (by rw [hqheight, hpheight])).symm
  rw [coe_rayBoundaryPoint, ← Φ.faceAffineToricSchemeMap_comp_affineToricChartι hface,
    Scheme.Hom.comp_apply, heq]

/-- The ray boundary point lies outside the dense torus. -/
theorem rayBoundaryPoint_notMem_range_denseTorusι (Φ : Fan i) (hΦ : Φ.IsRegular) (ρ : Φ.Ray) :
    (Φ.rayBoundaryPoint hΦ ρ).val ∉ Set.range (Φ.denseTorusι ⟨ρ.toCone⟩) := by
  let σ := ρ.toCone
  let r := Ray.toToricRay Φ ρ σ le_rfl
  let hσ := Φ.isToricCone σ.property
  let hreg := (isRegular_iff.1 hΦ) _ σ.property
  let hface := hσ.salient.bot_isFaceOf
  let t : CodimensionOnePoint (Φ.affineToricChart σ) := hreg.rayPoint Φ.lattice hσ r
  intro ⟨a, ha⟩
  rw [Φ.denseTorusι_face σ, Scheme.Hom.comp_apply, coe_rayBoundaryPoint] at ha
  have h := (Φ.affineToricChartι σ).isOpenEmbedding.injective ha
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  let m := dualSemigroupCoord Φ.lattice hσ hb (Sum.inl r)
  have hm : MonoidAlgebra.single (ofAdd m) (1 : ℂ) ∈ t.val.asIdeal := by
    rw [hreg.rayPoint_asIdeal, rayIdeal_eq_span Φ.lattice hσ hb, MonoidAlgebra.of_apply]
    exact Ideal.mem_span_singleton_self _
  rw [← h, faceAffineToricSchemeMap_def, Spec.map_apply] at hm
  let p : PrimeSpectrum (affineCoordinateRing Φ.lattice ⊥) := a
  have := p.isPrime
  have hm' : faceAffineCoordinateRingMap Φ.lattice hface (MonoidAlgebra.single (ofAdd m) 1) ∈
      p.asIdeal := hm
  apply p.asIdeal.notMem_of_isUnit _ hm'
  apply (isUnit_map_iff (denseTorusCoordinateRingEquiv Φ.lattice) _).1
  rw [faceAffineCoordinateRingMap_single, denseTorusCoordinateRingEquiv_single,
    ← MonoidAlgebra.of_apply]
  exact (Group.isUnit _).map (MonoidAlgebra.of ℂ _)

/-- The generic point of a ray divisor belongs to a cone chart exactly when that cone
contains the ray. -/
theorem rayBoundaryPoint_mem_range_affineToricChartι_iff (Φ : Fan i) (hΦ : Φ.IsRegular)
    (ρ : Φ.Ray) (σ : Φ.cones) :
    (Φ.rayBoundaryPoint hΦ ρ).val ∈ Set.range (Φ.affineToricChartι σ) ↔ ρ.toCone ≤ σ := by
  constructor
  · intro h
    let τ := ρ.toCone ⊓ σ
    have hτ : τ.val.IsFaceOf ρ.toCone.val :=
      Φ.isFaceOf_of_le ρ.toCone.property τ.property inf_le_left
    rw [ρ.toCone_eq_hull_primitiveGenerator] at hτ
    rcases hτ.eq_bot_or_eq_of_hull_singleton (i ρ.primitiveGenerator) with hbot | hfull
    · have hz : τ = ⟨⊥, Φ.bot_mem σ.property⟩ := Subtype.ext hbot
      have hmem : (Φ.rayBoundaryPoint hΦ ρ).val ∈ Set.range (Φ.affineToricChartι τ) := by
        rw [← Φ.range_affineToricChartι_inter_range_affineToricChartι]
        exact ⟨⟨_, Φ.coe_rayBoundaryPoint hΦ ρ |>.symm⟩, h⟩
      rw [hz, ← Φ.denseTorusι_eq_affineToricChartι ⟨ρ.toCone⟩ _] at hmem
      exact (Φ.rayBoundaryPoint_notMem_range_denseTorusι hΦ ρ hmem).elim
    · have heq : τ = ρ.toCone := Subtype.ext
        (hfull.trans ρ.toCone_eq_hull_primitiveGenerator.symm)
      exact heq ▸ inf_le_right (a := ρ.toCone) (b := σ)
  · intro h
    let r := ρ.toToricRay Φ σ h
    have hr : Ray.ofToricRay Φ σ r = ρ := by
      simpa only [r, rayEquiv_apply, rayEquiv_symm_apply] using
        congrArg Subtype.val ((Φ.rayEquiv σ).symm_apply_apply ⟨ρ, h⟩)
    exact ⟨_, (Φ.rayBoundaryPoint_ofToricRay hΦ σ r).symm.trans
      (congrArg (fun s : Φ.Ray ↦ (Φ.rayBoundaryPoint hΦ s).val) hr)⟩

private theorem exists_rayBoundaryPoint_of_notMem_range_denseTorusι (Φ : Fan i) (hΦ : Φ.IsRegular)
    (h₀ : Nonempty Φ.cones) (x : CodimensionOnePoint Φ.algebraicRealization)
    (hx : x.val ∉ Set.range (Φ.denseTorusι h₀)) :
    ∃ ρ : Φ.Ray, Φ.rayBoundaryPoint hΦ ρ = x := by
  obtain ⟨σ, y, hy⟩ := Φ.exists_affineToricChartι_apply_eq x.val
  let hσ := Φ.isToricCone σ.property
  let hreg := (isRegular_iff.1 hΦ) _ σ.property
  let hface := hσ.salient.bot_isFaceOf
  have hy' : y ∉ Set.range (faceAffineToricSchemeMap Φ.lattice hface) := by
    rintro ⟨a, rfl⟩
    exact hx ⟨a, by rw [Φ.denseTorusι_eq h₀ ⟨σ⟩, Φ.denseTorusι_face σ, Scheme.Hom.comp_apply, hy]⟩
  obtain ⟨m, hm⟩ :=
    hσ.rational.exists_isLocalization_away_faceAffineCoordinateRingMap Φ.lattice hface
  let := (faceAffineCoordinateRingMap Φ.lattice hface).toRingHom.toAlgebra
  let := hm
  have hrange : Set.range (faceAffineToricSchemeMap Φ.lattice hface) =
      (PrimeSpectrum.basicOpen (MonoidAlgebra.single (ofAdd m) (1 : ℂ)) :
        Set (PrimeSpectrum (affineCoordinateRing Φ.lattice σ.val))) := by
    rw [faceAffineToricSchemeMap_def]
    exact PrimeSpectrum.localization_away_comap_range (affineCoordinateRing Φ.lattice ⊥) _
  rw [hrange] at hy'
  have hmem : MonoidAlgebra.of ℂ _ (ofAdd m) ∈ y.asIdeal :=
    Classical.not_not.1 hy'
  obtain ⟨ρ, hρ⟩ := exists_rayIdeal_le_of_monomial_mem Φ.lattice hσ hreg y m hmem
  have hheight : y.asIdeal.height = 1 := by
    rw [idealHeight_eq_coheight (.of (affineCoordinateRing Φ.lattice σ.val)) y,
      ← coheight_eq_of_isOpenImmersion (Φ.affineToricChartι σ), hy]
    exact x.property
  have hρheight := hreg.height_rayIdeal Φ.lattice hσ ρ
  have := hreg.isPrime_rayIdeal Φ.lattice hσ ρ
  have : (rayIdeal Φ.lattice hσ ρ).FiniteHeight :=
    (rayIdeal Φ.lattice hσ ρ).finiteHeight_iff.mpr (by rw [hρheight]; simp)
  have heq := Ideal.eq_of_le_of_height_le _ hρ (by rw [hheight, hρheight])
  refine ⟨Ray.ofToricRay Φ σ ρ, Subtype.ext ?_⟩
  rw [rayBoundaryPoint_ofToricRay, ← hy]
  exact congrArg (Φ.affineToricChartι σ) (PrimeSpectrum.ext
    ((hreg.rayPoint_asIdeal Φ.lattice hσ ρ).trans heq))

section Character

variable (Φ : Fan i) [Nonempty Φ.cones]

/-- The order of a rational character at a toric boundary ray is its pairing with the
primitive lattice generator. -/
theorem ord_rayBoundaryPoint_character (hΦ : Φ.IsRegular) (ρ : Φ.Ray) (m : N →+ ℤ) :
    Φ.algebraicRealization.ord (Φ.character (ofAdd m)) (Φ.rayBoundaryPoint hΦ ρ).val =
      m (Ray.primitiveGenerator ρ) := by
  let σ := ρ.toCone
  let r := Ray.toToricRay Φ ρ σ le_rfl
  let hσ := Φ.isToricCone σ.property
  have hnonneg (a : N →+ ℤ) (ha : 0 ≤ a (Ray.primitiveGenerator ρ)) :
      a ∈ dualSemigroup Φ.lattice σ.val := by
    rw [Ray.toCone_eq_hull_primitiveGenerator ρ, ← Set.image_singleton,
      mem_dualSemigroup_hull_image]
    simpa using ha
  have hregular (a : N →+ ℤ) (ha : 0 ≤ a (Ray.primitiveGenerator ρ)) :
      Φ.algebraicRealization.ord (Φ.character (ofAdd a)) (Φ.rayBoundaryPoint hΦ ρ).val =
        a (Ray.primitiveGenerator ρ) := by
    have := hσ.isNoetherianRing_affineCoordinateRing Φ.lattice
    rw [coe_rayBoundaryPoint, ← TauCeti.AlgebraicGeometry.Scheme.ord_functionFieldMap,
      functionFieldMap_affineToricChartι_character Φ σ ⟨a, hnonneg a ha⟩]
    exact rayMonomial_ord Φ.lattice hσ ((isRegular_iff.1 hΦ) _ σ.property) r ⟨a, hnonneg a ha⟩
  by_cases hm : 0 ≤ m (Ray.primitiveGenerator ρ)
  · exact hregular m hm
  · have hn := hregular (-m) (by simp [le_of_not_ge hm])
    rw [ofAdd_neg, map_inv, Scheme.ord_inv, AddMonoidHom.neg_apply] at hn
    exact neg_injective hn

end Character

section Complex

variable {N : Type} {V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} (Φ : Fan i) [Nonempty Φ.cones]

local notation "C" => algebraMap ℂ Φ.algebraicRealization.functionField

/-- A scalar multiple of a lattice character has the same boundary order as the character itself. -/
theorem ord_rayBoundaryPoint_mul_character (hΦ : Φ.IsRegular) (ρ : Φ.Ray)
    (c : ℂˣ) (m : N →+ ℤ) :
    Φ.algebraicRealization.ord (C (c : ℂ) * Φ.character (ofAdd m))
        (Φ.rayBoundaryPoint hΦ ρ).val = m ρ.primitiveGenerator := by
  rw [Scheme.ord_mul ((map_ne_zero C).mpr c.ne_zero)
      ((Group.isUnit (ofAdd m)).map Φ.character).ne_zero,
    Scheme.ord_algebraMap_base_unit, zero_add, Φ.ord_rayBoundaryPoint_character]

end Complex

/-- Distinct fan rays have distinct boundary points. -/
theorem rayBoundaryPoint_injective (Φ : Fan i) (hΦ : Φ.IsRegular) :
    Function.Injective (Φ.rayBoundaryPoint hΦ) := by
  intro ρ τ h
  let : Nonempty Φ.cones := ⟨ρ.toCone⟩
  have := Φ.lattice.free
  let b := Module.Free.chooseBasis ℤ N
  have hgen : ρ.primitiveGenerator = τ.primitiveGenerator :=
    b.ext_elem_iff.2 fun j ↦ by
      have heq := congrArg
        (fun x : CodimensionOnePoint Φ.algebraicRealization ↦
          Φ.algebraicRealization.ord (Φ.character (ofAdd (b.coord j).toAddMonoidHom)) x.val) h
      simpa only [ord_rayBoundaryPoint_character Φ hΦ, LinearMap.toAddMonoidHom_coe,
        Module.Basis.coord_apply] using heq
  apply Subtype.ext
  apply Subtype.ext
  rw [Ray.toCone_eq_hull_primitiveGenerator ρ, Ray.toCone_eq_hull_primitiveGenerator τ, hgen]

/-- The codimension-one points outside the dense torus are precisely the ray boundary points. -/
theorem range_rayBoundaryPoint (Φ : Fan i) (hΦ : Φ.IsRegular) (h₀ : Nonempty Φ.cones) :
    Set.range (Φ.rayBoundaryPoint hΦ) =
      {x | x.val ∉ Set.range (Φ.denseTorusι h₀)} := by
  ext x
  constructor
  · rintro ⟨ρ, rfl⟩
    exact Φ.rayBoundaryPoint_notMem_range_denseTorusι hΦ ρ
  · exact Φ.exists_rayBoundaryPoint_of_notMem_range_denseTorusι hΦ h₀ x

end Fan

end TauCeti.Toric
