/-!
# Boundary ray ideals of affine toric charts

The characters vanishing on a ray form a face of the dual semigroup. The ray divisor
is cut out by the monomial ideal of the complement of this face.
-/

public section

open AddMonoidAlgebra Multiplicative

namespace TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {σ : PointedCone ℝ V}
  (hi : IsIntegralLattice i) (hσ : IsToricCone i σ) (ρ : ToricRay σ)

/-- The face of the dual semigroup consisting of characters vanishing on the primitive ray. -/
noncomputable def rayCharacterFace : AddSubmonoid (dualSemigroup hi σ) :=
  (⊥ : AddSubmonoid ℤ).comap
    ((AddMonoidHom.eval (primitiveGenerator hi hσ ρ)).comp (dualSemigroup hi σ).subtype)

/-- Membership in the ray's exponent face is vanishing on the primitive generator. -/
@[simp]
theorem mem_rayCharacterFace (m : dualSemigroup hi σ) :
    m ∈ rayCharacterFace hi hσ ρ ↔ m.val (primitiveGenerator hi hσ ρ) = 0 :=
  (Iff.rfl)

private theorem rayCharacter_nonneg (m : dualSemigroup hi σ) :
    0 ≤ m.val (primitiveGenerator hi hσ ρ) := by
  have h := (mem_dualSemigroup hi m.val).mp m.property
    (ρ.val.isFaceOf.le (primitiveGenerator_mem hi hσ ρ))
  exact_mod_cast (hi.realCharacter_apply _ _ ▸ h)

/-- The characters vanishing on the ray form a face of the dual semigroup. -/
theorem addSaturated_rayCharacterFace : (rayCharacterFace hi hσ ρ).AddSaturated := by
  intro a b hab
  simp only [mem_rayCharacterFace, AddSubmonoid.coe_add, AddMonoidHom.add_apply] at hab ⊢
  exact (add_eq_zero_iff_of_nonneg (rayCharacter_nonneg hi hσ ρ a)
    (rayCharacter_nonneg hi hσ ρ b)).mp hab

variable (R : Type*) [CommSemiring R]

/-- The ideal of the ray divisor in the affine chart of any cone containing the ray. -/
noncomputable def rayChartIdeal : Ideal (affineChartRing R hi σ) :=
  (rayCharacterFace hi hσ ρ).faceIdeal R

/-- The ideal of a ray is the face ideal of its annihilating characters. -/
theorem rayChartIdeal_def :
    rayChartIdeal hi hσ ρ R = (rayCharacterFace hi hσ ρ).faceIdeal R :=
  (rfl)

/-- The ray ideal is generated by the monomials with strictly positive order on the ray. -/
theorem rayChartIdeal_eq_span :
    rayChartIdeal hi hσ ρ R = Ideal.span {p | ∃ m : dualSemigroup hi σ,
      0 < m.val (primitiveGenerator hi hσ ρ) ∧ p = single m 1} := by
  rw [rayChartIdeal, AddSubmonoid.faceIdeal_def]
  congr 1
  ext p
  simp only [Set.mem_image, Set.mem_compl_iff, of'_apply, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨m, hm, rfl⟩
    change m ∉ rayCharacterFace hi hσ ρ at hm
    rw [mem_rayCharacterFace] at hm
    exact ⟨m, lt_of_le_of_ne (rayCharacter_nonneg hi hσ ρ m) (Ne.symm hm), rfl⟩
  · rintro ⟨m, hm, rfl⟩
    refine ⟨m, ?_, rfl⟩
    change m ∉ rayCharacterFace hi hσ ρ
    rw [mem_rayCharacterFace]
    exact hm.ne'

/-- An ideal contains the ray ideal exactly when it contains its positive monomials. -/
theorem rayChartIdeal_le_iff (I : Ideal (affineChartRing R hi σ)) :
    rayChartIdeal hi hσ ρ R ≤ I ↔ ∀ m : dualSemigroup hi σ,
      0 < m.val (primitiveGenerator hi hσ ρ) → single m 1 ∈ I := by
  rw [rayChartIdeal_eq_span, Ideal.span_le]
  exact ⟨fun h m hm ↦ h (show single m 1 ∈ _ from ⟨m, hm, rfl⟩),
    fun h _ ⟨m, hm, hpm⟩ ↦ hpm.symm ▸ h m hm⟩

/-- Elements of the ray ideal have zero coefficients at the exponents vanishing on the ray. -/
theorem mem_rayChartIdeal_iff (f : affineChartRing R hi σ) :
    f ∈ rayChartIdeal hi hσ ρ R ↔
      ∀ m : dualSemigroup hi σ, m.val (primitiveGenerator hi hσ ρ) = 0 → f.coeff m = 0 := by
  rw [rayChartIdeal, AddSubmonoid.mem_faceIdeal_iff _ (addSaturated_rayCharacterFace hi hσ ρ)]
  exact ⟨fun h m hm ↦ h ⟨m, (mem_rayCharacterFace hi hσ ρ m).mpr hm⟩,
    fun h m ↦ h m.val ((mem_rayCharacterFace hi hσ ρ m.val).mp m.property)⟩

/-- A monomial is in the ray ideal precisely when it is zero or its order on the ray is positive. -/
theorem single_mem_rayChartIdeal_iff (m : dualSemigroup hi σ) (r : R) :
    single m r ∈ rayChartIdeal hi hσ ρ R ↔
      r = 0 ∨ 0 < m.val (primitiveGenerator hi hσ ρ) := by
  rw [rayChartIdeal,
    AddSubmonoid.single_mem_faceIdeal_iff _ (addSaturated_rayCharacterFace hi hσ ρ)]
  simp only [mem_rayCharacterFace]
  exact or_congr Iff.rfl ⟨fun h ↦ lt_of_le_of_ne (rayCharacter_nonneg hi hσ ρ m) (Ne.symm h),
    fun h ↦ h.ne'⟩

/-- In a single-ray chart, a monomial of order one generates the ray ideal. -/
theorem rayChartIdeal_eq_span_of_apply_eq_one
    (hcone : σ = PointedCone.hull ℝ {i (primitiveGenerator hi hσ ρ)})
    (a : dualSemigroup hi σ) (ha : a.val (primitiveGenerator hi hσ ρ) = 1) :
    rayChartIdeal hi hσ ρ R = Ideal.span {single a 1} := by
  apply le_antisymm
  · rw [rayChartIdeal_le_iff]
    intro m hm
    let v := primitiveGenerator hi hσ ρ
    have hmem (x : N →+ ℤ) : x ∈ dualSemigroup hi σ ↔ 0 ≤ x v := by
      rw [show σ = PointedCone.hull ℝ {i v} from hcone, ← Set.image_singleton,
        mem_dualSemigroup_hull_image, Set.forall_mem_singleton]
    let d : dualSemigroup hi σ := ⟨m.val - a.val, (hmem _).2 (by
      simp only [AddMonoidHom.sub_apply, v, ha]
      omega)⟩
    refine Ideal.mem_span_singleton.mpr ⟨single d 1, ?_⟩
    rw [single_mul_single, mul_one]
    exact congrArg (fun χ ↦ single χ (1 : R)) (Subtype.ext (add_sub_cancel _ _)).symm
  · rw [Ideal.span_singleton_le_iff_mem, single_mem_rayChartIdeal_iff, ha]
    exact Or.inr Int.zero_lt_one

/-- The ray ideal over a domain is prime. -/
theorem isPrime_rayChartIdeal [Nontrivial R] [NoZeroDivisors R] :
    (rayChartIdeal hi hσ ρ R).IsPrime :=
  (rayCharacterFace hi hσ ρ).faceIdeal_isPrime (addSaturated_rayCharacterFace hi hσ ρ)

section RegularCoordinates

variable {ι : Type*} {b : Module.Basis (ToricRay σ ⊕ ι) ℤ N}
  (hb : ∀ ρ, IsPrimitiveGenerator i ρ (b (Sum.inl ρ)))

/-- In coordinates from a basis extending the primitive rays, the ray ideal is
generated by the ray variable. -/
theorem rayChartIdeal_eq_span_rayCoordinate :
    rayChartIdeal hi hσ ρ R =
      Ideal.span {single (dualSemigroupCoord hi hσ hb (Sum.inl ρ)) (1 : R)} := by
  classical
  apply le_antisymm
  · rw [rayChartIdeal_eq_span, Ideal.span_le]
    rintro _ ⟨m, hm, rfl⟩
    apply Ideal.mem_span_singleton.mpr
    apply (map_dvd_iff (affineChartRingEquivMvPolynomial hi hσ hb R)).mp
    rw [affineChartRingEquivMvPolynomial_rayCoord, affineChartRingEquivMvPolynomial_single,
      MvPolynomial.X_dvd_monomial]
    right
    have hpos : (0 : ℤ) < ((regularDualSemigroupEquiv hi hσ hb m).1 ρ : ℤ) := by
      rwa [coe_regularDualSemigroupEquiv_fst_apply, (hb ρ).eq_primitiveGenerator hi hσ]
    exact (Int.natCast_pos.mp hpos).ne'
  · rw [Ideal.span_singleton_le_iff_mem, single_mem_rayChartIdeal_iff]
    right
    simp [← (hb ρ).eq_primitiveGenerator hi hσ]

end RegularCoordinates

/-- In a regular cone chart over a Noetherian domain, the prime of a ray has height one. -/
theorem IsRegularCone.height_rayChartIdeal (hreg : IsRegularCone i σ)
    (A : Type*) [CommRing A] [IsDomain A] [IsNoetherianRing A] :
    (rayChartIdeal hi hσ ρ A).height = 1 := by
  have := hσ.isNoetherianRing_affineChartRing A hi
  have : IsDomain (affineChartRing A hi σ) := inferInstance
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  have hp := isPrime_rayChartIdeal hi hσ ρ A
  rw [rayChartIdeal_eq_span_rayCoordinate hi hσ ρ A hb] at hp ⊢
  exact Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
    (mem_nonZeroDivisors_of_ne_zero (single_ne_zero.mpr one_ne_zero))
    (fun hu ↦ hp.ne_top (Ideal.span_singleton_eq_top.mpr hu))

/-- Ray divisors in a regular affine chart over a regular ring have regular
coordinate rings. The ray coordinate is a polynomial variable in the chart. -/
theorem IsRegularCone.isRegularRing_quotient_rayChartIdeal (hreg : IsRegularCone i σ)
    (A : Type*) [CommRing A] [IsRegularRing A] :
    IsRegularRing (affineChartRing A hi σ ⧸ rayChartIdeal hi hσ ρ A) := by
  classical
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  let B := AddMonoidAlgebra A (Fin l →₀ ℤ)
  let C := MvPolynomial {τ : ToricRay σ // τ ≠ ρ} B
  let e : affineChartRing A hi σ ≃ₐ[A] Polynomial C :=
    (affineChartRingEquivMvPolynomial hi hσ hb A).trans <|
      (((MvPolynomial.renameEquiv B (Equiv.optionSubtypeNe ρ).symm).trans
        (MvPolynomial.optionEquivLeft B _)).restrictScalars A)
  have hX : e (single (dualSemigroupCoord hi hσ hb (Sum.inl ρ)) 1) = Polynomial.X := by
    dsimp only [e, AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply]
    rw [affineChartRingEquivMvPolynomial_rayCoord]
    simp only [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_X,
      Equiv.optionSubtypeNe_symm_self, MvPolynomial.optionEquivLeft_X_none]
  have hmap : (rayChartIdeal hi hσ ρ A).map e.toRingEquiv =
      Ideal.span {Polynomial.X - Polynomial.C (0 : C)} := by
    rw [rayChartIdeal_eq_span_rayCoordinate hi hσ ρ A hb, Ideal.map_span, Set.image_singleton]
    change Ideal.span {e (single (dualSemigroupCoord hi hσ hb (Sum.inl ρ)) 1)} = _
    have hzero : (Polynomial.X - Polynomial.C (0 : C)) = Polynomial.X := by simp
    rw [hX, hzero]
  have : Algebra.IsStandardSmoothOfRelativeDimension (Nat.card (Fin l)) A B :=
    AddMonoidAlgebra.isStandardSmoothOfRelativeDimension_finsupp_int A (Fin l)
  have : Algebra.IsStandardSmooth A B :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth (n := Nat.card (Fin l))
  have : IsRegularRing B := IsRegularRing.of_smooth (R := A)
  have : Finite (ToricRay σ) := ToricRay.finite_of_fg hreg.fg
  have : IsRegularRing C := inferInstanceAs (IsRegularRing (MvPolynomial _ B))
  let E := (Ideal.quotientEquiv _ _ e.toRingEquiv hmap.symm).trans
    (Polynomial.quotientSpanXSubCAlgEquiv (0 : C)).toRingEquiv
  exact IsRegularRing.of_ringEquiv E.symm

/-- A prime ideal in a regular chart containing a coefficient-one monomial contains a ray ideal. -/
theorem exists_rayChartIdeal_le_of_single_mem (A : Type*) [CommRing A]
    (hreg : IsRegularCone i σ) (I : Ideal (affineChartRing A hi σ)) [I.IsPrime]
    (m : dualSemigroup hi σ) (hm : single m (1 : A) ∈ I) :
    ∃ ρ : ToricRay σ, rayChartIdeal hi hσ ρ A ≤ I := by
  classical
  obtain ⟨l, b, hb⟩ := hreg.exists_basis_sum
  let e := affineChartRingEquivMvPolynomial hi hσ hb A
  let J := I.map e.toRingEquiv
  have hJ : J.IsPrime := Ideal.map_isPrime_of_equiv e.toRingEquiv
  let v := regularDualSemigroupEquiv hi hσ hb m
  have hmem : e (single m 1) ∈ J := Ideal.mem_map_of_mem e.toRingEquiv hm
  change affineChartRingEquivMvPolynomial hi hσ hb A (single m 1) ∈ J at hmem
  rw [affineChartRingEquivMvPolynomial_single, MvPolynomial.monomial_eq] at hmem
  have hu : IsUnit (single v.2 (1 : A)) :=
    (Group.isUnit (ofAdd v.2)).map (AddMonoidAlgebra.of A (Fin l →₀ ℤ))
  have hprod := (hJ.mem_or_mem hmem).resolve_left (J.notMem_of_isUnit (hu.map MvPolynomial.C))
  obtain ⟨ρ, hρ, hx⟩ := (Ideal.IsPrime.prod_mem_iff
    (s := v.1.support) (x := fun ρ ↦ MvPolynomial.X ρ ^ v.1 ρ) (p := J)).1 hprod
  have hX := (hJ.pow_mem_iff_mem (v.1 ρ) (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hρ))).1 hx
  refine ⟨ρ, ?_⟩
  rw [rayChartIdeal_eq_span_rayCoordinate hi hσ ρ A hb, Ideal.span_singleton_le_iff_mem]
  apply (Ideal.apply_mem_of_equiv_iff (f := e.toRingEquiv)).mp
  change e (single _ 1) ∈ J
  rwa [show e (single (dualSemigroupCoord hi hσ hb (Sum.inl ρ)) 1) = MvPolynomial.X ρ
    from affineChartRingEquivMvPolynomial_rayCoord hi hσ hb A ρ]

end TauCeti.Toric
