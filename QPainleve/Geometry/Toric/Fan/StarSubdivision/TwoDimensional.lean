module

public import QPainleve.Geometry.Toric.Cone.TwoDimensional
public import TauCeti.Geometry.Toric.Algebraic.Fan.StarSubdivision

import Mathlib.LinearAlgebra.Transvection.Basic
import QPainleve.Geometry.Toric.Cone.Coordinates
import TauCeti.Data.Fin.Rev

/-!
# Star subdivisions of two-dimensional regular cones

The two chart cones are generated by the sum of the primitive ray generators
and one of the original rays.
-/

public section

namespace TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V}

namespace IsRegularCone

/-- A chart cone of the star subdivision is generated by the new ray and one old ray. -/
theorem starSubdivisionCone_pair_eq_hull {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i)
    (b : Module.Basis (Fin 2) ℤ N) (e : Fin 2 ≃ ToricRay σ)
    (hb : ∀ j, b j = primitiveGenerator hi hσ.toIsToricCone (e j)) (j : Fin 2) :
    starSubdivisionCone hi (ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg)
        hσ.toIsToricCone {none, some (e j)} =
      PointedCone.hull ℝ {i (b 0 + b 1), i (b j)} := by
  have hsum := hσ.sum_primitiveGenerator_allRays hi b e hb
  simp only [starSubdivisionCone_def, Set.image_insert_eq, Set.image_singleton,
    starSubdivisionGenerator_none, starSubdivisionGenerator_some, hsum, ← hb]

/-- The chart cone spanned by the new ray and one of the original rays belongs
to the star subdivision of the fan of faces of a regular two-ray cone. -/
theorem starSubdivisionCone_pair_mem {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i) (e : Fin 2 ≃ ToricRay σ)
    (j : Fin 2) :
    let A := ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg
    starSubdivisionCone hi A hσ.toIsToricCone {none, some (e j)} ∈
      (Fan.starSubdivision hi A hσ).cones := by
  intro A
  refine (Fan.mem_starSubdivision_cones hi A hσ).mpr ⟨_, ⟨e j.rev, ?_, ?_⟩, rfl⟩
  · exact (ToricRay.mem_faceFinset _ _).2 (e j.rev).val.isFaceOf.le
  · have hne : j.rev ≠ j := by fin_cases j <;> decide
    simpa using e.injective.ne hne

/-- Every cone of the star subdivision of a regular two-ray cone lies in one of the
two charts spanned by the new ray and one of the original rays. -/
theorem exists_le_starSubdivisionCone_pair {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i) (e : Fin 2 ≃ ToricRay σ)
    {τ : PointedCone ℝ V}
    (hτ : τ ∈ (Fan.starSubdivision hi (ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg)
      hσ).cones) :
    let A := ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg
    ∃ j : Fin 2, τ ≤ starSubdivisionCone hi A hσ.toIsToricCone {none, some (e j)} := by
  intro A
  obtain ⟨S, ⟨ρ, -, hρ⟩, rfl⟩ := (Fan.mem_starSubdivision_cones hi A hσ).mp hτ
  obtain ⟨j, rfl⟩ := e.surjective ρ
  refine ⟨j.rev, starSubdivisionCone_mono hi A hσ.toIsToricCone ?_⟩
  intro x hx
  cases x with
  | none => simp
  | some ρ =>
    obtain ⟨k, rfl⟩ := e.surjective ρ
    rcases Fin.fin_two_eq_or_eq_rev j k with rfl | rfl
    · exact (hρ hx).elim
    · simp

end IsRegularCone

namespace Fan

open PointedCone

/-- The cone spanned by the sum of the two basis generators and one of those
generators belongs to the star subdivision along their cone. -/
theorem mem_starSubdivisionAlong_hull_sum_pair {Φ : Fan i} (hΦ : Φ.IsRegular)
    (σ : Φ.cones) (b : Module.Basis (Fin 2) ℤ N) (e : Fin 2 ≃ ToricRay σ.val)
    (hb : ∀ j, b j = primitiveGenerator Φ.lattice (Φ.isToricCone σ.property) (e j))
    (j : Fin 2) :
    hull ℝ {i (b 0 + b 1), i (b j)} ∈ (Φ.starSubdivisionAlong hΦ σ.property).cones := by
  let hσ := (isRegular_iff.1 hΦ) _ σ.property
  have hmem := hσ.starSubdivisionCone_pair_mem Φ.lattice e j
  dsimp only at hmem
  rw [hσ.starSubdivisionCone_pair_eq_hull Φ.lattice b e hb] at hmem
  exact (Φ.mem_starSubdivisionAlong_cones hΦ σ.property).mpr
    (.inr ⟨σ.val, σ.property, le_rfl, hmem⟩)

/-- A chart of the star subdivision of a two-dimensional basis cone has a basis
obtained by adding one basis vector to the other. -/
theorem exists_starSubdivisionAlong_basis (Φ : Fan i) (hΦ : Φ.IsRegular) {σ : PointedCone ℝ V}
    (hσ : σ ∈ Φ.cones) (b : Module.Basis (Fin 2) ℤ N)
    (hcone : σ = hull ℝ (Set.range (i ∘ b))) (j : Fin 2) :
    ∃ c : Module.Basis (Fin 2) ℤ N, c j = b j + b j.rev ∧ c j.rev = b j.rev ∧
      hull ℝ (Set.range (i ∘ c)) ∈ (Φ.starSubdivisionAlong hΦ hσ).cones := by
  classical
  have hne : j ≠ j.rev := by fin_cases j <;> decide
  have hj : b.coord j (b j.rev) = 0 := by simp [hne]
  let c := b.map (LinearEquiv.transvection hj)
  have hc : c j = b j + b j.rev := by simp [c, LinearMap.transvection.apply]
  have hc' : c j.rev = b j.rev := by
    simp [c, LinearMap.transvection.apply, hj]
  refine ⟨c, hc, hc', ?_⟩
  let hreg := isRegular_iff.mp hΦ _ hσ
  obtain ⟨r, hb'⟩ := hreg.exists_rayEquiv_of_basis Φ.lattice b hcone
  have hchart := mem_starSubdivisionAlong_hull_sum_pair hΦ ⟨σ, hσ⟩ b r hb' j.rev
  have hsum : b 0 + b 1 = c j := by
    rw [hc]
    fin_cases j <;> simp [add_comm]
  rw [hsum, ← hc'] at hchart
  suffices Set.range (i ∘ c) = {i (c j), i (c j.rev)} by
    rwa [this]
  ext x
  simp only [Set.mem_range, Function.comp_apply, Set.mem_insert_iff, Set.mem_singleton_iff]
  exact ⟨fun ⟨k, hk⟩ ↦ (Fin.fin_two_eq_or_eq_rev j k).elim
      (fun h ↦ Or.inl (h ▸ hk.symm)) (fun h ↦ Or.inr (h ▸ hk.symm)),
    fun h ↦ h.elim (fun h ↦ ⟨j, h.symm⟩) (fun h ↦ ⟨j.rev, h.symm⟩)⟩

end Fan

end TauCeti.Toric
