module

public import TauCeti.Geometry.Toric.Algebraic.Fan.StarSubdivision

/-!
# Two-dimensional regular cones

The two primitive generators of a full regular cone give an integral basis in
rank two. Such a cone is maximal in a regular fan containing it. These facts
apply to the affine blowup charts and to factorization of fan subdivisions.
-/

public section

namespace TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V}

namespace IsRegularCone

/-- The two primitive ray generators of a full regular cone form an integral basis. -/
theorem exists_basis_primitiveGenerators {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i) (hN : Module.finrank ℤ N = 2)
    (hc : Nat.card (ToricRay σ) = 2) :
    ∃ (e : Fin 2 ≃ ToricRay σ) (b : Module.Basis (Fin 2) ℤ N),
      ∀ j, b j = primitiveGenerator hi hσ.toIsToricCone (e j) := by
  have := ToricRay.finite_of_fg hσ.fg
  let := Fintype.ofFinite (ToricRay σ)
  let e := (Fintype.equivFinOfCardEq (Nat.card_eq_fintype_card.symm.trans hc)).symm
  obtain ⟨l, b₀, hb₀⟩ := hσ.exists_basis_sum
  have hl := Module.finrank_eq_nat_card_basis b₀
  rw [hN, Nat.card_sum, hc, Nat.card_fin] at hl
  have hl₀ : l = 0 := by omega
  subst l
  let q := (Equiv.sumEmpty (ToricRay σ) (Fin 0)).trans e.symm
  refine ⟨e, b₀.reindex q, fun j ↦ ?_⟩
  simpa [q] using (hb₀ (e j)).eq_primitiveGenerator hi hσ.toIsToricCone

/-- The cone hull of a basis of primitive ray generators is the original cone. -/
theorem hull_eq_of_basis_primitiveGenerators {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i)
    (b : Module.Basis (Fin 2) ℤ N) (e : Fin 2 ≃ ToricRay σ)
    (hb : ∀ j, b j = primitiveGenerator hi hσ.toIsToricCone (e j)) :
    PointedCone.hull ℝ (i '' Set.range b) = σ := by
  have he : (b : Fin 2 → N) = primitiveGenerator hi hσ.toIsToricCone ∘ e := funext hb
  rw [he, e.surjective.range_comp, hσ.toIsToricCone.hull_primitiveGenerator hi]

/-- The sum of the generators of a two-ray cone is the sum of the two basis vectors. -/
theorem sum_primitiveGenerator_allRays {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i)
    (b : Module.Basis (Fin 2) ℤ N) (e : Fin 2 ≃ ToricRay σ)
    (hb : ∀ j, b j = primitiveGenerator hi hσ.toIsToricCone (e j)) :
    ∑ ρ ∈ ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg,
      primitiveGenerator hi hσ.toIsToricCone ρ = b 0 + b 1 := by
  classical
  let := Fintype.ofEquiv _ e
  have hall :
      ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg = Finset.univ := by
    ext ρ
    simp [ToricRay.mem_faceFinset, ρ.val.isFaceOf.le]
  rw [hall, ← Equiv.sum_comp e, Fin.sum_univ_two, ← hb 0, ← hb 1]

/-- A chart cone of the star subdivision is generated by the new ray and one old ray. -/
theorem starSubdivisionCone_pair_eq_hull {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i)
    (b : Module.Basis (Fin 2) ℤ N) (e : Fin 2 ≃ ToricRay σ)
    (hb : ∀ j, b j = primitiveGenerator hi hσ.toIsToricCone (e j)) (j : Fin 2) :
    starSubdivisionCone hi (ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg)
        hσ.toIsToricCone {none, some (e j)} =
      PointedCone.hull ℝ {i (b 0 + b 1), i (b j)} := by
  have hsum := hσ.sum_primitiveGenerator_allRays hi b e hb
  simp only [starSubdivisionCone_def, Set.image_insert_eq, Set.image_singleton,
    starSubdivisionGenerator_none, starSubdivisionGenerator_some, hsum, ← hb]

/-- The chart cone spanned by the new ray and one of the original rays belongs
to the star subdivision of the fan of faces of a regular two-ray cone. -/
theorem starSubdivisionCone_pair_mem {σ : PointedCone ℝ V}
    (hσ : IsRegularCone i σ) (hi : IsIntegralLattice i) (e : Fin 2 ≃ ToricRay σ)
    (j : Fin 2) :
    let A := ToricRay.faceFinset (PointedCone.IsFaceOf.refl σ) hσ.fg
    starSubdivisionCone hi A hσ.toIsToricCone {none, some (e j)} ∈
      (Fan.starSubdivision hi A hσ).cones := by
  intro A
  refine (Fan.mem_starSubdivision_cones hi A hσ).mpr ⟨_, ⟨e j.rev, ?_, ?_⟩, rfl⟩
  · exact (ToricRay.mem_faceFinset _ _).2 (e j.rev).val.isFaceOf.le
  · have hne : j.rev ≠ j := by fin_cases j <;> decide
    simpa using e.injective.ne hne

end IsRegularCone

namespace Fan

variable {Φ : Fan i}

/-- A regular cone with two rays in a rank-two fan is maximal. -/
theorem eq_of_le_fullCone (hΦ : Φ.IsRegular) {σ τ : Φ.cones}
    (hN : Module.finrank ℤ N = 2) (hc : Nat.card (ToricRay σ.val) = 2) (h : σ ≤ τ) : σ = τ := by
  have hface := Φ.isFaceOf_of_le τ.property σ.property h
  have hτ := isRegular_iff.1 hΦ _ τ.property
  have := ToricRay.finite_of_fg (Φ.isToricCone σ.property).fg
  have := ToricRay.finite_of_fg hτ.fg
  let e := ToricRay.faceEmbedding hface
  let _ := Fintype.ofFinite (ToricRay σ.val)
  let _ := Fintype.ofFinite (ToricRay τ.val)
  have hcard : Fintype.card (ToricRay τ.val) ≤ Fintype.card (ToricRay σ.val) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hc, ← hN]
    exact hτ.card_toricRay_le_finrank
  have hsurj := ((Fintype.bijective_iff_injective_and_card e).2
    ⟨e.injective, le_antisymm (Fintype.card_le_of_injective e e.injective) hcard⟩).2
  apply Subtype.ext
  refine le_antisymm h ?_
  rw [← (Φ.isToricCone τ.property).hull_primitiveGenerator Φ.lattice]
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨_, ⟨r, rfl⟩, rfl⟩
  obtain ⟨s, rfl⟩ := hsurj r
  rw [primitiveGenerator_faceEmbedding]
  exact s.val.isFaceOf.le (primitiveGenerator_mem Φ.lattice (Φ.isToricCone σ.property) s)

/-- A cone with two rays is nonzero. -/
theorem ne_bot_of_card_toricRay_eq_two {σ : PointedCone ℝ V}
    (hc : Nat.card (ToricRay σ) = 2) : σ ≠ ⊥ := by
  intro h
  have hz : Nat.card (ToricRay (⊥ : PointedCone ℝ V)) = 0 := Nat.card_eq_zero.mpr
    (Or.inl inferInstance)
  rw [h, hz] at hc
  omega

end Fan

end TauCeti.Toric
