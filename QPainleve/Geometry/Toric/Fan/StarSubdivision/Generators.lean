module

public import QPainleve.Geometry.Toric.Cone.TwoDimensional
public import QPainleve.Geometry.Toric.Fan.ProjectiveSpace.Ray
public import QPainleve.Geometry.Toric.Fan.Ray
public import TauCeti.Geometry.Toric.Algebraic.Fan.StarSubdivision

import QPainleve.Geometry.Toric.Cone.Coordinates
import QPainleve.Geometry.Toric.Fan.StarSubdivision.TwoDimensional
import QPainleve.Geometry.Toric.Fan.TwoDimensional
import Mathlib.LinearAlgebra.Transvection.Basic

/-!
# Primitive generators of a star subdivision

A star subdivision retains every old ray. A ray whose least cone contains the
subdivision center must be the ray through the sum of the center's generators.
For a maximal cone of the projective plane, the resulting rays give the Hirzebruch-one fan.
-/

public section

open Module PointedCone

namespace TauCeti.Toric.Fan

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ : Fan i}

/-- The new ray of a star subdivision along a rank-two basis cone has primitive
generator equal to the sum of the basis vectors. -/
theorem primitiveGenerator_starSubdivisionAlongRay_of_basis (hΦ : Φ.IsRegular)
    (σ : Φ.cones) (b : Module.Basis (Fin 2) ℤ N)
    (hσ : σ.val = PointedCone.hull ℝ (Set.range (i ∘ b))) (hne : σ.val ≠ ⊥) :
    (Φ.starSubdivisionAlongRay hΦ σ.property hne).primitiveGenerator = b 0 + b 1 := by
  let hreg := isRegular_iff.mp hΦ _ σ.property
  obtain ⟨e, he⟩ := hreg.exists_rayEquiv_of_basis Φ.lattice b hσ
  obtain ⟨d, hd, -, -⟩ := Φ.exists_starSubdivisionAlong_basis hΦ σ.property b hσ 0
  apply Ray.primitiveGenerator_eq_of_mem_of_isPrimitive _ _ (hd ▸ d.isPrimitive 0)
  rw [coe_toCone_starSubdivisionAlongRay, hreg.sum_primitiveGenerator_allRays Φ.lattice b e he]
  exact PointedCone.subset_hull (Set.mem_singleton _)

/-- The rays of a star subdivision have the old primitive generators and the primitive
generator of the inserted ray. This also applies to subdivision along a ray, when the
inserted generator already belongs to the original range. -/
theorem range_primitiveGenerator_starSubdivisionAlong (hΦ : Φ.IsRegular) (σ : Φ.cones)
    (hσ : σ.val ≠ ⊥) :
    Set.range (Ray.primitiveGenerator (Phi := Φ.starSubdivisionAlong hΦ σ.property)) =
      insert (Φ.starSubdivisionAlongRay hΦ σ.property hσ).primitiveGenerator
        (Set.range (Ray.primitiveGenerator (Phi := Φ))) := by
  let r := Φ.starSubdivisionAlongRay hΦ σ.property hσ
  let h := Φ.starSubdivisionAlong_isSubdivision hΦ σ.property hσ
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨s, rfl⟩
    by_cases hs : s = r
    · exact Set.mem_insert_iff.mpr (Or.inl (congrArg Ray.primitiveGenerator hs))
    have hle : ¬ r.toCone ≤ s.toCone := by
      intro hle
      exact hs (Ray.primitiveGenerator_injective
        (r.primitiveGenerator_eq_of_toCone_le_hull s.toCone_eq_hull_primitiveGenerator
          s.isPrimitiveGenerator.isPrimitive hle).symm)
    have hleast := mt
      (Φ.starSubdivisionAlongRay_le_iff_le_leastCone hΦ σ.property hσ s.toCone).mpr hle
    have hsΦ := ((Φ.not_le_leastCone_starSubdivisionAlong_iff hΦ σ.property hσ
      s.toCone.property).mp hleast).1
    let t : Φ.Ray := ⟨⟨s.toCone.val, hsΦ⟩, s.property⟩
    exact Set.mem_insert_of_mem _ ⟨t,
      t.primitiveGenerator_eq_of_mem_of_isPrimitive s.primitiveGenerator_mem
        s.isPrimitiveGenerator.isPrimitive⟩
  · intro _ hx
    rcases Set.mem_insert_iff.mp hx with rfl | ⟨t, rfl⟩
    · exact Set.mem_range_self r
    · exact ⟨h.liftRay t, h.primitiveGenerator_liftRay t⟩

local notation "plane[" d "]" => projectiveSpace d Φ.lattice
local notation "reg[" d "]" => isRegular_projectiveSpace d Φ.lattice
local notation "centerCone[" d "]" => projectiveSpaceMaximalCone d Φ.lattice none
local notation "starPlane[" d "]" =>
  Fan.starSubdivisionAlong plane[d] reg[d] (Subtype.property centerCone[d])
local notation "newRay[" d "," h "]" =>
  Fan.starSubdivisionAlongRay plane[d] reg[d] (Subtype.property centerCone[d])
    (ne_bot_of_card_toricRay_eq_two h)

/-- A complete regular fan with the rays of `𝔽₁` is the star subdivision of the
plane fan at the cone generated by `b 0 - b 1` and `b 1`. The new ray is generated
by `b 0`, the ray of the negative section. -/
theorem exists_eq_starSubdivision_projectivePlane_of_hirzebruchOne
    (b : Basis (Fin 2) ℤ N) (hΦ : Φ.IsRegular) (hc : Φ.IsComplete)
    (hrays : Set.range (Fan.Ray.primitiveGenerator (Phi := Φ)) =
      {b 0, b 1, -b 0, b 0 - b 1}) :
    ∃ (d : Basis (Fin 2) ℤ N) (hσ : Nat.card (ToricRay (centerCone[d]).val) = 2),
      d 0 = b 0 - b 1 ∧ d 1 = b 1 ∧ Φ = starPlane[d] ∧ newRay[d, hσ].primitiveGenerator = b 0 := by
  have hzero : (-(b.coord 0)) (b 1) = 0 := by simp
  let d := b.map (LinearEquiv.transvection hzero)
  have hd₀ : d 0 = b 0 - b 1 := by
    simp [d, LinearMap.transvection.apply, sub_eq_add_neg]
  have hd₁ : d 1 = b 1 := by simp [d, LinearMap.transvection.apply, hzero]
  have hsum : d 0 + d 1 = b 0 := by rw [hd₀, hd₁, sub_add_cancel]
  have hcone : (centerCone[d]).val = hull ℝ (Set.range (i ∘ d)) :=
    projectiveSpaceCone_compl_none (i := i) d
  have hcard := card_toricRay_projectiveSpaceMaximalCone d Φ.lattice none
  have hnew : newRay[d, hcard].primitiveGenerator = b 0 :=
    (primitiveGenerator_starSubdivisionAlongRay_of_basis reg[d] (centerCone[d]) d hcone _).trans
      hsum
  refine ⟨d, hcard, hd₀, hd₁, ?_, hnew⟩
  let hs := (plane[d]).starSubdivisionAlong_isSubdivision reg[d] (centerCone[d]).property
    (ne_bot_of_card_toricRay_eq_two hcard)
  apply eq_of_range_primitiveGenerator_eq b hΦ
    ((plane[d]).isRegular_starSubdivisionAlong reg[d] (centerCone[d]).property) hc
    (hs.isComplete_iff.mpr (isComplete_projectiveSpace d Φ.lattice))
  rw [range_primitiveGenerator_starSubdivisionAlong reg[d] (centerCone[d])
      (ne_bot_of_card_toricRay_eq_two hcard),
    hnew, range_primitiveGenerator_projectivePlane, hrays, hd₀, hd₁]
  have hlast : -(b 0 - b 1) - b 1 = -b 0 := by abel
  rw [hlast]
  ext x
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  grind

/-- Subdivision at a maximal plane cone gives the Hirzebruch-one ray generators.
The inserted ray is opposite the ray omitted by the center cone. -/
theorem projectivePlane_vertex_starSubdivision_rays
    (d : Basis (Fin 2) ℤ N) (hi : IsIntegralLattice i) (k : Option (Fin 2)) :
    let Ψ := projectiveSpace d hi
    let hΨ := isRegular_projectiveSpace d hi
    let σ := projectiveSpaceMaximalCone d hi k
    let Γ := Ψ.starSubdivisionAlong hΨ σ.property
    ∃ (hσ : Nat.card (ToricRay σ.val) = 2) (b : Basis (Fin 2) ℤ N),
      (Ψ.starSubdivisionAlongRay hΨ σ.property
        (ne_bot_of_card_toricRay_eq_two hσ)).primitiveGenerator = b 0 ∧
      Set.range (Ray.primitiveGenerator (Phi := Γ)) = {b 0, b 1, -b 0, b 0 - b 1} ∧
      b 0 = -projectiveSpaceGenerator d k := by
  intro Ψ hΨ σ Γ
  obtain ⟨c, hc, hrays, hk⟩ := projectivePlane_vertex_rays d hi k
  have hσ : Nat.card (ToricRay σ.val) = 2 := card_toricRay_projectiveSpaceMaximalCone d hi k
  have hzero : c.coord 0 (c 1) = 0 := by simp
  let b := c.map (LinearEquiv.transvection hzero)
  have hb₀ : b 0 = c 0 + c 1 := by
    simp [b, LinearMap.transvection.apply, Basis.coord_apply]
  have hb₁ : b 1 = c 1 := by simp [b, LinearMap.transvection.apply, hzero]
  have hnew : (Ψ.starSubdivisionAlongRay hΨ σ.property
      (ne_bot_of_card_toricRay_eq_two hσ)).primitiveGenerator = b 0 :=
    (primitiveGenerator_starSubdivisionAlongRay_of_basis hΨ σ c hc _).trans hb₀.symm
  refine ⟨hσ, b, hnew, ?_, by rw [hb₀, hk]; abel⟩
  rw [range_primitiveGenerator_starSubdivisionAlong hΨ σ (ne_bot_of_card_toricRay_eq_two hσ),
    hnew, range_primitiveGenerator_projectiveSpace d hi, hrays, hb₀, hb₁]
  have hneg : -(c 0 + c 1) = -c 0 - c 1 := by abel
  have hsub : c 0 + c 1 - c 1 = c 0 := add_sub_cancel_right _ _
  rw [hneg, hsub]
  ext x
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  tauto

end TauCeti.Toric.Fan
