module

public import QPainleve.Geometry.Toric.Fan.Ray

import QPainleve.Geometry.Toric.Cone.Coordinates
import QPainleve.Geometry.Toric.Fan.StarSubdivision.TwoDimensional
import TauCeti.Data.Fin.Rev

/-!
# Inserting rays in regular surface fans

A ray generated by a lattice point in the support of a regular surface fan can be
inserted by repeatedly subdividing the two-dimensional cone containing it. In the
basis of that cone the sum of the two nonnegative coordinates decreases under a
subtractive Euclidean step.

The two-dimensional star subdivision is described in Cox, Little, and Schenck,
*Toric Varieties*, §10.4.
-/

public section

open PointedCone

namespace TauCeti.Toric.Fan

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ Ψ : Fan i}

private theorem exists_regular_subdivision_of_basis_coords {u : N} (hu : u ≠ 0)
    (hΦ : Φ.IsRegular) (b : Module.Basis (Fin 2) ℤ N)
    (hcone : hull ℝ (Set.range (i ∘ b)) ∈ Φ.cones)
    (a : Fin 2 → ℕ) (ha : ∑ j, a j • b j = u) :
    ∃ Ψ : Fan i, Ψ.IsSubdivision Φ ∧ Ψ.IsRegular ∧ hull ℝ {i u} ∈ Ψ.cones := by
  classical
  generalize hm : (∑ j, a j) = m
  induction m using Nat.strong_induction_on generalizing Φ b a with
  | ind m ih =>
    obtain ⟨j, hj⟩ : ∃ j : Fin 2, a j ≤ a j.rev := by
      rcases le_total (a 0) (a 1) with h | h
      · exact ⟨0, h⟩
      · exact ⟨1, h⟩
    have hne : j ≠ j.rev := by fin_cases j <;> decide
    have huniv : (Finset.univ : Finset (Fin 2)) = {j, j.rev} := by
      ext k
      simpa using Fin.fin_two_eq_or_eq_rev j k
    rw [huniv, Finset.sum_pair hne] at hm ha
    by_cases hz : a j = 0
    · have hp : 0 < a j.rev := by
        by_contra! h
        exact hu (by simpa [hz, Nat.eq_zero_of_le_zero h] using ha.symm)
      refine ⟨Φ, IsSubdivision.refl Φ, hΦ, ?_⟩
      rw [hz, zero_smul, zero_add] at ha
      rw [← ha]
      exact hull_nsmul_mem_cones (Φ.hull_basis_ray_mem b hcone j.rev) hp
    let Φ' := Φ.starSubdivisionAlong hΦ hcone
    have hcone_ne : hull ℝ (Set.range (i ∘ b)) ≠ ⊥ := by
      intro he
      have hx : i (b j) ∈ hull ℝ (Set.range (i ∘ b)) :=
        subset_hull (Set.mem_range_self (f := i ∘ b) j)
      rw [he] at hx
      have hzero : i (b j) = 0 := by simpa only [Submodule.mem_bot] using hx
      exact b.ne_zero j (Φ.lattice.injective (hzero.trans i.map_zero.symm))
    have hsub := Φ.starSubdivisionAlong_isSubdivision hΦ hcone hcone_ne
    obtain ⟨c, hc, hc', hnew⟩ := Φ.exists_starSubdivisionAlong_basis hΦ hcone b rfl j
    let a' : Fin 2 → ℕ := Function.update a j.rev (a j.rev - a j)
    have haj : a' j = a j := by simp [a', hne]
    have haj' : a' j.rev = a j.rev - a j := Function.update_self _ _ _
    have hrep : ∑ k, a' k • c k = u := by
      rw [huniv, Finset.sum_pair hne, haj, haj', hc, hc', smul_add, add_assoc, ← add_smul,
        Nat.add_sub_of_le hj, ha]
    have hlt : (∑ k, a' k) < m := by
      rw [huniv, Finset.sum_pair hne, haj, haj', Nat.add_sub_of_le hj]
      omega
    obtain ⟨Ψ, hΨ, hreg, hray⟩ := ih _ hlt (Φ := Φ')
      (Φ.isRegular_starSubdivisionAlong hΦ hcone) c hnew a' hrep rfl
    exact ⟨Ψ, hΨ.trans hsub, hreg, hray⟩

/-- A regular rank-two fan admits a regular subdivision containing the ray of any
nonzero lattice point in its support. The support of the fan is preserved. -/
theorem exists_regular_subdivision_containing_ray (Φ : Fan i) (hΦ : Φ.IsRegular)
    (hN : Module.finrank ℤ N = 2) {u : N} (hu : u ≠ 0) (hs : i u ∈ Φ.support) :
    ∃ Ψ : Fan i, Ψ.IsSubdivision Φ ∧ Ψ.IsRegular ∧ hull ℝ {i u} ∈ Ψ.cones := by
  classical
  obtain ⟨σ, hσ, huσ⟩ := Φ.mem_support.mp hs
  have hreg := isRegular_iff.mp hΦ _ hσ
  obtain ⟨b, r, hb⟩ := hN ▸ hreg.exists_basis_finrank
  have hm := (hb.mem_iff_lattice_basis_repr Φ.lattice hreg.toIsToricCone u).mp huσ
  let a (j : Fin 2) := (b.repr u j).toNat
  have ha : ∑ j, a j • b j = u := by
    simpa only [a, ← natCast_zsmul, Int.toNat_of_nonneg (hm _).1] using b.sum_repr u
  by_cases hr : Function.Surjective r
  · let e := Equiv.ofBijective r ⟨r.injective, hr⟩
    have he (j : Fin 2) : b j = primitiveGenerator Φ.lattice hreg.toIsToricCone (e.symm j) := by
      have hj : r (e.symm j) = j := e.apply_symm_apply j
      simpa only [hj] using (hb.isPrimitiveGenerator_apply (e.symm j)).eq_primitiveGenerator
        Φ.lattice hreg.toIsToricCone
    have hcone := hreg.hull_eq_of_basis_primitiveGenerators Φ.lattice b e.symm he
    rw [← Set.range_comp] at hcone
    exact exists_regular_subdivision_of_basis_coords hu hΦ b (hcone ▸ hσ) a ha
  · obtain ⟨j, hj⟩ : ∃ j, j ∉ Set.range r := by
      exact not_forall.mp hr
    have hja : a j = 0 := by simp [a, (hm j).2 hj]
    have hsum : ∑ k, a k • b k = a j • b j + a j.rev • b j.rev := by
      fin_cases j <;> simp [Fin.sum_univ_two, add_comm]
    rw [hsum, hja, zero_smul, zero_add] at ha
    have hpos' : 0 < a j.rev := by
      by_contra! h
      exact hu (by simpa [Nat.eq_zero_of_le_zero h] using ha.symm)
    have hj' : j.rev ∈ Set.range r := by
      by_contra h
      simp [a, (hm _).2 h] at hpos'
    refine ⟨Φ, IsSubdivision.refl Φ, hΦ, ?_⟩
    rw [← ha]
    exact hull_nsmul_mem_cones (Φ.hull_basisVector_mem hσ b r hb hj') hpos'

/-- Finitely many specified lattice rays in the support of a regular rank-two fan
can be included in a single regular subdivision. -/
theorem exists_regular_subdivision_containing_rays (Φ : Fan i) (hΦ : Φ.IsRegular)
    (hN : Module.finrank ℤ N = 2) {S : Set N} (hS : S.Finite)
    (hs : ∀ u ∈ S, u ≠ 0 ∧ i u ∈ Φ.support) :
    ∃ Ψ : Fan i, Ψ.IsSubdivision Φ ∧ Ψ.IsRegular ∧ ∀ u ∈ S, hull ℝ {i u} ∈ Ψ.cones := by
  induction S, hS using Set.Finite.induction_on_subset with
  | empty => exact ⟨Φ, IsSubdivision.refl Φ, hΦ, by simp⟩
  | insert _ _ _ ih =>
    obtain ⟨Ψ, hΨ, hreg, hrays⟩ := ih (fun v hv ↦ hs v (Set.mem_insert_of_mem _ hv))
    obtain ⟨Ω, hΩ, hΩreg, hnew⟩ := Ψ.exists_regular_subdivision_containing_ray hreg hN
      (hs _ (Set.mem_insert _ _)).1 (hΨ.support_eq.symm ▸ (hs _ (Set.mem_insert _ _)).2)
    refine ⟨Ω, hΩ.trans hΨ, hΩreg, fun v hv ↦ ?_⟩
    rcases Set.mem_insert_iff.mp hv with rfl | hv
    · exact hnew
    · exact hΩ.ray_mem ⟨⟨_, hrays _ hv⟩, finrank_span_coe_hull_singleton
        (map_ne_zero_iff i Ψ.lattice.injective |>.mpr (hs _ (Set.mem_insert_of_mem _ hv)).1)⟩

/-- A complete regular surface fan has a complete regular subdivision containing
the ray opposite a specified ray. The specified ray survives in the subdivision. -/
theorem Ray.exists_regular_subdivision_containing_opposite (ρ : Φ.Ray)
    (hΦ : Φ.IsRegular) (hc : Φ.IsComplete) (hN : Module.finrank ℤ N = 2) :
    ∃ (Ψ : Fan i) (h : Ψ.IsSubdivision Φ), Ψ.IsRegular ∧ Ψ.IsComplete ∧
      hull ℝ {i (-(h.liftRay ρ).primitiveGenerator)} ∈ Ψ.cones := by
  obtain ⟨Ψ, h, hreg, hopp⟩ := Φ.exists_regular_subdivision_containing_ray hΦ hN
    (neg_ne_zero.mpr ρ.primitiveGenerator_ne_zero) (Φ.mem_support.mpr (Φ.isComplete_iff.mp hc _))
  exact ⟨Ψ, h, hreg, h.isComplete_iff.mpr hc,
    by simpa only [h.primitiveGenerator_liftRay] using hopp⟩

end TauCeti.Toric.Fan
