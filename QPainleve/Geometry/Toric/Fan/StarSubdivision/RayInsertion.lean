/-!
# Inserting rays and constructing regular common subdivisions

A ray generated by a lattice point in the support of a regular surface fan can be
inserted by repeatedly subdividing the two-dimensional cone containing it. In the
basis of that cone the sum of the two nonnegative coordinates decreases under a
subtractive Euclidean step. For a common subdivision, insert the two directions
of the coordinate lines of every cone of the second fan whenever they are in the
common support. The resulting cones each lie in a single cone of the second fan.

The two-dimensional star subdivision is described in Cox, Little, and Schenck,
*Toric Varieties*, §10.4.
-/

public section

open PointedCone

namespace TauCeti.Toric.Fan

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ Ψ : Fan i}

private theorem hull_extendingBasis (hσ : IsToricCone i σ)
    (b : Module.Basis (Fin 2) ℤ N) (r : ToricRay σ ↪ Fin 2)
    (hb : IsExtendingBasis i b r) (hi : IsIntegralLattice i) :
    hull ℝ ((i ∘ b) '' Set.range r) = σ := by
  have hgen : (i ∘ b) ∘ r = i ∘ primitiveGenerator hi hσ := by
    funext j
    exact congrArg i ((hb.isPrimitiveGenerator_apply j).eq_primitiveGenerator hi hσ)
  rw [← Set.range_comp, hgen, Set.range_comp, hσ.hull_primitiveGenerator hi]

-- The coordinates outside the rays vanish, including for cones of dimension at most one.
private theorem mem_extendingBasis_cone (hσ : IsToricCone i σ)
    (b : Module.Basis (Fin 2) ℤ N) (r : ToricRay σ ↪ Fin 2)
    (hb : IsExtendingBasis i b r) (hi : IsIntegralLattice i) (x : V) :
    x ∈ σ ↔ (∀ j, 0 ≤ (hi.isBaseChange.basis b).repr x j) ∧
      ∀ j ∉ Set.range r, (hi.isBaseChange.basis b).repr x j = 0 := by
  let c := hi.isBaseChange.basis b
  have hc : (c : Fin 2 → V) = i ∘ b := funext (IsBaseChange.basis_apply b hi.isBaseChange)
  have hcone : hull ℝ (c '' Set.range r) = σ :=
    hc.symm ▸ hull_extendingBasis hσ b r hb hi
  conv_lhs => rw [← hcone, mem_hull_image_iff_linearCombination]
  constructor
  · rintro ⟨a, ha, ha₀, rfl⟩
    have hrep : (hi.isBaseChange.basis b).repr (Finsupp.linearCombination ℝ c a) = a :=
      c.repr_linearCombination a
    rw [hrep]
    exact ⟨ha₀, (Finsupp.mem_supported' ℝ a).mp ha⟩
  · rintro ⟨h₀, hzero⟩
    exact ⟨c.repr x, (Finsupp.mem_supported' ℝ _).mpr hzero, h₀, c.linearCombination_repr x⟩

private theorem hull_basisVector_mem (hσ : σ ∈ Φ.cones) (b : Module.Basis (Fin 2) ℤ N)
    (r : ToricRay σ ↪ Fin 2) (hb : IsExtendingBasis i b r) {j : Fin 2}
    (hj : j ∈ Set.range r) : hull ℝ {i (b j)} ∈ Φ.cones := by
  obtain ⟨ρ, rfl⟩ := hj
  have h := hb.isPrimitiveGenerator_apply ρ
  rw [← ρ.eq_hull_singleton ((Φ.isToricCone hσ).salient.anti ρ.val.isFaceOf.le)
    h.mem (map_ne_zero_iff _ Φ.lattice.injective |>.mpr h.ne_zero)]
  exact Φ.mem_of_isFaceOf hσ ρ.val.isFaceOf

private theorem exists_starSubdivisionAlong_basis (hΦ : Φ.IsRegular) {σ : PointedCone ℝ V}
    (hσ : σ ∈ Φ.cones) (b : Module.Basis (Fin 2) ℤ N)
    (hcone : σ = hull ℝ (Set.range (i ∘ b))) (j : Fin 2) :
    ∃ c : Module.Basis (Fin 2) ℤ N, c j = b j + b j.rev ∧ c j.rev = b j.rev ∧
      hull ℝ (Set.range (i ∘ c)) ∈ (Φ.starSubdivisionAlong hΦ hσ).cones := by
  classical
  have hne : j ≠ j.rev := by fin_cases j <;> decide
  have hj : b.coord j (b j.rev) = 0 := by simp [hne]
  let c := b.map (LinearEquiv.transvection hj)
  have hc : c j = b j + b j.rev := by simp [c, LinearMap.transvection.apply]
  have hc' : c j.rev = b j.rev := by
    simp [c, LinearMap.transvection.apply, hj]
  refine ⟨c, hc, hc', ?_⟩
  apply (Φ.mem_starSubdivisionAlong_cones hΦ hσ).mpr
  refine Or.inr ⟨σ, hσ, le_rfl, ?_⟩
  let hface := Φ.isFaceOf_of_le hσ hσ le_rfl
  let A := ToricRay.faceFinset hface (Φ.isToricCone hσ).fg
  let hreg := isRegular_iff.mp hΦ _ hσ
  have hli := Φ.lattice.linearIndependent_basis b
  let r := toricRayEquivOfLinearIndependent (i ∘ b) hli hcone
  let _ : Fintype (ToricRay σ) := Fintype.ofEquiv _ r.symm
  have hall : A = Finset.univ := by
    ext ρ
    simp [A, ToricRay.mem_faceFinset, ρ.val.isFaceOf.le]
  have hb' (k : Fin 2) : primitiveGenerator Φ.lattice hreg.toIsToricCone (r.symm k) = b k := by
    have hm := (apply_mem_iff_toricRayEquivOfLinearIndependent _ hli hcone (r.symm k) k).mpr
      (r.apply_symm_apply k).symm
    exact (isPrimitiveGenerator_iff.mpr ⟨hm, b.isPrimitive k⟩).eq_primitiveGenerator
      Φ.lattice hreg.toIsToricCone |>.symm
  have hsum : ∑ ρ ∈ A, primitiveGenerator Φ.lattice hreg.toIsToricCone ρ = b j + b j.rev := by
    rw [hall, ← Equiv.sum_comp r.symm, Fin.sum_univ_two, hb', hb']
    fin_cases j <;> simp [add_comm]
  refine (mem_starSubdivision_cones Φ.lattice A hreg).mpr
    ⟨{none, some (r.symm j.rev)}, ⟨r.symm j, by simp [hall], by simp [hne]⟩, ?_⟩
  simp only [starSubdivisionCone_def, Set.image_insert_eq, Set.image_singleton,
    starSubdivisionGenerator_none, starSubdivisionGenerator_some, hsum.trans hc.symm,
    (hb' j.rev).trans hc'.symm]
  congr 1
  ext x
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_range, Function.comp_apply]
  exact ⟨fun h ↦ h.elim (fun h ↦ ⟨j, h.symm⟩) (fun h ↦ ⟨j.rev, h.symm⟩),
    fun ⟨k, hk⟩ ↦ (Fin.fin_two_eq_or_eq_rev j k).elim
      (fun h ↦ Or.inl (h ▸ hk.symm)) (fun h ↦ Or.inr (h ▸ hk.symm))⟩

private theorem hull_nsmul_mem_cones {u : N} (h : hull ℝ {i u} ∈ Φ.cones)
    {a : ℕ} (ha : 0 < a) : hull ℝ {i (a • u)} ∈ Φ.cones := by
  have ha' : (0 : ℝ) < a := by exact_mod_cast ha
  rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℝ]
  have he : hull ℝ {(a : ℝ) • i u} = hull ℝ {i u} := by
    apply le_antisymm <;> rw [Submodule.span_singleton_le_iff_mem]
    · exact (smul_mem_iff _ ha').mpr (subset_hull rfl)
    · exact (smul_mem_iff _ ha').mp (subset_hull rfl)
  rwa [he]

private theorem hull_basis_ray_mem (b : Module.Basis (Fin 2) ℤ N)
    (hcone : hull ℝ (Set.range (i ∘ b)) ∈ Φ.cones) (j : Fin 2) :
    hull ℝ {i (b j)} ∈ Φ.cones := by
  apply Φ.mem_of_isFaceOf hcone
  simpa only [Set.image_singleton, Function.comp_def] using
    isFaceOf_hull_image (Φ.lattice.linearIndependent_basis b) rfl {j}

private theorem exists_regular_subdivision_of_basis_coords {u : N} (hu : u ≠ 0)
    (hΦ : Φ.IsRegular) (b : Module.Basis (Fin 2) ℤ N)
    (hcone : hull ℝ (Set.range (i ∘ b)) ∈ Φ.cones)
    (a : Fin 2 → ℕ) (ha : ∑ j, a j • b j = u) :
    ∃ Ψ : Fan i, Ψ.IsSubdivision Φ ∧ Ψ.IsRegular ∧ hull ℝ {i u} ∈ Ψ.cones := by
  classical
  generalize hm : (∑ j, a j) = m
  induction m using Nat.strong_induction_on generalizing Φ b a with
  | ind m ih =>
    obtain ⟨j, hj⟩ : ∃ j : Fin 2, a j ≤ a j.rev := by
      rcases le_total (a 0) (a 1) with h | h
      · exact ⟨0, h⟩
      · exact ⟨1, h⟩
    have hne : j ≠ j.rev := by fin_cases j <;> decide
    have huniv : (Finset.univ : Finset (Fin 2)) = {j, j.rev} := by
      ext k
      simpa using Fin.fin_two_eq_or_eq_rev j k
    rw [huniv, Finset.sum_pair hne] at hm ha
    by_cases hz : a j = 0
    · have hp : 0 < a j.rev := by
        by_contra! h
        exact hu (by simpa [hz, Nat.eq_zero_of_le_zero h] using ha.symm)
      refine ⟨Φ, IsSubdivision.refl Φ, hΦ, ?_⟩
      rw [hz, zero_smul, zero_add] at ha
      rw [← ha]
      exact hull_nsmul_mem_cones (hull_basis_ray_mem b hcone j.rev) hp
    let Φ' := Φ.starSubdivisionAlong hΦ hcone
    have hcone_ne : hull ℝ (Set.range (i ∘ b)) ≠ ⊥ := by
      intro he
      have hx : i (b j) ∈ hull ℝ (Set.range (i ∘ b)) :=
        subset_hull (Set.mem_range_self (f := i ∘ b) j)
      rw [he] at hx
      have hzero : i (b j) = 0 := by simpa only [Submodule.mem_bot] using hx
      exact b.ne_zero j (Φ.lattice.injective (hzero.trans i.map_zero.symm))
    have hsub := Φ.starSubdivisionAlong_isSubdivision hΦ hcone hcone_ne
    obtain ⟨c, hc, hc', hnew⟩ := exists_starSubdivisionAlong_basis hΦ hcone b rfl j
    let a' : Fin 2 → ℕ := Function.update a j.rev (a j.rev - a j)
    have haj : a' j = a j := by simp [a', hne]
    have haj' : a' j.rev = a j.rev - a j := Function.update_self _ _ _
    have hrep : ∑ k, a' k • c k = u := by
      rw [huniv, Finset.sum_pair hne, haj, haj', hc, hc', smul_add, add_assoc, ← add_smul,
        Nat.add_sub_of_le hj, ha]
    have hlt : (∑ k, a' k) < m := by
      rw [huniv, Finset.sum_pair hne, haj, haj', Nat.add_sub_of_le hj]
      omega
    obtain ⟨Ψ, hΨ, hreg, hray⟩ := ih _ hlt (Φ := Φ')
      (Φ.isRegular_starSubdivisionAlong hΦ hcone) c hnew a' hrep rfl
    exact ⟨Ψ, hΨ.trans hsub, hreg, hray⟩

/-- A regular rank-two fan admits a regular subdivision containing the ray of any
nonzero lattice point in its support. The support of the fan is preserved. -/
theorem exists_regular_subdivision_containing_ray (Φ : Fan i) (hΦ : Φ.IsRegular)
    (hN : Module.finrank ℤ N = 2) {u : N} (hu : u ≠ 0) (hs : i u ∈ Φ.support) :
    ∃ Ψ : Fan i, Ψ.IsSubdivision Φ ∧ Ψ.IsRegular ∧ hull ℝ {i u} ∈ Ψ.cones := by
  classical
  obtain ⟨σ, hσ, huσ⟩ := Φ.mem_support.mp hs
  obtain ⟨b, r, hb⟩ := hN ▸ (isRegular_iff.mp hΦ _ hσ).exists_basis_finrank
  have hm := (mem_extendingBasis_cone (Φ.isToricCone hσ) b r hb Φ.lattice (i u)).mp huσ
  have hrepr j : (Φ.lattice.isBaseChange.basis b).repr (i u) j = (b.repr u j : ℝ) := by
    simpa only [algebraMap_int_eq, Int.coe_castRingHom, AddMonoidHom.coe_toIntLinearMap] using
      IsBaseChange.basis_repr_comp_apply b Φ.lattice.isBaseChange u j
  have hpos j : 0 ≤ b.repr u j := by
    have h := hm.1 j
    rw [hrepr] at h
    exact_mod_cast h
  have hzero j (hj : j ∉ Set.range r) : b.repr u j = 0 := by
    have h := hm.2 j hj
    rw [hrepr] at h
    exact_mod_cast h
  let a (j : Fin 2) := (b.repr u j).toNat
  have ha : ∑ j, a j • b j = u := by
    simpa only [a, ← natCast_zsmul, Int.toNat_of_nonneg (hpos _)] using b.sum_repr u
  by_cases hr : Function.Surjective r
  · have hcone := hull_extendingBasis (Φ.isToricCone hσ) b r hb Φ.lattice
    rw [Set.range_eq_univ.mpr hr, Set.image_univ] at hcone
    exact exists_regular_subdivision_of_basis_coords hu hΦ b (hcone ▸ hσ) a ha
  · obtain ⟨j, hj⟩ : ∃ j, j ∉ Set.range r := by
      exact not_forall.mp hr
    have hja : a j = 0 := by simp [a, hzero j hj]
    have hsum : ∑ k, a k • b k = a j • b j + a j.rev • b j.rev := by
      fin_cases j <;> simp [Fin.sum_univ_two, add_comm]
    rw [hsum, hja, zero_smul, zero_add] at ha
    have hpos' : 0 < a j.rev := by
      by_contra! h
      exact hu (by simpa [Nat.eq_zero_of_le_zero h] using ha.symm)
    have hj' : j.rev ∈ Set.range r := by
      by_contra h
      simp [a, hzero _ h] at hpos'
    refine ⟨Φ, IsSubdivision.refl Φ, hΦ, ?_⟩
    rw [← ha]
    exact hull_nsmul_mem_cones (hull_basisVector_mem hσ b r hb hj') hpos'

/-- Finitely many specified lattice rays in the support of a regular rank-two fan
can be included in a single regular subdivision. -/
theorem exists_regular_subdivision_containing_rays (Φ : Fan i) (hΦ : Φ.IsRegular)
    (hN : Module.finrank ℤ N = 2) {S : Set N} (hS : S.Finite)
    (hs : ∀ u ∈ S, u ≠ 0 ∧ i u ∈ Φ.support) :
    ∃ Ψ : Fan i, Ψ.IsSubdivision Φ ∧ Ψ.IsRegular ∧ ∀ u ∈ S, hull ℝ {i u} ∈ Ψ.cones := by
  induction S, hS using Set.Finite.induction_on_subset with
  | empty => exact ⟨Φ, IsSubdivision.refl Φ, hΦ, by simp⟩
  | insert _ _ _ ih =>
    obtain ⟨Ψ, hΨ, hreg, hrays⟩ := ih (fun v hv ↦ hs v (Set.mem_insert_of_mem _ hv))
    obtain ⟨Ω, hΩ, hΩreg, hnew⟩ := Ψ.exists_regular_subdivision_containing_ray hreg hN
      (hs _ (Set.mem_insert _ _)).1 (hΨ.support_eq.symm ▸ (hs _ (Set.mem_insert _ _)).2)
    refine ⟨Ω, hΩ.trans hΨ, hΩreg, fun v hv ↦ ?_⟩
    rcases Set.mem_insert_iff.mp hv with rfl | hv
    · exact hnew
    · exact hΩ.ray_mem ⟨⟨_, hrays _ hv⟩, finrank_span_coe_hull_singleton
        (map_ne_zero_iff i Ψ.lattice.injective |>.mpr (hs _ (Set.mem_insert_of_mem _ hv)).1)⟩

private theorem nonneg_or_nonpos_basis_repr_on_cone
    (b : Module.Basis (Fin 2) ℤ N) (j : Fin 2) (σ : Φ.cones)
    (hpos : i (b j.rev) ∈ Φ.support → hull ℝ {i (b j.rev)} ∈ Φ.cones)
    (hneg : i (-b j.rev) ∈ Φ.support → hull ℝ {i (-b j.rev)} ∈ Φ.cones) :
    let c := Φ.lattice.isBaseChange.basis b
    (∀ x ∈ σ.val, 0 ≤ c.repr x j) ∨ ∀ x ∈ σ.val, c.repr x j ≤ 0 := by
  let c := Φ.lattice.isBaseChange.basis b
  have hne : j ≠ j.rev := by fin_cases j <;> decide
  have hc : c j.rev = i (b j.rev) := IsBaseChange.basis_apply _ Φ.lattice.isBaseChange _
  have hker : (c.coord j).ker = ℝ ∙ c j.rev := by
    refine le_antisymm (fun x hx ↦ ?_) ?_
    · have hz : c.repr x j = 0 := LinearMap.mem_ker.mp hx
      rw [← Set.image_singleton (f := c) (a := j.rev), c.mem_span_image]
      intro k hk
      rcases Fin.fin_two_eq_or_eq_rev j k with rfl | rfl
      · exact (Finsupp.mem_support_iff.mp hk hz).elim
      · exact Set.mem_singleton _
    · rw [Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]
      simp [hne]
  exact Φ.nonneg_or_nonpos_on_cone_of_mem_support hker
    (by simpa only [hc] using hpos) (by simpa only [hc, map_neg] using hneg) σ

-- A linear map that has constant weak sign on a cone can vanish at the sum of the
-- generators only if it vanishes on the whole cone.
private theorem map_eq_zero_of_sum_generators (hσ : IsToricCone i σ) (hi : IsIntegralLattice i)
    (f : V →ₗ[ℝ] ℝ) (hf : ∀ x ∈ σ, 0 ≤ f x) [Fintype (ToricRay σ)]
    (hzero : f (∑ ρ : ToricRay σ, i (primitiveGenerator hi hσ ρ)) = 0) :
    ∀ x ∈ σ, f x = 0 := by
  have hgens := (Fintype.sum_eq_zero_iff_of_nonneg fun ρ : ToricRay σ ↦ hf _
    (ρ.val.isFaceOf.le (primitiveGenerator_mem hi hσ ρ))).mp (by simpa only [map_sum] using hzero)
  have hle : σ ≤ Submodule.restrictScalars (Nonneg ℝ) f.ker := by
    rw [← hσ.hull_primitiveGenerator hi]
    apply Submodule.span_le.mpr
    rintro _ ⟨_, ⟨ρ, rfl⟩, rfl⟩
    exact congrFun hgens ρ
  exact fun x hx ↦ hle hx

private theorem le_of_sum_generators_mem (hσ : IsToricCone i σ) (hi : IsIntegralLattice i)
    (hτ : IsToricCone i τ) (b : Module.Basis (Fin 2) ℤ N) (r : ToricRay τ ↪ Fin 2)
    (hb : IsExtendingBasis i b r) [Fintype (ToricRay σ)]
    (hs : (∑ ρ : ToricRay σ, i (primitiveGenerator hi hσ ρ)) ∈ τ)
    (hsign : ∀ j, (∀ x ∈ σ, 0 ≤ (hi.isBaseChange.basis b).repr x j) ∨
      ∀ x ∈ σ, (hi.isBaseChange.basis b).repr x j ≤ 0) :
    σ ≤ τ := by
  let c := hi.isBaseChange.basis b
  let z := ∑ ρ : ToricRay σ, i (primitiveGenerator hi hσ ρ)
  have hz : z ∈ σ := Submodule.sum_mem _ fun ρ _ ↦
    ρ.val.isFaceOf.le (primitiveGenerator_mem hi hσ ρ)
  obtain ⟨hpos, hzero⟩ := (mem_extendingBasis_cone hτ b r hb hi z).mp hs
  intro x hx
  apply (mem_extendingBasis_cone hτ b r hb hi x).mpr
  have hfix {j : Fin 2} (h : c.repr z j = 0) : c.repr x j = 0 := by
    rcases hsign j with hj | hj
    · exact map_eq_zero_of_sum_generators hσ hi (c.coord j) hj h x hx
    · have h' : (-c.coord j) z = 0 := by simp [h, c]
      simpa using map_eq_zero_of_sum_generators hσ hi (-c.coord j)
        (fun y hy ↦ neg_nonneg.mpr (hj y hy)) h' x hx
  refine ⟨fun j ↦ ?_, fun j hj ↦ hfix (hzero j hj)⟩
  rcases hsign j with hj | hj
  · exact hj x hx
  · exact (hfix ((hj z hz).antisymm (hpos j))).ge

/-- Two regular fans in a rank-two lattice with the same support admit a regular common
subdivision. In particular, two complete regular surface fans have a complete regular
common subdivision. -/
theorem exists_regular_common_subdivision (Φ Ψ : Fan i)
    (hΦ : Φ.IsRegular) (hΨ : Ψ.IsRegular) (hN : Module.finrank ℤ N = 2)
    (hs : Φ.support = Ψ.support) :
    ∃ Ω : Fan i, Ω.IsSubdivision Φ ∧ Ω.IsSubdivision Ψ ∧ Ω.IsRegular := by
  classical
  have hbase (τ : Ψ.cones) := hN ▸ (isRegular_iff.mp hΨ _ τ.property).exists_basis_finrank
  choose b r hb using hbase
  let v (p : Ψ.cones × Fin 2 × Bool) := if p.2.2 then b p.1 p.2.1 else -b p.1 p.2.1
  let S : Set N := Set.range v ∩ i ⁻¹' Φ.support
  let _ := Ψ.finite_cones.fintype
  have hS : S.Finite := (Set.finite_range v).subset Set.inter_subset_left
  have hm : ∀ u ∈ S, u ≠ 0 ∧ i u ∈ Φ.support := by
    rintro u ⟨⟨p, rfl⟩, hp⟩
    refine ⟨?_, hp⟩
    rcases p with ⟨τ, j, s⟩
    cases s <;> simp [v, (b τ).ne_zero j]
  obtain ⟨Ω, hΩ, hreg, hrays⟩ := Φ.exists_regular_subdivision_containing_rays hΦ hN hS hm
  have hsΩ := hΩ.support_eq.trans hs
  refine ⟨Ω, hΩ, ⟨?_, hsΩ⟩, hreg⟩
  intro σ hσ
  let hσt := Ω.isToricCone hσ
  have := ToricRay.finite_of_fg hσt.fg
  let _ := Fintype.ofFinite (ToricRay σ)
  let z := ∑ ρ : ToricRay σ, i (primitiveGenerator Ω.lattice hσt ρ)
  have hz : z ∈ σ := Submodule.sum_mem _ fun ρ _ ↦
    ρ.val.isFaceOf.le (primitiveGenerator_mem Ω.lattice hσt ρ)
  obtain ⟨τ, hτ, hzτ⟩ := Ψ.mem_support.mp (hsΩ ▸ Ω.subset_support hσ hz)
  let τ' : Ψ.cones := ⟨τ, hτ⟩
  refine ⟨τ, hτ, le_of_sum_generators_mem hσt Ω.lattice (Ψ.isToricCone hτ) _ _ (hb τ')
    hzτ fun j ↦ nonneg_or_nonpos_basis_repr_on_cone (b τ') j ⟨σ, hσ⟩ (fun hp ↦ ?_)
      (fun hn ↦ ?_)⟩
  · exact hrays _ ⟨⟨⟨τ', j.rev, true⟩, by simp [v]⟩,
      Set.mem_preimage.mpr (hΩ.support_eq ▸ hp)⟩
  · exact hrays _ ⟨⟨⟨τ', j.rev, false⟩, by simp [v]⟩,
      Set.mem_preimage.mpr (hΩ.support_eq ▸ hn)⟩

end TauCeti.Toric.Fan
