module

public import QPainleve.Geometry.Toric.Fan.PiecewiseLinear
public import QPainleve.Geometry.Toric.Fan.HalfPlane
public import QPainleve.LinearAlgebra.Transvection.Piecewise

/-!
# Mutation of rank-two toric fans

If a fan contains the two opposite rays generated by a nonzero lattice vector `v`, each
cone lies in one of the closed half-planes bounded by the line of `v`. The piecewise
transvection `u ↦ u + max (det(u, v)) 0 • v` therefore maps the fan to another fan, preserving
regularity and completeness. The opposite rays are fixed, while each other ray is transported
by the shear on its half-plane.

This is the transformation `Tₖ` in the proof of Theorem 5.6 of Gross, Hacking and Keel,
*Birational geometry of cluster algebras*.
-/

public noncomputable section

namespace TauCeti.Toric

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V] {i : N →+ V}

private def mutationCharacter (b : Module.Basis (Fin 2) ℤ N) (v : N) : Module.Dual ℤ N :=
  -b.detDualEquiv v

private theorem mutationCharacter_apply (b : Module.Basis (Fin 2) ℤ N) (v u : N) :
    mutationCharacter b v u = b.det ![u, v] := by
  rw [mutationCharacter, LinearMap.neg_apply, ← b.detDualEquiv_swap u v, b.detDualEquiv_apply]

private theorem mutationCharacter_self (b : Module.Basis (Fin 2) ℤ N) (v : N) :
    mutationCharacter b v v = 0 := by
  simp only [mutationCharacter, LinearMap.neg_apply, b.detDualEquiv_self, neg_zero]

namespace IsIntegralLattice

variable (hi : IsIntegralLattice i) (b : Module.Basis (Fin 2) ℤ N) (v : N)

/-- The ambient ray transformation for mutation in direction `v`, in the orientation of `b`. -/
def mutationRayEquiv : V ≃ V :=
  (hi.realCharacter (mutationCharacter b v).toAddMonoidHom).piecewiseTransvection (i v)
    (by simp [mutationCharacter_self])

/-- The ambient shear uses the real-linear extension of the determinant character. -/
theorem mutationRayEquiv_apply (x : V) :
    hi.mutationRayEquiv b v x =
      x + max (hi.realCharacter (-b.detDualEquiv v).toAddMonoidHom x) 0 • i v := by
  rw [mutationRayEquiv, LinearMap.piecewiseTransvection_apply, mutationCharacter]

/-- On lattice vectors the ray transformation is given by the positive part of `det(u,v)`. -/
@[simp]
theorem mutationRayEquiv_apply_lattice (u : N) :
    hi.mutationRayEquiv b v (i u) = i (u + max (b.det ![u, v]) 0 • v) := by
  simp only [mutationRayEquiv, LinearMap.piecewiseTransvection_apply, realCharacter_apply,
    LinearMap.toAddMonoidHom_coe, mutationCharacter_apply, map_add, map_zsmul,
    ← Int.cast_smul_eq_zsmul ℝ, Int.cast_max, Int.cast_zero]

/-- The ray shear takes the hull of a vector to the hull of its image. -/
theorem image_mutationRayEquiv_hull_singleton (x : V) :
    hi.mutationRayEquiv b v '' (PointedCone.hull ℝ {x} : Set V) =
      (PointedCone.hull ℝ {hi.mutationRayEquiv b v x} : Set V) := by
  have hsmul {a : ℝ} (ha : 0 ≤ a) :
      hi.mutationRayEquiv b v (a • x) = a • hi.mutationRayEquiv b v x :=
    LinearMap.piecewiseTransvection_smul _ _ _ ha x
  ext y
  simp only [Set.mem_image, SetLike.mem_coe, PointedCone.mem_hull_singleton]
  constructor
  · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨a, ha, (hsmul ha).symm⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a • x, ⟨a, ha, rfl⟩, hsmul ha⟩

end IsIntegralLattice

namespace Fan

open PointedCone

variable (Φ : Fan i) (b : Module.Basis (Fin 2) ℤ N) {v : N}
  (hv : v ≠ 0) (hpos : hull ℝ {i v} ∈ Φ.cones) (hneg : hull ℝ {i (-v)} ∈ Φ.cones)

include hv hpos hneg in
private theorem mutationRayEquiv_isPiecewiseLinear (σ : Φ.cones) :
    ∃ (a : V ≃ₗ[ℝ] V) (c : N ≃+ N),
      Set.EqOn a (Φ.lattice.mutationRayEquiv b v) (σ.val : Set V) ∧
        ∀ n, a (i n) = i (c n) := by
  let f := Φ.lattice.realCharacter (mutationCharacter b v).toAddMonoidHom
  have hfv : f (i v) = 0 := by simp [f, mutationCharacter_self]
  have hker : f.ker = ℝ ∙ i v := by
    have hchar : (mutationCharacter b v).toAddMonoidHom =
        -(b.detDualEquiv v).toAddMonoidHom := (rfl)
    dsimp only [f]
    rw [hchar, map_neg, LinearMap.ker_neg]
    exact Φ.lattice.ker_realCharacter_detDualEquiv b hv
  rcases Φ.nonneg_or_nonpos_on_cone hker hpos (by simpa using hneg) σ with hs | hs
  · refine ⟨LinearEquiv.transvection hfv,
      (LinearEquiv.transvection (mutationCharacter_self b v)).toAddEquiv, ?_, ?_⟩
    · intro x hx
      exact (LinearMap.piecewiseTransvection_apply_of_nonneg (h := hfv) (hs x hx)).symm
    · intro n
      simp [LinearMap.transvection.apply, f, Int.cast_smul_eq_zsmul]
  · refine ⟨LinearEquiv.refl ℝ V, AddEquiv.refl N, ?_, fun _ ↦ rfl⟩
    intro x hx
    exact (LinearMap.piecewiseTransvection_apply_of_nonpos (h := hfv) (hs x hx)).symm

/-- Apply the mutation ray transformation to all cones of a rank-two fan containing both
rays along the mutation line. -/
def mutationFan : Fan i :=
  Φ.mapPiecewiseLinear (Φ.lattice.mutationRayEquiv b v)
    (Φ.mutationRayEquiv_isPiecewiseLinear b hv hpos hneg)

/-- The cones in the mutated fan are the images of the original cones under the ray shear. -/
theorem mem_mutationFan_cones {τ : PointedCone ℝ V} :
    τ ∈ (Φ.mutationFan b hv hpos hneg).cones ↔
      ∃ σ ∈ Φ.cones, (τ : Set V) = Φ.lattice.mutationRayEquiv b v '' (σ : Set V) :=
  Φ.mem_mapPiecewiseLinear_cones _ _

/-- The ray generated by the mutated lattice vector belongs to the mutated fan exactly
when the original ray belongs to the original fan. -/
@[simp]
theorem hull_singleton_mem_mutationFan_iff (u : N) :
    hull ℝ {i u + max (b.det ![u, v]) 0 • i v} ∈ (Φ.mutationFan b hv hpos hneg).cones ↔
      hull ℝ {i u} ∈ Φ.cones := by
  let e := Φ.lattice.mutationRayEquiv b v
  have himage : e '' (hull ℝ {i u} : Set V) =
      (hull ℝ {i u + max (b.det ![u, v]) 0 • i v} : Set V) := by
    simpa only [e, IsIntegralLattice.mutationRayEquiv_apply_lattice, map_add, map_zsmul] using
      Φ.lattice.image_mutationRayEquiv_hull_singleton b v (i u)
  rw [mem_mutationFan_cones, ← himage]
  constructor
  · rintro ⟨σ, hσ, h⟩
    exact (SetLike.coe_injective (e.injective.image_injective h) : hull ℝ {i u} = σ) ▸ hσ
  · intro hu
    exact ⟨hull ℝ {i u}, hu, rfl⟩

@[simp]
theorem support_mutationFan :
    (Φ.mutationFan b hv hpos hneg).support =
      Φ.lattice.mutationRayEquiv b v '' Φ.support :=
  Φ.support_mapPiecewiseLinear _ _

/-- The mutated fan is complete exactly when the original fan is complete. -/
theorem isComplete_mutationFan_iff : (Φ.mutationFan b hv hpos hneg).IsComplete ↔ Φ.IsComplete :=
  Φ.isComplete_mapPiecewiseLinear_iff _ _

/-- The mutated fan is regular exactly when the original fan is regular. -/
theorem isRegular_mutationFan_iff : (Φ.mutationFan b hv hpos hneg).IsRegular ↔ Φ.IsRegular :=
  Φ.isRegular_mapPiecewiseLinear_iff _ _

end Fan
end TauCeti.Toric
