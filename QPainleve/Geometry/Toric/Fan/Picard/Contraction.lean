module

public import QPainleve.AlgebraicGeometry.Blowup.Tower.Marking
public import QPainleve.Geometry.Toric.Fan.Picard.NodalDescent
public import QPainleve.Geometry.Toric.Fan.Smooth

import QPainleve.AlgebraicGeometry.Morphisms.Smooth.Factorial

/-!
# Marked Picard lattices of contracted toric models

For a nodal contraction of an ordered toric presentation, the span of the total
exceptional classes in the internal blowup marking is generated by the marked
boundary classes of the contracted rays. Thus a fixed set of contracted ray labels
defines the same marked orthogonal complement for every choice of the binomial centers
realizing those labels.
-/

public noncomputable section

open AlgebraicGeometry CategoryTheory QPainleve.BlowupTower TopologicalSpace
open TauCeti.AlgebraicGeometry Scheme.IdealSheafData

namespace TauCeti.Toric.Fan

variable {N V : Type} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ : Fan i} [h₀ : Nonempty Φ.cones] {n : ℕ}
  (hΦ : Φ.IsRegular) (hdim : Module.finrank ℤ N = 2)
  (s : Fin n → Φ.Ray) (m : Fin n → N →+ ℤ)
  (hm : ∀ j, m j (s j).primitiveGenerator = 0) (hprim : ∀ j, Function.Surjective (m j))
  (c : Fin n → ℂˣ)

local notation "Dtor" => Φ.boundaryIdeal h₀

variable (J : Fin n → {K : (Φ.boundaryIdeal h₀).subscheme.IdealSheafData //
    K.IsEffectiveCartier})
  (hJ : ∀ j, (J j).val = ((s j).binomialCenterOnBoundary hdim (hm j) (hprim j) (c j)).ker)

local notation "model" => alongBoundary (subschemeι Dtor) J
local notation "U" => WithBoundary.toTower (Sigma.snd model)
local notation "hU" => isClosedPointTower_alongBoundary_binomialCenters hdim s m hm hprim c J hJ
local notation "Dint" => Scheme.Hom.ker (WithBoundary.boundaryι (Sigma.snd model))
local notation "strictIdeal" ρ:arg => strictTransform (Φ.rayBoundaryIdeal hΦ ρ) U
local notation "S" => Spec (CommRingCat.of ℂ)
local notation "fZ" => (Φ.algebraicRealization ↘ S)

variable [DecidableEq Φ.Ray]
  {X Y : Scheme} [X.Over S] [IsNoetherian X] [IsIntegral X]
  [SmoothOfRelativeDimension 2 (X ↘ S)] {D : X.IdealSheafData} {d : ℕ}
  {T : QPainleve.BlowupTower X d Y}

/-- The total exceptional span in the ordered toric marking is generated by the
marked classes of the rays contracted on the original surface. The marked generators
depend only on the fan and the ordered ray labels, so the orthogonal complement
defining the contracted Picard marking is constant when the contracted rays are fixed. -/
theorem markedExceptionalSpan_eq_span_contractedRays
    (hT : IsNodalBoundaryTower D (X ↘ S) (𝟙 X) T)
    (e : (model).1 ≅ Y)
    (hD : (D.comap (e.hom ≫ T.toBase)).support = (Dint).support) :
    let : SmoothOfRelativeDimension 2 fZ :=
      hdim ▸ Φ.smoothOfRelativeDimension_algebraicRealizationStructureMap hΦ
    let p : (model).1 ⟶ X := e.hom ≫ T.toBase
    let V : (model).1.Opens := p ⁻¹ᵁ T.toBase.isoLocus
    let R := {ρ : Φ.Ray | Disjoint ((strictIdeal ρ).support : Set (model).1) V}
    markedExceptionalSpan ℂ hU T e =
      Submodule.span ℤ ((fun ρ ↦ markedBoundaryMap hΦ s (Pi.single ρ 1)) '' R) := by
  intro _ p V R
  let : IsNoetherian (model).1 := (U).isNoetherian
  let : IsIntegral (model).1 := (hU).isIntegral fZ
  let : SmoothOfRelativeDimension 2 ((U).toBase ≫ fZ) := (hU).smoothOfRelativeDimension fZ
  let := ((U).toBase ≫ fZ).uniqueFactorizationMonoid_stalk_of_smoothOfRelativeDimension_two
  have hOpen : D.support.compl ≤ T.toBase.isoLocus := by
    have h := hT.isIso_morphismRestrict_boundaryCompl
    rw [comap_id] at h
    exact T.toBase.le_isoLocus_iff.mpr h
  have hV : (Dint).support.compl ≤ V := by
    rw [← hD, compl_support_comap]
    exact p.preimage_mono hOpen
  rw [markedExceptionalSpan_eq_comap_primeDivisorSpanCompl ℂ hT.isClosedPointTower hU e,
    primeDivisorSpanCompl_eq_span_strictRayBoundaryClass hΦ hdim s m hm hprim c J hJ V hV]
  have hmap : (Submodule.span ℤ ((fun ρ ↦ markedBoundaryMap hΦ s (Pi.single ρ 1)) '' R)).map
      (U).picardHom =
        Submodule.span ℤ (strictRayBoundaryClass hΦ hdim U hU '' R) := by
    rw [Submodule.map_span, Set.image_image]
    exact congrArg (Submodule.span ℤ) (Set.image_congr fun ρ _ ↦
      picardHom_markedBoundaryMap_single hΦ hdim s m hm hprim c J hJ hU ρ)
  rw [← hmap, Submodule.comap_map_eq_of_injective ((hU).bijective_picardHom fZ).injective]

end TauCeti.Toric.Fan
