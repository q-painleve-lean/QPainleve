module

public import QPainleve.Geometry.Toric.Fan.Charge
public import QPainleve.Geometry.Toric.Fan.Picard.Presentation
public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.Torsion
public import Mathlib.LinearAlgebra.Dual.Defs

import QPainleve.LinearAlgebra.Dual.Cokernel
import QPainleve.LinearAlgebra.Quotient.Prod

/-!
# Boundary quotients in toric Picard coordinates

In the Picard marking for internal point blowups, there is one exceptional coordinate for
each center. A boundary ray class in these coordinates is its toric Picard class minus
the exceptional classes of the centers on that ray. Killing these marked classes eliminates
the toric summand. The remaining relations are the duals of the charges, which are the
primitive ray generators at the centers.

The comparison uses `Fan.exact_characterToRayDivisor_rayDivisorToPicard` and Mathlib's
`Module.piEquiv`. The index formula uses
`LinearMap.natCard_torsion_coker_dualMap_of_finrank_range_eq`.
-/

public noncomputable section

open TauCeti.AlgebraicGeometry
open Module (Basis Dual)
open LinearMap (ker range)

namespace TauCeti.Toric.Fan

variable {N : Type} {V ι : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ : Fan i}

local notation "Pic" => Additive (LineBundleClass (Fan.algebraicRealization Φ))

variable [Nonempty Φ.cones]

/-- The boundary class map in the toric Picard and exceptional coordinates. It subtracts
the coefficient of each ray from every exceptional coordinate of a center on that ray. -/
def markedBoundaryMap (hΦ : Φ.IsRegular) (s : ι → Φ.Ray) :
    (Φ.Ray → ℤ) →ₗ[ℤ] (Pic × (ι → ℤ)) :=
  (Φ.rayDivisorToPicard hΦ).toIntLinearMap.prod (-LinearMap.funLeft ℤ ℤ s)

@[simp]
theorem markedBoundaryMap_apply (hΦ : Φ.IsRegular) (s : ι → Φ.Ray) (a : Φ.Ray → ℤ) :
    markedBoundaryMap hΦ s a = (Φ.rayDivisorToPicard hΦ a, fun j ↦ -a (s j)) := (rfl)

/-- The range of the marked boundary map is generated by the individual boundary classes.
In the component for a ray, the exceptional coefficient is `-1` at each center on that
ray and zero elsewhere. -/
theorem range_markedBoundaryMap_eq_span (hΦ : Φ.IsRegular) (s : ι → Φ.Ray) [DecidableEq Φ.Ray] :
    range (markedBoundaryMap hΦ s) =
      Submodule.span ℤ (Set.range fun ρ ↦
        (Φ.rayDivisorToPicard hΦ (Pi.single ρ 1), fun j ↦ if s j = ρ then -1 else 0)) := by
  have hrange := (Pi.basisFun ℤ Φ.Ray).constr_range ℤ
    (f := fun ρ ↦ markedBoundaryMap hΦ s (Pi.basisFun ℤ Φ.Ray ρ))
  rw [Basis.constr_self] at hrange
  rw [hrange]
  congr 2
  funext ρ
  simp [Pi.basisFun_apply, Pi.single_apply, apply_ite]

variable [Finite ι]

local notation "coords" => LinearEquiv.symm (Module.piEquiv ι ℤ ℤ)

private def rayDivisorMap (Φ : Fan i) : Dual ℤ N →ₗ[ℤ] (Φ.Ray → ℤ) :=
  (Φ.characterToRayDivisor.comp LinearMap.toAddMonoidHom').toIntLinearMap

private theorem range_rayDivisorMap (hΦ : Φ.IsRegular) :
    range (rayDivisorMap Φ) = ker (Φ.rayDivisorToPicard hΦ).toIntLinearMap := by
  ext a
  rw [LinearMap.mem_range, LinearMap.mem_ker]
  refine ⟨?_, ?_⟩
  · rintro ⟨m, rfl⟩
    refine (Φ.exact_characterToRayDivisor_rayDivisorToPicard hΦ _).2 ⟨m.toAddMonoidHom, ?_⟩
    ext ρ
    simp [rayDivisorMap]
  · intro ha
    obtain ⟨m, hm⟩ := (Φ.exact_characterToRayDivisor_rayDivisorToPicard hΦ a).1 ha
    refine ⟨m.toIntLinearMap, ?_⟩
    ext ρ
    simpa [rayDivisorMap] using congrFun hm ρ

private theorem map_dualCharge_range (hΦ : Φ.IsRegular) (s : ι → Φ.Ray) :
    (rayChargeMap s).dualMap.range.map (coords).toLinearMap =
      ((-LinearMap.funLeft ℤ ℤ s).comp (ker (Φ.rayDivisorToPicard hΦ).toIntLinearMap).subtype
        ).range := by
  have hcomp : (coords).toLinearMap ∘ₗ (rayChargeMap s).dualMap =
      LinearMap.funLeft ℤ ℤ s ∘ₗ rayDivisorMap Φ := by
    classical
    ext m j
    simp [rayDivisorMap, Module.piEquiv]
  rw [← LinearMap.range_comp, hcomp, LinearMap.range_comp, LinearMap.range_comp,
    range_rayDivisorMap hΦ, Submodule.range_subtype, Submodule.map_neg]

/-- The marked Picard lattice modulo the strict-transform boundary classes is the cokernel
of the dual charge map. This comparison allows repeated centers on any ray and charge
images of any rank. -/
def boundaryQuotientEquivDualChargeCokernel (hΦ : Φ.IsRegular) (s : ι → Φ.Ray) :
    ((Pic × (ι → ℤ)) ⧸ range (markedBoundaryMap hΦ s)) ≃ₗ[ℤ]
      (Dual ℤ (ι → ℤ) ⧸ (rayChargeMap s).dualMap.range) :=
  ((Submodule.Quotient.equiv _ _ coords (map_dualCharge_range hΦ s)).trans
    ((Φ.rayDivisorToPicard hΦ).toIntLinearMap.quotientRangeProdEquiv
      (-LinearMap.funLeft ℤ ℤ s) (by
        simpa only [AddMonoidHom.coe_toIntLinearMap] using
          Φ.rayDivisorToPicard_surjective hΦ))).trans
      (Submodule.quotEquivOfEq _ _ (by rfl)) |>.symm

/-- A dual functional maps back to the exceptional coefficients given by its evaluations on the
standard basis, with zero toric Picard coordinate. -/
@[simp]
theorem boundaryQuotientEquivDualChargeCokernel_symm_apply_mk [DecidableEq ι]
    (hΦ : Φ.IsRegular) (s : ι → Φ.Ray) (m : Dual ℤ (ι → ℤ)) :
    (boundaryQuotientEquivDualChargeCokernel hΦ s).symm (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk (0, fun j ↦ m (Pi.single j 1)) := by
  rw [boundaryQuotientEquivDualChargeCokernel, LinearEquiv.symm_symm]
  simp only [LinearEquiv.trans_apply, Submodule.Quotient.equiv_apply, Submodule.mapQ_apply,
    LinearMap.quotientRangeProdEquiv_apply_mk]
  refine (Submodule.quotEquivOfEq_mk _ _ _ _).trans ?_
  apply congrArg (fun b ↦ Submodule.Quotient.mk (0, b))
  funext j
  simp only [LinearEquiv.coe_coe, Module.piEquiv, Basis.constr_symm_apply, Pi.basisFun_apply]

/-- If the charges span the ambient lattice rationally, their index is the order of the
torsion subgroup of the marked boundary quotient. -/
theorem natCard_torsion_boundaryQuotient_eq_chargeIndex (hΦ : Φ.IsRegular) (s : ι → Φ.Ray)
    [Module.Free ℤ N] [Module.Finite ℤ N]
    (h : Module.finrank ℤ (rayChargeMap s).range = Module.finrank ℤ N) :
    Nat.card (AddCommGroup.torsion ((Pic × (ι → ℤ)) ⧸ range (markedBoundaryMap hΦ s))) =
      (rayChargeMap s).range.toAddSubgroup.index := by
  let e := (boundaryQuotientEquivDualChargeCokernel hΦ s).toAddEquiv
  let eT := (e.addSubgroupMap (AddCommGroup.torsion _)).trans
    (AddEquiv.addSubgroupCongr e.map_torsion)
  exact (Nat.card_congr eT.toEquiv).trans
    ((rayChargeMap s).natCard_torsion_coker_dualMap_of_finrank_range_eq h)

end TauCeti.Toric.Fan
