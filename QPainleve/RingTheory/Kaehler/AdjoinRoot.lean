module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Kaehler.Basic
public import TauCeti.RingTheory.FittingIdeal.Basic
import Mathlib.RingTheory.Kaehler.Polynomial
import TauCeti.RingTheory.Kaehler.Hypersurface

/-!
# Differentials of a univariate hypersurface

The zeroth Fitting ideal of the relative differentials of `A[X]/(f)` is generated
by the image of `f'`. This is the univariate case of Tau Ceti's hypersurface
Fitting ideal formula.
-/

open Polynomial TauCeti

namespace AdjoinRoot

/-- The zeroth Fitting ideal of the relative differentials of a univariate hypersurface
is generated by the image of the derivative of its defining polynomial. -/
public theorem fittingIdeal_kaehlerDifferential_zero {A : Type*} [CommRing A] (f : A[X]) :
    fittingIdeal (AdjoinRoot f) Ω[AdjoinRoot f⁄A] 0 =
      Ideal.span {AdjoinRoot.mk f f.derivative} := by
  let b := (Module.Basis.singleton Unit A[X]).map
    (KaehlerDifferential.polynomialEquiv A).symm
  have hb (i : Unit) : b.coord i (KaehlerDifferential.D A A[X] f) = f.derivative := by
    simp [b, Module.Basis.coord_apply]
  simpa only [Fintype.card_unit, Nat.sub_self, hb, Set.range_const, Ideal.map_span,
    Set.image_singleton] using! fittingIdeal_kaehlerDifferential_quotient_span_singleton f b

end AdjoinRoot
