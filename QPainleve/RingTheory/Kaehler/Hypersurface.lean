module

public import Mathlib.RingTheory.Kaehler.Basic
public import TauCeti.RingTheory.FittingIdeal.Basic

import TauCeti.RingTheory.FittingIdeal.BaseChange
import TauCeti.RingTheory.Kaehler.Hypersurface

/-!
# Differentials of a product hypersurface

When the differentials of two elements form a basis, the first Fitting ideal of
the quotient by their product is generated by their images. The proof applies
the hypersurface Jacobian formula to the product rule.
-/

public section

open KaehlerDifferential TauCeti

namespace Module.Basis

/-- For a quotient by a product equation, the first Fitting ideal of the differentials
is generated by the images of the two factors when their differentials form a basis
in the ambient ring. -/
theorem fittingIdeal_kaehlerDifferential_eq_map_span_of_ker_eq_span_mul
    {k P A : Type*} [CommRing k] [CommRing P] [Algebra k P]
    [CommRing A] [Algebra k A] [Module.Finite A Ω[A⁄k]]
    (b : Basis (Fin 2) P Ω[P⁄k]) {x y : P}
    (hx : b 0 = D k P x) (hy : b 1 = D k P y)
    (f : P →ₐ[k] A) (hf : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span {x * y}) :
    fittingIdeal A Ω[A⁄k] 1 = (Ideal.span {x, y}).map (f : P →+* A) := by
  let Q := P ⧸ Ideal.span {x * y}
  let := Module.Finite.of_basis (b.baseChange Q)
  have : Module.Finite Q Ω[Q⁄k] :=
    Module.Finite.of_surjective (mapBaseChange k P Q)
      (mapBaseChange_surjective k P Q Ideal.Quotient.mk_surjective)
  have hcard : Fintype.card (Fin 2) - 1 = 1 := by simp
  have hder : D k P (x * y) = x • b 1 + y • b 0 := by
    rw [Derivation.leibniz, ← hx, ← hy]
  have hset : (Set.range fun i ↦ b.coord i (D k P (x * y))) = {x, y} := by
    ext z
    simp [hder, Fin.exists_fin_two, or_comm, eq_comm]
  let e := (Ideal.quotientEquivAlgOfEq k hker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hf)
  have he : e.toRingHom.comp (Ideal.Quotient.mk _) = (f : P →+* A) := by
    ext z
    rfl
  rw [fittingIdeal_kaehlerDifferential_eq_map_algEquiv e 1, ← hcard,
    fittingIdeal_kaehlerDifferential_quotient_span_singleton (x * y) b, hset]
  exact (Ideal.map_map (Ideal.Quotient.mk (Ideal.span {x * y})) e.toRingHom).trans
    (congrArg ((Ideal.span {x, y}).map) he)

end Module.Basis
