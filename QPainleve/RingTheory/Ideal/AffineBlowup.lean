module

public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Regular.RegularSequence
public import TauCeti.RingTheory.Ideal.AffineBlowup
import TauCeti.RingTheory.Regular.RegularSequence

/-!
# Affine blowup algebras for a regular pair

The chart of `a` in the blowup of the ideal `(a, b)` has the presentation
`A[X]/(aX - b)` when `a, b` is a weakly regular sequence. The class of `X` corresponds to
the fraction `b/a`. This gives polynomial coordinates for blowups of regular surface points.

The comparison uses Tau Ceti's `Ideal.affineBlowupLift`. For the affine blowup algebra
and its localization description, see
[The Stacks Project, Tag 052P](https://stacks.math.columbia.edu/tag/052P).
-/

public section

open Polynomial RingTheory.Sequence TauCeti.Localization

namespace Ideal

variable {A : Type*} [CommRing A] {a b : A}

private theorem isSMulRegular_in_chartQuotient (h : IsWeaklyRegular A [a, b]) :
    IsSMulRegular (AdjoinRoot (C a * X - C b)) (AdjoinRoot.of (C a * X - C b) a) := by
  obtain ⟨ha, hb⟩ := (isWeaklyRegular_cons_iff A a [b]).mp h
  rw [isWeaklyRegular_singleton_iff, TauCeti.isSMulRegular_quotSMulTop_iff] at hb
  -- If a multiple of a is a multiple of the relation, its multiplier is divisible by a.
  have hcancel {p q : A[X]} (hpq : C a * p = (C a * X - C b) * q) : C a ∣ q := by
    rw [C_dvd_iff_dvd_coeff]
    intro i
    have hi := congrArg (fun f : A[X] ↦ f.coeff i) hpq
    simp only [sub_mul, mul_assoc, coeff_sub, coeff_C_mul] at hi
    apply mem_span_singleton.mp
    rw [← mul_top (span {a} : Ideal A), ← smul_eq_mul,
      Submodule.ideal_span_singleton_smul]
    apply hb (q.coeff i) ((X * q).coeff i - p.coeff i)
    simp only [smul_eq_mul, mul_sub]
    linear_combination -hi
  apply isSMulRegular_iff_right_eq_zero_of_smul.mpr
  intro x
  induction x using AdjoinRoot.induction_on with
  | ih p =>
    intro hp
    rw [smul_eq_mul, ← AdjoinRoot.mk_C, ← map_mul, AdjoinRoot.mk_eq_zero] at hp
    obtain ⟨q, hq⟩ := hp
    obtain ⟨t, rfl⟩ := hcancel hq
    rw [AdjoinRoot.mk_eq_zero]
    refine ⟨t, ?_⟩
    ext i
    have hcoeff := congrArg (fun p : A[X] ↦ p.coeff i)
      (hq.trans (by ring : (C a * X - C b) * (C a * t) = C a * ((C a * X - C b) * t)))
    exact ha (by simpa only [coeff_C_mul, smul_eq_mul] using hcoeff)

private theorem mul_root_eq (a b : A) :
    algebraMap A (AdjoinRoot (C a * X - C b)) a * AdjoinRoot.root (C a * X - C b) =
      algebraMap A (AdjoinRoot (C a * X - C b)) b := by
  let p : A[X] := C a * X - C b
  have hroot := AdjoinRoot.eval₂_root p
  dsimp only [p] at hroot
  simp only [eval₂_sub, eval₂_mul, eval₂_C, eval₂_X] at hroot
  simpa only [AdjoinRoot.algebraMap_eq] using sub_eq_zero.mp hroot

/-- In the chart equation `aX = b`, the extended center ideal is generated by `a`. -/
theorem map_algebraMap_adjoinRoot_of_span_pair (I : Ideal A) (hI : span {a, b} = I) :
    I.map (algebraMap A (AdjoinRoot (C a * X - C b))) =
      span {algebraMap A (AdjoinRoot (C a * X - C b)) a} := by
  rw [← hI, Ideal.map_span, Set.image_insert_eq, Set.image_singleton,
    Ideal.span_pair_eq_span_left_iff_dvd]
  exact ⟨AdjoinRoot.root _, (mul_root_eq a b).symm⟩

private theorem map_chartRelation_eq_zero {I : Ideal A} (hI : span {a, b} = I) :
    (C a * X - C b).map (Ideal.Quotient.mk I) = 0 := by
  have ha : Ideal.Quotient.mk I a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (hI ▸ subset_span (by simp))
  have hb : Ideal.Quotient.mk I b = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (hI ▸ subset_span (by simp))
  simp [ha, hb]

/-- Setting the exceptional parameter `a` to zero leaves a polynomial ring over the center
`A/(a,b)`, with the same chart coordinate. -/
noncomputable def adjoinRootQuotientSpanPairEquiv (I : Ideal A) (hI : span {a, b} = I) :
    (AdjoinRoot (C a * X - C b) ⧸ span {AdjoinRoot.of (C a * X - C b) a}) ≃+*
      (A ⧸ I)[X] :=
  (Ideal.quotEquivOfEq (I.map_algebraMap_adjoinRoot_of_span_pair hI).symm).trans
    ((AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot I (C a * X - C b)).trans
      ((Ideal.quotEquivOfEq (by rw [map_chartRelation_eq_zero hI, Ideal.span_singleton_zero])).trans
        (RingEquiv.quotientBot _)))

/-- Restriction to the exceptional chart reduces coefficients modulo the center ideal. -/
@[simp]
theorem adjoinRootQuotientSpanPairEquiv_mk (I : Ideal A) (hI : span {a, b} = I) (p : A[X]) :
    I.adjoinRootQuotientSpanPairEquiv hI
        (Ideal.Quotient.mk (span {AdjoinRoot.of (C a * X - C b) a})
          (AdjoinRoot.mk (C a * X - C b) p)) =
      p.map (Ideal.Quotient.mk I) := by
  unfold adjoinRootQuotientSpanPairEquiv
  -- The quotient comparison uses the coefficient map `AdjoinRoot.of` for the algebra map.
  erw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk, RingEquiv.trans_apply,
    AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot_mk_of,
    RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk, RingEquiv.quotientBot_mk]

/-- The `a`-chart of the blowup of `(a, b)` sends the class of `X` in `A[X]/(aX-b)` to `b/a`. -/
noncomputable def affineBlowupEquivOfSpanPair (I : Ideal A) (hI : span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    AdjoinRoot (C a * X - C b) ≃ₐ[A] I.affineBlowup a (Localization.Away a) := by
  let B := I.affineBlowup a (Localization.Away a)
  let p : A[X] := C a * X - C b
  let Q := AdjoinRoot p
  have hb : b ∈ I := hI ▸ subset_span (by simp)
  let z : B := ⟨divBy b a, divBy_mem_affineBlowup hb⟩
  have hz : algebraMap A B a * z = algebraMap A B b :=
    Subtype.ext (algebraMap_mul_divBy b a)
  let f : Q →ₐ[A] B := AdjoinRoot.liftAlgHom p (Algebra.ofId A B) z (by simp [p, hz])
  have hf : f (AdjoinRoot.root p) = z := AdjoinRoot.liftAlgHom_root ..
  have hQ : algebraMap A Q a * AdjoinRoot.root p = algebraMap A Q b := mul_root_eq a b
  have hmap : I.map (algebraMap A Q) ≤ span {algebraMap A Q a} :=
    (I.map_algebraMap_adjoinRoot_of_span_pair hI).le
  have hreg : IsLeftRegular (algebraMap A Q a) := isSMulRegular_in_chartQuotient h
  let g : B →ₐ[A] Q := affineBlowupLift I a (Localization.Away a) hmap hreg
  have hg : g z = AdjoinRoot.root p :=
    hreg ((algebraMap_mul_algHom_divBy g hb).trans hQ.symm)
  refine AlgEquiv.ofAlgHom f g ?_ (AdjoinRoot.algHom_ext ?_)
  · exact affineBlowup_algHom_ext isRegular_algebraMap_affineBlowup.left
  · rw [AlgHom.comp_apply, hf, AlgHom.id_apply]
    exact hg

/-- In the polynomial presentation, the adjoined root is the fraction `b/a`. -/
@[simp]
theorem affineBlowupEquivOfSpanPair_apply_root (I : Ideal A) (hI : span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    I.affineBlowupEquivOfSpanPair hI h (AdjoinRoot.root (C a * X - C b)) =
      ⟨divBy b a, divBy_mem_affineBlowup (hI ▸ subset_span (by simp))⟩ := by
  simp [affineBlowupEquivOfSpanPair, AlgEquiv.ofAlgHom_apply]

end Ideal
