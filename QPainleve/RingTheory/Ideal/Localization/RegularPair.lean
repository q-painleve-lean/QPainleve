/-!
# Spreading out two regular parameters

A prime with a two-dimensional regular local ring is generated by a regular pair on a
principal neighborhood. We use the regular system of parameters of the local ring, then
spread out ideal generation and the colon ideal conditions for regularity. The ideal-inclusion
argument extends the finite-module argument in
`Ideal.exists_notMem_smul_le_span_singleton_of_map_le` from Tau Ceti.
-/

public section

open RingTheory.Sequence
open scoped Pointwise

namespace Ideal

variable {R : Type*} [CommRing R]

/-- An ideal inclusion that holds after localization at a prime holds after inverting one
element outside the prime, provided the smaller ideal is finitely generated. -/
theorem exists_notMem_map_le_of_map_le_atPrime {P I J : Ideal R} [P.IsPrime] (hI : I.FG)
    (S : Type*) [CommRing S] [Algebra R S] [IsLocalization.AtPrime S P]
    (h : I.map (algebraMap R S) ≤ J.map (algebraMap R S)) :
    ∃ r ∉ P, ∀ {B : Type*} [CommRing B] (f : R →+* B), IsUnit (f r) → I.map f ≤ J.map f := by
  have : Module.Finite R I := Module.Finite.iff_fg.mpr hI
  obtain ⟨r, hr, hkill⟩ := Module.exists_notMem_forall_smul_eq_zero (P := P)
      (I ⧸ Submodule.comap I.subtype J) fun z ↦ by
    obtain ⟨⟨x, hx⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    obtain ⟨s, hs, hsx⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff P.primeCompl S J x).mp
      (h (Ideal.mem_map_of_mem _ hx))
    exact ⟨s, hs, by simpa [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_comap, smul_eq_mul] using hsx⟩
  refine ⟨r, hr, fun f hu ↦ Ideal.map_le_iff_le_comap.mpr fun x hx ↦ ?_⟩
  have hx' : r * x ∈ J := by
    simpa [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_comap, smul_eq_mul] using hkill (Submodule.Quotient.mk ⟨x, hx⟩)
  exact (unit_mul_mem_iff_mem _ hu).mp (map_mul f r x ▸ mem_map_of_mem f hx')

private theorem map_span_pair (S : Type*) [CommRing S] [Algebra R S] (a b : R) :
    (span {a, b}).map (algebraMap R S) = span {algebraMap R S a, algebraMap R S b} := by
  rw [map_span, Set.image_insert_eq, Set.image_singleton]

private theorem smul_top_eq_span_singleton (a : R) :
    a • (⊤ : Ideal R) = span {a} := by
  rw [← Submodule.ideal_span_singleton_smul]
  exact (span {a}).mul_top

private theorem map_colon_span_singleton_le_iff (M : Submonoid R) (S : Type*) [CommRing S]
    [Algebra R S] [IsLocalization M S] (I : Ideal R) (c : R) :
    (I.colon (span {c} : Ideal R)).map (algebraMap R S) ≤ I.map (algebraMap R S) ↔
      ∀ z : S, algebraMap R S c * z ∈ I.map (algebraMap R S) → z ∈ I.map (algebraMap R S) := by
  rw [IsLocalization.map_colon M S _ _ (Submodule.fg_span_singleton c), map_span,
    Set.image_singleton]
  simp only [IsConcreteLE.le_iff, mem_colon_span_singleton, mul_comm]

private theorem exists_regular_span_pair_map_eq_maximalIdeal (P : Ideal R) [P.IsPrime]
    (S : Type*) [CommRing S] [Algebra R S] [IsLocalization.AtPrime S P] [IsRegularLocalRing S]
    (hdim : ringKrullDim S = 2) :
    ∃ a ∈ P, ∃ b ∈ P,
      span {algebraMap R S a, algebraMap R S b} = IsLocalRing.maximalIdeal S ∧
        IsRegular S [algebraMap R S a, algebraMap R S b] := by
  obtain ⟨x, y, hxy⟩ := TauCeti.IsRegularLocalRing.exists_span_pair_eq_maximalIdeal hdim
  obtain ⟨⟨⟨a, ha⟩, u⟩, hua⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl S).mp
    (IsLocalization.AtPrime.map_eq_maximalIdeal P S ▸
      hxy ▸ subset_span (by simp : x ∈ ({x, y} : Set S)))
  obtain ⟨⟨⟨b, hb⟩, v⟩, hvb⟩ := (IsLocalization.mem_map_algebraMap_iff P.primeCompl S).mp
    (IsLocalization.AtPrime.map_eq_maximalIdeal P S ▸
      hxy ▸ subset_span (by simp : y ∈ ({x, y} : Set S)))
  have hspan : span {algebraMap R S a, algebraMap R S b} = IsLocalRing.maximalIdeal S := by
    rw [← hua, ← hvb, span_insert, span_singleton_mul_right_unit (IsLocalization.map_units S u),
      span_singleton_mul_right_unit (IsLocalization.map_units S v), ← span_insert]
    exact hxy
  exact ⟨a, ha, b, hb, hspan, TauCeti.IsRegularLocalRing.isRegular_of_ofList_eq_maximalIdeal
    (by simpa [ofList_cons, ofList_singleton, ← span_insert] using hspan)
    (by simp [TauCeti.IsRegularLocalRing.spanFinrank_maximalIdeal_eq_two hdim])⟩

/-- If the localization at a prime is a two-dimensional regular local ring, there is a principal
neighborhood where that prime is generated by a weakly regular pair. -/
theorem exists_notMem_span_pair_of_isRegularLocalRing [IsNoetherianRing R]
    (P : Ideal R) [P.IsPrime] (S : Type*) [CommRing S] [Algebra R S]
    [IsLocalization.AtPrime S P] [IsRegularLocalRing S]
    (hdim : ringKrullDim S = 2) :
    ∃ r ∉ P, ∀ (T : Type*) [CommRing T] [Algebra R T] [IsLocalization.Away r T],
      ∃ a b : T, span {a, b} = P.map (algebraMap R T) ∧ IsWeaklyRegular T [a, b] := by
  obtain ⟨a, ha, b, hb, hspan, hreg⟩ := exists_regular_span_pair_map_eq_maximalIdeal P S hdim
  obtain ⟨r₀, hr₀, h₀⟩ := exists_notMem_map_le_of_map_le_atPrime (P := P)
    (IsNoetherian.noetherian P) S (J := span {a, b}) (by
      rw [map_span_pair, hspan, IsLocalization.AtPrime.map_eq_maximalIdeal P S])
  -- Colon inclusions express the two injectivity conditions for the pair.
  obtain ⟨hA, hmod⟩ := (isWeaklyRegular_cons_iff S _ _).mp hreg.toIsWeaklyRegular
  have hloc {I : Ideal R} {c : R}
      (h : ∀ z : S, algebraMap R S c * z ∈ I.map (algebraMap R S) →
        z ∈ I.map (algebraMap R S)) :
      (I.colon (span {c} : Ideal R)).map (algebraMap R S) ≤ I.map (algebraMap R S) :=
    (map_colon_span_singleton_le_iff P.primeCompl S I c).mpr h
  obtain ⟨r₁, hr₁, h₁⟩ := exists_notMem_map_le_of_map_le_atPrime (P := P)
    (IsNoetherian.noetherian _) S (hloc (I := ⊥) (c := a) (by
      simpa only [map_bot, Submodule.mem_bot, ← smul_eq_mul] using
        isSMulRegular_iff_right_eq_zero_of_smul.mp hA))
  obtain ⟨r₂, hr₂, h₂⟩ := exists_notMem_map_le_of_map_le_atPrime (P := P)
    (IsNoetherian.noetherian _) S (hloc (I := span {a}) (c := b) (by
      rw [map_span, Set.image_singleton]
      simpa only [smul_eq_mul, smul_top_eq_span_singleton] using
        (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mp
          ((isWeaklyRegular_singleton_iff _ _).mp hmod)))
  let r := r₀ * r₁ * r₂
  refine ⟨r, P.primeCompl.mul_mem (P.primeCompl.mul_mem hr₀ hr₁) hr₂, fun T _ _ _ ↦ ?_⟩
  let f := algebraMap R T
  have hu : IsUnit (f r) := IsLocalization.Away.algebraMap_isUnit r
  dsimp only [r] at hu
  rw [map_mul, map_mul, (Commute.all (f r₀ * f r₁) (f r₂)).isUnit_mul_iff,
    (Commute.all (f r₀) (f r₁)).isUnit_mul_iff] at hu
  refine ⟨f a, f b, ?_, ?_⟩
  · rw [← map_span_pair T]
    have hle : span {a, b} ≤ P :=
      span_le.mpr (Set.insert_subset_iff.mpr ⟨ha, Set.singleton_subset_iff.mpr hb⟩)
    exact (map_mono hle).antisymm (h₀ f hu.1.1)
  · refine (isWeaklyRegular_cons_iff T _ _).mpr ⟨?_, (isWeaklyRegular_singleton_iff _ _).mpr ?_⟩
    · apply isSMulRegular_iff_right_eq_zero_of_smul.mpr
      simpa only [map_bot, Submodule.mem_bot, smul_eq_mul] using
        (map_colon_span_singleton_le_iff (.powers r) T ⊥ a).mp (h₁ f hu.1.2)
    · apply (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mpr
      simpa only [map_span, Set.image_singleton, smul_eq_mul, smul_top_eq_span_singleton] using
        (map_colon_span_singleton_le_iff (.powers r) T (span {a}) b).mp (h₂ f hu.2)

end Ideal
