module

public import QPainleve.RingTheory.Ideal.AffineBlowup.Basic
import Mathlib.RingTheory.Localization.Ideal
import TauCeti.RingTheory.Regular.DSequence

/-!
# Strict transform equations in affine blowup algebras

The extension of a regularly generated center to a standard chart is principal.
Its powers contract back to the corresponding powers of the center. For a regular
pair generating a prime ideal, this computes the exact exceptional factor in the
pullback of an equation. Removing that factor gives the equation of the strict
transform, by saturation away from the exceptional parameter.

The contraction uses Tau Ceti's Goto–Yamagishi intersection identity
`TauCeti.IsDSequence.inf_pow_smul_top_eq`. For the description of the strict
transform by saturation, see the Stacks Project, Lemma 31.34.2 (tag 080E).
-/

public section

open RingTheory.Sequence

namespace Ideal

variable {R : Type*} [CommRing R] {I : Ideal R} {a : R}
  {S : Type*} [CommRing S] [Algebra R S] [IsLocalization.Away a S]

/-- In the chart of the first term of a weakly regular generating sequence, extending and
contracting a power of the center gives the original power. -/
theorem algebraMap_mem_map_pow_affineBlowup_iff {rs : List R}
    (h : IsWeaklyRegular R (a :: rs)) (hI : ofList (a :: rs) = I) (n : ℕ) (f : R) :
    algebraMap R (I.affineBlowup a S) f ∈
        (I ^ n).map (algebraMap R (I.affineBlowup a S)) ↔ f ∈ I ^ n := by
  refine ⟨?_, mem_map_of_mem _⟩
  intro hf
  have ha : a ∈ I := by
    rw [← hI, ofList_cons]
    exact (le_sup_left : span {a} ≤ span {a} ⊔ ofList rs) (mem_span_singleton_self a)
  have haReg := ((isWeaklyRegular_cons_iff R a rs).mp h).1
  have haCancel : IsRegular a := (Commute.isRegular_iff (Commute.all a)).mpr haReg
  have hInj : Function.Injective (algebraMap R S) :=
    IsLocalization.injectiveₛ (M := Submonoid.powers a) S (by
      rintro _ ⟨k, rfl⟩
      exact haCancel.pow k)
  -- The intersection formula lets us cancel one factor of the chart parameter in the filtration.
  have hStep (k : ℕ) {x : R} (hx : a * x ∈ I ^ (k + 1)) : x ∈ I ^ k := by
    have heq : span {a} ⊓ I ^ (k + 1) = I ^ k * span {a} := by
      simpa [ofList_cons, hI, mul_comm (span {a} : Ideal R)] using
        h.isDSequence.inf_pow_smul_top_eq 1 (n := k + 1) (Nat.succ_ne_zero k)
    have hx' : a * x ∈ I ^ k * span {a} := heq ▸
      mem_inf.mpr ⟨mem_span_singleton.mpr (dvd_mul_right a x), hx⟩
    obtain ⟨y, hy, hxy⟩ := mem_mul_span_singleton.mp hx'
    exact (haReg (by simpa [mul_comm, smul_eq_mul] using hxy.symm) : x = y) ▸ hy
  have hCancel (k : ℕ) {x : R} (hx : a ^ k * x ∈ I ^ (n + k)) : x ∈ I ^ n := by
    induction k with
    | zero => simpa using hx
    | succ k ih =>
      apply ih
      apply hStep (n + k)
      simpa [pow_succ', mul_assoc, Nat.add_assoc] using hx
  rw [Ideal.map_pow, map_algebraMap_affineBlowup ha, span_singleton_pow,
    mem_span_singleton] at hf
  obtain ⟨z, hz⟩ := hf
  obtain ⟨k, y, hy, hyz⟩ := (mem_affineBlowup_iff ha).mp z.property
  apply hCancel k
  have heq : a ^ k * f = a ^ n * y := hInj (by
    simp only [map_mul, map_pow]
    have hz' : algebraMap R S f = algebraMap R S a ^ n * (z : S) := by
      simpa only [map_mul, map_pow, AlgHom.commutes, Subalgebra.val_apply] using
        congrArg (I.affineBlowup a S).val hz
    rw [hz', mul_left_comm, hyz])
  rw [heq, pow_add]
  exact mul_mem_mul (pow_mem_pow ha n) hy

/-- In either standard chart of a prime center generated by a weakly regular pair, the
exceptional equation is prime. -/
theorem isPrime_span_algebraMap_affineBlowup {b : R} (h : IsWeaklyRegular R [a, b])
    (hI : span {a, b} = I) [I.IsPrime] :
    (span {algebraMap R (I.affineBlowup a (Localization.Away a)) a}).IsPrime := by
  let e := I.affineBlowupEquivOfSpanPair hI h
  let P := span {AdjoinRoot.of (Polynomial.C a * Polynomial.X - Polynomial.C b) a}
  have hP : P.map e.toRingHom = span {algebraMap R (I.affineBlowup a (Localization.Away a)) a} := by
    dsimp only [P]
    rw [Ideal.map_span, Set.image_singleton]
    exact congrArg (fun z ↦ span {z}) (e.commutes a)
  have : IsDomain (AdjoinRoot (Polynomial.C a * Polynomial.X - Polynomial.C b) ⧸ P) :=
    (I.adjoinRootQuotientSpanPairEquiv hI).toMulEquiv.isDomain_iff.mpr inferInstance
  have : P.IsPrime := (Ideal.Quotient.isDomain_iff_prime P).mp inferInstance
  rw [← hP]
  exact Ideal.map_isPrime_of_surjective e.surjective
    ((RingHom.injective_iff_ker_eq_bot e.toRingHom).mp e.injective ▸ bot_le)

/-- A function of exact order `n` along a prime center generated by a weakly regular pair
pulls back to the `n`th power of the exceptional equation times a factor. The exceptional
equation is a nonzerodivisor modulo this factor, so the factor defines the strict transform
on the chart. -/
theorem exists_affineBlowup_factor_of_mem_pow {b f : R} (h : IsWeaklyRegular R [a, b])
    (hI : span {a, b} = I) [I.IsPrime] {n : ℕ} (hf : f ∈ I ^ n)
    (hf' : f ∉ I ^ (n + 1)) :
    let B := I.affineBlowup a (Localization.Away a)
    ∃ g : B, algebraMap R B f = algebraMap R B a ^ n * g ∧
      IsSMulRegular (B ⧸ (span {g} : Ideal B)) (algebraMap R B a) := by
  let B := I.affineBlowup a (Localization.Away a)
  let p := algebraMap R B a
  have hList : ofList [a, b] = I := by simpa [span_insert] using hI
  have ha : a ∈ I := hI ▸ subset_span (by simp)
  have hMap (k : ℕ) :
      (I ^ k).map (algebraMap R B) = span {p ^ k} := by
    rw [Ideal.map_pow, map_algebraMap_affineBlowup ha, span_singleton_pow]
  obtain ⟨g, hg⟩ := mem_span_singleton.mp (hMap n ▸ mem_map_of_mem (algebraMap R B) hf)
  have hg' : g ∉ span {p} := by
    rintro hg'
    obtain ⟨t, ht⟩ := mem_span_singleton.mp hg'
    apply hf'
    refine (algebraMap_mem_map_pow_affineBlowup_iff (S := Localization.Away a)
      h hList (n + 1) f).mp ?_
    rw [hMap, hg, ht, pow_succ, ← mul_assoc]
    exact mem_span_singleton.mpr (dvd_mul_right _ _)
  refine ⟨g, hg, (isSMulRegular_quotient_iff_mem_of_smul_mem (span {g} : Ideal B) p).mpr ?_⟩
  intro x hx
  obtain ⟨y, hy⟩ := mem_span_singleton.mp hx
  have hprime := isPrime_span_algebraMap_affineBlowup h hI
  have hgy : g * y ∈ span {p} := by
    rw [← hy, smul_eq_mul]
    simpa [mul_comm] using mul_mem_left (span {p}) x (mem_span_singleton_self p)
  obtain ⟨z, rfl⟩ := mem_span_singleton.mp ((hprime.mem_or_mem hgy).resolve_left hg')
  have hp : IsLeftRegular p :=
    (isRegular_algebraMap_affineBlowup (I := I) (a := a) (S := Localization.Away a)).left
  exact mem_span_singleton.mpr ⟨z, hp (by simpa [smul_eq_mul, mul_left_comm g] using hy)⟩

end Ideal
