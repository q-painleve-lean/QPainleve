module

public import Mathlib.RingTheory.AdicCompletion.Algebra

/-!
# Recovering ideal powers from successive layers

Suppose a descending filtration of ideals contains the powers of `I`, and the image of
`I ^ n` generates each successive layer. If reduction modulo the filtration distinguishes
elements of the `I`-adic completion, then each filtration term is the corresponding power of
`I`. The argument uses an adic Cauchy sequence to lift successive approximations as in the
[Stacks Project, Lemma 54.16.3](https://stacks.math.columbia.edu/tag/0C2K).
-/

public section

namespace Ideal

open AdicCompletion

variable {R : Type*} [CommRing R]

/-- A descending ideal filtration agrees with the powers of `I` if each successive
layer is generated by the corresponding power and the induced filtration on the
`I`-adic completion has zero intersection. -/
theorem eq_pow_of_sup_succ_of_adicCompletion (I : Ideal R) (J : ℕ → Ideal R)
    (hstep : ∀ n, I ^ n ⊔ J (n + 1) = J n)
    (hsep : ∀ a : AdicCompletion I R,
      (∀ n, evalₐ I n a ∈ (J n).map (Ideal.Quotient.mk (I ^ n))) → a = 0)
    (n : ℕ) : J n = I ^ n := by
  have hJ : Antitone J := antitone_nat_of_succ_le fun j ↦ le_sup_right.trans_eq (hstep j)
  refine le_antisymm (fun r hr ↦ ?_) ((hstep n).symm ▸ le_sup_left)
  have lift (j : ℕ) (x : {x : R // r - x ∈ J (n + j)}) :
      ∃ y : R, r - y ∈ J (n + j + 1) ∧ y - x ∈ I ^ (n + j) := by
    have hx : r - (x : R) ∈ I ^ (n + j) ⊔ J (n + j + 1) :=
      (hstep (n + j)).symm ▸ x.property
    obtain ⟨a, ha, b, hb, heq⟩ := Submodule.mem_sup.mp hx
    refine ⟨(x : R) + a, ?_, ?_⟩
    · have h : r - ((x : R) + a) = b := by rw [sub_add_eq_sub_sub, ← heq, add_sub_cancel_left]
      rw [h]
      exact hb
    · rwa [add_sub_cancel_left]
  classical
  choose next hnext hdiff using lift
  let seq : (j : ℕ) → {x : R // r - x ∈ J (n + j)} :=
    Nat.rec ⟨0, by simpa using hr⟩ fun j x ↦ ⟨next j x, hnext j x⟩
  have hdiff' (j : ℕ) : (seq (j + 1)).val - (seq j).val ∈ I ^ (n + j) := by
    -- Unfold the successor equation of the dependent recursion.
    change next j (seq j) - (seq j).val ∈ I ^ (n + j)
    exact hdiff j (seq j)
  have hmem (j : ℕ) : (seq j).val ∈ I ^ n := by
    induction j with
    | zero => exact zero_mem _
    | succ j ih =>
        exact sub_add_cancel (seq (j + 1)).val (seq j).val ▸
          add_mem (Ideal.pow_le_pow_right (Nat.le_add_right n j) (hdiff' j)) ih
  let s := AdicCauchySequence.mk (I := I) (M := R) (fun j ↦ (seq j).val) fun j ↦ by
    rw [SModEq.sub_mem]
    have hj : (seq j).val - (seq (j + 1)).val ∈ I ^ j :=
      neg_sub (seq (j + 1)).val (seq j).val ▸
        neg_mem (Ideal.pow_le_pow_right (Nat.le_add_left j n) (hdiff' j))
    simpa using hj
  let a := mkₐ I s
  have ha : of I R r - a = 0 := hsep _ fun j ↦ by
    rw [map_sub, evalₐ_of, evalₐ_mkₐ, ← map_sub]
    exact Ideal.mem_map_of_mem _
      (hJ (Nat.le_add_left j n) (seq j).property)
  have hzero : evalₐ I n a = 0 :=
    (evalₐ_mkₐ I n s).trans (Ideal.Quotient.eq_zero_iff_mem.mpr (hmem n))
  exact Ideal.Quotient.eq_zero_iff_mem.mp
    ((evalₐ_of I n r).symm.trans
      ((congrArg (evalₐ I n) (sub_eq_zero.mp ha)).trans hzero))

end Ideal
