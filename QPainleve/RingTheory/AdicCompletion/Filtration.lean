module

public import Mathlib.RingTheory.AdicCompletion.Basic

/-!
# Comparison of ideal filtrations in a complete ring

If a separated descending filtration contains the powers of an ideal and each successive
layer is already generated by the corresponding power, completeness identifies the two
filtrations.
-/

public section

namespace Ideal

/-- A separated decreasing family of ideals which contains the adic filtration and agrees
with it modulo the next term is the adic filtration in an adically precomplete ring. -/
theorem eq_pow_of_isPrecomplete_of_le_sup {A : Type*} [CommRing A] (I : Ideal A)
    [IsPrecomplete I A] (J : ℕ → Ideal A) (hJ : Antitone J) (hsep : ⨅ n, J n = ⊥)
    (hpow : ∀ n, I ^ n ≤ J n) (hstep : ∀ n, J n ≤ I ^ n ⊔ J (n + 1)) (n : ℕ) :
    J n = I ^ n := by
  classical
  refine le_antisymm (fun x hx ↦ ?_) (hpow n)
  have hlift (k : ℕ) (a : A) (ha : x - a ∈ J (n + k)) :
      ∃ z ∈ I ^ (n + k), x - (a + z) ∈ J (n + (k + 1)) := by
    obtain ⟨z, hz, w, hw, heq⟩ := Submodule.mem_sup.mp (hstep (n + k) ha)
    exact ⟨z, hz, by
      rw [← sub_sub, ← heq, add_sub_cancel_left]
      simpa [Nat.add_assoc] using hw⟩
  let a : (k : ℕ) → {y : A // x - y ∈ J (n + k)} :=
    Nat.rec ⟨0, by simpa using hx⟩ (fun k y ↦
      ⟨y.val + (hlift k y.val y.property).choose,
        (hlift k y.val y.property).choose_spec.2⟩)
  have ha (k : ℕ) : (a (k + 1)).val - (a k).val ∈ I ^ (n + k) := by
    simpa [a] using (hlift k (a k).val (a k).property).choose_spec.1
  have hc {k l : ℕ} (hkl : k ≤ l) : (a l).val - (a k).val ∈ I ^ (n + k) := by
    induction hkl with
    | refl => simp
    | @step l hkl ih =>
      rw [← sub_add_sub_cancel (a (l + 1)).val (a l).val (a k).val]
      exact add_mem (Ideal.pow_le_pow_right (Nat.add_le_add_left hkl n) (ha l)) ih
  have hC {k l : ℕ} (hkl : k ≤ l) :
      (a k).val ≡ (a l).val [SMOD (I ^ k • ⊤ : Submodule A A)] := by
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
    simpa only [neg_sub] using neg_mem (Ideal.pow_le_pow_right (Nat.le_add_left k n) (hc hkl))
  obtain ⟨y, hy⟩ := IsPrecomplete.prec (inferInstance : IsPrecomplete I A) @hC
  have hay (k : ℕ) : y - (a k).val ∈ I ^ k := by
    have h : (a k).val - y ∈ I ^ k := by
      simpa only [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] using hy k
    simpa only [neg_sub] using neg_mem h
  have hxy : x - y = 0 := by
    rw [← Ideal.mem_bot, ← hsep, Ideal.mem_iInf]
    intro k
    rw [← sub_add_sub_cancel x (a k).val y]
    exact add_mem (hJ (Nat.le_add_left k n) (a k).property)
      (hpow k (by simpa only [neg_sub] using neg_mem (hay k)))
  have hya : y ∈ I ^ n := by
    have h : (a n).val ∈ I ^ n := by simpa [a] using hc (Nat.zero_le n)
    simpa using add_mem (hay n) h
  exact sub_eq_zero.mp hxy ▸ hya

end Ideal
