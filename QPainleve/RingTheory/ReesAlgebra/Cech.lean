module

public import Mathlib.RingTheory.Regular.RegularSequence
public import TauCeti.RingTheory.GradedAlgebra.HomogeneousLocalization.Basic
public import TauCeti.RingTheory.ReesAlgebra.Grading
import QPainleve.RingTheory.Ideal.Operations
import TauCeti.RingTheory.Regular.RegularSequence

/-!
# The two-chart Čech sequence of an affine blowup

For an ideal generated by `a` and `b`, every function on the intersection of the two standard
blowup charts is a difference of chart functions. If `a, b` is a weakly regular pair and `b`
is a non-zero-divisor, the two chart functions agree precisely when both come from the same
base-ring element. The restriction maps are the homogeneous localization maps of the Rees
algebra.

The intersection calculation uses Tau Ceti's
`IsWeaklyRegular.mem_range_algebraMap_of_pow_mul_mem` in the total ring of fractions.
-/

public section

open HomogeneousLocalization Polynomial RingTheory.Sequence

namespace reesAlgebra

variable {R : Type*} [CommRing R] {I : Ideal R} {a b : R}

local notation "A" => monomialDegreeOne (I := I)
local notation "𝒜" => grade I
local notation:max "coeffMap(" ha ")" =>
  Algebra.algebraMap (self := HomogeneousLocalization.algebra 𝒜 (Submonoid.powers (A ha)))

private theorem exists_split_numerator (ha : a ∈ I) (hb : b ∈ I)
    (hI : Ideal.span {a, b} = I) {n : ℕ} {x : reesAlgebra I}
    (hx : x ∈ 𝒜 (n • (1 + 1))) :
    ∃ y ∈ 𝒜 (n • 1), ∃ z ∈ 𝒜 (n • 1), x = y * A hb ^ n - z * A ha ^ n := by
  have hx' : x ∈ 𝒜 (n + n) := by simpa [Nat.mul_two] using hx
  obtain ⟨r, hr, hrx⟩ := mem_grade_iff.mp hx'
  have hsup : Ideal.span {a} ⊔ Ideal.span {b} = I := by rw [← Ideal.span_insert, hI]
  rw [← hsup, Ideal.sup_pow_add_eq_pow_mul_sup_pow_mul, hsup,
    Ideal.span_singleton_pow, Ideal.span_singleton_pow] at hr
  obtain ⟨rₐ, hₐ, rᵦ, hᵦ, hr⟩ := Submodule.mem_sup.mp hr
  obtain ⟨s, hs, rfl⟩ := Ideal.mem_span_singleton_mul.mp hₐ
  obtain ⟨t, ht, rfl⟩ := Ideal.mem_span_singleton_mul.mp hᵦ
  refine ⟨⟨monomial n t, monomial_mem.mpr ht⟩, by simpa using monomial_mem_grade ht,
    ⟨monomial n (-s), monomial_mem.mpr ((I ^ n).neg_mem hs)⟩,
    by simpa using monomial_mem_grade ((I ^ n).neg_mem hs), Subtype.ext ?_⟩
  rw [← hrx, ← hr]
  simp only [Subalgebra.coe_sub, Subalgebra.coe_mul, Subalgebra.coe_pow, coe_monomialDegreeOne,
    monomial_pow, one_mul, monomial_mul_monomial, ← map_sub]
  congr 1
  ring

/-- Every section on the intersection of the two standard charts of a two-generated ideal
is a difference of restrictions from the charts. -/
theorem exists_awayMap_sub_awayMap_eq (ha : a ∈ I) (hb : b ∈ I)
    (hI : Ideal.span {a, b} = I) (w : Away 𝒜 (A ha * A hb)) :
    ∃ u : Away 𝒜 (A ha), ∃ v : Away 𝒜 (A hb),
      awayMap 𝒜 (monomialDegreeOne_mem_grade hb) rfl u -
        awayMap 𝒜 (monomialDegreeOne_mem_grade ha) (mul_comm (A ha) (A hb)) v = w := by
  let hₐ := monomialDegreeOne_mem_grade ha
  let hᵦ := monomialDegreeOne_mem_grade hb
  let hₐᵦ := SetLike.mul_mem_graded hₐ hᵦ
  obtain ⟨n, x, hx, rfl⟩ := Away.mk_surjective 𝒜 hₐᵦ w
  obtain ⟨y, hy, z, hz, rfl⟩ := exists_split_numerator ha hb hI hx
  refine ⟨Away.mk 𝒜 hₐ n y hy, Away.mk 𝒜 hᵦ n z hz, ?_⟩
  apply HomogeneousLocalization.val_injective
  simp only [awayMap_mk, val_sub, Away.val_mk, Localization.mk_eq_mk']
  rw [← IsLocalization.mk'_sub]
  rw [← sub_mul, IsLocalization.mk'_cancel]

private noncomputable abbrev evalAtOne (I : Ideal R) : reesAlgebra I →+* FractionRing R :=
  ((aeval (1 : FractionRing R)).comp (reesAlgebra I).val).toRingHom

private theorem isUnit_evalAtOne (ha : a ∈ I) (ha' : a ∈ nonZeroDivisors R) :
    IsUnit (evalAtOne I (A ha)) := by
  simpa [evalAtOne, coe_monomialDegreeOne] using
    IsLocalization.map_units (FractionRing R) (⟨a, ha'⟩ : nonZeroDivisors R)

private noncomputable abbrev chartToFractionRing (ha : a ∈ I) (ha' : a ∈ nonZeroDivisors R) :
    Away 𝒜 (A ha) →+* FractionRing R :=
  Away.lift 𝒜 (evalAtOne I) (isUnit_evalAtOne ha ha')

private theorem chartToFractionRing_algebraMap (ha : a ∈ I) (ha' : a ∈ nonZeroDivisors R)
    (r : R) : chartToFractionRing ha ha' (coeffMap(ha) r) =
      algebraMap R (FractionRing R) r := by
  simp [HomogeneousLocalization.algebraMap_eq_comp, ← HomogeneousLocalization.algebraMap_eq,
    ← gradeZeroEquiv_apply, evalAtOne, coe_gradeZeroEquiv]

private theorem chartToFractionRing_mk (ha : a ∈ I) (ha' : a ∈ nonZeroDivisors R)
    {n : ℕ} {x : reesAlgebra I} (hx : x ∈ 𝒜 (n • 1)) :
    algebraMap R (FractionRing R) (a ^ n) *
        chartToFractionRing ha ha' (Away.mk 𝒜 (monomialDegreeOne_mem_grade ha) n x hx) =
      algebraMap R (FractionRing R) ((x : R[X]).coeff n) := by
  have hₐ : evalAtOne I (A ha) = algebraMap R (FractionRing R) a := by
    simp [evalAtOne, coe_monomialDegreeOne]
  have hr : evalAtOne I x = algebraMap R (FractionRing R) ((x : R[X]).coeff n) := by
    have hx' : x ∈ 𝒜 n := by simpa using hx
    -- Use the degree of the numerator to evaluate it as a single monomial.
    have he := congrArg (aeval (1 : FractionRing R)) (mem_grade_iff_monomial_coeff.mp hx')
    simpa [evalAtOne] using he.symm
  have hu : ↑((isUnit_evalAtOne ha ha').unit ^ n) = algebraMap R (FractionRing R) (a ^ n) := by
    rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hₐ, map_pow]
  rw [Away.lift_mk, hr, ← hu, mul_left_comm, Units.mul_inv, mul_one]

private theorem chartToFractionRing_injective (ha : a ∈ I) (ha' : a ∈ nonZeroDivisors R) :
    Function.Injective (chartToFractionRing ha ha') := by
  refine (injective_iff_map_eq_zero _).mpr fun w hw ↦ ?_
  obtain ⟨n, x, hx, rfl⟩ := Away.mk_surjective 𝒜 (monomialDegreeOne_mem_grade ha) w
  have he := chartToFractionRing_mk ha ha' hx
  rw [hw, mul_zero, eq_comm, map_eq_zero_iff _ (IsFractionRing.injective R _)] at he
  have hx' : x ∈ 𝒜 n := by simpa using hx
  have hx0 : x = 0 := Subtype.ext (by
    simpa [he] using (mem_grade_iff_monomial_coeff.mp hx').symm)
  apply HomogeneousLocalization.val_injective
  simp [Away.val_mk, Localization.mk_eq_mk', hx0, IsLocalization.mk'_zero]

/-- Constants embed in the standard chart of a non-zero-divisor. -/
theorem injective_algebraMap_away_monomialDegreeOne (ha : a ∈ I) (ha' : a ∈ nonZeroDivisors R) :
    Function.Injective (coeffMap(ha)) := by
  intro r s h
  apply IsFractionRing.injective R (FractionRing R)
  simpa only [chartToFractionRing_algebraMap] using congrArg (chartToFractionRing ha ha') h

/-- For a weakly regular pair with regular second element, chart functions agree on the
intersection exactly when both are restrictions of the same constant. The center ideal may
contain the pair. -/
theorem awayMap_eq_iff_exists_eq_algebraMap (ha : a ∈ I) (hb : b ∈ I)
    (hab : IsWeaklyRegular R [a, b]) (hb' : b ∈ nonZeroDivisors R)
    {u : Away 𝒜 (A ha)} {v : Away 𝒜 (A hb)} :
    awayMap 𝒜 (monomialDegreeOne_mem_grade hb) rfl u =
        awayMap 𝒜 (monomialDegreeOne_mem_grade ha) (mul_comm (A ha) (A hb)) v ↔
      ∃ r : R, u = coeffMap(ha) r ∧ v = coeffMap(hb) r := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · have ha' : a ∈ nonZeroDivisors R :=
      ((Commute.isRegular_iff fun _ ↦ Commute.all _ _).2
        ((isWeaklyRegular_cons_iff R a [b]).mp hab).1).mem_nonZeroDivisors
    have hunit : IsUnit (evalAtOne I (A ha * A hb)) := by
      rw [map_mul]
      exact (isUnit_evalAtOne ha ha').mul (isUnit_evalAtOne hb hb')
    have huv := congrArg (Away.lift 𝒜 (evalAtOne I) hunit) h
    rw [← RingHom.comp_apply, Away.lift_comp_awayMap _ _ _ _ (isUnit_evalAtOne ha ha'),
      ← RingHom.comp_apply, Away.lift_comp_awayMap _ _ _ _ (isUnit_evalAtOne hb hb')] at huv
    obtain ⟨n, x, hx, rfl⟩ := Away.mk_surjective 𝒜 (monomialDegreeOne_mem_grade ha) u
    obtain ⟨m, y, hy, rfl⟩ := Away.mk_surjective 𝒜 (monomialDegreeOne_mem_grade hb) v
    obtain ⟨r, hr⟩ := hab.mem_range_algebraMap_of_pow_mul_mem
      ⟨_, (chartToFractionRing_mk ha ha' hx).symm⟩
      ⟨_, (chartToFractionRing_mk hb hb' hy).symm.trans (congrArg (_ * ·) huv).symm⟩
    refine ⟨r, chartToFractionRing_injective ha ha' ?_, chartToFractionRing_injective hb hb' ?_⟩
    · rw [chartToFractionRing_algebraMap, hr]
    · rw [chartToFractionRing_algebraMap, hr, huv]
  · rintro ⟨r, rfl, rfl⟩
    rw [awayMap_algebraMap, awayMap_algebraMap]

end reesAlgebra
