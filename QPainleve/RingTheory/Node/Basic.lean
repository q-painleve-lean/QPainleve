module

public import Mathlib.RingTheory.Ideal.Colon
public import TauCeti.RingTheory.Node.Basic
import TauCeti.RingTheory.Ideal.Colon
import TauCeti.RingTheory.Node.Flat

/-!
# Parameter and coordinate ideals of the node algebra

In the node algebra `xy = t`, the parameter ideal is the product of the two coordinate
ideals. When `t` acts regularly on the base ring, taking the colon by one coordinate
recovers the ideal of the other.
-/

public section

namespace TauCeti.NodeAlgebra

variable {R : Type*} [CommRing R] (t : R)

local notation "N" => NodeAlgebra R t

/-- After a change of coordinates, a split node is defined by the product of its two coordinates. -/
theorem ker_mk_zero_comp_algEquiv {A : Type*} [CommRing A] [Algebra R A]
    (e : A ≃ₐ[R] MvPolynomial (Fin 2) R) :
    RingHom.ker ((mk (0 : R)).comp e.toAlgHom).toRingHom =
      Ideal.span {e.symm (MvPolynomial.X 0) * e.symm (MvPolynomial.X 1)} := by
  refine (AlgHom.comap_ker (mk (0 : R)) e.toAlgHom).symm.trans ?_
  have hker : RingHom.ker (mk (0 : R) : MvPolynomial (Fin 2) R →+* NodeAlgebra R 0) =
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} := by simp
  refine (congrArg (Ideal.comap (e.toAlgHom : A →+* MvPolynomial (Fin 2) R)) hker).trans ?_
  exact (Ideal.map_symm e.toRingEquiv).symm.trans (by simp [Ideal.map_span])

/-- The ideal generated by the parameter is the product of the two coordinate ideals. -/
theorem span_parameter_eq_mul_span_coords (i : Fin 2) :
    Ideal.span {algebraMap R N t} = Ideal.span {coord t i} * Ideal.span {coord t (1 - i)} := by
  rw [Ideal.span_singleton_mul_span_singleton, coord_mul_coord_one_sub]

/-- For a regular parameter, taking the colon of the parameter ideal by one coordinate
recovers the ideal generated by the other coordinate. -/
theorem span_parameter_colon_coord (ht : IsSMulRegular R t) (i : Fin 2) :
    (Ideal.span {algebraMap R N t}).colon {coord t i} = Ideal.span {coord t (1 - i)} := by
  have ht' := (Commute.isRegular_iff (Commute.all t)).mpr ht.isLeftRegular
  have hreg : IsLeftRegular (coord t i) :=
    (isRegular_iff_mem_nonZeroDivisors.mpr (coord_mem_nonZeroDivisors ht'.mem_nonZeroDivisors
      i)).left
  rw [span_parameter_eq_mul_span_coords t i, Ideal.span_singleton_mul_colon_singleton hreg]

end TauCeti.NodeAlgebra
