module

public import TauCeti.RingTheory.FittingIdeal.Determinant

/-!
# Fitting ideals of composites of square presentations

For maps between finite free modules of the same rank, the zeroth cokernel Fitting
ideal of a composite is the product of the two zeroth cokernel Fitting ideals. The
calculation uses Tau Ceti's determinant formula for square presentations and the
multiplicativity of the determinant.
-/

public section

namespace LinearMap

open Module

variable {R M N P : Type*} [CommRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [AddCommGroup P] [Module R P]

/-- In bases with a common finite index, the zeroth Fitting ideal of the cokernel is
generated by the determinant of the matrix of the map. -/
theorem fittingIdeal_coker_zero_eq_span_det_toMatrix {ι : Type*} [Fintype ι] [DecidableEq ι]
    (bM : Basis ι R M) (bN : Basis ι R N) (f : M →ₗ[R] N) :
    letI := Module.Finite.of_basis bN
    TauCeti.fittingIdeal R (N ⧸ range f) 0 = Ideal.span {(toMatrix bM bN f).det} := by
  let := Module.Finite.of_basis bN
  let := Module.Free.of_basis bN
  let e := bN.equiv bM (Equiv.refl ι)
  let g := f.comp e.toLinearMap
  have hrange : range g = range f :=
    range_comp_of_range_eq_top f (range_eq_top.mpr e.surjective)
  rw [← hrange, fittingIdeal_coker_zero_eq_span_det, ← det_toMatrix bN,
    toMatrix_comp bN bM bN, toMatrix_basis_equiv, Matrix.mul_one]

variable [Module.Free R M] [Module.Finite R M] [Module.Free R N] [Module.Finite R N]
  [Module.Free R P] [Module.Finite R P]

/-- For a composite of maps between finite free modules of equal rank, the zeroth
Fitting ideal of the cokernel is the product of the ideals for the individual maps. -/
theorem fittingIdeal_coker_zero_comp_of_finrank_eq (g : N →ₗ[R] P) (f : M →ₗ[R] N)
    (hMN : finrank R M = finrank R N) (hNP : finrank R N = finrank R P) :
    TauCeti.fittingIdeal R (P ⧸ range (g.comp f)) 0 =
      TauCeti.fittingIdeal R (P ⧸ range g) 0 * TauCeti.fittingIdeal R (N ⧸ range f) 0 := by
  nontriviality R
  let bM := finBasis R M
  let bN := finBasisOfFinrankEq R N hMN.symm
  let bP := finBasisOfFinrankEq R P (hMN.trans hNP).symm
  rw [fittingIdeal_coker_zero_eq_span_det_toMatrix bM bP,
    fittingIdeal_coker_zero_eq_span_det_toMatrix bN bP,
    fittingIdeal_coker_zero_eq_span_det_toMatrix bM bN, toMatrix_comp bM bN bP,
    Matrix.det_mul, Ideal.span_singleton_mul_span_singleton]

end LinearMap
