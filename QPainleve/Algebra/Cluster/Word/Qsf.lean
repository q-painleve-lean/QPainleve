module

public import QPainleve.Algebra.Cluster.Word.ModularGroup
public import QPainleve.Algebra.Cluster.Word.SubtractionFree
public import QPainleve.Algebra.Cluster.Word.TerminalRelabel

/-!
# Signed loop substitutions in the universal coefficient semifield

Over a characteristic-zero field, signed loop pullbacks on the field of independent
X coordinates are multiplicatively equivalent to the substitutions on `TauCeti.Qsf`
obtained from mutations, inversions, and a terminal relabeling. The exchange matrix
after relabeling must equal the initial matrix. The equivalence respects composition
of pullbacks, which is the reverse of composition of point maps.

The comparison uses the subtraction-free word evaluation
`Quiver.Path.xPullback_comp_toXField_eq_eval_ySeed` and the universal substitution
`TauCeti.Qsf.eval`.
-/

public noncomputable section

open CategoryTheory Quiver TauCeti QPainleve.Cluster

variable {ι : Type*} [DecidableEq ι]

local notation "EndQsf" => Function.End (Qsf ι)
local notation "XField" k => FractionRing (AddMonoidAlgebra k (ι →₀ ℤ))

namespace QPainleve.Cluster

variable (k : Type*) [Field k] [CharZero k] (B : SkewExchangeMatrix ι)

private def signedLoopSubstitutionSet : Set EndQsf :=
  {f | ∃ (ps : List (Option ι)) (τ : Equiv.Perm ι),
    let s := (ps.map Generator.mutationOrInversion).foldl
      (fun t g ↦ g.ySeed t) (⟨Qsf.X, B.val⟩ : YSeed ι (Qsf ι))
    (∀ i j, s.exchangeMatrix.matrix (τ i) (τ j) = B.val.matrix i j) ∧
      ∀ x, f x = Qsf.eval (fun i ↦ s.coefficient (τ i)) x}

/-- The submonoid of universal coefficient substitutions generated by signed loops.
Each loop is a list of mutations and inversions closed by a terminal relabeling. -/
def signedLoopSubstitutions : Submonoid EndQsf :=
  Submonoid.closure (signedLoopSubstitutionSet B)

local notation "embedQsf" =>
  (fun x : Qsf ι ↦ QsfZero.toXField k (x : QsfZero ι))

omit [DecidableEq ι] in
private theorem embedQsf_injective : Function.Injective (embedQsf : Qsf ι → XField k) :=
  (QsfZero.toXField_injective k).comp Units.val_injective

private def loopSubstitution (f : signedLoopPullbacks k B) : EndQsf :=
  fun x ↦ Qsf.eval (((mem_signedLoopPullbacks_iff k B f.val).mp f.property).choose.ySeed
    ⟨Qsf.X, B.val⟩).coefficient x

private theorem semiconj_loopSubstitution (f : signedLoopPullbacks k B) :
    Function.Semiconj (embedQsf : Qsf ι → XField k) (loopSubstitution k B f) f.val := by
  intro x
  have hw := (mem_signedLoopPullbacks_iff k B f.val).mp f.property
  exact (hw.choose.xPullback_toXField_eval_ySeed k x).symm.trans
    (congrArg (fun a ↦ a (embedQsf x)) hw.choose_spec)

private theorem loopSubstitution_apply_of_word (f : signedLoopPullbacks k B) (w : Word B B)
    (hw : w.xPullback k = f.val) (x : Qsf ι) :
    loopSubstitution k B f x = Qsf.eval (w.ySeed ⟨Qsf.X, B.val⟩).coefficient x := by
  apply embedQsf_injective k
  exact (semiconj_loopSubstitution k B f x).trans
    (hw ▸ w.xPullback_toXField_eval_ySeed k x)

private def loopSubstitutionHom : signedLoopPullbacks k B →* EndQsf where
  toFun := loopSubstitution k B
  map_one' := by
    funext x
    apply embedQsf_injective k
    exact (semiconj_loopSubstitution k B 1 x).trans (AlgEquiv.one_apply _)
  map_mul' f g := by
    funext x
    apply embedQsf_injective k
    exact (semiconj_loopSubstitution k B (f * g) x).trans
      (((semiconj_loopSubstitution k B f).comp_right (semiconj_loopSubstitution k B g)) x).symm

private theorem loopSubstitutionHom_injective : Function.Injective (loopSubstitutionHom k B) := by
  intro f g h
  obtain ⟨w, hw⟩ := (mem_signedLoopPullbacks_iff k B f.val).mp f.property
  obtain ⟨v, hv⟩ := (mem_signedLoopPullbacks_iff k B g.val).mp g.property
  apply Subtype.ext
  rw [← hw, ← hv, w.xPullback_eq_iff_qsf_eval_eq k v]
  apply DFunLike.ext
  intro x
  have hx : loopSubstitution k B f x = loopSubstitution k B g x := congrFun h x
  simpa only [loopSubstitution_apply_of_word k B f w hw, loopSubstitution_apply_of_word k B g v hv]
    using hx

private theorem loopSubstitution_mem_set (f : signedLoopPullbacks k B) :
    loopSubstitution k B f ∈ signedLoopSubstitutionSet B := by
  obtain ⟨w, hw⟩ := (mem_signedLoopPullbacks_iff k B f.val).mp f.property
  let s : YSeed ι (Qsf ι) := ⟨Qsf.X, B.val⟩
  obtain ⟨ps, τ, h⟩ := Generator.exists_foldl_ySeed_eq_reindex w.generators s
  have hs := (w.ySeed_eq_foldl_generators s).trans h
  refine ⟨ps, τ, fun i j ↦ ?_, fun x ↦ ?_⟩
  · have he := w.ySeed_exchangeMatrix s rfl
    rw [hs, YSeed.reindex_exchangeMatrix] at he
    simpa using congrArg (fun e : ExchangeMatrix (Function.Embedding.refl ι) ↦ e.matrix i j) he
  · rw [loopSubstitution_apply_of_word k B f w hw]
    rw [hs]
    congr 2
    funext i
    simp [s]

private theorem exists_loopSubstitution_of_mem_set {f : EndQsf}
    (hf : f ∈ signedLoopSubstitutionSet B) : ∃ g, loopSubstitution k B g = f := by
  obtain ⟨ps, τ, hclose, heval⟩ := hf
  let gs := ps.map Generator.mutationOrInversion
  let p := Generator.wordOfList B (gs ++ [.permute τ])
  let s : YSeed ι (Qsf ι) := ⟨Qsf.X, B.val⟩
  have hs : p.2.ySeed s = YSeed.reindex τ.symm (gs.foldl (fun t g ↦ g.ySeed t) s) := by
    exact Generator.ySeed_wordOfList_append_permute B gs τ s
  have hp : p.1 = B :=
    (Generator.wordOfList_append_permute_fst_eq_iff B gs τ s rfl).mpr hclose
  let w := p.2.cast rfl hp
  have hw : w.ySeed s = p.2.ySeed s := by
    simp only [Path.ySeed_eq_foldl_generators, w, Path.generators_cast]
  refine ⟨⟨w.xPullback k, (mem_signedLoopPullbacks_iff k B _).mpr ⟨w, rfl⟩⟩, ?_⟩
  funext x
  rw [loopSubstitution_apply_of_word k B _ w rfl, hw, hs]
  rw [heval]
  congr 2
  funext i
  simp [s, gs]

private theorem signedLoopSubstitutionSet_eq_range :
    signedLoopSubstitutionSet B = Set.range (loopSubstitutionHom k B) := by
  ext f
  exact ⟨exists_loopSubstitution_of_mem_set k B, by
    rintro ⟨g, rfl⟩
    exact loopSubstitution_mem_set k B g⟩

private theorem signedLoopSubstitutions_eq_mrange :
    signedLoopSubstitutions B = MonoidHom.mrange (loopSubstitutionHom k B) := by
  rw [signedLoopSubstitutions, signedLoopSubstitutionSet_eq_range k B, MonoidHom.mclosure_range]

/-- Each substitution in the generated monoid comes from a single closed word.
Here `some i` denotes mutation at `i`, and `none` denotes global inversion. -/
@[simp]
theorem mem_signedLoopSubstitutions_iff (f : EndQsf) :
    f ∈ signedLoopSubstitutions B ↔
      ∃ (ps : List (Option ι)) (τ : Equiv.Perm ι),
        let s := (ps.map Generator.mutationOrInversion).foldl
          (fun t g ↦ g.ySeed t) (⟨Qsf.X, B.val⟩ : YSeed ι (Qsf ι))
        (∀ i j, s.exchangeMatrix.matrix (τ i) (τ j) = B.val.matrix i j) ∧
          ∀ x, f x = Qsf.eval (fun i ↦ s.coefficient (τ i)) x := by
  rw [signedLoopSubstitutions_eq_mrange ℚ B, ← SetLike.mem_coe, MonoidHom.coe_mrange,
    ← signedLoopSubstitutionSet_eq_range ℚ B]
  rfl

/-- Restrict characteristic-zero X pullbacks to the universal coefficient semifield.
The equivalence uses composition of substitutions on both sides. -/
def signedLoopPullbacksQsfMulEquiv : signedLoopPullbacks k B ≃* signedLoopSubstitutions B :=
  (MulEquiv.ofBijective (loopSubstitutionHom k B).mrangeRestrict
    ⟨fun _ _ h ↦ loopSubstitutionHom_injective k B (congrArg Subtype.val h),
      MonoidHom.mrangeRestrict_surjective _⟩).trans
    (MulEquiv.submonoidCongr (signedLoopSubstitutions_eq_mrange k B).symm)

/-- The restriction of a loop pullback substitutes the coefficients of its final Y-seed. -/
@[simp]
theorem signedLoopPullbacksQsfMulEquiv_apply_loop (w : Word B B) (x : Qsf ι) :
    (signedLoopPullbacksQsfMulEquiv k B
      (signedClusterModularGroupMap k B (End.of w)).unop).val x =
      Qsf.eval (w.ySeed ⟨Qsf.X, B.val⟩).coefficient x :=
  loopSubstitution_apply_of_word k B _ w
    (signedClusterModularGroupMap_unop_coe k B (End.of w)).symm x

/-- Embedding a restricted pullback in the X field agrees with applying the original
pullback after embedding. -/
theorem signedLoopPullbacksQsfMulEquiv_toXField (f : signedLoopPullbacks k B) (x : Qsf ι) :
    QsfZero.toXField k ((signedLoopPullbacksQsfMulEquiv k B f).val x : QsfZero ι) =
      f.val (QsfZero.toXField k (x : QsfZero ι)) :=
  semiconj_loopSubstitution k B f x

end QPainleve.Cluster
