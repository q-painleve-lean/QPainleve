module

public import TauCeti.Algebra.Polynomial.Laurent.Augmentation

/-!
# Evaluation at the root of a Laurent binomial

The normalized equation `1 + cT` cuts out the evaluation point `T = -c⁻¹`
when `c` is a unit.
-/

public section

open LaurentPolynomial

namespace TauCeti

/-- Evaluation at `-c⁻¹` has kernel generated by the normalized binomial `1 + cT`. -/
theorem ker_laurentEval_neg_inv {R : Type*} [CommRing R] (c : Rˣ) :
    RingHom.ker (laurentEval ((-1 : Rˣ) * c⁻¹)) =
      Ideal.span {(1 + C (c : R) * T 1 : LaurentPolynomial R)} := by
  rw [ker_laurentEval]
  have h : IsUnit (C (↑c⁻¹ : R)) := c⁻¹.isUnit.map C
  refine Eq.trans ?_ (Ideal.span_singleton_mul_right_unit h _)
  congr 2
  simp only [Units.val_neg, neg_one_mul, map_neg]
  calc
    T 1 - -C (↑c⁻¹ : R) = C (↑c⁻¹ : R) + T 1 := by ring
    _ = (1 + C (c : R) * T 1) * C (↑c⁻¹ : R) := by
      rw [add_mul, one_mul, mul_right_comm, ← map_mul, ← Units.val_mul, mul_inv_cancel,
        Units.val_one, map_one, one_mul]

end TauCeti
