module

public import Mathlib.AlgebraicGeometry.Birational.Birational
public import QPainleve.AlgebraicGeometry.Chow.Ample
public import QPainleve.AlgebraicGeometry.Chow.Nef.Cone
public import QPainleve.AlgebraicGeometry.Chow.RationalSurface.Ample

import Mathlib.Analysis.SpecificLimits.Basic
import QPainleve.AlgebraicGeometry.LineBundle.Ample
import QPainleve.Topology.Algebra.Module.RationalDensity
import TauCeti.Analysis.Convex.Topology

/-!
# The real ample cone of a rational surface

The positive real cone generated by ample line-bundle classes is the interior
of the real nef cone. Integral points in this interior are exactly the ample
line-bundle classes. The comparison uses the intersection bound
`exists_abs_realIntersectionBilinForm_le` and the density of classes with a
positive integral multiple. Tau Ceti's `Convex.interior_closure` then recovers
the entire open cone from those classes.
-/

public noncomputable section

open AlgebraicGeometry CategoryTheory Filter TopologicalSpace
open TauCeti.AlgebraicGeometry
open scoped TensorProduct Topology

namespace TauCeti.AlgebraicGeometry.Chow

open LineBundleClass

universe u

local notation "Pic(" X ")" => Additive (LineBundleClass X)
local notation "V(" X ")" => (ℝ ⊗[ℤ] Pic(X))
local notation "ι(" a ")" => ((1 : ℝ) ⊗ₜ[ℤ] Additive.ofMul a)

variable (k : Type u) [Field k] {X : Scheme.{u}}
  [X.Over (Spec (.of k))] [X.IsProjectiveOver k]
  [SmoothOfRelativeDimension 2 (X ↘ Spec (.of k))]
  [TopologicalSpace V(X)] [IsTopologicalAddGroup V(X)] [ContinuousSMul ℝ V(X)] [T2Space V(X)]

variable [IsAlgClosed k] [rational : Scheme.IsRationalOver (X ↘ Spec (.of k))]

section Nef

variable [IsIntegral X] [Module.Finite ℤ Pic(X)]

/-- An integral class is ample exactly when its real image is interior to the nef cone. -/
@[simp]
theorem one_tmul_mem_interior_nefCone_iff (a : LineBundleClass X) :
    ι(a) ∈ interior (nefCone k (X := X) : Set V(X)) ↔ a.IsAmple := by
  let : Module.Free ℤ Pic(X) := X.free_picard_of_isRationalOver k
  refine ⟨fun ha ↦ ?_, one_tmul_mem_interior_nefCone k⟩
  obtain ⟨h, hh⟩ := X.exists_isAmple_of_isProjectiveOver k
  -- Subtract a small ample class and clear the denominator to obtain a nef twist.
  have hlim : Tendsto (fun n : ℕ ↦ ι(a) - (n : ℝ)⁻¹ • ι(h)) atTop (𝓝 ι(a)) := by
    simpa only [zero_smul, sub_zero] using
      (tendsto_const_nhds (x := ι(a))).sub
        ((tendsto_inv_atTop_nhds_zero_nat (𝕜 := ℝ)).smul_const ι(h))
  obtain ⟨n, hn, hnef⟩ := ((eventually_gt_atTop 0).and
    (hlim (mem_interior_iff_mem_nhds.mp ha))).exists
  have hn' : 0 < (n : ℝ) := Nat.cast_pos.mpr hn
  have hscaled := (nefCone k (X := X)).smul_mem hnef hn'.le
  rw [smul_sub, smul_inv_smul₀ hn'.ne'] at hscaled
  have heq : (n : ℝ) • ι(a) - ι(h) = ι(h⁻¹ * a ^ n) := by
    simp only [ofMul_mul, ofMul_inv, ofMul_pow, TensorProduct.tmul_add, TensorProduct.tmul_neg,
      ← Nat.cast_smul_eq_nsmul ℤ, TensorProduct.tmul_smul, ← Int.cast_smul_eq_zsmul ℝ,
      Int.cast_natCast, sub_eq_add_neg, add_comm]
  rw [heq, one_tmul_mem_nefCone_iff] at hscaled
  apply IsAmple.of_pow hn
  simpa only [← mul_assoc, mul_inv_cancel, one_mul] using hh.mul_of_isNef hscaled

/-- A real class is ample exactly when it is in the interior of the real nef cone. -/
theorem ampleCone_eq_interior_nefCone :
    (ampleCone X : Set V(X)) = interior (nefCone k (X := X) : Set V(X)) := by
  let : Module.Free ℤ Pic(X) := X.free_picard_of_isRationalOver k
  let N := nefCone k (X := X)
  let U : ConvexCone ℝ V(X) :=
    { carrier := interior (N : Set V(X))
      smul_mem' := fun r hr x hx ↦ by
        have hm : Set.MapsTo (r • ·) (N : Set V(X)) N := fun _ hz ↦ N.smul_mem hz hr.le
        exact (isOpenMap_smul₀ hr.ne').mapsTo_interior hm hx
      add_mem' := fun x hx y hy ↦ by
        have hm : Set.MapsTo (· + y) (N : Set V(X)) N :=
          fun _ hz ↦ N.add_mem hz (interior_subset hy)
        exact (isOpenMap_add_right y).mapsTo_interior hm hx }
  have hle : ampleCone X ≤ U := by
    apply ConvexCone.hull_min
    rintro y ⟨a, ha, rfl⟩
    exact one_tmul_mem_interior_nefCone k ha
  refine Set.Subset.antisymm hle ?_
  have hd := (Module.finBasis ℤ Pic(X)).dense_setOf_exists_pos_natCast_smul_eq_one_tmul
  have hsubset : interior (N : Set V(X)) ⊆ closure (ampleCone X : Set V(X)) := by
    intro x hx
    apply closure_mono ?_ (hd.open_subset_closure_inter isOpen_interior hx)
    rintro y ⟨hy, n, hn, a, hny⟩
    have hn' : 0 < (n : ℝ) := Nat.cast_pos.mpr hn
    have hscaled : (n : ℝ) • y ∈ interior (N : Set V(X)) := U.smul_mem hn' hy
    have ha : a.toMul.IsAmple := (one_tmul_mem_interior_nefCone_iff k a.toMul).mp
      (by simpa only [ofMul_toMul, hny] using hscaled)
    rw [← inv_smul_smul₀ hn'.ne' y, hny]
    apply (ampleCone X).smul_mem (inv_pos.mpr hn')
    simpa only [ofMul_toMul] using one_tmul_mem_ampleCone ha
  calc
    interior (N : Set V(X)) = interior (interior (N : Set V(X))) := interior_interior.symm
    _ ⊆ interior (closure (ampleCone X : Set V(X))) := interior_mono hsubset
    _ = interior (ampleCone X : Set V(X)) := (ampleCone X).convex.interior_closure
    _ ⊆ ampleCone X := interior_subset

end Nef

include k in
/-- An integral point of the real ample cone is an ample line-bundle class. -/
theorem one_tmul_mem_ampleCone_iff (a : LineBundleClass X) :
    ι(a) ∈ ampleCone X ↔ a.IsAmple := by
  let : Smooth (X ↘ Spec (.of k)) := SmoothOfRelativeDimension.smooth 2 _
  let : IsIntegral X := rational.isIntegral_of_smooth
  let : Module.Finite ℤ Pic(X) := X.finite_picard_of_isRationalOver k
  rw [← SetLike.mem_coe, ampleCone_eq_interior_nefCone k, one_tmul_mem_interior_nefCone_iff k]

include k in
/-- The real ample cone of a smooth projective rational surface is open. -/
theorem isOpen_ampleCone : IsOpen (ampleCone X : Set V(X)) := by
  let : Smooth (X ↘ Spec (.of k)) := SmoothOfRelativeDimension.smooth 2 _
  let : IsIntegral X := rational.isIntegral_of_smooth
  let : Module.Finite ℤ Pic(X) := X.finite_picard_of_isRationalOver k
  rw [ampleCone_eq_interior_nefCone k (X := X)]
  exact isOpen_interior

end TauCeti.AlgebraicGeometry.Chow
