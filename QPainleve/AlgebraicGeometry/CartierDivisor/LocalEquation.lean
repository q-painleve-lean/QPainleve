module

public import QPainleve.AlgebraicGeometry.CartierDivisor.ZeroDivisor
public import QPainleve.AlgebraicGeometry.LineBundle.Ratio
import QPainleve.AlgebraicGeometry.LineBundle.Frame

/-!
# Local equations for zero ideals of line bundle sections

On an affine open framed by a section of the line bundle, the coefficient of a global
section in that frame generates its zero ideal.
The formula applies to every section, including zero.
-/

public section

open AlgebraicGeometry CategoryTheory MonoidalCategory MonoidalClosed Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Modules

universe u

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

variable {X : Scheme.{u}} (L : InvertibleSheaf X)

private theorem dualSectionEquiv_symm_app (s : Γ(L.obj, ⊤)) (U : X.Opens)
    (a : Γ((dual L).obj, U)) :
    let D : X.Modules := (ihom L.obj).obj (𝟙_ X.Modules)
    let v : L.obj ⊗ D ⟶ 𝟙_ X.Modules := L.evaluationDualIsoSheaf.hom
    (L.dualSectionEquiv.symm s).app U a =
      ((β_ D L.obj).hom ≫ v).app U (tmulRight D (L.obj.presheaf.map U.leTop.op s)
        (((eqToIso (dual_obj L)).hom : (dual L).obj ⟶ D).app U a)) := by
  dsimp only
  let D : X.Modules := (ihom L.obj).obj (𝟙_ X.Modules)
  let e : (dual L).obj ≅ D := eqToIso (dual_obj L)
  let σ : 𝟙_ X.Modules ⟶ L.obj := L.obj.unitHomEquivTop.symm s
  let φ := L.dualSectionEquiv.symm s
  have hσ : L.obj.dualHomUnitEquiv (e.inv ≫ φ) = σ := by
    apply L.obj.unitHomEquivTop.injective
    exact (L.dualSectionEquiv_apply φ).symm.trans
      ((L.dualSectionEquiv.apply_symm_apply s).trans
        (L.obj.unitHomEquivTop.apply_symm_apply s).symm)
  have hφ : φ = e.hom ≫ (λ_ D).inv ≫ σ ▷ D ≫ L.evaluationDualIsoSheaf.hom := by
    have hf := congrArg L.obj.dualHomUnitEquiv.symm hσ
    rw [Equiv.symm_apply_apply, dualHomUnitEquiv_symm_apply] at hf
    have hv : (ihom.ev L.obj).app (𝟙_ X.Modules) = L.evaluationDualIsoSheaf.hom :=
      (L.evaluationDualIsoSheaf_hom).symm
    exact (e.hom_inv_id_assoc φ).symm.trans
      ((congrArg (e.hom ≫ ·) hf).trans
        (congrArg (fun w : L.obj ⊗ D ⟶ 𝟙_ X.Modules ↦ e.hom ≫ (λ_ D).inv ≫ σ ▷ D ≫ w) hv))
  have hβ : (ρ_ D).inv ≫ D ◁ σ ≫ (β_ D L.obj).hom = (λ_ D).inv ≫ σ ▷ D := by
    rw [BraidedCategory.braiding_naturality_right, ← Category.assoc, rightUnitor_inv_braiding]
  let v : L.obj ⊗ D ⟶ 𝟙_ X.Modules := L.evaluationDualIsoSheaf.hom
  have hcomp : φ = e.hom ≫ (ρ_ D).inv ≫ D ◁ σ ≫ (β_ D L.obj).hom ≫ v :=
    hφ.trans ((congrArg (fun g ↦ e.hom ≫ g ≫ v) hβ.symm).trans (by simp only [Category.assoc]))
  -- Both sides are applications of maps of scheme modules, with the same bundled dual.
  change φ.app U a = _
  rw [hcomp]
  simp only [Hom.comp_app, ConcreteCategory.comp_apply, rightUnitor_inv_app_eq_tmulRight]
  have hsection : σ.app U (1 : Γ(X, U)) = L.obj.presheaf.map U.leTop.op s :=
    (unitHomEquivTop_symm_val_app L.obj s U 1).trans (one_smul _ _)
  let a' : Γ(D, U) := e.hom.app U a
  let one : Γ(𝟙_ X.Modules, U) := (1 : Γ(X, U))
  have hz := whiskerLeft_app_tmulRight D σ one a'
  -- The unitor rewrites the dual section as its tensor with the local unit.
  change v.app U ((β_ D L.obj).hom.app U ((D ◁ σ).app U (tmulRight D one a'))) =
    v.app U ((β_ D L.obj).hom.app U (tmulRight D (L.obj.presheaf.map U.leTop.op s) a'))
  exact congrArg (fun z ↦ v.app U ((β_ D L.obj).hom.app U z))
    (hz.trans (congrArg (fun t ↦ tmulRight D t a') hsection))

/-- In a local frame, the zero ideal on an affine open is generated by the coefficient
of the section in that frame. -/
theorem zeroIdeal_ideal_eq_span_singleton (s : Γ(L.obj, ⊤)) (U : X.affineOpens)
    (b : Γ(L.obj, U.val)) (hb : U.val ≤ L.obj.nonvanishingLocus b) :
    (L.zeroIdeal s).ideal U =
      Ideal.span {L.obj.sectionRatio (L.obj.presheaf.map U.val.leTop.op s) b hb} := by
  let u := U.val
  let c := L.obj.sectionRatio (L.obj.presheaf.map u.leTop.op s) b hb
  let e : (dual L).obj ≅ L.obj.dual := eqToIso (dual_obj L)
  let D : X.Modules := (ihom L.obj).obj (𝟙_ X.Modules)
  let q : D ⊗ L.obj ≅ 𝟙_ X.Modules :=
    (β_ D L.obj) ≪≫ L.evaluationDualIsoSheaf
  let evaluate (t : Γ(L.obj, u)) (a : Γ((dual L).obj, u)) :=
    Hom.app q.hom u (tmulRight D t (e.hom.app u a))
  have hq (a : Γ((dual L).obj, u)) :
      (L.dualSectionEquiv.symm s).app u a = c • evaluate b a := by
    refine (dualSectionEquiv_symm_app L s u a).trans ?_
    -- Replace the restricted section by its scalar multiple of the frame.
    change evaluate (L.obj.presheaf.map u.leTop.op s) a = c • evaluate b a
    rw [← L.obj.sectionRatio_smul (L.obj.presheaf.map u.leTop.op s) b hb]
    exact ((congrArg (Hom.app q.hom u) (tmulRight_smul D c b (e.hom.app u a))).trans
      (Hom.app_smul q.hom _ _))
  have hsurj : Function.Surjective (evaluate b) :=
    (ConcreteCategory.bijective_of_isIso ((sectionsFunctor u).mapIso q).hom).2.comp
      ((bijective_tmulRight_of_le_nonvanishingLocus _ b hb).2.comp
        (ConcreteCategory.bijective_of_isIso ((sectionsFunctor u).mapIso e).hom).2)
  rw [zeroIdeal_ideal]
  -- The generator in the statement is the coefficient c used above.
  change (L.dualSectionEquiv.symm s).imageIdeal u = Ideal.span {c}
  ext r
  rw [Hom.mem_imageIdeal, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨evaluate b a, (mul_comm _ _).trans (hq a).symm⟩
  · rintro ⟨d, rfl⟩
    obtain ⟨a, ha⟩ := hsurj d
    exact ⟨a, (hq a).trans ((congrArg (c • ·) ha).trans
      ((unit_smul_eq_mul X u c d).trans (mul_comm c d)))⟩

end TauCeti.AlgebraicGeometry.InvertibleSheaf
