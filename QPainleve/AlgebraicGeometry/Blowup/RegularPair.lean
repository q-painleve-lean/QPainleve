module

public import Mathlib.RingTheory.RegularLocalRing.Defs
public import QPainleve.RingTheory.Ideal.AffineBlowup
public import TauCeti.AlgebraicGeometry.Blowup.Exceptional
import Mathlib.Data.Bool.Set
import TauCeti.RingTheory.RegularLocalRing.CohenMacaulay
import TauCeti.RingTheory.RegularLocalRing.DimensionTwo

/-!
# Polynomial charts for a blowup along a regular pair

The blowup of `Spec A` in `(a, b)` has standard charts given by the equations
`aX = b` and `bY = a` for a permutable regular pair. On the first chart the
exceptional divisor has equation `a = 0`, and the overlap is the open where `X`
is invertible. These charts apply to the blowup of the maximal ideal of a
two-dimensional regular local ring.

The construction uses Tau Ceti's `affineBlowupι` and
`affineBlowupExceptionalIdeal`. See
[The Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
for the description of the blowup by affine charts of its Rees algebra.
-/

public section

open AlgebraicGeometry CategoryTheory Polynomial RingTheory.Sequence reesAlgebra
open TauCeti.AlgebraicGeometry
open AlgebraicGeometry.Scheme.IdealSheafData

namespace QPainleve

universe u

variable {A : Type u} [CommRing A] {I : Ideal A} {a b : A}

/-- The chart of `a` in the blowup of `(a, b)`, with polynomial coordinate `X = b/a`. -/
noncomputable def affineBlowupChartOfSpanPair (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    Spec (.of (AdjoinRoot (C a * X - C b))) ⟶ Proj (grade I) :=
  Spec.map (I.affineBlowupEquivOfSpanPair hI h).toRingEquiv.toCommRingCatIso.inv ≫
    affineBlowupι (Localization.Away a) (hI ▸ Ideal.subset_span (by simp))

/-- The polynomial chart embeds as an open subscheme of the blowup. -/
instance (hI : Ideal.span {a, b} = I) (h : IsWeaklyRegular A [a, b]) :
    IsOpenImmersion (affineBlowupChartOfSpanPair hI h) :=
  IsOpenImmersion.comp _ _

/-- The polynomial chart has image the standard open of the first generator. -/
@[simp]
theorem opensRange_affineBlowupChartOfSpanPair (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    (affineBlowupChartOfSpanPair hI h).opensRange =
      Proj.basicOpen (grade I)
        (monomialDegreeOne (hI ▸ Ideal.subset_span (by simp : a ∈ ({a, b} : Set A)))) := by
  exact (Scheme.Hom.opensRange_comp_of_isIso _ _).trans (opensRange_affineBlowupι _ _)

/-- The structural map of the polynomial chart is induced by the coefficient algebra. -/
@[reassoc (attr := simp)]
theorem affineBlowupChartOfSpanPair_toSpecZero (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    affineBlowupChartOfSpanPair hI h ≫ Proj.toSpecZero (grade I) ≫
        Spec.map (CommRingCat.ofHom ↑(gradeZeroEquiv I)) =
      Spec.map (CommRingCat.ofHom (algebraMap A (AdjoinRoot (C a * X - C b)))) := by
  rw [← RingEquiv.toCommRingCatIso_hom, affineBlowupChartOfSpanPair, Category.assoc,
    affineBlowupι_toSpecZero, ← Spec.map_comp]
  congr 1
  ext r
  simp

/-- The overlap with the second chart is the open where the first chart coordinate is a unit. -/
@[simp]
theorem affineBlowupChartOfSpanPair_preimage_basicOpen (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    affineBlowupChartOfSpanPair hI h ⁻¹ᵁ
        Proj.basicOpen (grade I)
          (monomialDegreeOne (hI ▸ Ideal.subset_span (by simp : b ∈ ({a, b} : Set A)))) =
      (PrimeSpectrum.basicOpen (AdjoinRoot.root (C a * X - C b)) :
        (Spec (.of (AdjoinRoot (C a * X - C b)))).Opens) := by
  rw [affineBlowupChartOfSpanPair, Scheme.Hom.comp_preimage,
    affineBlowupι_preimage_basicOpen, SpecMap_preimage_basicOpen]
  congr 1
  exact (I.affineBlowupEquivOfSpanPair hI h).symm_apply_eq.mpr
    (I.affineBlowupEquivOfSpanPair_apply_root hI h).symm

/-- The exceptional ideal on the polynomial chart is generated by the first parameter. -/
@[simp]
theorem affineBlowupExceptionalIdeal_comap_chartOfSpanPair (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    (affineBlowupExceptionalIdeal A I).comap (affineBlowupChartOfSpanPair hI h) =
      ofIdealTop ((Ideal.span {algebraMap A (AdjoinRoot (C a * X - C b)) a}).map
        (Scheme.ΓSpecIso (.of (AdjoinRoot (C a * X - C b)))).inv.hom) := by
  rw [affineBlowupExceptionalIdeal_def, ← comap_comp, RingEquiv.toCommRingCatIso_hom,
    affineBlowupChartOfSpanPair_toSpecZero,
    comap_ofIdealTop_map_ΓSpecIso_inv, CommRingCat.hom_ofHom,
    I.map_algebraMap_adjoinRoot_of_span_pair hI]

private theorem exceptionalChartMap_ker (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    (Spec.map (CommRingCat.ofHom ((I.adjoinRootQuotientSpanPairEquiv hI).toRingHom.comp
        (Ideal.Quotient.mk _)))).ker =
      (affineBlowupExceptionalIdeal A I).comap (affineBlowupChartOfSpanPair hI h) := by
  rw [Scheme.Hom.ker_Spec_map, CommRingCat.hom_ofHom,
    RingHom.ker_comp_of_injective _ (I.adjoinRootQuotientSpanPairEquiv hI).injective,
    Ideal.mk_ker, affineBlowupExceptionalIdeal_comap_chartOfSpanPair, AdjoinRoot.algebraMap_eq]

/-- The scheme-theoretic exceptional divisor in the polynomial chart is the affine line over
the center, with coordinate given by the class of the chart variable. -/
noncomputable def affineBlowupExceptionalChartIsoSpec (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    ((affineBlowupExceptionalIdeal A I).comap (affineBlowupChartOfSpanPair hI h)).subscheme ≅
      Spec (.of (A ⧸ I)[X]) := by
  let e := I.adjoinRootQuotientSpanPairEquiv hI
  let φ := CommRingCat.ofHom (e.toRingHom.comp (Ideal.Quotient.mk _))
  have : IsClosedImmersion (Spec.map φ) :=
    IsClosedImmersion.spec_of_surjective φ (e.surjective.comp Ideal.Quotient.mk_surjective)
  exact (asIso (Spec.map φ).toImage ≪≫
    eqToIso (congrArg (fun J : (Spec (.of (AdjoinRoot (C a * X - C b)))).IdealSheafData ↦
      J.subscheme) (exceptionalChartMap_ker hI h))).symm

/-- In exceptional coordinates, the inclusion into the ambient chart reduces coefficients
modulo the center ideal as in `Ideal.adjoinRootQuotientSpanPairEquiv_mk`. -/
@[reassoc (attr := simp)]
theorem affineBlowupExceptionalChartIsoSpec_inv_subschemeι (hI : Ideal.span {a, b} = I)
    (h : IsWeaklyRegular A [a, b]) :
    (affineBlowupExceptionalChartIsoSpec hI h).inv ≫
      ((affineBlowupExceptionalIdeal A I).comap (affineBlowupChartOfSpanPair hI h)).subschemeι =
    Spec.map (CommRingCat.ofHom ((I.adjoinRootQuotientSpanPairEquiv hI).toRingHom.comp
      (Ideal.Quotient.mk _))) := by
  unfold affineBlowupExceptionalChartIsoSpec
  simp only [Iso.symm_inv, Iso.trans_hom, asIso_hom, eqToIso.hom, Category.assoc]
  rw [← eqToHom_naturality
    (fun J : (Spec (.of (AdjoinRoot (C a * X - C b)))).IdealSheafData ↦ J.subschemeι)
    (exceptionalChartMap_ker hI h), eqToHom_refl, Category.comp_id]
  exact Scheme.Hom.toImage_imageι _

/-- The polynomial charts in both orders cover the blowup when the pair is regular in both
orders. -/
theorem sup_opensRange_affineBlowupChartOfSpanPair (hI : Ideal.span {a, b} = I)
    (hab : IsWeaklyRegular A [a, b]) (hba : IsWeaklyRegular A [b, a]) :
    (affineBlowupChartOfSpanPair hI hab).opensRange ⊔
      (affineBlowupChartOfSpanPair (Set.pair_comm a b ▸ hI) hba).opensRange = ⊤ := by
  have hcover := iSup_opensRange_affineBlowupι (s := fun i : Bool ↦ cond i a b)
    (by simpa [Bool.range_eq, Set.pair_comm b a] using hI)
  rw [iSup_bool_eq] at hcover
  simpa only [opensRange_affineBlowupι, opensRange_affineBlowupChartOfSpanPair] using hcover

/-- A two-dimensional regular local ring admits a parameter pair giving polynomial charts that
cover the blowup of its closed point. -/
theorem exists_affineBlowupChartOfSpanPair_cover [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) :
    ∃ (a b : A) (hI : Ideal.span {a, b} = IsLocalRing.maximalIdeal A)
      (hab : IsWeaklyRegular A [a, b]) (hba : IsWeaklyRegular A [b, a]),
      (affineBlowupChartOfSpanPair hI hab).opensRange ⊔
        (affineBlowupChartOfSpanPair (Set.pair_comm a b ▸ hI) hba).opensRange = ⊤ := by
  obtain ⟨a, b, hI⟩ := TauCeti.IsRegularLocalRing.exists_span_pair_eq_maximalIdeal hdim
  have hlen : ([a, b] : List A).length ≤ (IsLocalRing.maximalIdeal A).spanFinrank := by
    simp [TauCeti.IsRegularLocalRing.spanFinrank_maximalIdeal_eq_two hdim]
  have hab : IsRegular A [a, b] :=
    TauCeti.IsRegularLocalRing.isRegular_of_ofList_eq_maximalIdeal
      (by simpa [Ideal.span_insert] using hI) hlen
  have hba := IsLocalRing.isRegular_of_perm hab (List.Perm.swap b a [])
  exact ⟨a, b, hI, hab.toIsWeaklyRegular, hba.toIsWeaklyRegular,
    sup_opensRange_affineBlowupChartOfSpanPair hI _ _⟩

end QPainleve
