/-!
# Exceptional multiplicity of a strict transform

For a divisor equation of order `m` along a prime center generated by a
regular pair, the total transform equals the strict transform plus `m` times
the exceptional divisor on the blowup charts.

The strict transform is computed as the scheme-theoretic image of the
restriction away from the center, using Tau Ceti's `ker_blowupMap`.

## References

* P. Hacking, *583C Lecture notes (Compact Complex Surfaces)*, §7.2,
  [total transform of a divisor](https://paulhacking.github.io/surfaces.pdf#page=38).
* The Stacks Project, [Lemma 31.34.2](https://stacks.math.columbia.edu/tag/080E).
-/

public section

open CategoryTheory Limits TopologicalSpace
open TauCeti.AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.IdealSheafData

universe u

/-- The strict transform of a closed subscheme is obtained by restricting its total transform
off the exceptional divisor and taking the scheme-theoretic image in the blowup. -/
theorem ker_blowupMap_subschemeι_eq_map_comap {X : Scheme.{u}} (I J : X.IdealSheafData) :
    let E := I.comap I.blowupToBase
    let W : I.blowup.Opens := E.support.compl
    let j := W.ι
    (I.blowupMap J.subschemeι).ker = ((J.comap I.blowupToBase).comap j).map j := by
  let E := I.comap I.blowupToBase
  let W : I.blowup.Opens := E.support.compl
  let f := pullback.snd J.subschemeι I.blowupToBase
  have hW : f ⁻¹ᵁ W = (pullback.fst J.subschemeι I.blowupToBase ≫ J.subschemeι) ⁻¹ᵁ
      I.support.compl := by
    dsimp only [W, E]
    rw [compl_support_comap, ← Scheme.Hom.comp_preimage, ← pullback.condition]
  have hTotal : f.ker = J.comap I.blowupToBase := by
    simpa [f] using (ker_eq_comap_of_isPullback J.subschemeι
      (IsPullback.of_hasPullback J.subschemeι I.blowupToBase).flip)
  rw [I.ker_blowupMap, ← hW, ← morphismRestrict_ι, Scheme.Hom.ker_comp]
  rw [ker_eq_comap_of_isPullback f (isPullback_morphismRestrict f W), hTotal]

/-- On an open of a blowup, a factor of the total transform obtained by removing a power
of the exceptional ideal defines the strict transform if the exceptional complement in
that factor is schematically dense. -/
theorem comap_ker_blowupMap_subschemeι_eq_of_factor {X V Z : Scheme.{u}}
    (I J : X.IdealSheafData) [IsLocallyNoetherian X]
    (c : V ⟶ I.blowup) [IsOpenImmersion c] (q : Z ⟶ V) [IsClosedImmersion q] (n : ℕ)
    (h : J.comap (c ≫ I.blowupToBase) =
      q.ker * (I.comap (c ≫ I.blowupToBase)) ^ n)
    (hd : IsSchemeTheoreticallyDominant
      ((q ⁻¹ᵁ (I.comap (c ≫ I.blowupToBase)).support.compl).ι)) :
    (I.blowupMap J.subschemeι).ker.comap c = q.ker := by
  let E := I.comap I.blowupToBase
  let W : I.blowup.Opens := E.support.compl
  let U : V.Opens := c ⁻¹ᵁ W
  have hU : U = (E.comap c).support.compl := (compl_support_comap E c).symm
  have : IsLocallyNoetherian I.blowup := LocallyOfFiniteType.isLocallyNoetherian I.blowupToBase
  have hE : (E.comap c).comap U.ι = ⊤ :=
    (comap_eq_top_iff _ _).mpr (hU ▸ Scheme.Opens.ι_preimage_self U)
  have htotal : ((J.comap I.blowupToBase).comap c).comap U.ι = q.ker.comap U.ι := by
    rw [← comap_comp J c I.blowupToBase, h, comap_mul, comap_pow,
      comap_comp I c I.blowupToBase, hE]
    rw [← one_eq_top, one_pow, mul_one]
  have hcomp : U.ι ≫ c = c ∣_ W ≫ W.ι := (morphismRestrict_ι c W).symm
  let : IsSchemeTheoreticallyDominant ((q ⁻¹ᵁ U).ι) := by
    rw [hU, ← comap_comp]
    exact hd
  rw [ker_blowupMap_subschemeι_eq_map_comap,
    comap_map_of_isPullback_of_isOpenImmersion _ (isPullback_morphismRestrict c W).flip,
    ← comap_comp, ← hcomp, comap_comp, htotal, map_comap_ker_of_isSchemeTheoreticallyDominant]

open RingTheory.Sequence in
/-- On the chart of the first generator of a weakly regular pair, the ideal of the total
transform factors as the strict transform ideal times the exceptional ideal to the order
of the equation at the center. -/
theorem comap_totalTransform_eq_strictTransform_mul_pow {X : Scheme.{u}} [IsLocallyNoetherian X]
    (I J : X.IdealSheafData) (U : X.affineOpens) {a b f : Γ(X, U)}
    (hI : Ideal.span {a, b} = I.ideal U) [(I.ideal U).IsPrime]
    (h : IsWeaklyRegular Γ(X, U) [a, b]) (hJ : J.ideal U = Ideal.span {f})
    {n : ℕ} (hf : f ∈ I.ideal U ^ n) (hf' : f ∉ I.ideal U ^ (n + 1)) :
    let ha : a ∈ I.ideal U := hI ▸ Ideal.subset_span (Set.mem_insert _ _)
    let c := affineBlowupι (Localization.Away a) ha ≫ I.blowupChart U.property
    (J.comap I.blowupToBase).comap c = (I.blowupMap J.subschemeι).ker.comap c *
      ((I.comap I.blowupToBase).comap c) ^ n := by
  let hU : IsAffineOpen U.val := U.property
  let A := Γ(X, U)
  let B := (I.ideal U).affineBlowup a (Localization.Away a)
  let p := algebraMap A B a
  let ha : a ∈ I.ideal U := hI ▸ Ideal.subset_span (Set.mem_insert _ _)
  let c := affineBlowupι (Localization.Away a) ha ≫ I.blowupChart hU
  -- The chart pulls back equations by the coefficient map into the affine blowup algebra.
  have hc : c ≫ I.blowupToBase =
      Spec.map (CommRingCat.ofHom (algebraMap A B)) ≫ hU.fromSpec := by
    dsimp only [c]
    rw [Category.assoc, I.blowupChart_blowupToBase hU, ← Category.assoc,
      toSpecCoeff_reesAlgebra, affineBlowupι_toSpecZero]
  have hmap (K : X.IdealSheafData) :
      K.comap (c ≫ I.blowupToBase) =
        ofIdealTop (((K.ideal U).map (algebraMap A B)).map (Scheme.ΓSpecIso (.of B)).inv.hom) := by
    rw [hc, comap_comp, comap_fromSpec_eq_ofIdealTop K hU, comap_ofIdealTop_map_ΓSpecIso_inv]
    rfl
  have hE : I.comap (c ≫ I.blowupToBase) =
      ofIdealTop ((Ideal.span {p}).map (Scheme.ΓSpecIso (.of B)).inv.hom) := by
    rw [hmap, Ideal.map_algebraMap_affineBlowup ha]
  -- The quotient by the residual factor has a schematically dense exceptional complement.
  obtain ⟨g, hg, hgReg⟩ := Ideal.exists_affineBlowup_factor_of_mem_pow h hI hf hf'
  let P : Ideal B := Ideal.span {g}
  let R := B ⧸ P
  let φ : CommRingCat.of B ⟶ CommRingCat.of R := CommRingCat.ofHom (Ideal.Quotient.mk P)
  let q := Spec.map φ
  let : IsClosedImmersion q := IsClosedImmersion.spec_of_surjective φ Ideal.Quotient.mk_surjective
  have hker : q.ker = ofIdealTop ((Ideal.span {g}).map (Scheme.ΓSpecIso (.of B)).inv.hom) := by
    rw [Scheme.Hom.ker_Spec_map, CommRingCat.hom_ofHom, Ideal.mk_ker]
  have hfactor : J.comap (c ≫ I.blowupToBase) = q.ker * (I.comap (c ≫ I.blowupToBase)) ^ n := by
    rw [hmap, hJ, hker, hE, ← ofIdealTop_pow, ← ofIdealTop_mul,
      ← Ideal.map_pow, ← Ideal.map_mul, Ideal.map_span, Set.image_singleton]
    rw [hg, Ideal.span_singleton_pow, Ideal.span_singleton_mul_span_singleton, mul_comm g]
  have hregular : IsSMulRegular R (φ p) := by
    intro x y hxy
    -- The base-ring scalar action on the quotient is multiplication by its image.
    change p • x = p • y at hxy
    exact hgReg hxy
  let v := (Scheme.ΓSpecIso (.of R)).inv (φ p)
  have hv : IsSMulRegular Γ(Spec (.of R), ⊤) v :=
    (TauCeti.isSMulRegular_map_iff (Scheme.ΓSpecIso (.of R)).symm.commRingCatIsoToRingEquiv
      (φ p)).mpr hregular
  have hCartier : ((I.comap (c ≫ I.blowupToBase)).comap q).IsEffectiveCartier := by
    rw [hE, comap_ofIdealTop_map_ΓSpecIso_inv, Ideal.map_span, Set.image_singleton,
      Ideal.map_span, Set.image_singleton]
    simpa using Scheme.Hom.isEffectiveCartier_ofIdealTop_span_appTop
      (𝟙 (Spec (.of R))) hv
  have hd : IsSchemeTheoreticallyDominant
      ((q ⁻¹ᵁ (I.comap (c ≫ I.blowupToBase)).support.compl).ι) := by
    rw [← compl_support_comap]
    exact hCartier.isSchemeTheoreticallyDominant_support_compl_ι
  have : IsOpenImmersion c := @IsOpenImmersion.comp _ _ _
    (affineBlowupι (Localization.Away a) ha) (I.blowupChart hU)
    (instIsOpenImmersionAffineBlowupι (Localization.Away a) ha) inferInstance
  have hstrict : (I.blowupMap J.subschemeι).ker.comap c = q.ker :=
    comap_ker_blowupMap_subschemeι_eq_of_factor I J c q n hfactor hd
  rw [← hstrict] at hfactor
  simpa only [comap_comp J c _, comap_comp I c _] using hfactor

private theorem comap_ker_blowupMap_subschemeι_exceptionalCompl
    {X : Scheme.{u}} [IsLocallyNoetherian X] (I J : X.IdealSheafData) :
    let W : I.blowup.Opens := (I.comap I.blowupToBase).support.compl
    (I.blowupMap J.subschemeι).ker.comap W.ι = (J.comap I.blowupToBase).comap W.ι := by
  let W : I.blowup.Opens := (I.comap I.blowupToBase).support.compl
  have : IsLocallyNoetherian I.blowup := LocallyOfFiniteType.isLocallyNoetherian I.blowupToBase
  have he := comap_map_of_isOpenImmersion ((J.comap I.blowupToBase).comap W.ι) W.ι
  simpa only [ker_blowupMap_subschemeι_eq_map_comap] using he

open RingTheory.Sequence in
/-- A weakly regular pair around the whole center gives the total-transform formula on the
blowup. The remainder of the blowup lies in the exceptional complement. -/
theorem totalTransform_eq_strictTransform_mul_pow_of_affine {X : Scheme.{u}} [IsLocallyNoetherian X]
    (I J : X.IdealSheafData) (U : X.affineOpens) (hU : (I.support : Set X) ⊆ U.val)
    {a b f : Γ(X, U)} (hI : Ideal.span {a, b} = I.ideal U) [(I.ideal U).IsPrime]
    (hab : IsWeaklyRegular Γ(X, U) [a, b]) (hba : IsWeaklyRegular Γ(X, U) [b, a])
    (hJ : J.ideal U = Ideal.span {f}) {n : ℕ}
    (hf : f ∈ I.ideal U ^ n) (hf' : f ∉ I.ideal U ^ (n + 1)) :
    J.comap I.blowupToBase =
      (I.blowupMap J.subschemeι).ker * (I.comap I.blowupToBase) ^ n := by
  let E := I.comap I.blowupToBase
  let W : I.blowup.Opens := E.support.compl
  let hAff : IsAffineOpen U.val := U.property
  let c (d : Γ(X, U)) (hd : d ∈ I.ideal U) :=
    affineBlowupι (Localization.Away d) hd ≫ I.blowupChart hAff
  let s (i : Bool) := cond i a b
  have hs : Ideal.span (Set.range s) = I.ideal U := by
    simpa [s, Bool.range_eq, Set.pair_comm] using hI
  let m (i : Bool) : s i ∈ I.ideal U := hs ▸ Ideal.subset_span (Set.mem_range_self i)
  let C : I.blowup.OpenCover := Scheme.Cover.mkOfCovers (Option Bool)
    (fun i ↦ match i with
    | none => W.toScheme
    | some j => Spec (.of ((I.ideal U).affineBlowup (s j) (Localization.Away (s j)))))
    (fun i ↦ match i with
    | none => W.ι
    | some j => c (s j) (m j))
    (by
      -- Over the center the two standard charts cover, and W covers every other point.
      intro y
      by_cases hy : y ∈ W
      · exact ⟨none, ⟨y, hy⟩, rfl⟩
      · have hyE : y ∈ (E.support : Set I.blowup) := by
          by_contra h
          exact hy h
        have hyU : I.blowupToBase y ∈ U.val := by
          apply hU
          dsimp only [E] at hyE
          rwa [support_comap, Closeds.coe_preimage] at hyE
        obtain ⟨z, rfl⟩ : ∃ z, I.blowupChart hAff z = y := by
          rw [← Set.mem_range, ← Scheme.Hom.coe_opensRange, I.opensRange_blowupChart]
          exact hyU
        have hcover := iSup_opensRange_affineBlowupι (s := s) hs
        obtain ⟨j, hj⟩ := Opens.mem_iSup.mp (hcover ▸ Opens.mem_top z)
        have hj' : z ∈ Set.range (affineBlowupι (Localization.Away (s j)) (m j)) := by
          rwa [← Scheme.Hom.coe_opensRange]
        obtain ⟨x, rfl⟩ := hj'
        exact ⟨some j, x, rfl⟩)
    (by rintro (_ | j) <;> dsimp only [c] <;> infer_instance)
  apply ext_of_comap_openCover C
  intro j
  rw [comap_mul, comap_pow]
  cases j with
  | none =>
    -- Off the exceptional divisor, the strict and total transforms agree.
    have hW : E.comap W.ι = ⊤ := (comap_eq_top_iff _ _).mpr (Scheme.Opens.ι_preimage_self W)
    -- Evaluate the cover at its exceptional-complement member.
    change (J.comap I.blowupToBase).comap W.ι =
      (I.blowupMap J.subschemeι).ker.comap W.ι * (E.comap W.ι) ^ n
    rw [hW, ← one_eq_top, one_pow, mul_one, comap_ker_blowupMap_subschemeι_exceptionalCompl]
  | some j =>
    cases j
    · exact comap_totalTransform_eq_strictTransform_mul_pow I J U
        ((Set.pair_comm a b) ▸ hI) hba hJ hf hf'
    · exact comap_totalTransform_eq_strictTransform_mul_pow I J U
        hI hab hJ hf hf'

open RingTheory.Sequence in
/-- The total transform of an effective Cartier divisor under a blowup of a regular
closed point of local dimension two is its strict transform plus its multiplicity at
the point times the exceptional divisor. The equality is on the actual ideal sheaves. -/
theorem IsEffectiveCartier.totalTransform_eq_strictTransform_mul_pow_closedPoint
    {X : Scheme.{u}} [IsLocallyNoetherian X] [IsIntegral X] {p : X}
    [IsRegularLocalRing (X.presheaf.stalk p)] {J : X.IdealSheafData}
    (hJ : J.IsEffectiveCartier) (hp : IsClosed ({p} : Set X))
    (hdim : ringKrullDim (X.presheaf.stalk p) = 2) :
    let I := vanishingIdeal (Closeds.mk (closure {p}) isClosed_closure)
    J.comap I.blowupToBase =
      (I.blowupMap J.subschemeι).ker * (I.comap I.blowupToBase) ^ (J.stalkOrder p).toNat := by
  let I := vanishingIdeal (Closeds.mk (closure {p}) isClosed_closure)
  obtain ⟨V, -, hpV, f₀, -, hf₀⟩ := hJ.exists_eq_span_singleton_le ⊤ (Opens.mem_top p)
  obtain ⟨U, hpU, hUV, a, b, hab, hreg⟩ :=
    exists_mem_le_span_pair_vanishingIdeal_closure_singleton hdim hpV
  let f : Γ(X, U) := X.presheaf.map (homOfLE hUV).op f₀
  have hf : J.ideal U = Ideal.span {f} := J.ideal_eq_span_singleton_of_le hUV hf₀
  have hsupport : (I.support : Set X) ⊆ U.val := by
    rw [coe_support_vanishingIdeal, Closeds.coe_mk, hp.closure_eq]
    exact Set.singleton_subset_iff.mpr hpU
  let P := (U.property.primeIdealOf ⟨p, hpU⟩).asIdeal
  have hIP : I.ideal U = P := vanishingIdeal_closure_singleton_ideal p U hpU
  let : P.IsMaximal := U.property.primeIdealOf_isMaximal_of_isClosed ⟨p, hpU⟩ hp
  have hPrime : (I.ideal U).IsPrime := hIP.symm ▸ (inferInstance : P.IsPrime)
  let : Nonempty U.val := ⟨⟨p, hpU⟩⟩
  have hswap := hreg.swap_of_span_ne_top (hab.trans_ne hPrime.ne_top)
  have hord : J.stalkOrder p ≠ ⊤ := by
    obtain ⟨x, hx, hEq⟩ := hJ.exists_map_germ_eq_span_singleton U hpU
    rw [J.stalkOrder_def, ne_eq, Ideal.localOrder_eq_top_iff_eq_bot,
      J.stalkIdeal_eq_map U p hpU, hEq, Ideal.span_singleton_eq_bot]
    intro he
    exact one_ne_zero (hx (by simp [he]) : (1 : X.presheaf.stalk p) = 0)
  let n := (J.stalkOrder p).toNat
  have hn : (n : ℕ∞) = J.stalkOrder p := ENat.natCast_toNat hord
  have hpow (m : ℕ) : f ∈ I.ideal U ^ m ↔ (m : ℕ∞) ≤ J.stalkOrder p := by
    have he : (IsLocalRing.maximalIdeal (Localization.AtPrime P) ^ m).comap
        (algebraMap Γ(X, U) (Localization.AtPrime P)) = P ^ m :=
      IsLocalization.AtPrime.under_maximalIdeal_pow P (Localization.AtPrime P) m
    rw [J.stalkOrder_eq_orderAt U p hpU, Ideal.natCast_le_orderAt_iff, hIP,
      Ideal.map_le_iff_le_comap, he, hf, Ideal.span_singleton_le_iff_mem]
  refine totalTransform_eq_strictTransform_mul_pow_of_affine I J U hsupport hab hreg hswap hf
    ((hpow n).mpr hn.le) (fun hm ↦ ?_)
  have hle := (hpow (n + 1)).mp hm
  rw [← hn] at hle
  exact (Nat.not_succ_le_self n) (by exact_mod_cast hle)

end AlgebraicGeometry.Scheme.IdealSheafData
