/-!
# Picard groups of point blowups

Restriction to the complement of a closed point of codimension at least two preserves
the Picard group of a Noetherian locally factorial integral scheme. On the blowup the
corresponding restriction has kernel generated by the exceptional class when the
exceptional divisor is an exceptional curve of the first kind. The negative of the
restriction degree on that curve gives the integer coordinate in the Picard decomposition.

The excision argument follows P. Hacking, *583C Lecture notes (Compact Complex Surfaces)*,
Proposition 7.1, and uses Tau Ceti's
`LineBundleClass.pullback_eq_one_iff_mem_closure_of_isOpenImmersion`.
-/

public noncomputable section

open CategoryTheory Limits Order TopologicalSpace
open TauCeti.AlgebraicGeometry
open LineBundleClass

namespace AlgebraicGeometry.Scheme.IdealSheafData

universe u

variable {X : Scheme.{u}} (I : X.IdealSheafData) {p : X}

local notation "π" => blowupToBase I
local notation "E" => comap I π
local notation "eClass" =>
  (LineBundleClass.mk (IsEffectiveCartier.toInvertibleSheaf
    (isEffectiveCartier_comap_blowupToBase I)))⁻¹
local notation "U" => Closeds.compl (support I)
local notation "j" => Scheme.Opens.ι (π ⁻¹ᵁ U)
local notation "iU" => Scheme.Opens.ι U

/-- A line bundle pulled back from the base of a closed point blowup restricts to the
trivial class on the scheme-theoretic exceptional fiber. -/
@[simp]
theorem pullback_exceptionalSubschemeι_comp_blowupToBase (hI : (I.support : Set X) = {p})
    (a : LineBundleClass X) :
    pullback ((E).subschemeι ≫ π) a = 1 := by
  let c := (I.comapIso π).hom ≫ Limits.pullback.snd π I.subschemeι
  have hcomp : c ≫ I.subschemeι = (E).subschemeι ≫ π := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, comapIso_hom_fst]
  have hconstant (x : I.subscheme) : I.subschemeι x = p := by
    have hx : I.subschemeι x ∈ (I.support : Set X) :=
      I.range_subschemeι ▸ Set.mem_range_self x
    simpa only [hI, Set.mem_singleton_iff] using hx
  have hpRange : p ∈ Set.range I.subschemeι := by
    rw [I.range_subschemeι, hI]
    exact Set.mem_singleton p
  obtain ⟨q, -⟩ := hpRange
  rw [← hcomp, ← pullback_comp]
  apply Eq.trans (congrArg (pullback c) ?_) (pullback_one c)
  apply eq_one_of_forall_specializes (x := q)
  intro x
  apply I.subschemeι.isClosedEmbedding.isEmbedding.isInducing.specializes_iff.mp
  simp only [hconstant, specializes_refl]

private def picardBlowupHom :
    Additive (LineBundleClass X) × ℤ →+ Additive (LineBundleClass I.blowup) :=
  (MonoidHom.toAdditive (pullbackHom π)).coprod (zmultiplesHom _ (Additive.ofMul eClass))

private theorem picardBlowupHom_toMul (a : Additive (LineBundleClass X) × ℤ) :
    (picardBlowupHom I a).toMul = pullback π a.1.toMul * eClass ^ a.2 := by
  rw [picardBlowupHom, AddMonoidHom.coprod_apply, zmultiplesHom_apply, toMul_add,
    toMul_zsmul, MonoidHom.toAdditive_apply_apply, pullbackHom_apply, toMul_ofMul, toMul_ofMul]

private theorem intersectionNumber_picardBlowupHom (hI : (I.support : Set X) = {p})
    {k : Type u} [Field k] (e : projectiveLine k ≅ (E).subscheme)
    (he : intersectionNumber k (e.hom ≫ (E).subschemeι) eClass = -1)
    (a : Additive (LineBundleClass X) × ℤ) :
    intersectionNumber k (e.hom ≫ (E).subschemeι) (picardBlowupHom I a).toMul = -a.2 := by
  let d := (projectiveLine.picardDegreeEquiv k).toAddMonoidHom.comp
    (MonoidHom.toAdditive (pullbackHom (e.hom ≫ (E).subschemeι)))
  have d_apply (c : Additive (LineBundleClass I.blowup)) :
      d c = intersectionNumber k (e.hom ≫ (E).subschemeι) c.toMul := by
    rw [AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
      projectiveLine.picardDegreeEquiv_apply, MonoidHom.toAdditive_apply_apply, pullbackHom_apply,
      toMul_ofMul, intersectionNumber_def]
  have hbase : d (Additive.ofMul (pullback π a.1.toMul)) = 0 := by
    rw [d_apply, toMul_ofMul, intersectionNumber_def, pullback_comp, Category.assoc,
      ← pullback_comp, pullback_exceptionalSubschemeι_comp_blowupToBase I hI, pullback_one,
      eulerDegree_one]
  have hEdeg : d (Additive.ofMul eClass) = -1 := by
    rwa [d_apply, toMul_ofMul]
  rw [← d_apply, picardBlowupHom, AddMonoidHom.coprod_apply, zmultiplesHom_apply, map_add,
    map_zsmul, MonoidHom.toAdditive_apply_apply, pullbackHom_apply, hbase, hEdeg]
  simp

section Factorial

variable [IsIntegral X] [IsNoetherian X]
  [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]
  [∀ x : I.blowup, UniqueFactorizationMonoid (I.blowup.presheaf.stalk x)]

omit [∀ x : I.blowup, UniqueFactorizationMonoid (I.blowup.presheaf.stalk x)] in
private theorem bijective_pullback_compl_closedPoint (hI : (I.support : Set X) = {p})
    (hp' : 1 < coheight p) :
    Function.Bijective (pullbackHom iU) := by
  constructor
  · apply (injective_iff_map_eq_one _).2
    intro a ha
    rw [pullbackHom_apply] at ha
    have hset : {primeDivisorClass η | (η : CodimensionOnePoint X)
        (_ : (η : X) ∉ Set.range iU)} = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      rintro _ ⟨η, hη, rfl⟩
      have hmem : (η : X) ∈ (I.support : Set X) := by
        simpa only [Scheme.Opens.range_ι, Closeds.coe_compl, Set.mem_compl_iff, not_not] using hη
      have heq : (η : X) = p := by simpa [hI] using hmem
      exact hp'.ne' (heq ▸ η.property)
    have h := (pullback_eq_one_iff_mem_closure_of_isOpenImmersion iU).mp ha
    rwa [hset, Subgroup.closure_empty, Subgroup.mem_bot] at h
  · intro a
    obtain ⟨b, hb⟩ := pullback_surjective_of_isOpenImmersion iU a
    exact ⟨b, by rwa [pullbackHom_apply]⟩

omit [∀ x : I.blowup, UniqueFactorizationMonoid (I.blowup.presheaf.stalk x)] in
/-- Pullback to a blowup supported at a point of codimension at least two is injective on
Picard groups when the base is Noetherian, locally factorial and integral. -/
theorem pullback_blowupToBase_injective_of_support_eq_singleton
    (hI : (I.support : Set X) = {p}) (hp' : 1 < coheight p) :
    Function.Injective (pullback π) := by
  intro a b hab
  let e := asIso (π ∣_ U)
  have restrict (c : LineBundleClass X) :
      pullback j (pullback π c) = pullbackEquiv e (pullback iU c) := by
    simp only [pullbackEquiv_apply, e, asIso_hom, pullback_comp, morphismRestrict_ι]
  have h : pullback j (pullback π a) = pullback j (pullback π b) :=
    congrArg (pullback j) hab
  rw [restrict, restrict] at h
  have hU := (pullbackEquiv e).injective h
  exact (bijective_pullback_compl_closedPoint I hI hp').1
    (by simpa only [pullbackHom_apply] using hU)

omit [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)] in
private theorem pullback_eq_one_iff_exists_zpow_exceptionalClass
    (hI : (I.support : Set X) = {p}) (hp' : 1 < coheight p)
    [IsIntegral (E).subscheme] (a : LineBundleClass I.blowup) :
    pullback j a = 1 ↔ ∃ n : ℤ, eClass ^ n = a := by
  classical
  have hne : genericPoint X ≠ p := by
    intro h
    have hz : coheight (genericPoint X) = 0 :=
      coheight_eq_zero.mpr (TauCeti.AlgebraicGeometry.Scheme.isMax_genericPoint)
    rw [h] at hz
    simp [hz] at hp'
  have hU : Nonempty U := ⟨⟨genericPoint X, by
    rw [← SetLike.mem_coe, Closeds.coe_compl, Set.mem_compl_iff, hI, Set.mem_singleton_iff]
    exact hne⟩⟩
  have : IsIntegral I.blowup := I.isIntegral_blowup_of_nonempty_compl_support hU
  have : IsNoetherian I.blowup := isNoetherian_of_finiteType π
  let hCartier := I.isEffectiveCartier_comap_blowupToBase
  let η : CodimensionOnePoint I.blowup :=
    ⟨(E).subschemeι (genericPoint (E).subscheme), hCartier.coheight_subschemeι_genericPoint⟩
  have hset : {primeDivisorClass x | (x : CodimensionOnePoint I.blowup)
      (_ : (x : I.blowup) ∉ Set.range j)} = {primeDivisorClass η} := by
    have hmem (x : CodimensionOnePoint I.blowup) :
        (x : I.blowup) ∉ Set.range j ↔ x = η := by
      rw [Scheme.Opens.range_ι, ← compl_support_comap, Closeds.coe_compl,
        Set.mem_compl_iff, not_not]
      exact (hCartier.mem_support_iff_eq_subschemeι_genericPoint x.property).trans
        ⟨fun h ↦ Subtype.ext h, fun h ↦ congrArg Subtype.val h⟩
    ext c
    constructor
    · rintro ⟨x, hx, rfl⟩
      rw [(hmem x).mp hx]
      exact Set.mem_singleton _
    · intro hc
      exact ⟨η, (hmem η).mpr rfl, hc.symm⟩
  rw [pullback_eq_one_iff_mem_closure_of_isOpenImmersion j, hset,
    ← Subgroup.zpowers_eq_closure, Subgroup.mem_zpowers_iff]
  have hclass : primeDivisorClass η = eClass := by
    rw [primeDivisorClass_def]
    congr 1
    exact mk_toInvertibleSheaf_congr _ hCartier (E).vanishingIdeal_closure_subschemeι_genericPoint
  rw [hclass]

private theorem picardBlowupHom_surjective (hI : (I.support : Set X) = {p}) (hp' : 1 < coheight p)
    (hE : (E).IsExceptionalCurveOfFirstKind) : Function.Surjective (picardBlowupHom I) := by
  intro a
  let e := asIso (π ∣_ U)
  obtain ⟨b, hb⟩ := (bijective_pullback_compl_closedPoint I hI hp').2
    (pullback e.inv (pullback j a.toMul))
  rw [pullbackHom_apply] at hb
  have hb' : pullback j (pullback π b) = pullback j a.toMul := by
    rw [pullback_comp, ← morphismRestrict_ι, ← pullback_comp]
    exact (congrArg (pullback e.hom) hb).trans (by rw [pullback_comp, e.hom_inv_id, pullback_id])
  have hquot : pullback j (a.toMul / pullback π b) = 1 := by
    simp only [div_eq_mul_inv, pullback_mul, pullback_inv, hb', mul_inv_cancel]
  have : IsIntegral (E).subscheme := hE.isIntegral_subscheme
  obtain ⟨n, hn⟩ := (pullback_eq_one_iff_exists_zpow_exceptionalClass I hI hp' _).mp hquot
  refine ⟨(Additive.ofMul b, n), Additive.toMul.injective ?_⟩
  rw [picardBlowupHom_toMul, toMul_ofMul, hn, mul_comm, div_mul_cancel]

omit [∀ x : I.blowup, UniqueFactorizationMonoid (I.blowup.presheaf.stalk x)] in
private theorem picardBlowupHom_injective (hI : (I.support : Set X) = {p}) (hp' : 1 < coheight p)
    (hE : (E).IsExceptionalCurveOfFirstKind) : Function.Injective (picardBlowupHom I) := by
  obtain ⟨_, k, _, e, he⟩ := isExceptionalCurveOfFirstKind_iff_intersectionNumber.mp hE
  have hd := intersectionNumber_picardBlowupHom I hI e he
  intro a b hab
  have hn : a.2 = b.2 := by
    apply neg_injective
    rw [← hd a, ← hd b, hab]
  have hbase : pullback π a.1.toMul = pullback π b.1.toMul := by
    have h := congrArg Additive.toMul hab
    rw [picardBlowupHom_toMul, picardBlowupHom_toMul, hn] at h
    exact mul_right_cancel h
  exact Prod.ext (Additive.toMul.injective
    (pullback_blowupToBase_injective_of_support_eq_singleton I hI hp' hbase)) hn

/-- The Picard group of a blowup centered at a point of codimension at least two,
when the exceptional fiber is a first-kind exceptional curve. The two summands are
pullback from the base and integral multiples of the exceptional divisor. -/
def picardBlowupEquiv (hI : (I.support : Set X) = {p}) (hp' : 1 < coheight p)
    (hE : (E).IsExceptionalCurveOfFirstKind) :
    Additive (LineBundleClass X) × ℤ ≃+ Additive (LineBundleClass I.blowup) :=
  AddEquiv.ofBijective (picardBlowupHom I)
    ⟨picardBlowupHom_injective I hI hp' hE, picardBlowupHom_surjective I hI hp' hE⟩

/-- In the Picard decomposition, the class of `(L, n)` is `π*L ⊗ 𝒪(nE)`. -/
@[simp]
theorem picardBlowupEquiv_apply_toMul (hI : (I.support : Set X) = {p}) (hp' : 1 < coheight p)
    (hE : (E).IsExceptionalCurveOfFirstKind) (a : Additive (LineBundleClass X) × ℤ) :
    (picardBlowupEquiv I hI hp' hE a).toMul = pullback π a.1.toMul * eClass ^ a.2 :=
  picardBlowupHom_toMul I a

/-- The exceptional coefficient of a line-bundle class is minus its degree on the exceptional
projective line. The formula holds for every identification realizing normal degree `-1`. -/
theorem picardBlowupEquiv_symm_snd_eq_neg_intersectionNumber
    (hI : (I.support : Set X) = {p}) (hp' : 1 < coheight p) (hE : (E).IsExceptionalCurveOfFirstKind)
    {k : Type u} [Field k] (e : projectiveLine k ≅ (E).subscheme)
    (he : intersectionNumber k (e.hom ≫ (E).subschemeι) eClass = -1)
    (a : Additive (LineBundleClass I.blowup)) :
    ((picardBlowupEquiv I hI hp' hE).symm a).2 =
      -intersectionNumber k (e.hom ≫ (E).subschemeι) a.toMul := by
  let P := picardBlowupEquiv I hI hp' hE
  have hb : picardBlowupHom I (P.symm a) = a := P.apply_symm_apply a
  have h := intersectionNumber_picardBlowupHom I hI e he (P.symm a)
  rw [hb] at h
  rw [h, neg_neg]

end Factorial

end AlgebraicGeometry.Scheme.IdealSheafData
