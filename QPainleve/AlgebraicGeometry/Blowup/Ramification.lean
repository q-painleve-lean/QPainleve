/-!
# The Jacobian ideal of a point blowup

The ramification ideal of the blowup of a regular closed point of dimension two
is the exceptional ideal. In the chart with equation `aT = b`, the relative
Jacobian ideal is generated by `a`, the equation of the exceptional divisor.
The other chart interchanges the parameters.

See P. Hacking, [*583C Lecture notes*, Proposition 7.2](https://paulhacking.github.io/surfaces.pdf).
-/

open CategoryTheory Limits Polynomial RingTheory.Sequence TopologicalSpace reesAlgebra
open TauCeti TauCeti.AlgebraicGeometry

namespace AlgebraicGeometry.Scheme.IdealSheafData

universe u

variable {X : Scheme.{u}} {R : Type u} [CommRing R] [X.Over (Spec (.of R))]

section Charts

variable (I : X.IdealSheafData)
  [I.blowup.Over (Spec (.of R))] [I.blowupToBase.IsOver (Spec (.of R))]
  [(cokernel (cotangentMap R I.blowupToBase)).IsFiniteType]

private theorem ramification_comap_chartOfSpanPair {U : X.Opens} (hU : IsAffineOpen U)
    {a b : Γ(X, U)} (hI : Ideal.span {a, b} = I.ideal ⟨U, hU⟩)
    (h : IsWeaklyRegular Γ(X, U) [a, b]) :
    (ramificationIdealSheaf R I.blowupToBase).comap
        (QPainleve.affineBlowupChartOfSpanPair hI h ≫ I.blowupChart hU) =
      (I.comap I.blowupToBase).comap
        (QPainleve.affineBlowupChartOfSpanPair hI h ≫ I.blowupChart hU) := by
  let j := QPainleve.affineBlowupChartOfSpanPair hI h
  have hj : (j ≫ I.blowupChart hU) ≫ I.blowupToBase =
      Spec.map (CommRingCat.ofHom
        (algebraMap Γ(X, U) (AdjoinRoot (C a * Polynomial.X - C b)))) ≫
          hU.fromSpec := by
    rw [Category.assoc, I.blowupChart_blowupToBase, ← Category.assoc]
    exact congrArg (· ≫ hU.fromSpec) (by
      rw [toSpecCoeff_reesAlgebra, ← Category.assoc, RingEquiv.toCommRingCatIso_hom]
      exact QPainleve.affineBlowupChartOfSpanPair_toSpecZero hI h)
  rw [ramificationIdealSheaf_comap_of_isOpenImmersion R I.blowupToBase ⟨U, hU⟩ _ hj,
    AdjoinRoot.fittingIdeal_kaehlerDifferential_zero, comap_comp,
    I.comap_blowupChart_comap_blowupToBase,
    toSpecCoeff_reesAlgebra, ← affineBlowupExceptionalIdeal_def,
    QPainleve.affineBlowupExceptionalIdeal_comap_chartOfSpanPair]
  rw [derivative_sub, derivative_C_mul, derivative_X, mul_one, derivative_C, sub_zero]
  rfl

private theorem ramification_comap_comp_of_le_compl_support
    {B : Type u} [CommRing B] (j : Spec (.of B) ⟶ I.blowup) [IsOpenImmersion j]
    (hj : j.opensRange ≤ I.blowupToBase ⁻¹ᵁ I.support.compl) :
    (ramificationIdealSheaf R I.blowupToBase).comap j =
      (I.comap I.blowupToBase).comap j := by
  let W : X.Opens := I.support.compl
  let f := I.blowupToBase
  have hpre : ⊤ ≤ j ⁻¹ᵁ (f ⁻¹ᵁ W) :=
    (j.preimage_opensRange).symm.le.trans (j.preimage_mono hj)
  have hRange : Set.range j ⊆ Set.range (f ⁻¹ᵁ W).ι := by
    rw [Scheme.Opens.range_ι]
    exact hj
  let l := IsOpenImmersion.lift (f ⁻¹ᵁ W).ι j hRange
  have hl : IsOpenImmersion l := IsOpenImmersion.of_comp l (f ⁻¹ᵁ W).ι
  have : IsOpenImmersion (j ≫ f) := by
    have H : IsIso (f ∣_ W) := I.isIso_blowupToBase_restrict_of_disjoint_support disjoint_compl_left
    rw [← IsOpenImmersion.lift_fac (f ⁻¹ᵁ W).ι j hRange, Category.assoc, ← morphismRestrict_ι]
    exact IsOpenImmersion.comp _ _
  rw [ramificationIdealSheaf_comap_eq_top_of_isOpenImmersion_comp R f j]
  symm
  exact (comap_eq_top_iff _ _).mpr (by
    rw [compl_support_comap]
    exact top_unique hpre)

end Charts

variable {p : X}

local notation "Iₚ" =>
  vanishingIdeal (Closeds.mk (closure (Set.singleton p)) isClosed_closure)

/-- The ramification ideal of the blowup of a regular closed point of local dimension two
is the actual exceptional ideal sheaf. -/
public theorem ramificationIdealSheaf_blowup_closedPoint [IsLocallyNoetherian X]
    (hp : IsClosed ({p} : Set X)) [IsRegularLocalRing (X.presheaf.stalk p)]
    (hdim : ringKrullDim (X.presheaf.stalk p) = 2)
    [(Iₚ).blowup.Over (Spec (.of R))] [(Iₚ).blowupToBase.IsOver (Spec (.of R))]
    [(cokernel (cotangentMap R (Iₚ).blowupToBase)).IsFiniteType] :
    ramificationIdealSheaf R (Iₚ).blowupToBase = (Iₚ).comap (Iₚ).blowupToBase := by
  classical
  let I := (Iₚ)
  let f := I.blowupToBase
  let W := f ⁻¹ᵁ I.support.compl
  obtain ⟨U, hpU, -, a, b, hI, hab, hba⟩ :=
    exists_mem_le_span_pair_vanishingIdeal_closure_singleton hdim (Opens.mem_top p)
  have hI' := Set.pair_comm a b ▸ hI
  have hU : IsAffineOpen U.val := U.property
  let j₁ := QPainleve.affineBlowupChartOfSpanPair hI hab ≫ I.blowupChart hU
  let j₂ := QPainleve.affineBlowupChartOfSpanPair hI' hba ≫ I.blowupChart hU
  have : IsOpenImmersion j₁ := IsOpenImmersion.comp _ _
  have : IsOpenImmersion j₂ := IsOpenImmersion.comp _ _
  have hsupport : (I.support : Set X) = {p} :=
    (coe_support_vanishingIdeal _).trans hp.closure_eq
  let J := ramificationIdealSheaf R f
  let E := I.comap f
  have hcover (y : I.blowup) : ∃ (B : CommRingCat.{u}) (j : Spec B ⟶ I.blowup),
      IsOpenImmersion j ∧ y ∈ Set.range j ∧ J.comap j = E.comap j := by
    by_cases hy : y ∈ W
    · obtain ⟨V, hV, hyV, hVW⟩ := exists_isAffineOpen_mem_and_subset hy
      refine ⟨Γ(I.blowup, V), hV.fromSpec, inferInstance, ?_, ?_⟩
      · rwa [← Scheme.Hom.coe_opensRange, hV.opensRange_fromSpec]
      · apply ramification_comap_comp_of_le_compl_support I
        rwa [hV.opensRange_fromSpec]
    · have hfy : f y = p := by
        have h : f y ∈ (I.support : Set X) := by
          by_contra h
          exact hy (f.mem_preimage.mpr h)
        rwa [hsupport, Set.mem_singleton_iff] at h
      have hy' : y ∈ (I.blowupChart hU).opensRange := by
        rw [I.opensRange_blowupChart]
        exact f.mem_preimage.mpr (hfy ▸ hpU)
      obtain ⟨z, rfl⟩ := hy'
      have hz : z ∈ (QPainleve.affineBlowupChartOfSpanPair hI hab).opensRange ⊔
          (QPainleve.affineBlowupChartOfSpanPair hI' hba).opensRange := by
        rw [QPainleve.sup_opensRange_affineBlowupChartOfSpanPair hI hab hba]
        exact Opens.mem_top z
      rcases hz with ⟨q, rfl⟩ | ⟨q, rfl⟩
      · exact ⟨_, j₁, inferInstance, ⟨q, rfl⟩, ramification_comap_chartOfSpanPair I hU hI hab⟩
      · exact ⟨_, j₂, inferInstance, ⟨q, rfl⟩, ramification_comap_chartOfSpanPair I hU hI' hba⟩
  choose B j hj hy hEq using hcover
  let cov : I.blowup.OpenCover := Scheme.Cover.mkOfCovers I.blowup
    (fun y ↦ Spec (B y)) j (fun y ↦ (hy y).elim fun z hz ↦ ⟨y, z, hz⟩) hj
  exact ext_of_comap_openCover cov hEq

/-- On the blowup of a closed point of a smooth surface over a perfect field, the
ramification ideal is the exceptional ideal, with the canonical structure morphism
on the blowup. -/
public theorem ramificationIdealSheaf_blowup_of_smoothSurface
    (k : Type u) [Field k] [PerfectField k] [X.Over (Spec (.of k))]
    [SmoothOfRelativeDimension 2 (X ↘ Spec (.of k))] (hp : IsClosed ({p} : Set X)) :
    let I := (Iₚ)
    letI : I.blowup.Over (Spec (.of k)) := ⟨I.blowupToBase ≫ X ↘ Spec (.of k)⟩
    haveI : I.blowupToBase.IsOver (Spec (.of k)) := ⟨rfl⟩
    haveI : (cokernel (cotangentMap k I.blowupToBase)).IsFiniteType := by
      have : Smooth (I.blowup ↘ Spec (.of k)) :=
        (smoothOfRelativeDimension_blowup_closed_point (X ↘ Spec (.of k)) hp).smooth
      have := (isFiniteLocallyFree_relativeDifferentials k I.blowup).2
      infer_instance
    ramificationIdealSheaf k I.blowupToBase = I.comap I.blowupToBase := by
  let I := (Iₚ)
  let : I.blowup.Over (Spec (.of k)) := ⟨I.blowupToBase ≫ X ↘ Spec (.of k)⟩
  have : I.blowupToBase.IsOver (Spec (.of k)) := ⟨rfl⟩
  have : Smooth (I.blowup ↘ Spec (.of k)) :=
    (smoothOfRelativeDimension_blowup_closed_point (X ↘ Spec (.of k)) hp).smooth
  have := (isFiniteLocallyFree_relativeDifferentials k I.blowup).2
  have : Smooth (X ↘ Spec (.of k)) := SmoothOfRelativeDimension.smooth 2 _
  have : IsRegular X := IsRegular.of_smooth (X ↘ Spec (.of k))
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian (X ↘ Spec (.of k))
  exact ramificationIdealSheaf_blowup_closedPoint hp
    (((smoothOfRelativeDimension_iff_ringKrullDim_stalk_eq (X ↘ Spec (.of k)) 2).mp
      inferInstance).2 p hp)

end AlgebraicGeometry.Scheme.IdealSheafData
