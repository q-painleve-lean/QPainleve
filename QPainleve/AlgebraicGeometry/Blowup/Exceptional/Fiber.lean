/-!
# The projective spectrum of the exceptional fiber

The inverse image of the center in an affine blowup is the projective spectrum
of the associated graded ring of the center ideal. The Rees symbol map induces
the inclusion into the blowup. For an ideal generated by a weakly regular pair
the exceptional subscheme is the projective line over the center.

The proof uses Tau Ceti's `Proj.isPullback_map_of_isBaseChange` and its graded
polynomial description of the associated graded ring of a weakly regular sequence.

## References

* [The Stacks Project, Lemma 54.3.1](https://stacks.math.columbia.edu/tag/0AGQ)
-/

public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry reesAlgebra
open TauCeti.AlgebraicGeometry
open AlgebraicGeometry.Scheme.IdealSheafData

universe u

namespace QPainleve

variable {R : Type u} [CommRing R] (I : Ideal R)

local notation "π" => Proj.toSpecCoeff (grade I)
local notation "q" => Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))
local notation "E" => affineBlowupExceptionalIdeal R I
local notation "G" => Ideal.AssociatedGraded.grade I
local notation "ρ" => Proj.toSpecCoeff (R := R ⧸ I) (A := I.AssociatedGraded) G

-- Select the existing submodule instance using the ring structures used by `Proj`.
local instance : AddSubgroupClass (Submodule (R ⧸ I) I.AssociatedGraded) I.AssociatedGraded :=
  @Submodule.addSubgroupClass (R ⧸ I) I.AssociatedGraded
    (Ideal.Quotient.commRing I).toRing (DirectSum.commRing I.GradedPiece).toAddCommGroup
    Algebra.toModule

/-- The inclusion of the projectivized associated graded ring into the blowup, induced by
the Rees symbol map. -/
def affineBlowupAssociatedGradedι : Proj G ⟶ Proj (grade I) :=
  Proj.map (gradedToAssociatedGraded I)
    (HomogeneousIdeal.irrelevant_le_map_of_surjective _
      (gradedToAssociatedGraded_surjective I))

/-- Restricting a Rees basic open to the exceptional divisor takes its Rees symbol. -/
@[simp]
theorem affineBlowupAssociatedGradedι_preimage_basicOpen (s : reesAlgebra I) :
    affineBlowupAssociatedGradedι I ⁻¹ᵁ Proj.basicOpen (grade I) s =
      Proj.basicOpen G (toAssociatedGraded I s) := by
  rw [affineBlowupAssociatedGradedι, Proj.map_preimage_basicOpen, gradedToAssociatedGraded_apply]

private theorem reesSymbol_commutes (r : R) :
    gradedToAssociatedGraded I (algebraMap R (reesAlgebra I) r) =
      algebraMap R I.AssociatedGraded r :=
  (gradedToAssociatedGraded_apply I _).trans ((toAssociatedGraded I).commutes r)

/-- The projectivized associated graded ring is the scheme-theoretic inverse image of the
center of the affine blowup. -/
theorem isPullback_affineBlowupAssociatedGradedι :
    IsPullback (affineBlowupAssociatedGradedι I) ρ π q := by
  let A := ↥(reesAlgebra I)
  let B := I.AssociatedGraded
  let f : A →ₐ[R] B := AlgHom.mk (gradedToAssociatedGraded I).toRingHom
    (reesSymbol_commutes I)
  have hf : f = toAssociatedGraded I := AlgHom.ext (gradedToAssociatedGraded_apply I)
  have hbc : IsBaseChange (R ⧸ I) f.toLinearMap := by
    rw [hf]
    exact isBaseChange_toAssociatedGraded I
  -- Fix the algebra structures before applying the base-change theorem to the direct sum.
  have H := @Proj.isPullback_map_of_isBaseChange R A inferInstance inferInstance inferInstance
    (grade I) inferInstance (R ⧸ I) inferInstance inferInstance B
    inferInstance inferInstance inferInstance Ideal.AssociatedGraded.instIsScalarTowerQuotient
    G inferInstance (gradedToAssociatedGraded I) (reesSymbol_commutes I) hbc
  rw [affineBlowupAssociatedGradedι]
  exact H

/-- The Rees symbol map embeds the projectivized associated graded ring as a closed subscheme. -/
instance : IsClosedImmersion (affineBlowupAssociatedGradedι I) := by
  rw [affineBlowupAssociatedGradedι]
  exact Proj.isClosedImmersion_map _ _ (gradedToAssociatedGraded_surjective I)

/-- The ideal of the projectivized associated graded ring in the blowup is the exceptional
ideal. -/
@[simp]
theorem ker_affineBlowupAssociatedGradedι :
    (affineBlowupAssociatedGradedι I).ker = E := by
  have : IsClosedImmersion q := IsClosedImmersion.spec_of_surjective _
    (Ideal.Quotient.mk_surjective (I := I))
  rw [ker_eq_comap_of_isPullback q (isPullback_affineBlowupAssociatedGradedι I),
    Scheme.Hom.ker_Spec_map, CommRingCat.hom_ofHom, Ideal.mk_ker,
    affineBlowupExceptionalIdeal_def, ← toSpecCoeff_reesAlgebra]

/-- The exceptional closed subscheme of the affine blowup is the projective spectrum of
the associated graded ring of the ideal. -/
def affineBlowupExceptionalIsoProjAssociatedGraded : (E).subscheme ≅ Proj G := by
  let j := affineBlowupAssociatedGradedι I
  let f := IsClosedImmersion.lift j (E).subschemeι (by simp [j])
  have : IsIso f := IsClosedImmersion.isIso_of_ker_eq (E).subschemeι j f
    (IsClosedImmersion.lift_fac ..) (by simp [j])
  exact asIso f

/-- The exceptional subscheme isomorphism carries its closed immersion to the map on
projective spectra induced by the Rees symbol map. -/
@[reassoc (attr := simp)]
theorem affineBlowupExceptionalIsoProjAssociatedGraded_hom_ι :
    (affineBlowupExceptionalIsoProjAssociatedGraded I).hom ≫ affineBlowupAssociatedGradedι I =
      (E).subschemeι := by
  rw [affineBlowupExceptionalIsoProjAssociatedGraded, asIso_hom, IsClosedImmersion.lift_fac]

/-- The exceptional divisor of the affine blowup maps to its center. -/
def affineBlowupExceptionalToCenter : (E).subscheme ⟶ Spec (.of (R ⧸ I)) :=
  (affineBlowupExceptionalIsoProjAssociatedGraded I).hom ≫ ρ

/-- The associated graded comparison is an isomorphism over the center. -/
@[reassoc (attr := simp)]
theorem affineBlowupExceptionalIsoProjAssociatedGraded_hom_toSpec :
    (affineBlowupExceptionalIsoProjAssociatedGraded I).hom ≫ ρ =
      affineBlowupExceptionalToCenter I :=
  (rfl)

/-- The exceptional subscheme is the scheme-theoretic fiber over the closed center. -/
theorem isPullback_affineBlowupExceptionalToCenter :
    IsPullback (E).subschemeι (affineBlowupExceptionalToCenter I) π q :=
  (isPullback_affineBlowupAssociatedGradedι I).of_iso'
    (affineBlowupExceptionalIsoProjAssociatedGraded I) (.refl _) (.refl _) (.refl _)
    (by simp) (by simp) (by simp) (by simp)

/-- The map from the exceptional divisor to the base factors through the center. -/
@[reassoc (attr := simp)]
theorem affineBlowupExceptionalToCenter_comp :
    affineBlowupExceptionalToCenter I ≫ q = (E).subschemeι ≫ π :=
  (isPullback_affineBlowupExceptionalToCenter I).w.symm

section RegularPair

open RingTheory.Sequence

variable {I} {a b : R} (h : IsWeaklyRegular R [a, b]) (hI : Ideal.ofList [a, b] = I)

local notation "S" => R ⧸ I
local notation "P" => _root_.SymmetricAlgebra S (Fin 2 → S)
local notation "𝒜ₚ" => TauCeti.SymmetricAlgebra.homogeneousSubmodule S (Fin 2 → S)

/-- Homogeneous functions on the exceptional line in the coordinates of the ordered
weakly regular pair. -/
def affineBlowupParameterAlgebraEquiv : P ≃ₐ[S] I.AssociatedGraded :=
  (_root_.SymmetricAlgebra.equivMvPolynomial (Pi.basisFun S (Fin 2))).trans
    (h.associatedGradedEquiv hI)

private theorem parameterAlgebraEquiv_mem_grade_iff (n : ℕ) (p : P) :
    affineBlowupParameterAlgebraEquiv h hI p ∈ G n ↔ p ∈ 𝒜ₚ n := by
  rw [affineBlowupParameterAlgebraEquiv, AlgEquiv.trans_apply, Ideal.AssociatedGraded.mem_grade_iff,
    ← h.isHomogeneous_iff_associatedGradedEquiv_mem_range hI,
    _root_.SymmetricAlgebra.equivMvPolynomial_isHomogeneous_iff]

private def parameterGradedAlgHom : 𝒜ₚ →ₐᵍ[S] G where
  toAlgHom := (affineBlowupParameterAlgebraEquiv h hI).toAlgHom
  map_mem {n} p hp := (parameterAlgebraEquiv_mem_grade_iff h hI n p).2 hp

private def parameterGradedAlgHomInv : G →ₐᵍ[S] 𝒜ₚ where
  toAlgHom := (affineBlowupParameterAlgebraEquiv h hI).symm.toAlgHom
  map_mem {n} p hp := by
    apply (parameterAlgebraEquiv_mem_grade_iff h hI n _).1
    -- The graded map uses the underlying ring homomorphism of the inverse equivalence.
    change affineBlowupParameterAlgebraEquiv h hI
      ((affineBlowupParameterAlgebraEquiv h hI).symm p) ∈ G n
    rwa [AlgEquiv.apply_symm_apply]

private theorem parameterGradedAlgHom_rightInverse :
    Function.RightInverse (parameterGradedAlgHomInv h hI).toGradedRingHom
      (parameterGradedAlgHom h hI).toGradedRingHom :=
  fun p ↦ (affineBlowupParameterAlgebraEquiv h hI).apply_symm_apply p

private theorem parameterGradedAlgHom_leftInverse :
    Function.LeftInverse (parameterGradedAlgHomInv h hI).toGradedRingHom
      (parameterGradedAlgHom h hI).toGradedRingHom :=
  fun p ↦ (affineBlowupParameterAlgebraEquiv h hI).symm_apply_apply p

private def parameterProjIso : Proj G ≅ projectiveLine S :=
  Proj.mapIso (parameterGradedAlgHom h hI).toGradedRingHom
    (parameterGradedAlgHomInv h hI).toGradedRingHom
    (parameterGradedAlgHom_rightInverse h hI) (parameterGradedAlgHom_leftInverse h hI)

private theorem parameterProjIso_hom_toSpec :
    (parameterProjIso h hI).hom ≫ projectiveLine S ↘ Spec (.of S) = ρ := by
  rw [parameterProjIso, Proj.mapIso_hom, TauCeti.SymmetricAlgebra.over_eq_projToSpec,
    TauCeti.SymmetricAlgebra.projToSpec_def, ← Proj.toSpecCoeff_def]
  exact Proj.map_toSpecCoeff _ _ _ fun s ↦
    Subtype.ext ((parameterGradedAlgHom h hI).commutes s)

/-- The exceptional divisor of the blowup of a weakly regular pair is the projective line
over the center, with homogeneous coordinates corresponding to the ordered parameters. -/
def affineBlowupExceptionalIsoProjectiveLine :
    (E).subscheme ≅ projectiveLine S :=
  affineBlowupExceptionalIsoProjAssociatedGraded I ≪≫ parameterProjIso h hI

/-- The isomorphism with the projective line respects the structure morphisms to the center. -/
@[reassoc (attr := simp)]
theorem affineBlowupExceptionalIsoProjectiveLine_hom_toSpec :
    (affineBlowupExceptionalIsoProjectiveLine h hI).hom ≫ projectiveLine S ↘ Spec (.of S) =
      affineBlowupExceptionalToCenter I := by
  simp only [affineBlowupExceptionalIsoProjectiveLine, Iso.trans_hom, Category.assoc,
    parameterProjIso_hom_toSpec, affineBlowupExceptionalIsoProjAssociatedGraded_hom_toSpec]

private theorem affineBlowupExceptionalIsoProjectiveLine_inv_ι :
    (affineBlowupExceptionalIsoProjectiveLine h hI).inv ≫ (E).subschemeι =
      (parameterProjIso h hI).inv ≫ affineBlowupAssociatedGradedι I := by
  rw [affineBlowupExceptionalIsoProjectiveLine, Iso.trans_inv, Category.assoc,
    ← affineBlowupExceptionalIsoProjAssociatedGraded_hom_ι, Iso.inv_hom_id_assoc]

/-- The projective line with the exceptional immersion is the pullback of the affine
blowup along the closed immersion of the center. -/
theorem isPullback_affineBlowupExceptionalIsoProjectiveLine :
    IsPullback ((affineBlowupExceptionalIsoProjectiveLine h hI).inv ≫ (E).subschemeι)
      (projectiveLine S ↘ Spec (.of S)) π q := by
  refine (isPullback_affineBlowupExceptionalToCenter I).of_iso'
    (affineBlowupExceptionalIsoProjectiveLine h hI).symm (.refl _) (.refl _) (.refl _)
    (by simp) ?_ (by simp) (by simp)
  rw [Iso.symm_hom, Iso.refl_hom, Category.comp_id,
    ← affineBlowupExceptionalIsoProjectiveLine_hom_toSpec h hI, Iso.inv_hom_id_assoc]

/-- Under the Rees symbol map, a twisting sheaf on the affine blowup restricts to
the same twist on the projectivized associated graded ring. -/
def affineBlowupAssociatedGradedPullbackTwistingSheafIso (n : ℤ) :
    (Scheme.Modules.pullback (affineBlowupAssociatedGradedι I)).obj
      (Proj.twistingSheaf (grade I) n) ≅ Proj.twistingSheaf G n := by
  rw [affineBlowupAssociatedGradedι]
  let s (a : I) : reesAlgebra I := monomialDegreeOne a.property
  have hcover : ⨆ a : I, Proj.basicOpen (grade I) (s a) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top
    exact (irrelevant_eq_span_monomialDegreeOne (s := fun a : I ↦ (a : R)) (by simp)).le
  exact Proj.pullbackTwistingSheafIso (𝒜 := grade I) (ℬ := G) _ _
    s (fun a ↦ monomialDegreeOne_mem_grade a.property) hcover n

private def parameterProjIsoPullbackTwistingSheaf (n : ℤ) :
    (Scheme.Modules.pullback (parameterProjIso h hI).hom).obj
      (Proj.twistingSheaf 𝒜ₚ n) ≅ Proj.twistingSheaf G n := by
  rw [parameterProjIso, Proj.mapIso_hom]
  exact asIso (Proj.pullbackTwistingSheafMap _ _ n)

/-- The Rees twisting sheaf restricts to the twisting sheaf of the exceptional projective
line in every integer degree. The comparison uses the projective-line coordinates of the
ordered regular pair. -/
def affineBlowupExceptionalPullbackTwistingSheafIso (n : ℤ) :
    (Scheme.Modules.pullback ((affineBlowupExceptionalIsoProjectiveLine h hI).inv ≫
      (E).subschemeι)).obj (Proj.twistingSheaf (grade I) n) ≅ Proj.twistingSheaf 𝒜ₚ n := by
  let e := parameterProjIso h hI
  let L := Proj.twistingSheaf 𝒜ₚ n
  let j := affineBlowupAssociatedGradedι I
  have hcomp : (affineBlowupExceptionalIsoProjectiveLine h hI).inv ≫ (E).subschemeι = e.inv ≫ j :=
    affineBlowupExceptionalIsoProjectiveLine_inv_ι h hI
  exact (Scheme.Modules.pullbackCongr hcomp).app _ ≪≫
    ((Scheme.Modules.pullbackComp e.inv j).app _).symm ≪≫
    (Scheme.Modules.pullback e.inv).mapIso
      (affineBlowupAssociatedGradedPullbackTwistingSheafIso (I := I) n ≪≫
        (parameterProjIsoPullbackTwistingSheaf h hI n).symm) ≪≫
    (Scheme.Modules.pullbackComp e.inv e.hom).app L ≪≫
    (Scheme.Modules.pullbackCongr e.inv_hom_id).app L ≪≫
    (Scheme.Modules.pullbackId _).app L

/-- The coordinates of the exceptional projective line are the degree-one classes of
the ordered generators of the center ideal. -/
@[simp]
theorem affineBlowupParameterAlgebraEquiv_coord (j : Fin 2) :
    let hj : ([a, b] : List R)[(j : ℕ)] ∈ I := by
      rw [← hI]
      exact Ideal.subset_span (List.getElem_mem _)
    affineBlowupParameterAlgebraEquiv h hI (projectiveLine.coord S j) =
      Ideal.AssociatedGraded.mk I 1 ⟨[a, b][(j : ℕ)], by simpa only [pow_one] using hj⟩ := by
  intro hj
  have hι : _root_.SymmetricAlgebra.ι S (Fin 2 → S) (Pi.single j 1) =
      projectiveLine.coord S j := by
    fin_cases j <;> simp [projectiveLine.ι_eq_smul_coord_add_smul_coord S 0]
  rw [affineBlowupParameterAlgebraEquiv, AlgEquiv.trans_apply, ← hι, ← Pi.basisFun_apply,
    _root_.SymmetricAlgebra.equivMvPolynomial_ι_apply, h.associatedGradedEquiv_X]

/-- The restriction of a Rees basic open to the exceptional line is the basic open
of the homogeneous polynomial representing its symbol in the ordered parameters. -/
theorem preimage_basicOpen_affineBlowupExceptionalIsoProjectiveLine_of_symbol
    (s : reesAlgebra I) (p : P)
    (hp : affineBlowupParameterAlgebraEquiv h hI p = toAssociatedGraded I s) :
    ((affineBlowupExceptionalIsoProjectiveLine h hI).inv ≫ (E).subschemeι) ⁻¹ᵁ
      Proj.basicOpen (grade I) s = Proj.basicOpen 𝒜ₚ p := by
  rw [affineBlowupExceptionalIsoProjectiveLine_inv_ι, Scheme.Hom.comp_preimage,
    affineBlowupAssociatedGradedι_preimage_basicOpen, ← hp,
    parameterProjIso, Proj.mapIso_inv, Proj.map_preimage_basicOpen]
  congr 1
  exact (affineBlowupParameterAlgebraEquiv h hI).symm_apply_apply p

/-- The blowup chart of each parameter restricts on the exceptional line to the standard
open where its corresponding homogeneous coordinate is nonzero. -/
theorem preimage_basicOpen_affineBlowupExceptionalIsoProjectiveLine (j : Fin 2) :
    let hj : ([a, b] : List R)[(j : ℕ)] ∈ I := by
      rw [← hI]
      exact Ideal.subset_span (List.getElem_mem _)
    ((affineBlowupExceptionalIsoProjectiveLine h hI).inv ≫ (E).subschemeι) ⁻¹ᵁ
      Proj.basicOpen (grade I) (monomialDegreeOne hj) =
      Proj.basicOpen 𝒜ₚ (projectiveLine.coord S j) := by
  intro hj
  apply preimage_basicOpen_affineBlowupExceptionalIsoProjectiveLine_of_symbol
  rw [affineBlowupParameterAlgebraEquiv_coord, toAssociatedGraded_monomialDegreeOne]

end RegularPair

/-- Blowing up the closed point of a two-dimensional regular local ring has exceptional
divisor the projective line over its residue field. -/
theorem exists_affineBlowupExceptionalIsoProjectiveLine_of_isRegularLocalRing
    [IsRegularLocalRing R] (hdim : ringKrullDim R = 2) :
    let J := IsLocalRing.maximalIdeal R
    let S := R ⧸ J
    ∃ e : (affineBlowupExceptionalIdeal R J).subscheme ≅ projectiveLine S,
      e.hom ≫ projectiveLine S ↘ Spec (.of S) = affineBlowupExceptionalToCenter J := by
  dsimp only
  obtain ⟨a, b, hspan, hab, _, _⟩ :=
    exists_affineBlowupChartOfSpanPair_cover (A := R) hdim
  have hI : Ideal.ofList [a, b] = IsLocalRing.maximalIdeal R := by
    simpa [Ideal.span_insert] using hspan
  exact ⟨affineBlowupExceptionalIsoProjectiveLine hab hI,
    affineBlowupExceptionalIsoProjectiveLine_hom_toSpec hab hI⟩

end QPainleve

namespace AlgebraicGeometry.Scheme.IdealSheafData

open QPainleve RingTheory.Sequence

/-- If the center ideal on an affine open of the base is generated by a weakly regular pair,
then the inverse image of that part of the center in the scheme blowup is the projective line
over its quotient ring. -/
theorem isPullback_blowupChart_projectiveLine {X : Scheme.{u}} (J : X.IdealSheafData)
    {U : X.Opens} (hU : IsAffineOpen U) {a b : Γ(X, U)}
    (h : IsWeaklyRegular Γ(X, U) [a, b])
    (hJ : Ideal.ofList [a, b] = J.ideal ⟨U, hU⟩) :
    let I := J.ideal ⟨U, hU⟩
    let S := Γ(X, U) ⧸ I
    IsPullback ((affineBlowupExceptionalIsoProjectiveLine h hJ).inv ≫
      (affineBlowupExceptionalIdeal Γ(X, U) I).subschemeι ≫ J.blowupChart hU)
      (projectiveLine S ↘ Spec (.of S)) J.blowupToBase
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ hU.fromSpec) := by
  simpa only [Category.assoc] using
    (isPullback_affineBlowupExceptionalIsoProjectiveLine h hJ).paste_horiz
      (J.isPullback_blowupChart_fromSpec hU).flip

end AlgebraicGeometry.Scheme.IdealSheafData
