module

public import TauCeti.AlgebraicGeometry.LineBundle.ProjectiveLine
public import TauCeti.AlgebraicGeometry.LineBundle.GlobalGeneration.Pullback

import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.Ample

/-!
# Global generation on the projective line

A line bundle of nonnegative degree is globally generated by the comparison with the
standard twisting sheaves and their coordinate sections.
-/

public section

open CategoryTheory AlgebraicGeometry

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

universe u

open projectiveLine (coord coord_mem iSup_basicOpen_coord_eq_top nonempty_iso_twistingSheaf_iff)

/-- A line bundle whose degree on an isomorphic projective line is nonnegative is globally
generated. -/
theorem isGloballyGenerated_of_nonneg_eulerDegree_projectiveLine
    {k : Type u} [Field k] {X : Scheme.{u}} (L : InvertibleSheaf X) (e : projectiveLine k ≅ X)
    (hL : 0 ≤ ((pullback e.hom).obj L).eulerDegree k) : L.IsGloballyGenerated := by
  let P := (pullback e.hom).obj L
  let n := (P.eulerDegree k).toNat
  have hn : (n : ℤ) = P.eulerDegree k := Int.toNat_of_nonneg hL
  obtain ⟨t⟩ := (nonempty_iso_twistingSheaf_iff k P (n : ℤ)).mpr hn.symm
  let f (i : ULift.{u} (Fin 2)) := coord k i.down
  let 𝒜 := TauCeti.SymmetricAlgebra.homogeneousSubmodule k (Fin 2 → k)
  have hcover : (⨆ i, Proj.basicOpen 𝒜 (f i)) = ⊤ := by
    simpa only [f, 𝒜, iSup_ulift] using iSup_basicOpen_coord_eq_top k
  have hP : P.IsGloballyGenerated := (isGloballyGenerated_iff_of_iso t).mpr
    (Proj.isGloballyGenerated_twistingSheaf f (fun i ↦ coord_mem k i.down) hcover n)
  let ε : ((pullback e.inv).obj P).obj ≅ L.obj :=
    (Scheme.Modules.pullbackComp e.inv e.hom).app L.obj ≪≫
      (Scheme.Modules.pullbackCongr e.inv_hom_id).app L.obj ≪≫
      (Scheme.Modules.pullbackId _).app L.obj
  exact (isGloballyGenerated_iff_of_iso ε).mp (hP.pullback e.inv)

end TauCeti.AlgebraicGeometry.InvertibleSheaf
