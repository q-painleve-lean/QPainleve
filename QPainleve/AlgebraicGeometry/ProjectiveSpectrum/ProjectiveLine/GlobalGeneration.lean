module

public import TauCeti.AlgebraicGeometry.LineBundle.ProjectiveLine
public import TauCeti.AlgebraicGeometry.LineBundle.GlobalGeneration.Pullback

import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.GlobalGeneration
import TauCeti.CategoryTheory.Limits.Shapes.ZeroMorphisms

/-!
# Global generation on the projective line

A line bundle of nonnegative degree is globally generated by the comparison with the
standard twisting sheaves and their coordinate sections. Serre global generation also
gives a nonzero morphism from a twisting sheaf to any nonzero quasi-coherent sheaf of
finite type.
-/

public section

open CategoryTheory AlgebraicGeometry

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

universe u

open projectiveLine (coord coord_mem iSup_basicOpen_coord_eq_top nonempty_iso_twistingSheaf_iff)

/-- A line bundle whose degree on an isomorphic projective line is nonnegative is globally
generated. -/
theorem isGloballyGenerated_of_nonneg_eulerDegree_projectiveLine
    {k : Type u} [Field k] {X : Scheme.{u}} (L : InvertibleSheaf X) (e : projectiveLine k ≅ X)
    (hL : 0 ≤ ((pullback e.hom).obj L).eulerDegree k) : L.IsGloballyGenerated := by
  let P := (pullback e.hom).obj L
  let n := (P.eulerDegree k).toNat
  have hn : (n : ℤ) = P.eulerDegree k := Int.toNat_of_nonneg hL
  obtain ⟨t⟩ := (nonempty_iso_twistingSheaf_iff k P (n : ℤ)).mpr hn.symm
  let f (i : ULift.{u} (Fin 2)) := coord k i.down
  let 𝒜 := TauCeti.SymmetricAlgebra.homogeneousSubmodule k (Fin 2 → k)
  have hcover : (⨆ i, Proj.basicOpen 𝒜 (f i)) = ⊤ := by
    simpa only [f, 𝒜, iSup_ulift] using iSup_basicOpen_coord_eq_top k
  have hP : P.IsGloballyGenerated := (isGloballyGenerated_iff_of_iso t).mpr
    (Proj.isGloballyGenerated_twistingSheaf f (fun i ↦ coord_mem k i.down) hcover n)
  let ε : ((pullback e.inv).obj P).obj ≅ L.obj :=
    (Scheme.Modules.pullbackComp e.inv e.hom).app L.obj ≪≫
      (Scheme.Modules.pullbackCongr e.inv_hom_id).app L.obj ≪≫
      (Scheme.Modules.pullbackId _).app L.obj
  exact (isGloballyGenerated_iff_of_iso ε).mp (hP.pullback e.inv)

end TauCeti.AlgebraicGeometry.InvertibleSheaf

namespace TauCeti.AlgebraicGeometry.projectiveLine

open CategoryTheory.Limits MonoidalCategory

universe u

variable (k : Type u) [CommRing k]

local notation "P" => projectiveLine k
local notation "𝒜" => TauCeti.SymmetricAlgebra.homogeneousSubmodule k (Fin 2 → k)
local notation "𝒪(" n ")" => Proj.twistingSheaf 𝒜 n

/-- A nonzero quasi-coherent sheaf of finite type on the projective line admits a nonzero
morphism from a twist of the structure sheaf. -/
theorem exists_nonzero_twisting_hom (M : (P).Modules)
    [M.IsQuasicoherent] [M.IsFiniteType] (hM : ¬ IsZero M) :
    ∃ (a : ℤ) (f : 𝒪(a) ⟶ M), f ≠ 0 := by
  obtain ⟨n, σ, -⟩ := (Proj.eventually_exists_generatingSections_tensor_twistingSheaf
    (coord k) (coord_mem k) (iSup_basicOpen_coord_eq_top k) M).exists
  let L : InvertibleSheaf P := ⟨𝒪(n), inferInstance⟩
  let F := tensorRight L.obj
  have : F.IsEquivalence := by
    change (tensorRight L.obj).IsEquivalence
    rw [← InvertibleSheaf.tensorRightDualEquivalence_inverse]
    infer_instance
  let : MonoidalPreadditive (P).Modules := TauCeti.SheafOfModules.monoidalPreadditive (P).sheaf
  let e : (𝒪(-(n : ℤ)) ⊗ 𝒪(n)) ≅ 𝟙_ (P).Modules :=
    Proj.twistingSheaf.tensorObjIso (coord k) (coord_mem k) (iSup_basicOpen_coord_eq_top k)
      (-(n : ℤ)) n ≪≫ eqToIso (by rw [neg_add_cancel]) ≪≫
      (Proj.unitIsoTwistingSheafZero 𝒜).symm
  by_contra! hn
  have h (g : 𝟙_ (P).Modules ⟶ M ⊗ 𝒪(n)) : g = 0 := by
    obtain ⟨f, hf⟩ := F.map_surjective (e.hom ≫ g)
    have hz : e.hom ≫ g = 0 := by rw [← hf, hn _ f, F.map_zero]
    exact (comp_eq_zero_iff_of_epi _).mp hz
  have hπ : σ.π = 0 := by
    apply Cofan.IsColimit.hom_ext (SheafOfModules.isColimitFreeCofan σ.I)
    intro j
    exact (h _).trans (comp_zero (f := _)).symm
  have hm : IsZero (F.obj M) :=
    @IsZero.of_epi_eq_zero (P).Modules _ _ _ (F.obj M) σ.π σ.epi hπ
  exact hM (Functor.isZero_of_isZero_obj F hm)

end TauCeti.AlgebraicGeometry.projectiveLine
