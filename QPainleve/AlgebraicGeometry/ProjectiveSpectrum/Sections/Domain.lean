/-!
# The domain of a projective section presentation

On the inverse image of a standard chart of a regular representative, the corresponding
coordinate section divides all the others locally. Thus the base ideal is locally
generated by that section on the rational map's domain. When the base ideal has no
divisorial components, its support is exactly the indeterminacy locus.

The calculation uses the normalized coordinates of projective space, as in the Stacks
Project, [Section 27.13](https://stacks.math.columbia.edu/tag/01ND).
-/

public section

open CategoryTheory HomogeneousLocalization Opposite TopologicalSpace
open AlgebraicGeometry AlgebraicGeometry.Scheme.Modules TauCeti.MvPolynomial

universe u

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

attribute [local instance] MvPolynomial.gradedAlgebra

variable {X : Scheme.{u}} [IsIntegral X] {R ι : Type u} [CommRing R]
  (L : InvertibleSheaf X) (f : X ⟶ Spec (.of R)) (s : ι → Γ(L.obj, ⊤))

local notation "𝒜" => MvPolynomial.homogeneousSubmodule ι R
local notation "ℙ" => Proj 𝒜
local notation "D[" i "]" => L.obj.nonvanishingLocus (s i)
local notation "B[" i "]" => Away 𝒜 (MvPolynomial.X i)
local notation "P[" i "]" => Proj.basicOpen 𝒜 (MvPolynomial.X i)
local notation "j[" i "]" => Proj.awayι 𝒜 (MvPolynomial.X i)
  (Iff.mpr (MvPolynomial.mem_homogeneousSubmodule _ _) (MvPolynomial.isHomogeneous_X R i)) one_pos

private theorem chart_eq_on {i : ι} (hi : Dense (D[i] : Set X)) (p : X.PartialMap ℙ)
    (hp : (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap = p.toRationalMap)
    {V : X.Opens} (hV : Dense (V : Set X)) (hVi : V ≤ D[i]) (hVp : V ≤ p.domain) :
    X.homOfLE hVi ≫ L.obj.toProjectiveSpaceChart f s i ≫ j[i] = X.homOfLE hVp ≫ p.hom := by
  let q := L.obj.partialMapToProjectiveSpace f s i hi
  have hq : q.domain = D[i] := L.obj.partialMapToProjectiveSpace_domain f s i hi
  have he := (Scheme.PartialMap.equiv_iff_of_isSeparated_of_le
    (X ↘ ⊤_ Scheme) (ℙ ↘ ⊤_ Scheme) (f := q) (g := p) hV (hVi.trans hq.ge) hVp).mp
    (Scheme.PartialMap.toRationalMap_eq_iff.mp hp)
  have he' : X.homOfLE (hVi.trans hq.ge) ≫ q.hom = X.homOfLE hVp ≫ p.hom := he
  simpa only [q, partialMapToProjectiveSpace_hom, ← Category.assoc,
    Scheme.homOfLE_homOfLE] using he'

private theorem dense_nonvanishingLocus_of_projectiveChart {i : ι}
    (hi : Dense (D[i] : Set X)) (p : X.PartialMap ℙ)
    (hp : (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap = p.toRationalMap)
    {j : ι} {x : p.domain} (hx : p.hom x ∈ P[j]) :
    Dense (D[j] : Set X) := by
  let W := p.domain.ι ''ᵁ (p.hom ⁻¹ᵁ P[j])
  have hxW : (x : X) ∈ W := ⟨x, hx, rfl⟩
  have hk : W ≤ p.domain :=
    (p.domain.ι.image_le_opensRange _).trans_eq p.domain.opensRange_ι
  have hηi : genericPoint X ∈ D[i] :=
    (genericPoint_specializes _).mem_open (D[i]).isOpen hi.nonempty.choose_spec
  have hηW : genericPoint X ∈ W := (genericPoint_specializes _).mem_open W.isOpen hxW
  let V := D[i] ⊓ W
  have hV : Dense (V : Set X) := V.isOpen.dense ⟨_, hηi, hηW⟩
  have hVi : V ≤ D[i] := inf_le_left
  have hVp : V ≤ p.domain := inf_le_right.trans hk
  have hv := L.chart_eq_on f s hi p hp hV hVi hVp
  let η : V := ⟨genericPoint X, hηi, hηW⟩
  have hmem : X.homOfLE hVi η ∈
      (L.obj.toProjectiveSpaceChart f s i ≫ j[i]) ⁻¹ᵁ P[j] := by
    have hη : X.homOfLE hVp η ∈ p.hom ⁻¹ᵁ P[j] := by
      have hη' : X.homOfLE hVp η ∈ p.domain.ι ⁻¹ᵁ W :=
        (Scheme.Hom.mem_preimage _).mpr (by
          have hc := (Scheme.Opens.ι_apply p.domain (X.homOfLE hVp η)).trans
            (Scheme.homOfLE_apply hVp η)
          exact hc.symm ▸ hηW)
      simpa only [W, Scheme.Hom.preimage_image_eq] using hη'
    have e := congrArg (fun m : V.toScheme ⟶ ℙ ↦ m η) hv
    have e' := (Scheme.Hom.comp_apply (X.homOfLE hVi) _ η).symm.trans
      (e.trans (Scheme.Hom.comp_apply (X.homOfLE hVp) _ η))
    exact (Scheme.Hom.mem_preimage _).mpr (e'.symm ▸ (Scheme.Hom.mem_preimage _).mp hη)
  rw [Scheme.Hom.comp_preimage, toProjectiveSpaceChart_awayι_preimage_basicOpen] at hmem
  exact (D[j]).isOpen.dense ⟨_, hmem⟩

private theorem exists_restrict_eq_smul_of_projectiveChart {i : ι}
    (hi : Dense (D[i] : Set X)) (p : X.PartialMap ℙ)
    (hp : (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap = p.toRationalMap)
    {U : X.Opens} [Nonempty U] (hU : U ≤ p.domain)
    (hchart : Set.range (X.homOfLE hU ≫ p.hom) ⊆ (P[i] : Set ℙ)) (j : ι) :
    ∃ r : Γ(X, U), r • L.obj.presheaf.map U.leTop.op (s i) =
      L.obj.presheaf.map U.leTop.op (s j) := by
  let d : Spec (.of B[i]) ⟶ ℙ := j[i]
  have hP : d.opensRange = P[i] := Proj.opensRange_awayι _ _ _ _
  have hrange : Set.range (X.homOfLE hU ≫ p.hom) ⊆ Set.range d := by
    rw [← Scheme.Hom.coe_opensRange d, hP]
    exact hchart
  let q := IsOpenImmersion.lift d (X.homOfLE hU ≫ p.hom) hrange
  let V := U ⊓ D[i]
  let b : V ⟶ U := homOfLE inf_le_left
  let a : V ⟶ D[i] := homOfLE inf_le_right
  have hη : genericPoint X ∈ D[i] :=
    (genericPoint_specializes _).mem_open (D[i]).isOpen hi.nonempty.choose_spec
  have hV : Nonempty V := ⟨⟨genericPoint X, Scheme.genericPoint_mem U, hη⟩⟩
  have hv := L.chart_eq_on f s hi p hp (V.isOpen.dense (Set.nonempty_coe_sort.mp hV))
    a.le (b.le.trans hU)
  have hq : X.homOfLE b.le ≫ q = X.homOfLE a.le ≫ L.obj.toProjectiveSpaceChart f s i := by
    apply (cancel_mono d).mp
    rw [Category.assoc, IsOpenImmersion.lift_fac, Category.assoc,
      ← Category.assoc (X.homOfLE b.le), Scheme.homOfLE_homOfLE]
    exact hv.symm
  let z := (Scheme.ΓSpecIso (.of B[i])).inv (awayXRatio (R := R) i j)
  let r := U.topIso.hom (q.appTop z)
  let c := L.obj.sectionRatio (L.obj.presheaf.map (D[i]).leTop.op (s j))
    (L.obj.presheaf.map (D[i]).leTop.op (s i)) (by rw [nonvanishingLocus_map, inf_idem])
  have hap : X.presheaf.map b.op r = X.presheaf.map a.op c := by
    have hm (W : X.Opens) (b : V ⟶ W) :
        W.topIso.hom ≫ X.presheaf.map b.op = (X.homOfLE b.le).appTop ≫ V.topIso.hom :=
      (X.restrictFunctorΓ.hom.naturality b.op).symm
    have hh := congrArg (fun h : V.toScheme ⟶ Spec (.of B[i]) ↦ V.topIso.hom (h.appTop z)) hq
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop,
      ConcreteCategory.comp_apply, ConcreteCategory.comp_apply] at hh
    dsimp only [r]
    rw [← ConcreteCategory.comp_apply, hm U b, ConcreteCategory.comp_apply, hh]
    dsimp only [z]
    rw [toProjectiveSpaceChart_appTop_awayXRatio, ← ConcreteCategory.comp_apply,
      ← hm (D[i]) a, ConcreteCategory.comp_apply, Iso.inv_hom_id_apply]
    rfl
  refine ⟨r, L.map_injective_of_isIntegral b ?_⟩
  rw [L.obj.map_smul, hap]
  have hh := congrArg (L.obj.presheaf.map a.op) (L.obj.sectionRatio_smul
    (L.obj.presheaf.map (D[i]).leTop.op (s j)) (L.obj.presheaf.map (D[i]).leTop.op (s i))
    (by rw [nonvanishingLocus_map, inf_idem]))
  have he : a ≫ (D[i]).leTop = b ≫ U.leTop := Subsingleton.elim _ _
  simpa only [c, Scheme.Modules.map_smul, ← Functor.map_comp_apply, ← op_comp, he] using hh

/-- At each point of the domain of a projective presentation, its base ideal agrees
on an affine neighbourhood with the zero ideal of one nonzero coordinate section. -/
theorem exists_affineOpen_ideal_iSup_zeroIdeal_eq_of_mem_domain
    {i : ι} (hi : Dense (D[i] : Set X)) {x : X}
    (hx : x ∈ (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap.domain) :
    ∃ U : X.affineOpens, x ∈ U.val ∧
      U.val ≤ (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap.domain ∧
      ∃ j : ι, s j ≠ 0 ∧
        (⨆ k, L.zeroIdeal (s k)).ideal U = (L.zeroIdeal (s j)).ideal U := by
  obtain ⟨p, hxp, hp⟩ := Scheme.RationalMap.mem_domain.mp hx
  let x' : p.domain := ⟨x, hxp⟩
  have hcover : (⨆ j : ι, P[j]) = ⊤ :=
    Proj.iSup_basicOpen_eq_top _ _ (MvPolynomial.irrelevant_eq_span_X ι R).le
  obtain ⟨j, hj⟩ := Opens.mem_iSup.mp (hcover.ge (Opens.mem_top (p.hom x')))
  have hd := L.dense_nonvanishingLocus_of_projectiveChart f s hi p hp.symm hj
  have hn : s j ≠ 0 := by
    intro hz
    rw [hz, nonvanishingLocus_zero] at hd
    exact hd.nonempty.ne_empty rfl
  let W := p.domain.ι ''ᵁ (p.hom ⁻¹ᵁ P[j])
  have hxW : x ∈ W := ⟨x', hj, rfl⟩
  obtain ⟨T, e, hxT⟩ := L.obj.exists_mem_trivialization x
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVWT⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (⟨hxW, hxT⟩ : x ∈ W ⊓ T) (W ⊓ T).isOpen
  let U : X.affineOpens := ⟨V, hV⟩
  have hVW : V ≤ W := (show V ≤ W ⊓ T from hVWT).trans inf_le_left
  have hVp : V ≤ p.domain :=
    hVW.trans ((p.domain.ι.image_le_opensRange _).trans_eq p.domain.opensRange_ι)
  let aT : V ⟶ T := homOfLE ((show V ≤ W ⊓ T from hVWT).trans inf_le_right)
  let b := L.obj.presheaf.map aT.op (L.obj.trivializationGenerator e)
  have hb : V ≤ L.obj.nonvanishingLocus b :=
    L.obj.le_nonvanishingLocus_map aT _
      (by rw [nonvanishingLocus_trivializationGenerator]; exact aT.le)
  have hnonempty : Nonempty V := ⟨⟨x, hxV⟩⟩
  have hdomain := hVp.trans p.le_domain_toRationalMap
  rw [hp] at hdomain
  refine ⟨U, hxV, hdomain, j, hn, ?_⟩
  refine le_antisymm ?_ (le_iSup (fun j ↦ L.zeroIdeal (s j)) j U)
  rw [Scheme.IdealSheafData.ideal_iSup, iSup_apply]
  refine iSup_le fun k ↦ ?_
  have hj' := (L.obj.toRationalMap_partialMapToProjectiveSpace_eq f s j i hd hi).trans hp.symm
  have hrange : Set.range (X.homOfLE hVp ≫ p.hom) ⊆ (P[j] : Set ℙ) := by
    rintro _ ⟨y, rfl⟩
    have hy : X.homOfLE hVp y ∈ p.domain.ι ⁻¹ᵁ W :=
      (Scheme.Hom.mem_preimage _).mpr (by
        have hc := (Scheme.Opens.ι_apply p.domain (X.homOfLE hVp y)).trans
          (Scheme.homOfLE_apply hVp y)
        exact hc.symm ▸ hVW y.property)
    dsimp only [W] at hy
    rw [Scheme.Hom.preimage_image_eq] at hy
    exact (Scheme.Hom.comp_apply _ _ y).symm ▸ hy
  obtain ⟨r, hr⟩ :=
    L.exists_restrict_eq_smul_of_projectiveChart f s hd p hj' hVp hrange k
  rw [L.zeroIdeal_ideal_eq_span_singleton (s k) U b hb,
    L.zeroIdeal_ideal_eq_span_singleton (s j) U b hb, ← hr, Ideal.span_singleton_le_span_singleton]
  refine ⟨r, ?_⟩
  simpa only [sectionFrame_symm_apply, smul_eq_mul, mul_comm] using
    _root_.map_smul (L.obj.sectionFrame b hb).symm r (L.obj.presheaf.map U.val.leTop.op (s j))

/-- If a projective section presentation is defined everywhere, its actual base ideal defines
an effective Cartier divisor. The divisor can include fixed components of the presentation. -/
theorem isEffectiveCartier_iSup_zeroIdeal_of_domain_eq_top
    {i : ι} (hi : Dense (D[i] : Set X))
    (hdom : (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap.domain = ⊤) :
    (⨆ j, L.zeroIdeal (s j)).IsEffectiveCartier := by
  rw [Scheme.IdealSheafData.isEffectiveCartier_iff]
  intro x
  have hx : x ∈ (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap.domain := by
    rw [hdom]
    exact Opens.mem_top x
  obtain ⟨U, hxU, -, j, hj, hU⟩ :=
    L.exists_affineOpen_ideal_iSup_zeroIdeal_eq_of_mem_domain f s hi hx
  obtain ⟨V, hVU, hxV, a, ha, hV⟩ :=
    (L.isEffectiveCartier_zeroIdeal hj).exists_eq_span_singleton_le U.val hxU
  refine ⟨V, hxV, a, ha, ?_⟩
  rwa [← Scheme.IdealSheafData.map_ideal _ hVU, hU, Scheme.IdealSheafData.map_ideal]

private theorem exists_nonvanishing_of_notMem_support_iSup_zeroIdeal
    {X : Scheme.{u}} (L : InvertibleSheaf X) {κ : Type*} (s : κ → Γ(L.obj, ⊤))
    {x : X} (hx : x ∉ (⨆ j, L.zeroIdeal (s j)).support) :
    ∃ j, x ∈ L.obj.nonvanishingLocus (s j) := by
  classical
  rw [Scheme.IdealSheafData.support_iSup, Closeds.mem_iInf, not_forall] at hx
  obtain ⟨j, hj⟩ := hx
  obtain ⟨T, e, hxT⟩ := L.obj.exists_mem_trivialization x
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUT⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxT T.isOpen
  let a : U ⟶ T := homOfLE hUT
  let b := L.obj.presheaf.map a.op (L.obj.trivializationGenerator e)
  have hb : U ≤ L.obj.nonvanishingLocus b :=
    L.obj.le_nonvanishingLocus_map a _
      (by rw [nonvanishingLocus_trivializationGenerator]; exact a.le)
  have he := L.obj.basicOpen_eq_inf_nonvanishingLocus U.leTop (s j) hb
    (L.obj.sectionRatio_smul (L.obj.presheaf.map U.leTop.op (s j)) b hb)
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hU⟩) hxU,
    L.zeroIdeal_ideal_eq_span_singleton (s j) ⟨U, hU⟩ b hb, X.zeroLocus_span,
    X.zeroLocus_singleton, Set.mem_compl_iff, not_not, he] at hj
  exact ⟨j, hj.2⟩

/-- A projective section presentation without divisorial base components is defined
exactly away from the support of its base ideal. -/
theorem mem_domain_partialMapToProjectiveSpace_iff_notMem_support
    [IsLocallyNoetherian X] {i : ι} (hi : Dense (D[i] : Set X))
    (hbase : ∀ p : CodimensionOnePoint X, (p : X) ∉ (⨆ j, L.zeroIdeal (s j)).support)
    (x : X) :
    x ∈ (L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap.domain ↔
      x ∉ (⨆ j, L.zeroIdeal (s j)).support := by
  let I := ⨆ j, L.zeroIdeal (s j)
  constructor
  · intro hx hxI
    obtain ⟨U, hxU, -, j, hj, he⟩ :=
      L.exists_affineOpen_ideal_iSup_zeroIdeal_eq_of_mem_domain f s hi hx
    have hsame {y : X} (hy : y ∈ U.val) :
        y ∈ I.support ↔ y ∈ (L.zeroIdeal (s j)).support := by
      rw [Scheme.IdealSheafData.mem_support_iff_of_mem hy,
        Scheme.IdealSheafData.mem_support_iff_of_mem hy, he]
    have hj' := L.isEffectiveCartier_zeroIdeal hj
    obtain ⟨p, hp, hpx⟩ :=
      hj'.mem_support_iff_exists_codimensionOnePoint.mp ((hsame hxU).mp hxI)
    exact hbase p ((hsame (hpx.mem_open U.val.isOpen hxU)).mpr hp)
  · intro hx
    obtain ⟨j, hj⟩ := exists_nonvanishing_of_notMem_support_iSup_zeroIdeal L s hx
    have hd : Dense (D[j] : Set X) := (D[j]).isOpen.dense ⟨x, hj⟩
    have hm : x ∈ (L.obj.partialMapToProjectiveSpace f s j hd).toRationalMap.domain :=
      (L.obj.partialMapToProjectiveSpace f s j hd).le_domain_toRationalMap
        ((L.obj.partialMapToProjectiveSpace_domain f s j hd).symm ▸ hj)
    rwa [L.obj.toRationalMap_partialMapToProjectiveSpace_eq f s j i hd hi] at hm

section

variable [IsNoetherian X]
  [∀ x : X, UniqueFactorizationMonoid (X.presheaf.stalk x)]

attribute [local instance] IsNormalScheme.of_uniqueFactorizationMonoid_stalk
open SchemeWeilDivisor

/-- The indeterminacy locus of a projective presentation is the support of the base
ideal of the moving part of its system of zero divisors. Zero coordinates are allowed. -/
theorem domain_partialMapToProjectiveSpace_eq_compl_support_baseIdeal_movingPart
    {i : ι} (hi : Dense (D[i] : Set X)) :
    let S := Set.range (fun j : {j // s j ≠ 0} ↦ (L.zeroDivisor j.property).toWeilDivisor)
    let hS : ∀ E ∈ S, 0 ≤ E := fun _ ⟨j, hj⟩ ↦ hj ▸
      (Scheme.CartierDivisor.isEffective_iff_toWeilDivisor_nonneg _).mp
        (L.isEffective_zeroDivisor j.property)
    let hsi : s i ≠ 0 := by
      intro h
      have hd := hi
      rw [h, nonvanishingLocus_zero] at hd
      exact hd.nonempty.ne_empty rfl
    let hne : S.Nonempty := ⟨_, Set.mem_range_self ⟨i, hsi⟩⟩
    ((L.obj.partialMapToProjectiveSpace f s i hi).toRationalMap.domain : Set X) =
      ((baseIdeal (WeilDivisor.movingPart S hne hS) (fun _ ↦
        WeilDivisor.nonneg_of_mem_movingPart hne hS)).support : Set X)ᶜ := by
  classical
  intro S hS hsi hne
  let K := {j // s j ≠ 0}
  let inst : Nonempty K := ⟨⟨i, hsi⟩⟩
  let F : SchemeWeilDivisor X := WeilDivisor.fixedPart S hne hS
  let hI := F.isEffectiveCartier_idealSheaf (WeilDivisor.fixedPart_nonneg hne hS)
  let M := hI.toInvertibleSheaf.tensorProduct L
  obtain ⟨t', ht', hdiv, hrange⟩ :=
    exists_sections_movingPart L (fun j : K ↦ s j) (fun j ↦ j.property)
  let t (j : ι) : Γ(M.obj, ⊤) := if h : s j ≠ 0 then t' ⟨j, h⟩ else 0
  have ht (j : ι) : (L.idealTwistInclusion hI).app ⊤ (t j) = s j := by
    by_cases hj : s j ≠ 0
    · simpa only [t, dite_eq_left hj] using hdiv ⟨j, hj⟩
    · simp only [t, dite_eq_right hj, map_zero, not_ne_iff.mp hj]
  have hti : t i ≠ 0 := by simpa only [t, dite_eq_left hsi] using ht' ⟨i, hsi⟩
  have hd := (M.isEffectiveCartier_zeroIdeal hti).genericPoint_notMem_support
  have hd' : genericPoint X ∉ (⨆ _ : Unit, M.zeroIdeal (t i)).support := by
    simpa only [iSup_const] using hd
  obtain ⟨_, hη⟩ := exists_nonvanishing_of_notMem_support_iSup_zeroIdeal M (fun _ : Unit ↦ t i) hd'
  have htd : Dense (M.obj.nonvanishingLocus (t i) : Set X) :=
    (M.obj.nonvanishingLocus (t i)).isOpen.dense ⟨_, hη⟩
  have hsum : (⨆ j, M.zeroIdeal (t j)) = ⨆ j : K, M.zeroIdeal (t' j) := by
    refine le_antisymm (iSup_le fun j ↦ ?_) (iSup_le fun j ↦ ?_)
    · by_cases hj : s j ≠ 0
      · simpa only [t, dite_eq_left hj] using le_iSup (fun k : K ↦ M.zeroIdeal (t' k)) ⟨j, hj⟩
      · simp only [t, dite_eq_right hj, zeroIdeal_zero, bot_le]
    · simpa only [t, dite_eq_left j.property] using le_iSup (fun k ↦ M.zeroIdeal (t k)) j.val
  have hbase :
      (⨆ j, M.zeroIdeal (t j)) =
        baseIdeal (WeilDivisor.movingPart S hne hS)
          (fun _ ↦ WeilDivisor.nonneg_of_mem_movingPart hne hS) := by
    rw [hsum, ← baseIdeal_range_toWeilDivisor_zeroDivisor M t' ht']
    -- The base ideal depends only on the set of divisors.
    congr 1
  have he := toRationalMap_partialMapToProjectiveSpace_eq_of_hom f t s
    (L.idealTwistInclusion hI) ht i htd hi
  ext x
  rw [← he]
  exact (M.mem_domain_partialMapToProjectiveSpace_iff_notMem_support f t htd
    (by rw [hbase]; exact notMem_support_baseIdeal_movingPart hS hne) x).trans
    (Iff.of_eq (congrArg (fun I : X.IdealSheafData ↦ x ∉ I.support) hbase))

end

