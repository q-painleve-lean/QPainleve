module

public import QPainleve.AlgebraicGeometry.LineBundle.Power
public import TauCeti.AlgebraicGeometry.LineBundle.Ample
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
import Mathlib.Algebra.Order.BigOperators.GroupWithZero.Finset
import Mathlib.Order.Filter.AtTopBot.Finite
import TauCeti.Algebra.Category.ModuleCat.Sheaf.GeneratingSections
import TauCeti.AlgebraicGeometry.LineBundle.TwistedSections
import TauCeti.AlgebraicGeometry.Modules.FiniteType

/-!
# Global generation by ample twists

A finite affine nonvanishing cover for an ample line bundle can be realized by sections of one
positive tensor power. Applying Tau Ceti's
`Scheme.Modules.eventually_exists_generatingSections_tensor_tensorPow` to that power, separately
in each exponent residue class, gives finite global generation for all sufficiently high twists.

## References

* [The Stacks Project, Proposition 28.27.13](https://stacks.math.columbia.edu/tag/01Q3).
-/

public section

open CategoryTheory MonoidalCategory Filter TopologicalSpace
open TauCeti.AlgebraicGeometry

universe u

namespace TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple

open _root_.AlgebraicGeometry

variable {X : Scheme.{u}}

/-- Ample line bundles admit a finite affine cover by nonvanishing loci of global sections
of a single positive tensor power. -/
theorem exists_finset_isAffineOpen_nonvanishingLocus_tensorPow {L : InvertibleSheaf X}
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ d : ℕ, 0 < d ∧ ∃ S : Finset X.Opens, sSup (S : Set X.Opens) = ⊤ ∧
      ∀ U ∈ S, IsAffineOpen U ∧
        ∃ s : Γ((L.tensorPow d).obj, ⊤), (L.tensorPow d).obj.nonvanishingLocus s = U := by
  classical
  obtain ⟨S, hS, h⟩ := hL.exists_finset_isAffineOpen_nonvanishingLocus
  choose hAffine n hn K hK s hs using fun i : S ↦ h i i.property
  let d := ∏ i : S, n i
  have hd : 0 < d := Finset.prod_pos fun i _ ↦ hn i
  refine ⟨d, hd, S, hS, fun U hU ↦ ⟨hAffine ⟨U, hU⟩, ?_⟩⟩
  let i : S := ⟨U, hU⟩
  obtain ⟨m, hm⟩ : n i ∣ d := Finset.dvd_prod_of_mem n (Finset.mem_univ i)
  have hmpos : 0 < m := Nat.pos_of_mul_pos_left (hm ▸ hd)
  have hClass : LineBundleClass.mk ((K i).tensorPow m) = LineBundleClass.mk (L.tensorPow d) := by
    rw [mk_tensorPow, mk_tensorPow, hK i, ← pow_mul, ← hm]
  obtain ⟨e⟩ := mk_eq_mk_iff.mp hClass
  let φ := ((K i).tensorPowObjIso m).symm ≪≫ e
  exact ⟨φ.hom.app ⊤ (Scheme.Modules.tensorPowSection (s i) m), by
    rw [Scheme.Modules.nonvanishingLocus_hom_app,
      Scheme.Modules.nonvanishingLocus_tensorPowSection _ hmpos, hs i]⟩

end TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- A quasi-coherent module of finite type twisted by any sufficiently high power of an ample
line bundle is generated by finitely many global sections. -/
theorem eventually_exists_generatingSections_tensor_tensorPow_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∀ᶠ n : ℕ in atTop, ∃ σ : (F ⊗ (L.tensorPow n).obj).GeneratingSections, σ.IsFiniteType := by
  have := hL.compactSpace
  obtain ⟨d, hd, S, hS, hCover⟩ := hL.exists_finset_isAffineOpen_nonvanishingLocus_tensorPow
  let K := L.tensorPow d
  have hK (x : X) : ∃ s : Γ(K.obj, ⊤), x ∈ K.obj.nonvanishingLocus s ∧
      IsAffineOpen (K.obj.nonvanishingLocus s) := by
    obtain ⟨U, hU, hx⟩ := Opens.mem_sSup.mp (hS.symm ▸ Opens.mem_top x)
    obtain ⟨ha, s, rfl⟩ := hCover U hU
    exact ⟨s, hx, ha⟩
  refine Eventually.atTop_of_arithmetic (Nat.ne_of_gt hd) fun r _ ↦ ?_
  let P := L.tensorPow r
  filter_upwards [eventually_exists_generatingSections_tensor_tensorPow (F ⊗ P.obj) hK]
    with q ⟨σ, hσ⟩
  have hClass : LineBundleClass.mk (P.tensorProduct (K.tensorPow q)) =
      LineBundleClass.mk (L.tensorPow (d * q + r)) := by
    simp [P, K, pow_add, pow_mul, mul_comm]
  obtain ⟨e⟩ := LineBundleClass.mk_eq_mk_iff.mp hClass
  let φ := (α_ F P.obj (TauCeti.tensorPow K.obj q)) ≪≫
    whiskerLeftIso F (whiskerLeftIso P.obj (K.tensorPowObjIso q).symm ≪≫
      (P.tensorProductObjIso (K.tensorPow q)).symm ≪≫ e)
  exact ⟨σ.equivOfIso φ, SheafOfModules.GeneratingSections.isFiniteType_equivOfIso φ σ⟩

end AlgebraicGeometry.Scheme.Modules
