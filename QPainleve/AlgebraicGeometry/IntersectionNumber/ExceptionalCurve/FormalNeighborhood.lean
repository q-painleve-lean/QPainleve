/-!
# Products in the formal neighborhood of an exceptional curve

The powers of an exceptional Cartier ideal give a filtration of the ring of global
functions. Over an affine contraction the successive quotients are generated by
products of degree-one classes. Over the local base this identifies the kernels of
restriction from its completion with the powers of the completed maximal ideal.

## References

* The Stacks Project, [Lemma 54.16.3](https://stacks.math.columbia.edu/tag/0C2K).
-/

public noncomputable section

open CategoryTheory Limits MonoidalCategory Functor.LaxMonoidal Opposite
open scoped TensorProduct
open TauCeti.AlgebraicGeometry TauCeti.AlgebraicGeometry.Scheme.Modules
open AlgebraicGeometry.Scheme.Modules

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}} {E : X.IdealSheafData}

local notation "i" => E.subschemeι
local notation "P" => Scheme.Modules.pullback i
local notation "Γ₀" => (⊤ : X.Opens)

namespace IsExceptionalCurveOfFirstKind

private def conormalProduct (n : ℕ) (U : E.subscheme.Opens) :
    let S := sectionsFunctor U
    S.obj ((P).obj (E ^ n).sheaf) ⊗ S.obj ((P).obj (E ^ 1).sheaf) ⟶
      S.obj ((P).obj (E ^ (n + 1)).sheaf) :=
  let J := E ^ n
  let K := E ^ 1
  let S := sectionsFunctor U
  let a := J.sheafMul K ≫ eqToHom (congrArg sheaf (pow_add E n 1).symm)
  let δ := Functor.OplaxMonoidal.δ (P) J.sheaf K.sheaf
  μ S ((P).obj J.sheaf) ((P).obj K.sheaf) ≫ S.map (inv δ ≫ (P).map a)

private theorem exists_lift_conormalProduct (n : ℕ)
    (hJ : Function.Surjective ((i).pullbackSections (E ^ n).sheaf Γ₀))
    (hK : Function.Surjective ((i).pullbackSections (E ^ 1).sheaf Γ₀)) :
    let U := (i) ⁻¹ᵁ Γ₀
    let S := sectionsFunctor U
    ∀ z : S.obj ((P).obj (E ^ n).sheaf) ⊗[Γ(E.subscheme, U)] S.obj ((P).obj (E ^ 1).sheaf),
      ∃ w : Γ((E ^ (n + 1)).sheaf, Γ₀),
        (E ^ (n + 1)).sheafι.app Γ₀ w ∈ (E ^ n).sections Γ₀ * (E ^ 1).sections Γ₀ ∧
          (i).pullbackSections (E ^ (n + 1)).sheaf Γ₀ w = conormalProduct n U z := by
  intro U S z
  let J := E ^ n
  let K := E ^ 1
  let a : J.sheaf ⊗ K.sheaf ⟶ (E ^ (n + 1)).sheaf :=
    J.sheafMul K ≫ eqToHom (congrArg sheaf (pow_add E n 1).symm)
  let δ := Functor.OplaxMonoidal.δ (P) J.sheaf K.sheaf
  let β := conormalProduct (E := E) n U
  have hJK : J * K = E ^ (n + 1) := (pow_add E n 1).symm
  induction z using TensorProduct.inductionOn with
  | add p q hp hq =>
    obtain ⟨x, hx, hpx⟩ := hp
    obtain ⟨y, hy, hqy⟩ := hq
    refine ⟨x + y, ?_, ?_⟩
    · have h := map_add ((E ^ (n + 1)).sheafι.app Γ₀).hom x y
      exact h.symm ▸ add_mem hx hy
    · rw [map_add, hpx, hqy]
      exact (map_add β.hom p q).symm
  | tmul p q =>
    obtain ⟨x, rfl⟩ := hJ p
    obtain ⟨y, rfl⟩ := hK q
    let z : Γ(J.sheaf ⊗ K.sheaf, Γ₀) :=
      μ (sectionsFunctor Γ₀) J.sheaf K.sheaf (x ⊗ₜ y)
    have hxy : (E ^ (n + 1)).sheafι.app Γ₀ (a.app Γ₀ z) =
        HMul.hMul (α := Γ(X, Γ₀)) (β := Γ(X, Γ₀))
          (J.sheafι.app Γ₀ x) (K.sheafι.app Γ₀ y) := by
      simp only [a, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply]
      have hι {A B : X.IdealSheafData} (h : A = B) :
          eqToHom (congrArg sheaf h) ≫ (B.sheafι : B.sheaf ⟶ Scheme.Modules.unit X) =
            A.sheafι := by
        subst B
        exact Category.id_comp _
      erw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, hι hJK]
      simpa only [z, tmulRight_apply] using
        (congrArg ((J * K).sheafι.app Γ₀) (J.sheafMul_app_tmulRight K x y)).trans
          (J.sheafι_app_sectionsMul K Γ₀ x y)
    refine ⟨a.app Γ₀ z, hxy.symm ▸ Ideal.mul_mem_mul (I := J.sections Γ₀)
      (J := K.sections Γ₀) (J.sheafι_app_mem Γ₀ x) (K.sheafι_app_mem Γ₀ y), ?_⟩
    refine ((i).pullbackSections_naturality (J.sheaf ⊗ K.sheaf) Γ₀ a z).symm.trans ?_
    have hδ := (i).δ_app_pullbackSections_μ J.sheaf Γ₀ K.sheaf x y
    simp only [conormalProduct, ConcreteCategory.comp_apply]
    rw [← hδ]
    have hcancel := Iso.hom_inv_id_apply (S.mapIso (asIso δ))
      ((i).pullbackSections _ Γ₀ z)
    have hcancel' : S.map (inv δ) (S.map δ ((i).pullbackSections _ Γ₀ z)) =
        (i).pullbackSections _ Γ₀ z := hcancel
    exact (congrArg (S.map ((P).map a)) hcancel').symm

/-- Over an affine contraction base, functions vanishing along the exceptional curve
to order at least `n + 1` are sums of products of functions vanishing to orders at
least `n` and one, modulo functions vanishing to order at least `n + 2`. -/
theorem sections_pow_succ_eq_mul_sup (hE : E.IsExceptionalCurveOfFirstKind)
    {Y : Scheme.{u}} [IsAffine Y] [IsLocallyNoetherian Y] {I : Y.IdealSheafData}
    (f : X ⟶ Y) [IsProper f] (hI : I.comap f = E) (hU : I.support.compl ≤ f.isoLocus)
    (n : ℕ) :
    (E ^ (n + 1)).sections Γ₀ =
      (E ^ n).sections Γ₀ * E.sections Γ₀ ⊔ (E ^ (n + 2)).sections Γ₀ := by
  let J := E ^ n
  let K := E ^ 1
  let U := (i) ⁻¹ᵁ Γ₀
  let β := conormalProduct (E := E) n U
  have hβ : Function.Surjective β := by
    have h (V : E.subscheme.Opens) (hV : V = ⊤) :
        Function.Surjective (conormalProduct (E := E) n V) := by
      subst V
      exact hE.surjective_conormalPowerMultiplication n 1
    exact h U ((i).preimage_top)
  have hvan d := hE.subsingleton_cohomology_one_ideal_pow_of_contraction f hI hU d
  have hJ := hE.isEffectiveCartier.surjective_pullbackSections_pow_of_subsingleton_cohomology_one
    n (hvan (n + 1))
  have hK := hE.isEffectiveCartier.surjective_pullbackSections_pow_of_subsingleton_cohomology_one
    1 (hvan 2)
  have hprod : J.sections Γ₀ * K.sections Γ₀ ≤ (J * K).sections Γ₀ :=
    Ideal.mul_le.mpr fun x hx y hy ↦ mul_mem_sections_mul hx hy
  have hJK : J * K = E ^ (n + 1) := (pow_add E n 1).symm
  -- Compare the image in the conormal layer before restoring the higher-order ideal.
  rw [show E.sections Γ₀ = K.sections Γ₀ by simp [K]]
  apply le_antisymm
  · intro s hs
    let w := (E ^ (n + 1)).sectionMk s hs
    obtain ⟨z, hz⟩ := hβ ((i).pullbackSections (E ^ (n + 1)).sheaf Γ₀ w)
    obtain ⟨v, hv, hvs⟩ := exists_lift_conormalProduct n hJ hK z
    have hd : (i).pullbackSections (E ^ (n + 1)).sheaf Γ₀ (w - v) = 0 := by
      rw [map_sub, hvs, hz, sub_self]
    have hw := (hE.isEffectiveCartier.pullbackSections_pow_eq_zero_iff (n + 1) (w - v)).mp hd
    rw [map_sub, sheafι_app_sectionMk] at hw
    exact Submodule.mem_sup.mpr ⟨_, hv, _, hw, add_sub_cancel _ _⟩
  · apply sup_le
    · exact hJK ▸ hprod
    · exact sections_mono (pow_le_pow_right_of_le_one' le_top (Nat.le_succ (n + 1))) Γ₀

section LocalContraction

open IsLocalRing

variable {R : Type u} [CommRing R] [IsLocalRing R]
variable (f : X ⟶ Spec (.of R))

local notation "𝔪" => maximalIdeal R
local notation "R̂" => AdicCompletion 𝔪 R
local notation "g" => Iso.commRingCatIsoToRingEquiv
  (Iso.symm (Scheme.ΓSpecIso (CommRingCat.of R)) ≪≫ asIso (Scheme.Hom.appTop f))
local notation "J" => (fun (n : ℕ) ↦
  Ideal.map (RingEquiv.symm g) (sections (E ^ n) Γ₀))
local notation "I" => ofIdealTop
  (Ideal.map (CommRingCat.Hom.hom (Iso.inv (Scheme.ΓSpecIso (CommRingCat.of R)))) 𝔪)

private theorem ker_fiberThickening (hI : (I).comap f = E) (n : ℕ) :
    let q := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ (n + 1))))
    (Limits.pullback.fst f q).ker = E ^ (n + 1) := by
  intro q
  have : IsClosedImmersion q :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  rw [ker_fst_of_isClosedImmersion, Hom.ker_Spec_map, CommRingCat.hom_ofHom, Ideal.mk_ker,
    Ideal.map_pow, ofIdealTop_pow, comap_pow, hI]

variable [IsIso f.appTop]

private theorem mem_sections_fiberThickening_iff (hI : (I).comap f = E) (n : ℕ) (r : R) :
    r ∈ J (n + 1) ↔ f.completionToFiberThickening n (algebraMap R R̂ r) = 0 := by
  let q := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ (n + 1))))
  have : IsClosedImmersion q :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  let p := Limits.pullback.fst f q
  have hp : p.ker = E ^ (n + 1) := ker_fiberThickening f hI n
  dsimp only
  rw [Ideal.map_symm (g), Ideal.mem_comap, ← hp, p.mem_ker_sections_iff,
    Scheme.Hom.completionToFiberThickening_algebraMap]
  rfl

private theorem maximalIdeal_pow_le_sections (hI : (I).comap f = E) (n : ℕ) :
    𝔪 ^ n ≤ J n := by
  cases n with
  | zero =>
    simp only [pow_zero, one_eq_top, sections_top, Ideal.map_top]
    exact le_top
  | succ n =>
    intro r hr
    rw [mem_sections_fiberThickening_iff f hI, Scheme.Hom.completionToFiberThickening_apply]
    have hz : AdicCompletion.evalₐ 𝔪 (n + 1) (algebraMap R R̂ r) = 0 := by
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Ideal.Quotient.eq_zero_iff_mem]
      exact hr
    rw [hz, map_zero, map_zero]

private theorem sections_one_eq_maximalIdeal (hE : E.IsExceptionalCurveOfFirstKind)
    (hI : (I).comap f = E) : J 1 = 𝔪 := by
  apply le_antisymm _ (by simpa using maximalIdeal_pow_le_sections f hI 1)
  refine le_maximalIdeal ?_
  intro h
  have : Nontrivial Γ(E.subscheme, ⊤) := hE.isField_globalSections.nontrivial
  have hz : (1 : Γ(X, Γ₀)) ∈ E.sections Γ₀ := by
    have hs : (1 : R) ∈ J 1 := by rw [h]; exact Submodule.mem_top
    dsimp only at hs
    rwa [Ideal.map_symm (g), Ideal.mem_comap, map_one, pow_one] at hs
  rw [← E.ker_subschemeι, E.subschemeι.mem_ker_sections_iff, map_one] at hz
  exact one_ne_zero (α := Γ(E.subscheme, ⊤)) hz

variable [IsNoetherianRing R] [IsProper f]

private theorem sections_pow_le_pow_sup (hE : E.IsExceptionalCurveOfFirstKind)
    (hI : (I).comap f = E) (hU : (I).support.compl ≤ f.isoLocus) (n : ℕ) :
    J n ≤ 𝔪 ^ n ⊔ J (n + 1) := by
  have hmul (j : ℕ) : J j * 𝔪 ≤ J (j + 1) := by
    rw [← sections_one_eq_maximalIdeal f hE hI]
    dsimp only
    rw [← Ideal.map_mul, pow_one, pow_succ]
    exact Ideal.map_mono (Ideal.mul_le.mpr fun _ hx _ hy ↦ mul_mem_sections_mul hx hy)
  have hrec (j : ℕ) : J (j + 1) = J j * 𝔪 ⊔ J (j + 2) := by
    rw [← sections_one_eq_maximalIdeal f hE hI]
    dsimp only
    rw [hE.sections_pow_succ_eq_mul_sup f hI hU j, Ideal.map_sup, Ideal.map_mul, pow_one]
  induction n with
  | zero => simp
  | succ n ih =>
    rw [hrec n, pow_succ]
    exact sup_le (le_trans (Ideal.mul_mono ih le_rfl) (by
      rw [Ideal.sup_mul]
      exact sup_le le_sup_left ((hmul (n + 1)).trans le_sup_right))) le_sup_right

omit [IsProper f] in
private theorem ker_completionToFiberThickening_eq_map (hI : (I).comap f = E) (n : ℕ) :
    RingHom.ker (f.completionToFiberThickening n) = (J (n + 1)).map (algebraMap R R̂) := by
  refine le_antisymm (fun a ha ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun r hr ↦ ?_)
  · obtain ⟨r, hr⟩ := AdicCompletion.exists_sub_algebraMap_mem_map_pow
      (Ideal.fg_of_isNoetherianRing 𝔪) (n + 1) a
    have hz : AdicCompletion.evalₐ 𝔪 (n + 1) (a - algebraMap R R̂ r) = 0 := by
      rw [← RingHom.mem_ker, AdicCompletion.ker_evalₐ_eq_map_pow
        (Ideal.fg_of_isNoetherianRing 𝔪)]
      exact hr
    have he : f.completionToFiberThickening n (a - algebraMap R R̂ r) = 0 := by
      simp [Scheme.Hom.completionToFiberThickening_apply, hz]
    have hr' : r ∈ J (n + 1) :=
      (mem_sections_fiberThickening_iff f hI n r).mpr (by
        simpa [map_sub, RingHom.mem_ker.mp ha] using he)
    simpa only [sub_add_cancel] using add_mem
      (Ideal.map_mono (maximalIdeal_pow_le_sections f hI (n + 1)) hr)
      (Ideal.mem_map_of_mem (algebraMap R R̂) hr')
  · exact (mem_sections_fiberThickening_iff f hI n r).mp hr

/-- The kernel of the map from the completed local base ring to functions on the
`(n + 1)`st thickening of the exceptional fiber is the `(n + 1)`st power of the
maximal ideal of the completion. -/
theorem ker_completionToFiberThickening (hE : E.IsExceptionalCurveOfFirstKind)
    (hI : (I).comap f = E) (hU : (I).support.compl ≤ f.isoLocus)
    (n : ℕ) :
    RingHom.ker (f.completionToFiberThickening n) = maximalIdeal R̂ ^ (n + 1) := by
  let K : ℕ → Ideal R̂ := fun j ↦ (J j).map (algebraMap R R̂)
  have hK : Antitone K := by
    intro a b hab
    apply Ideal.map_mono
    apply Ideal.map_mono
    exact sections_mono (pow_le_pow_right_of_le_one' le_top hab) Γ₀
  have : IsSchemeTheoreticallyDominant f :=
    (isSchemeTheoreticallyDominant_iff_appTop_injective f).mpr
      (ConcreteCategory.bijective_of_isIso f.appTop).1
  have hsep : ⨅ j, K j = ⊥ := by
    refine le_antisymm (fun a ha ↦ Ideal.mem_bot.mpr ?_) bot_le
    apply f.injective_completionToFiberThickeningLimit
    apply Concrete.limit_ext
    intro j
    have hzero : f.completionToFiberThickening j.unop a = 0 := by
      rw [← RingHom.mem_ker, ker_completionToFiberThickening_eq_map f hI]
      exact (Ideal.mem_iInf.mp ha) (j.unop + 1)
    have hh := ConcreteCategory.congr_hom (f.completionToFiberThickeningLimit_π j.unop) a
    rw [map_zero, map_zero]
    exact hh.trans hzero
  have hpow (j : ℕ) : maximalIdeal R̂ ^ j ≤ K j := by
    rw [AdicCompletion.maximalIdeal_eq_map, ← Ideal.map_pow]
    exact Ideal.map_mono (maximalIdeal_pow_le_sections f hI j)
  have hstep (j : ℕ) : K j ≤ maximalIdeal R̂ ^ j ⊔ K (j + 1) := by
    dsimp only [K]
    rw [AdicCompletion.maximalIdeal_eq_map, ← Ideal.map_pow, ← Ideal.map_sup]
    exact Ideal.map_mono (sections_pow_le_pow_sup f hE hI hU j)
  rw [ker_completionToFiberThickening_eq_map f hI]
  exact (maximalIdeal R̂).eq_pow_of_isPrecomplete_of_le_sup K hK hsep hpow hstep (n + 1)

/-- The functions on the `(n + 1)`st thickening of the exceptional fiber are the
`(n + 1)`st truncation of the completed local base ring. The equivalence is induced by
pullback from the base. -/
def completionQuotientEquivFiberThickening (hE : E.IsExceptionalCurveOfFirstKind)
    (hI : (I).comap f = E) (hU : (I).support.compl ≤ f.isoLocus) (n : ℕ) :
    (R̂ ⧸ maximalIdeal R̂ ^ (n + 1)) ≃+*
      Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ (n + 1))))), ⊤) :=
  (Ideal.quotEquivOfEq (hE.ker_completionToFiberThickening f hI hU n).symm).trans
    (RingHom.quotientKerEquivOfSurjective (f := f.completionToFiberThickening n) (by
      let q := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (𝔪 ^ (n + 1))))
      have : IsClosedImmersion q :=
        IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
      let p := Limits.pullback.fst f q
      let j := (E ^ (n + 1)).subschemeι
      have hp : p.ker = j.ker := (ker_fiberThickening f hI n).trans (ker_subschemeι _).symm
      let e := IsClosedImmersion.lift p j hp.le
      have he : e ≫ p = j := IsClosedImmersion.lift_fac ..
      have : IsIso e := IsClosedImmersion.isIso_of_ker_eq j p e he hp.symm
      have : IsIso e.appTop := Scheme.Γ.map_isIso e.op
      intro s
      obtain ⟨t, ht⟩ := hE.surjective_appTop_subschemeι_pow_of_contraction
        f hI hU (n + 1) (e.appTop s)
      obtain ⟨r, hr⟩ := (g).surjective t
      refine ⟨algebraMap R R̂ r, (ConcreteCategory.bijective_of_isIso e.appTop).1 ?_⟩
      have hc : p.appTop ((g) r) = f.completionToFiberThickening n (algebraMap R R̂ r) :=
        (Scheme.Hom.completionToFiberThickening_algebraMap f n r).symm
      rw [← hc, hr]
      exact (ConcreteCategory.congr_hom
        ((Scheme.Hom.comp_appTop e p).symm.trans (congrArg Scheme.Hom.appTop he)) t).trans ht))

/-- The finite-level equivalence sends the class of a completed element to its pullback
on the infinitesimal fiber. -/
@[simp]
theorem completionQuotientEquivFiberThickening_mk (hE : E.IsExceptionalCurveOfFirstKind)
    (hI : (I).comap f = E) (hU : (I).support.compl ≤ f.isoLocus) (n : ℕ) (r : R̂) :
    hE.completionQuotientEquivFiberThickening f hI hU n (Ideal.Quotient.mk _ r) =
      f.completionToFiberThickening n r := by
  simp only [completionQuotientEquivFiberThickening, RingEquiv.trans_apply,
    Ideal.quotEquivOfEq_mk]
  exact RingHom.quotientKerEquivOfSurjective_apply_mk _ r

/-- Under the finite-level equivalences, the quotient transition is restriction
along the inclusion of infinitesimal fibers. -/
theorem completionQuotientEquivFiberThickening_factor (hE : E.IsExceptionalCurveOfFirstKind)
    (hI : (I).comap f = E) (hU : (I).support.compl ≤ f.isoLocus) (n : ℕ)
    (q : R̂ ⧸ maximalIdeal R̂ ^ (n + 2)) :
    hE.completionQuotientEquivFiberThickening f hI hU n
        (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_succ (n + 1))) q) =
      (f.fiberThickeningι n).appTop
        (hE.completionQuotientEquivFiberThickening f hI hU (n + 1) q) := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
  rw [Ideal.Quotient.factor_mk, completionQuotientEquivFiberThickening_mk,
    completionQuotientEquivFiberThickening_mk]
  exact (ConcreteCategory.congr_hom (f.completionToFiberThickening_naturality n) r).symm

end LocalContraction

end IsExceptionalCurveOfFirstKind

end AlgebraicGeometry.Scheme.IdealSheafData
